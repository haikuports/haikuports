ADDITIONAL_FILES="papers.rdef.in
	compile-schemas.sh"

ARCHITECTURES="x86_64"
if [ "$targetArchitecture" = x86_gcc2 ]; then
SECONDARY_ARCHITECTURES="?x86"
fi

commandBinDir=$binDir
commandSuffix=$secondaryArchSuffix
if [ "$targetArchitecture" = x86_gcc2 ]; then
	commandSuffix=
	commandBinDir=$prefix/bin
fi

libPPSDocumentVersion="6.0.0"
libPPSDocumenVersionCompat="$libPPSDocumentVersion compat >= ${libPPSDocumentVersion%%.*}"
libPPSViewVersion="5.0.0"
libPPSViewVersionCompat="$libPPSViewVersion compat >= ${libPPSViewVersion%%.*}"

POST_INSTALL_SCRIPTS="
	$relativePostInstallDir/compile-schemas.sh
	"

PROVIDES="
	papers$secondaryArchSuffix = $portVersion
	cmd:papers$commandSuffix
	cmd:papers_previewer$commandSuffix
	cmd:papers_thumbnailer$commandSuffix
	lib:libppsdocument_4.0$secondaryArchSuffix = $libPPSDocumenVersionCompat
	lib:libppsview_4.0$secondaryArchSuffix = $libPPSViewVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libadwaita_1$secondaryArchSuffix
	lib:libarchive$secondaryArchSuffix
	lib:libcairo$secondaryArchSuffix
	lib:libdjvulibre$secondaryArchSuffix
	lib:libexempi$secondaryArchSuffix
	lib:libgdk_pixbuf_2.0$secondaryArchSuffix
	lib:libgio_2.0$secondaryArchSuffix
	lib:libglib_2.0$secondaryArchSuffix
	lib:libgmodule_2.0$secondaryArchSuffix
	lib:libgobject_2.0$secondaryArchSuffix
	lib:libgraphene_1.0$secondaryArchSuffix
	lib:libgtk_4$secondaryArchSuffix
	lib:libgtksourceview_5$secondaryArchSuffix
	lib:libiconv$secondaryArchSuffix
	lib:libintl$secondaryArchSuffix
	lib:libpango_1.0$secondaryArchSuffix
	lib:libpoppler_glib$secondaryArchSuffix
	lib:libspelling_1$secondaryArchSuffix
	lib:libtiff$secondaryArchSuffix
	"

PROVIDES_devel="
	papers${secondaryArchSuffix}_devel = $portVersion
	devel:libppsdocument_4.0$secondaryArchSuffix = $libPPSDocumenVersionCompat
	devel:libppsview_4.0$secondaryArchSuffix = $libPPSViewVersionCompat
	"
REQUIRES_devel="
	papers$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libadwaita_1$secondaryArchSuffix
	devel:libarchive$secondaryArchSuffix
	devel:libdjvulibre$secondaryArchSuffix
	devel:libexempi$secondaryArchSuffix
	devel:libgdk_pixbuf_2.0$secondaryArchSuffix
	devel:libglib_2.0$secondaryArchSuffix
	devel:libgtk_4$secondaryArchSuffix
	devel:libpoppler_glib$secondaryArchSuffix >= 8.31
	devel:libspelling_1$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:appstreamcli
	cmd:awk
	cmd:blueprint_compiler
	cmd:cargo$secondaryArchSuffix
	cmd:cmp
	cmd:diff
	cmd:gcc$secondaryArchSuffix
	cmd:itstool
	cmd:make
	cmd:meson
	cmd:msgfmt$secondaryArchSuffix
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	"

PATCH()
{
	sed -i -e 's|update_desktop_database: true,|update_desktop_database: false,|' \
		meson.build
}

BUILD()
{
	export CARGO_HOME=$sourceDir/build/cargo-home
	vendor=$CARGO_HOME/haiku
	mkdir -p "$vendor"
	for i in $(seq 2 350); do
		eval "srcDir=\$sourceDir$i"
		eval "sha256sum=\$CHECKSUM_SHA256_$i"
		set -- "$srcDir"/*
		ln -sf "$1" "$vendor"
		cat <<-EOF >"$vendor/${1##*/}/.cargo-checksum.json"
		{
		  "package": "$sha256sum",
		  "files": {}
		}
		EOF
	done

	cat <<-EOF >"$CARGO_HOME"/config.toml
	[source.haiku]
	directory = "$vendor"

	[source.crates-io]
	replace-with = "haiku"
	EOF

	meson --buildtype=release build \
		--prefix=$prefix \
		--bindir=$commandBinDir \
		--datadir=$dataDir \
		--localedir=$dataDir/locale \
		--includedir=$includeDir \
		--libdir=$libDir \
		-D nautilus=false \
		-D introspection=enabled  \
		-D documentation=false \
		-D keyring=disabled \
		-D tests=false
}

INSTALL()
{
	RUSTFLAGS="-L/boot/system/develop/lib -liconv" RUST_BACKTRACE=1 \
		ninja -C build install

	# cleanup
	rm -rf $dataDir/{applications,metainfo}
	rm -rf $dataDir/glib-2.0/schemas/gschemas.compiled
	rm -rf $dataDir/icons/hicolor/icon-theme.cache

	# install post-install script
	mkdir -p $postInstallDir
	cp -f $portDir/additional-files/compile-schemas.sh $postInstallDir
	chmod -v a+rx $postInstallDir/compile-schemas.sh

	local MAJOR="`echo "$portVersion" | cut -d. -f1`"
	local MIDDLE="`echo "$portVersion" | cut -d. -f2`"
	local APP_NAME="Papers"
	local LONG_INFO="$SUMMARY"
	local APP_SIGNATURE="application/x-vnd.papers"
	sed \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		-e "s|@APP_NAME@|$APP_NAME|" \
		-e "s|@APP_SIGNATURE@|$APP_SIGNATURE|" \
		$portDir/additional-files/papers.rdef.in > papers.rdef

	addResourcesToBinaries papers.rdef $commandBinDir/papers
	addAppDeskbarSymlink $commandBinDir/papers Papers

	prepareInstalledDevelLibs \
		libppsdocument-4.0 \
		libppsview-4.0
	fixPkgconfig

	packageEntries devel \
		$developDir \
		$dataDir/gir-1.0
}
