From 6ba0ea64da7000ed9990875a8f33759c55f4684e Mon Sep 17 00:00:00 2001
From: Luc Schrijvers <begasus@gmail.com>
Date: Sat, 1 Aug 2026 15:10:24 +0200
Subject: Fixes for newer gtk4


diff --git a/src/core/control/tools/VerticalToolHandler.cpp b/src/core/control/tools/VerticalToolHandler.cpp
index 40e7c35..28b7513 100644
--- a/src/core/control/tools/VerticalToolHandler.cpp
+++ b/src/core/control/tools/VerticalToolHandler.cpp
@@ -4,7 +4,7 @@
 #include <memory>     // for __shared_ptr_access
 
 #include <cairo.h>           // for cairo_fill, cairo_...
-#include <gdk/gdkkeysyms.h>  // for GDK_KEY_Control_L
+#include <gdk/gdk.h>  // for GDK_KEY_Control_L
 
 #include "control/tools/SnapToGridInputHandler.h"  // for SnapToGridInputHan...
 #include "gui/LegacyRedrawable.h"                  // for Redrawable
diff --git a/src/core/gui/inputdevices/InputContext.cpp b/src/core/gui/inputdevices/InputContext.cpp
index ea33bc4..8c96661 100644
--- a/src/core/gui/inputdevices/InputContext.cpp
+++ b/src/core/gui/inputdevices/InputContext.cpp
@@ -138,6 +138,7 @@ static constexpr bool HANDLE_EVENT_TYPE[] = {
 #ifdef GDK_VERSION_4_6
         false,  // GDK_TOUCHPAD_HOLD
 #endif
+        false,
 };
 static_assert(GDK_EVENT_LAST == G_N_ELEMENTS(HANDLE_EVENT_TYPE));
 static bool shouldHandleEvent(GdkEvent* e) { return e && HANDLE_EVENT_TYPE[gdk_event_get_event_type(e)]; }
-- 
