SUMMARY="Guile bindings to GnuTLS"
DESCRIPTION="This package provides Guile bindings to GnuTLS,
a library implementation the TLS protocol.  It supersedes
the Guile bindings that were formerly provided as part of
GnuTLS."
HOMEPAGE="https://codeberg.org/guile-gnutls/guile-gnutls"
COPYRIGHT="2007-2026 Ludovic Courtès et al."
LICENSE="GNU LGPL v2.1"
REVISION="1"
SOURCE_URI="https://codeberg.org/guile-gnutls/guile-gnutls/releases/download/v5.0.3/guile-gnutls-5.0.3.tar.gz"
CHECKSUM_SHA256="230ae4f89dffac6d57fff618410611820e1550907aeef6065b121fe6410a7b6b"
SOURCE_DIR="guile-gnutls-5.0.3"

ARCHITECTURES="all !x86_gcc2"

GUILE_VERSION=3.0

PROVIDES="
	guile_gnutls = 5.0.3
	"

REQUIRES="
	haiku
	guile >= ${GUILE_VERSION}
	lib:libgnutls
	lib:libgc
	"

BUILD_REQUIRES="
	haiku_devel
	guile_devel >= ${GUILE_VERSION}
	gmp_devel
	boehm_gc_devel
	gnutls_devel
	"

BUILD_PREREQUIRES="
	cmd:bash
	cmd:gcc
	cmd:make
	cmd:autoconf
	cmd:automake
	cmd:libtool
	pkgconfig
	texinfo
	texlive
	"

BUILD()
{
    runConfigure ./configure \
		 --infodir=/documentation/info \
		 --with-guile-site-dir=/data/guile/site/3.0 \
		 --with-guile-site-ccache-dir=/lib/guile/3.0/site-ccache \
		 --with-guile-extension-dir=/lib/guile/3.0/extensions
    make $jobArgs
}

INSTALL()
{
    DESTDIR=$prefix make install
}

TEST()
{
    make check
}
