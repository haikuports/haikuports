SUMMARY="Guile bindings to GnuTLS"
DESCRIPTION="This package provides Guile bindings to GnuTLS,
a library implementation the TLS protocol.  It supersedes
the Guile bindings that were formerly provided as part of
GnuTLS."
HOMEPAGE="https://codeberg.org/guile-gnutls/guile-gnutls"
COPYRIGHT="2007-2026 Ludovic Courtès et al."
LICENSE="GNU LGPL v2.1"
REVISION="1"
SOURCE_URI="https://codeberg.org/guile-gnutls/guile-gnutls/releases/download/v$portVersion/guile-gnutls-$portVersion.tar.gz"
CHECKSUM_SHA256="230ae4f89dffac6d57fff618410611820e1550907aeef6065b121fe6410a7b6b"
SOURCE_DIR="guile-gnutls-$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

GUILE_VERSION=3.0

PROVIDES="
	guile_gnutls$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libgc$secondaryArchSuffix
	lib:libgnutls$secondaryArchSuffix
	lib:libguile_$GUILE_VERSION$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libgc$secondaryArchSuffix
	devel:libgmp$secondaryArchSuffix
	devel:libgnutls$secondaryArchSuffix
	devel:libguile_$GUILE_VERSION$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	cmd:libtool$secondaryArchSuffix
	cmd:make
	cmd:makeinfo >= 7
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	runConfigure ./configure \
		--with-guile-site-dir=$dataDir/guile/site/$GUILE_VERSION \
		--with-guile-site-ccache-dir=$libDir/guile/$GUILE_VERSION/site-ccache \
		--with-guile-extension-dir=$libDir/guile/$GUILE_VERSION/extensions
	make $jobArgs
}

INSTALL()
{
	make install
	rm $libDir/guile/$GUILE_VERSION/extensions/*.la
}

TEST()
{
	make check
}
