SUMMARY="Structured access to bytevector contents"
DESCRIPTION="Bytestructures offers a system imitating the type system
of the C programming language, to be used on bytevectors. C's type
system works on raw memory, and Scheme works on bytevectors which are
an abstraction over raw memory."
HOMEPAGE="https://github.com/TaylanUB/scheme-bytestructures"
COPYRIGHT="2015-2021 Taylan Kammer"
LICENSE="GNU GPL v3"
REVISION="1"
SOURCE_URI="https://github.com/TaylanUB/scheme-bytestructures/releases/download/v$portVersion/bytestructures-$portVersion.tar.gz"
CHECKSUM_SHA256="515029be70c0e4d57b0285c2bae6e52501f3dd38c834b1771a668eb3aafad11d"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

GUILE_VERSION=3.0

PROVIDES_guile="
	bytestructures${secondaryArchSuffix}_guile = $portVersion
	"
REQUIRES_guile="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libguile_$GUILE_VERSION$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:awk
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	runConfigure ./configure
	make $jobArgs
}

INSTALL()
{
	make install

	# "share" is explicitly encoded in the Makefile which doesn't
	# honor the --datarootdir configure flag.
	mv $prefix/share $prefix/data
	packageEntries guile lib data
}

TEST()
{
	make check
}
