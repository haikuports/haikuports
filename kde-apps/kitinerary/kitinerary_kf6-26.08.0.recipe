SUMMARY="Itinerary data extraction engine"
DESCRIPTION="The itinerary data extraction engine extracts travel-related information from \
input in various forms, from PDF documents to ticket barcodes, from emails to calendar events, \
and provides that in a machine-readable way."
HOMEPAGE="https://invent.kde.org/pim/kitinerary"
COPYRIGHT="2010-2026 KDE Organisation"
LICENSE="GNU LGPL v2.1"
REVISION="2"
SOURCE_URI="https://download.kde.org/stable/release-service/$portVersion/src/kitinerary-$portVersion.tar.xz"
CHECKSUM_SHA256="b90eeba1507d99e0d911066955031854273938ff1e4f39f9cd4173f4a549515c"
SOURCE_DIR="kitinerary-$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

libVersion="6.8.0"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

enableDocumentation=true # not yet with kde_doc_common

PROVIDES="
	kitinerary_kf6$secondaryArchSuffix = $portVersion
	lib:libKPim6Itinerary$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	abseil_cpp.2025$secondaryArchSuffix
	cmd:osmconvert
	lib:libboost_date_time$secondaryArchSuffix
	lib:libcrypto$secondaryArchSuffix
	lib:libGL$secondaryArchSuffix
	lib:libicuuc$secondaryArchSuffix
	lib:libphonenumber$secondaryArchSuffix
	lib:libpoppler$secondaryArchSuffix
	lib:libprotobuf$secondaryArchSuffix
	lib:libxml2$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	lib:libZXing$secondaryArchSuffix
	# KF6
	lib:libKF6Archive$secondaryArchSuffix
	lib:libKF6CalendarCore$secondaryArchSuffix
	lib:libKF6Codecs$secondaryArchSuffix
	lib:libKF6Contacts$secondaryArchSuffix
	lib:libKF6I18n$secondaryArchSuffix
	lib:libKF6Mime$secondaryArchSuffix
	# KPim6
	lib:libKPim6PkPass$secondaryArchSuffix
	# Qt6
	lib:libQt6Core$secondaryArchSuffix
	lib:libQt6Gui$secondaryArchSuffix
	lib:libQt6Network$secondaryArchSuffix
	lib:libQt6Qml$secondaryArchSuffix
	"

PROVIDES_devel="
	kitinerary_kf6${secondaryArchSuffix}_devel = $portVersion
	devel:libKPim6Itinerary$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	kitinerary_kf6$secondaryArchSuffix == $portVersion base
	"

if $enableDocumentation; then
	ARCHITECTURES_doc="any"

	PROVIDES_doc="
		kitinerary_kf6_doc = $portVersion
		"
	REPLACES_doc="
		kitinerary_kf6_x86_doc
		"
fi

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	shared_mime_info$secondaryArchSuffix
	devel:libphonenumber$secondaryArchSuffix
	devel:libpoppler$secondaryArchSuffix >= 155
	devel:libpoppler_Qt6$secondaryArchSuffix >= 3.10.0
	devel:libssl$secondaryArchSuffix
	devel:libxml2$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	devel:libZXing$secondaryArchSuffix
	# KF6
	extra_cmake_modules$secondaryArchSuffix
	devel:libKF6Archive$secondaryArchSuffix
	devel:libKF6CalendarCore$secondaryArchSuffix
	devel:libKF6Codecs$secondaryArchSuffix
	devel:libKF6Contacts$secondaryArchSuffix
	devel:libKF6I18n$secondaryArchSuffix
	devel:libKF6Mime$secondaryArchSuffix
	# KPim6
	devel:libKPim6PkPass$secondaryArchSuffix
	# Qt6
	qt6_tools${secondaryArchSuffix}_devel
	devel:libQt6Core$secondaryArchSuffix
	devel:libQt6Qml$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
#	kde_qdoc_common
	cmd:cmake
	cmd:dot
	cmd:doxygen
	cmd:g++$secondaryArchSuffix
	cmd:make
	cmd:msgfmt$secondaryArchSuffix
	cmd:msgmerge$secondaryArchSuffix
	cmd:osmconvert
	cmd:pkg_config$secondaryArchSuffix
	cmd:qdoc6$secondaryArchSuffix
	"

BUILD()
{
#	export KDE_DOCS="`finddir B_SYSTEM_DATA_DIRECTORY`"/kde-qdoc-common

	cmake -B build -S . -DCMAKE_BUILD_TYPE=Release \
		$cmakeDirArgs \
		-DBUILD_QCH=ON \
		-DCMAKE_SKIP_RPATH=YES \
		-DBUILD_TESTING=OFF \
		-Wno-dev

	make -C build $jobArgs
# if $enableDocumentation; then
# 	cmake --build build --target prepare_docs
# 	cmake --build build --target generate_docs
# 	cmake --build build --target generate_qch
# fi
}

INSTALL()
{
	make -C build install
# if $enableDocumentation; then
# 	cmake --build build --target install_html_docs
# 	cmake --build build --target install_qch_docs
# fi

	# don't mess with shared_mime_info files
	rm -rf $dataDir/mime/{aliases,generic-icons,globs,globs2,icons,magic}
	rm -rf $dataDir/mime/{mime.cache,subclasses,treemagic,types,version,XMLnamespaces}

	prepareInstalledDevelLib \
		libKPim6Itinerary

	packageEntries devel \
		$developDir \
		$libDir/cmake

if $enableDocumentation; then
	packageEntries doc \
		$documentationDir
fi
}

TEST()
{
	# 80% tests passed, 9 tests failed out of 45
	export LIBRARY_PATH="$sourceDir/build/bin${LIBRARY_PATH:+:$LIBRARY_PATH}"
	ctest --test-dir build --output-on-failure
}
