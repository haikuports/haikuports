From 9d45b10985a3fd1a99a0e66a6a5141831006b11d Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Sun, 2 Aug 2026 16:21:26 +0200
Subject: Patch nvtt to support Haiku


diff --git a/libraries/source/nvtt/build.sh b/libraries/source/nvtt/build.sh
index f05ce28..62d006d 100755
--- a/libraries/source/nvtt/build.sh
+++ b/libraries/source/nvtt/build.sh
@@ -67,11 +67,12 @@ patch -d nvtt-${PV} -p1 <patches/0003-Use-execute_process-insted-of-exec_program
 patch -d nvtt-${PV} -p1 <patches/0004-Properly-detect-ppc64le-systems.patch
 patch -d nvtt-${PV} -p1 <patches/0005-Fix-compiler-flags-on-ppc64le-systems.patch
 patch -d nvtt-${PV} -p1 <patches/0006-Fix-altivec-include-on-ppc64le-systems.patch
+patch -d nvtt-${PV} -p1 <patches/0007-Haiku-support.patch
 
 # build
 (
 	cd nvtt-${PV}
-	mkdir bin lib
+	mkdir -p bin lib
 	./build.sh
 )
 
