From 635a79e04de8c1b7df4cf8012c0106304acdf4fe Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Wed, 5 Aug 2026 18:33:36 +0200
Subject: Allow running as UID 0 on Haiku

There is no notion of root user

diff --git a/source/main.cpp b/source/main.cpp
index 0ad09c1..bc1e2ab 100644
--- a/source/main.cpp
+++ b/source/main.cpp
@@ -805,7 +805,7 @@ extern "C" __attribute__((visibility ("default"))) int pyrogenesis_main(int argc
 int main(int argc, char* argv[])
 #endif
 {
-#if OS_UNIX
+#if OS_UNIX && !OS_HAIKU
 	// Don't allow people to run the game with root permissions,
 	//	because bad things can happen, check before we do anything
 	if (geteuid() == 0)
-- 
2.54.0

