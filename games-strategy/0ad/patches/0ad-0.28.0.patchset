+diff --git a/src/extern/poshlib/posh.h b/src/extern/poshlib/posh.h
+index ba12725..c6cafd2 100644
+--- a/src/extern/poshlib/posh.h
++++ b/src/extern/poshlib/posh.h
+@@ -327,6 +327,11 @@ MCST LCC (eLbrus Compiler Collection):
+ #  define POSH_OS_STRING "OpenBSD"
+ #endif
+ 
++#if defined __HAIKU__
++#  define POSH_OS_HAIKU 1
++#  define POSH_OS_STRING "Haiku"
++#endif
++
+ #if defined __CYGWIN32__
+ #  define POSH_OS_CYGWIN32 1
+ #  define POSH_OS_STRING "Cygwin"
+diff --git a/src/src/nvcore/Debug.cpp b/src/src/nvcore/Debug.cpp
+index b6636c2..42ff81a 100644
+--- a/src/src/nvcore/Debug.cpp
++++ b/src/src/nvcore/Debug.cpp
+@@ -51,11 +51,13 @@
+ #   endif
+ #endif
+ 
+-#if NV_OS_DARWIN || NV_OS_FREEBSD || NV_OS_NETBSD || NV_OS_OPENBSD
++#if NV_OS_DARWIN || NV_OS_FREEBSD || NV_OS_NETBSD || NV_OS_OPENBSD || NV_OS_HAIKU
+ #   include <sys/types.h>
+ #   include <sys/param.h>
+-#   include <sys/sysctl.h> // sysctl
+-#   if !defined(NV_OS_OPENBSD)
++#   if !defined(NV_OS_HAIKU)
++#       include <sys/sysctl.h> // sysctl
++#   endif
++#   if !defined(NV_OS_OPENBSD) && !defined(NV_OS_HAIKU)
+ #       include <sys/ucontext.h>
+ #   endif
+ #   if defined(HAVE_EXECINFO_H) // only after OSX 10.5
+@@ -657,6 +659,9 @@ namespace
+ #  else
+ #       error "Unknown CPU"
+ #  endif        
++#elif NV_OS_HAIKU
++        ucontext_t * ucp = (ucontext_t *)secret;
++        return (void *)ucp->uc_mcontext.rip;
+ #else
+ #  if NV_CPU_X86_64
+         // #define REG_RIP REG_INDEX(rip) // seems to be 16
+diff --git a/src/src/nvcore/nvcore.h b/src/src/nvcore/nvcore.h
+index b5426c1..ff58e6d 100644
+--- a/src/src/nvcore/nvcore.h
++++ b/src/src/nvcore/nvcore.h
+@@ -50,6 +50,9 @@
+ #elif defined POSH_OS_OPENBSD
+ #   define NV_OS_OPENBSD 1
+ #   define NV_OS_UNIX 1
++#elif defined POSH_OS_HAIKU
++#   define NV_OS_HAIKU 1
++#   define NV_OS_UNIX 1
+ #elif defined POSH_OS_CYGWIN32
+ #   define NV_OS_CYGWIN 1
+ #elif defined POSH_OS_MINGW
+@@ -296,7 +299,7 @@ NV_COMPILER_CHECK(sizeof(uint32) == 4);
+ #elif NV_CC_GNUC
+ #   if NV_OS_LINUX
+ #       include "DefsGnucLinux.h"
+-#   elif NV_OS_DARWIN || NV_OS_FREEBSD || NV_OS_NETBSD || NV_OS_OPENBSD
++#   elif NV_OS_DARWIN || NV_OS_FREEBSD || NV_OS_NETBSD || NV_OS_OPENBSD || NV_OS_HAIKU
+ #       include "DefsGnucDarwin.h"
+ #   elif NV_OS_MINGW
+ #       include "DefsGnucWin32.h"
+diff --git a/src/src/nvmath/nvmath.h b/src/src/nvmath/nvmath.h
+index 7fc4d75..dc5fe5e 100644
+--- a/src/src/nvmath/nvmath.h
++++ b/src/src/nvmath/nvmath.h
+@@ -181,7 +181,7 @@ namespace nv
+     {
+ #if NV_OS_WIN32 || NV_OS_XBOX
+         return _finite(f) != 0;
+-#elif NV_OS_DARWIN || NV_OS_FREEBSD || NV_OS_NETBSD || NV_OS_OPENBSD || NV_OS_ORBIS
++#elif NV_OS_DARWIN || NV_OS_FREEBSD || NV_OS_NETBSD || NV_OS_OPENBSD || NV_OS_ORBIS || NV_OS_HAIKU
+         return isfinite(f);
+ #elif NV_OS_LINUX
+         return finitef(f);
+@@ -196,7 +196,7 @@ namespace nv
+     {
+ #if NV_OS_WIN32 || NV_OS_XBOX
+         return _isnan(f) != 0;
+-#elif NV_OS_DARWIN || NV_OS_FREEBSD || NV_OS_NETBSD || NV_OS_OPENBSD || NV_OS_ORBIS || NV_OS_LINUX
++#elif NV_OS_DARWIN || NV_OS_FREEBSD || NV_OS_NETBSD || NV_OS_OPENBSD || NV_OS_ORBIS || NV_OS_LINUX || NV_OS_HAIKU
+         return isnan(f);
+ #else
+ #   error "isNan not supported"
+diff --git a/src/src/nvthread/nvthread.cpp b/src/src/nvthread/nvthread.cpp
+index 967b886..5de6eff 100644
+--- a/src/src/nvthread/nvthread.cpp
++++ b/src/src/nvthread/nvthread.cpp
+@@ -8,7 +8,7 @@
+ #include "Win32.h"
+ #elif NV_OS_UNIX
+ #include <sys/types.h>
+-#if !NV_OS_LINUX
++#if !NV_OS_LINUX && !NV_OS_HAIKU
+ #include <sys/sysctl.h>
+ #endif
+ #include <unistd.h>
