+++ b/source/lib/sysdep/os/unix/unix_executable_pathname.cpp
@@ -41,7 +41,7 @@ OsPath unix_ExecutablePathname()
 	// Find the executable's filename
 	Dl_info dl_info;
 	memset(&dl_info, 0, sizeof(dl_info));
