SUMMARY="A Firefox fork with privacy, usability, and speed enhancements"
DESCRIPTION="Waterfox is an open-source, privacy-focused browser based on the popular \
open source browser with a red panda as a mascot. It is designed to be a drop-in \
replacement for said browser that offers enhanced privacy features, performance \
improvements, and customizability while maintaining compatibility with existing extensions.

Key Features:
* Privacy-focused: Removal of telemetry and tracking, with bare minimum of data collection for operation.
* Performance-oriented: Optimized for modern systems
* Customizable: Support for classic and modern extensions
* Cross-platform: Available for Windows, macOS, Linux, Android and Haiku
* Modern: Regular updates to stay current with web standards"
HOMEPAGE="https://www.waterfox.net/"
COPYRIGHT="1995-2026 Mozilla Developers, BrowserWorks"
LICENSE="MPL v2.0"
REVISION="2"
SOURCE_URI="https://github.com/BrowserWorks/Waterfox/archive/refs/tags/$portVersion.tar.gz"
CHECKSUM_SHA256="41c19dd00ba44f2dfd491200c7b2d1bdc31809ba78a0349b12812bbe73e62f48"
SOURCE_DIR="waterfox-$portVersion"
srcGitRev="9bbefd5ede79575326b14b4b90d3763cf247feff"
SOURCE_URI_2="https://github.com/BrowserWorks/l10n/archive/$srcGitRev.tar.gz"
CHECKSUM_SHA256_2="80229a1b860b51cb8869f9fcffe0a64675206990e6266790f07717b34b2c3aee"
SOURCE_DIR_2="l10n-$srcGitRev"
PATCHES="
	waterfox-$portVersion.patchset
	waterfox_launcher-$portVersion.patchset
	"

# UI backend: "NATIVE" (cairo-haiku) or "GTK" (cairo-gtk3-wayland-only)
UI_BACKEND="NATIVE"

ADDITIONAL_FILES="
	waterfox.rdef.in
	waterfox_launcher.rdef.in
	mozconfig_gtk
	mozconfig_native
	"

ARCHITECTURES="x86_64"

PROVIDES="
	waterfox = $portVersion
	app:Waterfox = $portVersion
	cmd:waterfox = $portVersion
	"
CONFLICTS="
	waterfox_bin
	"
REPLACES="
	waterfox_bin
	"
REQUIRES="
	haiku
	noto_emoji
	noto_emoji_color
	lib:libcairo
	lib:libevent_2.1
	lib:libffi
	lib:libfontconfig
	lib:libfreetype
	lib:libgl
	lib:libharfbuzz
	lib:libintl
	lib:libjpeg
	lib:libmediahelpers
	lib:libnspr4
	lib:libnss3
	lib:libvpx
	lib:libwebp
	lib:libzstd
	lib:libz
	"

if [ "$UI_BACKEND" = "GTK" ]; then
	REQUIRES+="
		lib:libatk_1.0
		lib:libcairo_gobject
		lib:libdbus_1
		lib:libgdk_3
		lib:libgdk_pixbuf_2.0
		lib:libglib_2.0
		lib:libgtk_3
		lib:libnotify
		lib:libpango_1.0
		lib:libpangocairo_1.0
		"
fi

BUILD_REQUIRES="
	haiku_devel
	devel:libevent
	devel:libffi
	devel:libfontconfig
	devel:libfreetype
	devel:libgl
	devel:libjpeg
	devel:libmediahelpers
	devel:libnspr4
	devel:libnss3
	devel:libvpx >= 8
	devel:libwebp
	devel:libzstd
	devel:libz
	"

if [ "$UI_BACKEND" = "GTK" ]; then
	BUILD_REQUIRES+="
		devel:libdbus_1
		devel:libdbus_glib_1
		devel:libglib_2.0
		devel:libgtk_3
		devel:libnotify
		"
fi

BUILD_PREREQUIRES="
	llvm21
	nodejs20
	rust_bin	
	cmd:autoconf_2.13
	cmd:cbindgen
	cmd:clang++
	cmd:gawk
	cmd:gcc
	cmd:git
	cmd:gn >= 0.2385
	cmd:lld >= 21
	cmd:m4
	cmd:make
	cmd:nasm
	cmd:perl
	cmd:pkg_config
	cmd:python3
	cmd:tar
	cmd:unzip
	cmd:xargs
	cmd:zip
	"

PATCH()
{
	find "$sourceDir/third_party/rust/" -name ".cargo-checksum.json" | while read -r file; do
		printf '{"files":{}}' > "$file"
	done

	sed -i '/^checksum =/d' $sourceDir/Cargo.lock

	chmod +x \
		$sourceDir/build/cargo-linker \
		$sourceDir/mach
}

BUILD()
{
	rm -f .mozconfig
	if [ "$UI_BACKEND" = "GTK" ]; then
		cp -f $portDir/additional-files/mozconfig_gtk .mozconfig
	else
		cp -f $portDir/additional-files/mozconfig_native .mozconfig
	fi
	echo "export MOZ_APP_VERSION=$portVersion" >> .mozconfig
	echo "export MOZ_APP_VERSION_DISPLAY=$portVersion" >> .mozconfig
	echo $portVersion >> browser/config/version.txt
	echo $portVersion >> browser/config/version_display.txt

	rm -rf waterfox/browser/locales
	ln -s $sourceDir2 waterfox/browser/locales

	export MOZBUILD_STATE_PATH="$sourceDir/.buildstate"

	export RUSTFLAGS="-C link-arg=-Wl,--no-gc-sections -C force-unwind-tables=no -C codegen-units=1"
	export RUST_BACKTRACE=full
	export RUST_MIN_STACK=33554432
	export CARGO_NET_OFFLINE=true
	export CARGO_BUILD_JOBS=1
	export CARGO_INCREMENTAL=0

	export PIP_NETWORK_INSTALL_RESTRICTED_VIRTUALENVS=mach
	export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE="none"
	export PIP_DISABLE_PIP_VERSION_CHECK=1
	export PIP_NO_INDEX=1

	python3 -m ensurepip --default-pip

	./mach -vv \
		--no-interactive bootstrap \
		--application-choice="Firefox for Desktop" \
		--exclude=sysroot-wasm32-wasi

	./mach python build/gn_processor.py dom/media/webrtc/third_party_build/gn-configs/webrtc.json

	./mach build -j4

	cd tools/haiku-launcher
	g++ -O2 -o "Waterfox Browser" launcher.cpp -lbe
}

INSTALL()
{
	export MOZBUILD_STATE_PATH="$sourceDir/.buildstate"

	export CARGO_NET_OFFLINE=true
	export PIP_NETWORK_INSTALL_RESTRICTED_VIRTUALENVS=mach
	export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE="none"
	export PIP_DISABLE_PIP_VERSION_CHECK=1
	export PIP_NO_INDEX=1

	./mach install

	mkdir -p $appsDir $binDir

	mv /usr/local/lib/waterfox $appsDir/Waterfox
	mv $appsDir/Waterfox/waterfox $appsDir/Waterfox/Waterfox
	cp "tools/haiku-launcher/Waterfox Browser" $appsDir/Waterfox
	ln -s "$appsDir/Waterfox/Waterfox" $binDir/waterfox

	# arranging the files in lib directory
	mkdir -p $appsDir/Waterfox/lib

	pushd $appsDir/Waterfox
	mv -f \
		libgkcodecs.so       \
		liblgpllibs.so       \
		libmozavcodec.so     \
		libmozavutil.so      \
		libmozinference.so   \
		libmozsqlite3.so     \
		libxul.so            \
		lib/ 2>/dev/null || true

	if [ "$UI_BACKEND" = "GTK" ]; then
		mv -f \
			libmozgtk.so     \
			libmozwayland.so \
			lib/ 2>/dev/null || true
	fi
	popd

	local APP_SIGNATURE="application/x-vnd.waterfox"
	local MAJOR="`echo "$portVersion" | cut -d. -f1`"
	local MIDDLE="`echo "$portVersion" | cut -d. -f2`"
	local MINOR="`echo "$portVersion" | cut -d. -f3`"
	local LONG_INFO="$SUMMARY"

	sed \
		-e "s|@APP_SIGNATURE@|$APP_SIGNATURE|" \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/waterfox.rdef.in > waterfox.rdef

	sed \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/waterfox_launcher.rdef.in > waterfox_launcher.rdef

	addResourcesToBinaries waterfox.rdef "$appsDir/Waterfox/Waterfox"
	addResourcesToBinaries waterfox_launcher.rdef "$appsDir/Waterfox/Waterfox Browser"

	addAppDeskbarSymlink $appsDir/Waterfox/Waterfox
}
