resource app_flags B_MULTIPLE_LAUNCH | B_BACKGROUND_APP;

resource app_signature "application/x-vnd.Mozilla-gfxtest";

resource app_version {
	major  = @MAJOR@,
	middle = @MIDDLE@,
	minor  = @MINOR@,

	variety = B_APPV_FINAL,
	internal = 0,

	short_info = "gfxtest",
	long_info = "Firefox OpenGL probe utility"
};
