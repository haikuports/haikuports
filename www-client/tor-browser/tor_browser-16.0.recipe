	cmd:python3
	cmd:tar
	cmd:tor
	cmd:unzip
	cmd:xargs
	cmd:zip
	"

PATCH()
{
	find "$sourceDir/third_party/rust/" -name ".cargo-checksum.json" | while read -r file; do
		printf '{"files":{}}' > "$file"
	done

	sed -i '/^checksum =/d' $sourceDir/Cargo.lock

	chmod +x \
		$sourceDir/build/cargo-linker \
		$sourceDir/mach
}

BUILD()
{
	rm -f mozconfig
	cp -f $portDir/additional-files/mozconfig_native mozconfig

	export MOZBUILD_STATE_PATH="$sourceDir/.mozconfig"

	export RUSTFLAGS="-C link-arg=-Wl,--no-gc-sections -C force-unwind-tables=no -C codegen-units=1"
	export RUST_BACKTRACE=full
	export RUST_MIN_STACK=33554432
	export CARGO_NET_OFFLINE=true
	export CARGO_BUILD_JOBS=1
	export CARGO_INCREMENTAL=0

	export PIP_NETWORK_INSTALL_RESTRICTED_VIRTUALENVS=mach
	export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE="none"
	export PIP_DISABLE_PIP_VERSION_CHECK=1
	export PIP_NO_INDEX=1

	python3 -m ensurepip --default-pip

	# build browser
	./mach -vv \
		--no-interactive bootstrap \
		--application-choice="Tor Browser for Desktop" \
		--exclude=sysroot-wasm32-wasi

	./mach build -j4

	# build launcher
	cd tools/haiku-launcher
	g++ -O2 -o "Tor Browser Launcher" launcher.cpp -lbe

	# build lyrebird
	workDir="$(dirname "$sourceDir3")"
	workDir="${workDir%/}"

	(
		cd "$sourceDir2"
		rm -rf /tmp/govendor
		mkdir -p /tmp/govendor vendor
		cp "$portDir/additional-files/modules.txt" vendor/modules.txt

		i=3
		while read -r _ mod ver arrow rep_mod rep_ver; do
			if [ "$arrow" = "=>" ]; then
				dl_mod="$rep_mod"
				dl_ver="$rep_ver"
			else
				dl_mod="$mod"
				dl_ver="$ver"
			fi

			unzip -oq "$workDir/sources-${i}/"*.zip -d /tmp/govendor
			src="/tmp/govendor/${dl_mod}@${dl_ver}"
			[ -d "$src" ] || { echo "Missing module dir: $src" >&2; exit 1; }
			mkdir -p "vendor/$mod"
			cp -a "$src/." "vendor/$mod/"
			i=$((i + 1))
		done < <(grep '^# ' vendor/modules.txt)
		rm -rf /tmp/govendor

		mkdir -p /tmp/gocache /tmp/gotmp
		export HOME=/tmp
		export TMPDIR=/tmp/gotmp
		export GOTMPDIR=/tmp/gotmp
		export GOCACHE=/tmp/gocache
		export GOMAXPROCS=1
		export GOPROXY=off
		export GOSUMDB=off
		export GOFLAGS="-mod=vendor -trimpath"
		CGO_ENABLED=0 go build -p 1 -ldflags="-X main.lyrebirdVersion=0.9.0" ./cmd/lyrebird
	)
}

INSTALL()
{
	export MOZBUILD_STATE_PATH="$sourceDir/.mozconfig"

	export CARGO_NET_OFFLINE=true
	export PIP_NETWORK_INSTALL_RESTRICTED_VIRTUALENVS=mach
	export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE="none"
	export PIP_DISABLE_PIP_VERSION_CHECK=1
	export PIP_NO_INDEX=1

	./mach install

	mkdir -p $appsDir $binDir

	mv /usr/local/lib/torbrowser $appsDir/TorBrowser
	mv $appsDir/TorBrowser/torbrowser "$appsDir/TorBrowser/Tor Browser"
	cp "tools/haiku-launcher/Tor Browser Launcher" $appsDir/TorBrowser
	ln -s "$appsDir/TorBrowser/Tor Browser" $binDir/torbrowser

	# arranging the files in lib directory
	mkdir -p $appsDir/TorBrowser/lib

	pushd $appsDir/TorBrowser
	mv -f \
		libgkcodecs.so       \
		liblgpllibs.so       \
		libmozavcodec.so     \
		libmozavutil.so      \
		libmozinference.so   \
		libmozsqlite3.so     \
		libxul.so            \
		lib/ 2>/dev/null || true
	popd

	# tor and lyrebird
	mkdir -p $appsDir/TorBrowser/TorBrowser/Tor/PluggableTransports
	ln -s /system/bin/tor $appsDir/TorBrowser/TorBrowser/Tor/tor
	install -m 755 $sourceDir2/lyrebird \
		$appsDir/TorBrowser/TorBrowser/Tor/PluggableTransports/lyrebird

	# geoip data from system tor
	ln -s /system/data/tor/geoip \
		$appsDir/TorBrowser/TorBrowser/Tor/geoip
	ln -s /system/data/tor/geoip6 \
		$appsDir/TorBrowser/TorBrowser/Tor/geoip6

	cp $portDir/additional-files/torrc-defaults \
		$appsDir/TorBrowser/TorBrowser/Tor/torrc-defaults

	# noscript extension
	mkdir -p $appsDir/TorBrowser/distribution/extensions
	cp $sourceDir67/noscript-13.6.37.1984.xpi \
		$appsDir/TorBrowser/distribution/extensions/{73a6fe31-595d-460b-a920-fcc0f8843232}.xpi

	local APP_SIGNATURE="application/x-vnd.tor-browser"
	local MAJOR="`echo "$portVersion" | cut -d. -f1`"
	local MIDDLE="`echo "$portVersion" | cut -d. -f2`"
	local MINOR="0"
	local LONG_INFO="$SUMMARY"

	sed \
		-e "s|@APP_SIGNATURE@|$APP_SIGNATURE|" \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/tor_browser.rdef.in > tor_browser.rdef

	sed \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/tor_browser_launcher.rdef.in > tor_browser_launcher.rdef

	addResourcesToBinaries tor_browser.rdef "$appsDir/TorBrowser/Tor Browser"
	addResourcesToBinaries tor_browser_launcher.rdef "$appsDir/TorBrowser/Tor Browser Launcher"
	addAppDeskbarSymlink "$appsDir/TorBrowser/Tor Browser"
}
