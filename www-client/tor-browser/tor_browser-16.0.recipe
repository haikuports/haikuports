PATCHES="
	tor_browser-$portVersion.patchset
	tor_browser_launcher-$portVersion.patchset
	"

ADDITIONAL_FILES="
	tor_browser.rdef.in
	tor_browser_launcher.rdef.in
	mozconfig_native
	modules.txt
	torrc-defaults
	"

ARCHITECTURES="x86_64"

PROVIDES="
	tor_browser = $portVersion
	app:TorBrowser = $portVersion
	cmd:torbrowser = $portVersion
	"
REQUIRES="
	haiku
	noto_emoji
	noto_emoji_color	
	lib:libcairo
	lib:libevent_2.1
	lib:libffi
	lib:libfontconfig
	lib:libfreetype
	lib:libgl
	lib:libharfbuzz
	lib:libintl
	lib:libjpeg
	lib:libmediahelpers
	lib:libnspr4
	lib:libnss3
	lib:libvpx
	lib:libwebp
	lib:libzstd
	lib:libz
	cmd:tor
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libevent
	devel:libffi
	devel:libfontconfig
	devel:libfreetype
	devel:libgl
	devel:libjpeg
	devel:libmediahelpers
	devel:libnspr4
	devel:libnss3
	devel:libvpx >= 8
	devel:libwebp
	devel:libzstd
	devel:libz
	"
BUILD_PREREQUIRES="
	llvm21
	nodejs20
	rust_bin
	cmd:autoconf_2.13
	cmd:cbindgen
	cmd:clang++
	cmd:gawk
	cmd:gcc
	cmd:git
	cmd:gn >= 0.2385
	cmd:go
	cmd:lld >= 21
	cmd:m4
	cmd:make
