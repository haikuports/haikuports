diff --git a/widget/haiku/nsClipboardHaiku.cpp b/widget/haiku/nsClipboardHaiku.cpp
new file mode 100644
index 0000000000..c458268873
--- /dev/null
+++ b/widget/haiku/nsClipboardHaiku.cpp
@@ -0,0 +1,304 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsClipboardHaiku.h"
+
+#include <cstdio>
+#include <cstring>
+#include <new>
+
+#include "imgIContainer.h"
+#include "nsComponentManagerUtils.h"
+#include "nsISupportsPrimitives.h"
+#include "nsPrimitiveHelpers.h"
+#include "nsString.h"
+#include "nsStringStream.h"
+#include "nsIInputStream.h"
+
+using namespace mozilla;
+using namespace mozilla::widget;
+
+NS_IMPL_ISUPPORTS_INHERITED0(nsClipboardHaiku, nsBaseClipboard)
+
+nsClipboardHaiku::nsClipboardHaiku()
+    : nsBaseClipboard(mozilla::dom::ClipboardCapabilities(
+          false,
+          false,
+          false)) {}
+
+nsClipboardHaiku::~nsClipboardHaiku() = default;
+
+nsresult nsClipboardHaiku::EmptyNativeClipboardData(
+    ClipboardType aWhichClipboard) {
+  if (aWhichClipboard != ClipboardType::kGlobalClipboard) {
+    return NS_OK;
+  }
+
+  if (!be_clipboard->Lock()) {
+    return NS_ERROR_FAILURE;
+  }
+
+  be_clipboard->Clear();
+  be_clipboard->Commit();
+  be_clipboard->Unlock();
+
+  mLocalSequenceNumber++;
+  return NS_OK;
+}
+
+mozilla::Result<int32_t, nsresult>
+nsClipboardHaiku::GetNativeClipboardSequenceNumber(
+    ClipboardType aWhichClipboard) {
+  if (aWhichClipboard != ClipboardType::kGlobalClipboard) {
+    return 0;
+  }
+
+  if (be_clipboard) {
+    return static_cast<int32_t>(be_clipboard->SystemCount());
+  }
+
+  return mLocalSequenceNumber;
+}
+
+mozilla::Result<bool, nsresult>
+nsClipboardHaiku::HasNativeClipboardDataMatchingFlavors(
+    const nsTArray<nsCString>& aFlavorList, ClipboardType aWhichClipboard) {
+  if (aWhichClipboard != ClipboardType::kGlobalClipboard) {
+    return false;
+  }
+
+  if (!be_clipboard->Lock()) {
+    return mozilla::Err(NS_ERROR_FAILURE);
+  }
+
+  BMessage* clip = be_clipboard->Data();
+  bool found = false;
+
+  if (clip) {
+    for (const auto& flavor : aFlavorList) {
+      if (flavor.EqualsLiteral(kTextMime) || flavor.EqualsLiteral("text/plain")) {
+        if (clip->HasData("text/plain", B_MIME_TYPE)) {
+          found = true;
+          break;
+        }
+      } else if (flavor.EqualsLiteral(kHTMLMime) || flavor.EqualsLiteral("text/html")) {
+        if (clip->HasData("text/html", B_MIME_TYPE)) {
+          found = true;
+          break;
+        }
+      } else if (flavor.EqualsLiteral(kPNGImageMime) ||
+                 flavor.EqualsLiteral(kJPEGImageMime) ||
+                 flavor.EqualsLiteral(kJPGImageMime) ||
+                 flavor.EqualsLiteral(kNativeImageMime)) {
+        if (clip->HasMessage("image/bitmap") ||
+            clip->HasData("image/png", B_MIME_TYPE)) {
+          found = true;
+          break;
+        }
+      }
+    }
+  }
+
+  be_clipboard->Unlock();
+  return found;
+}
+
+NS_IMETHODIMP
+nsClipboardHaiku::SetNativeClipboardData(nsITransferable* aTransferable,
+                                         ClipboardType aWhichClipboard) {
+  NS_ENSURE_ARG_POINTER(aTransferable);
+
+  if (aWhichClipboard != ClipboardType::kGlobalClipboard) {
+    return NS_ERROR_FAILURE;
+  }
+
+  if (!be_clipboard->Lock()) {
+    return NS_ERROR_FAILURE;
+  }
+
+  be_clipboard->Clear();
+
+  BMessage* clip = be_clipboard->Data();
+  if (!clip) {
+    be_clipboard->Unlock();
+    return NS_ERROR_FAILURE;
+  }
+
+  WriteStringData(clip, aTransferable, kTextMime, "text/plain", "text/plain");
+  WriteStringData(clip, aTransferable, kHTMLMime, "text/html");
+  WriteImage(clip, aTransferable);
+
+  be_clipboard->Commit();
+  be_clipboard->Unlock();
+
+  mLocalSequenceNumber++;
+  return NS_OK;
+}
+
+nsresult nsClipboardHaiku::WriteStringData(BMessage* aClip, nsITransferable* aTrans,
+                                           const char* aGeckoFlavor, const char* aHaikuMime,
+                                           const char* aAltGeckoFlavor) {
+  nsCOMPtr<nsISupports> data;
+  nsresult rv = aTrans->GetTransferData(aGeckoFlavor, getter_AddRefs(data));
+  if ((NS_FAILED(rv) || !data) && aAltGeckoFlavor) {
+    rv = aTrans->GetTransferData(aAltGeckoFlavor, getter_AddRefs(data));
+  }
+  if (NS_FAILED(rv) || !data) {
+    return rv;
+  }
+
+  nsCOMPtr<nsISupportsString> str = do_QueryInterface(data);
+  if (!str) {
+    return NS_ERROR_FAILURE;
+  }
+
+  nsAutoString u16str;
+  str->GetData(u16str);
+
+  NS_ConvertUTF16toUTF8 u8str(u16str);
+  status_t stat = aClip->AddData(aHaikuMime, B_MIME_TYPE, u8str.get(), u8str.Length());
+  return stat == B_OK ? NS_OK : NS_ERROR_FAILURE;
+}
+
+nsresult nsClipboardHaiku::WriteImage(BMessage* aClip, nsITransferable* aTrans) {
+  nsCOMPtr<nsISupports> data;
+  nsresult rv = aTrans->GetTransferData(kNativeImageMime, getter_AddRefs(data));
+  if (NS_FAILED(rv) || !data) {
+    rv = aTrans->GetTransferData(kPNGImageMime, getter_AddRefs(data));
+    if (NS_FAILED(rv) || !data) {
+      return rv;
+    }
+  }
+
+  nsCOMPtr<imgIContainer> image = do_QueryInterface(data);
+  if (!image) {
+    return NS_ERROR_FAILURE;
+  }
+
+  BBitmap* haikuBitmap = CreateBBitmapFromImage(image);
+  if (!haikuBitmap) {
+    return NS_ERROR_FAILURE;
+  }
+
+  BMessage bitmapArchive;
+  if (haikuBitmap->Archive(&bitmapArchive) == B_OK) {
+    aClip->AddMessage("image/bitmap", &bitmapArchive);
+    aClip->AddPoint("be:location", BPoint(0, 0));
+  }
+
+  delete haikuBitmap;
+  return NS_OK;
+}
+
+mozilla::Result<nsCOMPtr<nsISupports>, nsresult>
+nsClipboardHaiku::GetNativeClipboardData(const nsACString& aFlavor,
+                                         ClipboardType aWhichClipboard,
+                                         uint64_t aThreshold) {
+  if (aWhichClipboard != ClipboardType::kGlobalClipboard) {
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  if (!be_clipboard->Lock()) {
+    return mozilla::Err(NS_ERROR_FAILURE);
+  }
+
+  BMessage* clip = be_clipboard->Data();
+  if (!clip) {
+    be_clipboard->Unlock();
+    return mozilla::Err(NS_ERROR_FAILURE);
+  }
+
+  mozilla::Result<nsCOMPtr<nsISupports>, nsresult> result = nsCOMPtr<nsISupports>{};
+
+  if (aFlavor.EqualsLiteral(kTextMime) || aFlavor.EqualsLiteral("text/plain")) {
+    result = ReadStringData(clip, "text/plain");
+  } else if (aFlavor.EqualsLiteral(kHTMLMime) || aFlavor.EqualsLiteral("text/html")) {
+    result = ReadStringData(clip, "text/html");
+  } else if (aFlavor.EqualsLiteral(kPNGImageMime) ||
+             aFlavor.EqualsLiteral(kJPEGImageMime) ||
+             aFlavor.EqualsLiteral(kJPGImageMime) ||
+             aFlavor.EqualsLiteral(kNativeImageMime)) {
+    result = ReadImage(clip, aFlavor);
+  }
+
+  be_clipboard->Unlock();
+  return result;
+}
+
+mozilla::Result<nsCOMPtr<nsISupports>, nsresult>
+nsClipboardHaiku::ReadStringData(BMessage* aClip, const char* aMimeType) {
+  const void* data = nullptr;
+  ssize_t dataLen = 0;
+  if (aClip->FindData(aMimeType, B_MIME_TYPE, &data, &dataLen) != B_OK ||
+      !data || dataLen <= 0) {
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  const char* strData = static_cast<const char*>(data);
+  if (dataLen > 0 && strData[dataLen - 1] == '\0') {
+    dataLen--;
+  }
+
+  nsAutoString u16str;
+  CopyUTF8toUTF16(Span(strData, dataLen), u16str);
+
+  nsCOMPtr<nsISupportsString> str =
+      do_CreateInstance(NS_SUPPORTS_STRING_CONTRACTID);
+  if (!str) {
+    return mozilla::Err(NS_ERROR_FAILURE);
+  }
+  str->SetData(u16str);
+
+  return nsCOMPtr<nsISupports>(std::move(str));
+}
+
+mozilla::Result<nsCOMPtr<nsISupports>, nsresult>
+nsClipboardHaiku::ReadImage(BMessage* aClip, const nsACString& aFlavor) {
+  const void* rawPngData = nullptr;
+  ssize_t rawPngLen = 0;
+  if (aClip->FindData("image/png", B_MIME_TYPE, &rawPngData, &rawPngLen) == B_OK &&
+      rawPngData && rawPngLen > 0) {
+    nsCOMPtr<nsIInputStream> byteStream;
+    NS_NewByteInputStream(getter_AddRefs(byteStream),
+                          Span(static_cast<const char*>(rawPngData), rawPngLen),
+                          NS_ASSIGNMENT_COPY);
+    return nsCOMPtr<nsISupports>(std::move(byteStream));
+  }
+
+  BMessage archive;
+  if (aClip->FindMessage("image/bitmap", &archive) != B_OK) {
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  auto* bitmap = new (std::nothrow) BBitmap(&archive);
+  if (!bitmap || bitmap->InitCheck() != B_OK) {
+    delete bitmap;
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  BBitmapStream bitmapStream(bitmap);
+  BMallocIO mallocIO;
+  BTranslatorRoster* roster = BTranslatorRoster::Default();
+  if (!roster || roster->Translate(&bitmapStream, nullptr, nullptr,
+                                   &mallocIO, B_PNG_FORMAT) != B_OK) {
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  const void* buffer = mallocIO.Buffer();
+  size_t bufferSize = mallocIO.BufferLength();
+  if (!buffer || bufferSize == 0) {
+    return nsCOMPtr<nsISupports>{};
+  }
+
+  nsCOMPtr<nsIInputStream> byteStream;
+  nsresult rv = NS_NewByteInputStream(
+      getter_AddRefs(byteStream),
+      Span(static_cast<const char*>(buffer), bufferSize),
+      NS_ASSIGNMENT_COPY);
+  if (NS_FAILED(rv)) {
+    return mozilla::Err(rv);
+  }
+
+  return nsCOMPtr<nsISupports>(std::move(byteStream));
+}
