diff --git a/browser/components/shell/nsHaikuShellService.cpp b/browser/components/shell/nsHaikuShellService.cpp
new file mode 100644
index 0000000000..d48664900a
--- /dev/null
+++ b/browser/components/shell/nsHaikuShellService.cpp
@@ -0,0 +1,321 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsHaikuShellService.h"
+
+#include <cstring>
+#include <new>
+
+#pragma GCC visibility push(default)
+#include <app/Messenger.h>
+#include <interface/Screen.h>
+#include <interface/Window.h>
+#include <storage/Directory.h>
+#include <storage/FindDirectory.h>
+#include <storage/MimeType.h>
+#include <storage/Node.h>
+#include <storage/Path.h>
+#pragma GCC visibility pop
+
+#include "mozilla/dom/Document.h"
+#include "mozilla/dom/Element.h"
+#include "mozilla/dom/ReferrerInfo.h"
+#include "nsComponentManagerUtils.h"
+#include "nsContentPolicyUtils.h"
+#include "nsICookieJarSettings.h"
+#include "nsIDocShell.h"
+#include "nsIImageLoadingContent.h"
+#include "nsILoadContext.h"
+#include "nsIObserverService.h"
+#include "nsIPrefService.h"
+#include "nsIURI.h"
+#include "nsIWebBrowserPersist.h"
+#include "nsNetUtil.h"
+#include "nsServiceManagerUtils.h"
+#include "nsShellService.h"
+#include "nsString.h"
+
+#define HAIKU_FIREFOX_SIGNATURE "application/x-vnd.iceweasel-launcher"
+
+NS_IMPL_ISUPPORTS(nsHaikuShellService, nsIShellService, nsIToolkitShellService,
+                  nsIWebProgressListener)
+
+nsresult nsHaikuShellService::Init() { return NS_OK; }
+
+static bool IsMimeDefault(const char* aMimeType, const char* aSignature) {
+  BMimeType mime(aMimeType);
+  if (mime.InitCheck() != B_OK) {
+    return false;
+  }
+  char preferred[B_MIME_TYPE_LENGTH] = {0};
+  if (mime.GetPreferredApp(preferred) == B_OK) {
+    return strcmp(preferred, aSignature) == 0;
+  }
+  return false;
+}
+
+static void SetMimeDefault(const char* aMimeType, const char* aSignature) {
+  BMimeType mime(aMimeType);
+  if (mime.InitCheck() == B_OK) {
+    mime.SetPreferredApp(aSignature);
+  }
+}
+
+NS_IMETHODIMP
+nsHaikuShellService::IsDefaultBrowser(bool aForAllTypes,
+                                     bool* aIsDefaultBrowser) {
+  NS_ENSURE_ARG_POINTER(aIsDefaultBrowser);
+
+  bool isDefault = IsMimeDefault("application/x-vnd.Be.URL.http",
+                                 HAIKU_FIREFOX_SIGNATURE) &&
+                   IsMimeDefault("application/x-vnd.Be.URL.https",
+                                 HAIKU_FIREFOX_SIGNATURE);
+
+  if (isDefault && aForAllTypes) {
+    isDefault = IsMimeDefault("text/html", HAIKU_FIREFOX_SIGNATURE);
+  }
+
+  *aIsDefaultBrowser = isDefault;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsHaikuShellService::SetDefaultBrowser(bool aForAllUsers) {
+  SetMimeDefault("application/x-vnd.Be.URL.http", HAIKU_FIREFOX_SIGNATURE);
+  SetMimeDefault("application/x-vnd.Be.URL.https", HAIKU_FIREFOX_SIGNATURE);
+  SetMimeDefault("text/html", HAIKU_FIREFOX_SIGNATURE);
+
+  nsCOMPtr<nsIPrefBranch> prefs(do_GetService(NS_PREFSERVICE_CONTRACTID));
+  if (prefs) {
+    (void)prefs->SetBoolPref(PREF_CHECKDEFAULTBROWSER, true);
+    (void)prefs->SetIntPref(PREF_DEFAULTBROWSERCHECKCOUNT, 0);
+  }
+
+  return NS_OK;
+}
+
+static int32_t ConvertPositionToHaikuMode(int32_t aPosition) {
+  switch (aPosition) {
+    case nsIShellService::BACKGROUND_TILE:
+      return 3; // kTiled
+    case nsIShellService::BACKGROUND_CENTER:
+      return 1; // kCentered
+    case nsIShellService::BACKGROUND_STRETCH:
+    case nsIShellService::BACKGROUND_FILL:
+    case nsIShellService::BACKGROUND_FIT:
+    case nsIShellService::BACKGROUND_SPAN:
+    default:
+      return 2; // kScaledToFit
+  }
+}
+
+static status_t ApplyHaikuDesktopBackground(const char* aImagePath,
+                                            int32_t aHaikuMode) {
+  BPath desktopPath;
+  if (find_directory(B_DESKTOP_DIRECTORY, &desktopPath) != B_OK) {
+    return B_ERROR;
+  }
+
+  BNode desktopNode(desktopPath.Path());
+  if (desktopNode.InitCheck() != B_OK) {
+    return B_ERROR;
+  }
+
+  BMessage container;
+  container.AddString("be:bgndimginfopath", aImagePath);
+  container.AddInt32("be:bgndimginfoworkspaces", B_ALL_WORKSPACES);
+  container.AddInt32("be:bgndimginfomode", aHaikuMode);
+  container.AddPoint("be:bgndimginfooffset", BPoint(0, 0));
+  container.AddBool("be:bgndimginfoerasetext", true);
+  container.AddInt32("be:bgndimginfoset", 0);
+
+  ssize_t flattenedSize = container.FlattenedSize();
+  if (flattenedSize < B_OK) {
+    return flattenedSize;
+  }
+
+  char* buffer = new (std::nothrow) char[flattenedSize];
+  if (!buffer) {
+    return B_NO_MEMORY;
+  }
+
+  status_t err = container.Flatten(buffer, flattenedSize);
+  if (err == B_OK) {
+    ssize_t written = desktopNode.WriteAttr(
+        "be:bgndimginfo", B_MESSAGE_TYPE, 0, buffer, flattenedSize);
+    if (written != flattenedSize) {
+      err = (written < 0) ? static_cast<status_t>(written) : B_ERROR;
+    }
+  }
+
+  delete[] buffer;
+
+  if (err == B_OK) {
+    BMessenger tracker("application/x-vnd.Be-TRAK");
+    if (tracker.IsValid()) {
+      tracker.SendMessage('Tbgr');
+    }
+  }
+
+  return err;
+}
+
+NS_IMETHODIMP
+nsHaikuShellService::SetDesktopBackground(mozilla::dom::Element* aElement,
+                                         int32_t aPosition,
+                                         const nsACString& aImageName) {
+  NS_ENSURE_ARG_POINTER(aElement);
+
+  nsresult rv;
+  nsCOMPtr<nsIImageLoadingContent> imageContent =
+      do_QueryInterface(aElement, &rv);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsCOMPtr<nsIURI> imageURI;
+  rv = imageContent->GetCurrentURI(getter_AddRefs(imageURI));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  BPath settingsPath;
+  if (find_directory(B_USER_SETTINGS_DIRECTORY, &settingsPath) != B_OK) {
+    return NS_ERROR_FAILURE;
+  }
+  settingsPath.Append("Mozilla/Firefox");
+  create_directory(settingsPath.Path(), 0755);
+
+  nsAutoCString leafName(aImageName);
+  int32_t dot = leafName.RFindChar('.');
+  nsAutoCString ext(".png"_ns);
+  if (dot != kNotFound) {
+    ext = Substring(leafName, dot);
+  }
+
+  nsAutoCString bgFileName("desktop_background");
+  bgFileName.Append(ext);
+  settingsPath.Append(bgFileName.get());
+
+  rv = NS_NewNativeLocalFile(nsDependentCString(settingsPath.Path()),
+                             getter_AddRefs(mBackgroundFile));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  mBackgroundPosition = aPosition;
+
+  nsCOMPtr<nsIWebBrowserPersist> wbp(do_CreateInstance(
+      "@mozilla.org/embedding/browser/nsWebBrowserPersist;1", &rv));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  uint32_t flags = nsIWebBrowserPersist::PERSIST_FLAGS_NO_CONVERSION |
+                   nsIWebBrowserPersist::PERSIST_FLAGS_REPLACE_EXISTING_FILES |
+                   nsIWebBrowserPersist::PERSIST_FLAGS_FROM_CACHE;
+
+  wbp->SetPersistFlags(flags);
+  wbp->SetProgressListener(this);
+
+  nsCOMPtr<nsILoadContext> loadContext;
+  nsCOMPtr<nsISupports> container = aElement->OwnerDoc()->GetContainer();
+  nsCOMPtr<nsIDocShell> docShell = do_QueryInterface(container);
+  if (docShell) {
+    loadContext = do_QueryInterface(docShell);
+  }
+
+  auto referrerInfo =
+      mozilla::MakeRefPtr<mozilla::dom::ReferrerInfo>(*aElement);
+  nsCOMPtr<nsICookieJarSettings> cookieJarSettings =
+      aElement->OwnerDoc()->CookieJarSettings();
+
+  return wbp->SaveURI(imageURI, aElement->NodePrincipal(), 0, referrerInfo,
+                      cookieJarSettings, nullptr, nullptr, mBackgroundFile,
+                      nsIContentPolicy::TYPE_IMAGE,
+                      loadContext ? loadContext->UsePrivateBrowsing() : false);
+}
+
+NS_IMETHODIMP
+nsHaikuShellService::GetDesktopBackgroundColor(uint32_t* aColor) {
+  NS_ENSURE_ARG_POINTER(aColor);
+  rgb_color c = BScreen().DesktopColor();
+  *aColor = (c.red << 16) | (c.green << 8) | c.blue;
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsHaikuShellService::SetDesktopBackgroundColor(uint32_t aColor) {
+  rgb_color c;
+  c.red = (aColor >> 16) & 0xFF;
+  c.green = (aColor >> 8) & 0xFF;
+  c.blue = aColor & 0xFF;
+  c.alpha = 255;
+
+  BScreen screen;
+  int32 count = count_workspaces();
+  for (int32 i = 0; i < count; ++i) {
+    screen.SetDesktopColor(c, i, true);
+  }
+
+  BMessenger messenger("application/x-vnd.Haiku-Screen");
+  if (messenger.IsValid()) {
+    messenger.SendMessage('upcl');
+  }
+
+  nsCOMPtr<nsIObserverService> os(
+      do_GetService("@mozilla.org/observer-service;1"));
+  if (os) {
+    os->NotifyObservers(nullptr, "shell:desktop-background-changed", nullptr);
+  }
+
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsHaikuShellService::OnStateChange(nsIWebProgress* aWebProgress,
+                                   nsIRequest* aRequest, uint32_t aStateFlags,
+                                   nsresult aStatus) {
+  if (NS_SUCCEEDED(aStatus) && (aStateFlags & STATE_STOP) && !aRequest) {
+    if (mBackgroundFile) {
+      bool exists = false;
+      mBackgroundFile->Exists(&exists);
+      if (exists) {
+        nsAutoCString nativePath;
+        mBackgroundFile->GetNativePath(nativePath);
+        int32_t haikuMode = ConvertPositionToHaikuMode(mBackgroundPosition);
+        ApplyHaikuDesktopBackground(nativePath.get(), haikuMode);
+      }
+    }
+
+    nsCOMPtr<nsIObserverService> os(
+        do_GetService("@mozilla.org/observer-service;1"));
+    if (os) {
+      os->NotifyObservers(nullptr, "shell:desktop-background-changed", nullptr);
+    }
+  }
+
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsHaikuShellService::OnProgressChange(nsIWebProgress*, nsIRequest*, int32_t,
+                                      int32_t, int32_t, int32_t) {
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsHaikuShellService::OnLocationChange(nsIWebProgress*, nsIRequest*, nsIURI*,
+                                      uint32_t) {
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsHaikuShellService::OnStatusChange(nsIWebProgress*, nsIRequest*, nsresult,
+                                    const char16_t*) {
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsHaikuShellService::OnSecurityChange(nsIWebProgress*, nsIRequest*, uint32_t) {
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsHaikuShellService::OnContentBlockingEvent(nsIWebProgress*, nsIRequest*,
+                                            uint32_t) {
+  return NS_OK;
+}
diff --git a/browser/components/shell/nsHaikuShellService.h b/browser/components/shell/nsHaikuShellService.h
new file mode 100644
index 0000000000..2b3fe4a400
--- /dev/null
+++ b/browser/components/shell/nsHaikuShellService.h
@@ -0,0 +1,42 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef nsHaikuShellService_h_
+#define nsHaikuShellService_h_
+
+#include "nsCOMPtr.h"
+#include "nsIFile.h"
+#include "nsIShellService.h"
+#include "nsIToolkitShellService.h"
+#include "nsIWebProgressListener.h"
+#include "nsToolkitShellService.h"
+
+#define NS_HAIKUSHELLSERVICE_CID                     \
+  {                                                  \
+    0x63c7b9f4, 0x0cc8, 0x43f8, {                    \
+      0xb6, 0x66, 0x0a, 0x66, 0x16, 0x55, 0xcb, 0x73 \
+    }                                                \
+  }
+
+class nsHaikuShellService final : public nsIShellService,
+                                  public nsToolkitShellService,
+                                  public nsIWebProgressListener {
+ public:
+  nsHaikuShellService() = default;
+
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSISHELLSERVICE
+  NS_DECL_NSIWEBPROGRESSLISTENER
+
+  nsresult Init();
+
+ protected:
+  virtual ~nsHaikuShellService() = default;
+
+ private:
+  nsCOMPtr<nsIFile> mBackgroundFile;
+  int32_t mBackgroundPosition = nsIShellService::BACKGROUND_STRETCH;
+};
+
+#endif  // nsHaikuShellService_h_
