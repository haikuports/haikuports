diff --git a/widget/haiku/HaikuCursor.cpp b/widget/haiku/HaikuCursor.cpp
new file mode 100644
index 0000000000..194370a95f
--- /dev/null
+++ b/widget/haiku/HaikuCursor.cpp
@@ -0,0 +1,113 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "HaikuCursor.h"
+#include "HaikuView.h"
+#include "imgIContainer.h"
+#include "nsTHashMap.h"
+
+#include <algorithm>
+
+namespace mozilla::widget {
+
+const BCursor* HaikuCursor::GetSystemCursor(BCursorID aId) {
+  static nsTHashMap<nsUint32HashKey, UniquePtr<BCursor>>* sCursorMap = nullptr;
+  if (!sCursorMap) {
+    sCursorMap = new nsTHashMap<nsUint32HashKey, UniquePtr<BCursor>>();
+  }
+
+  auto& cursor = sCursorMap->LookupOrInsert(static_cast<uint32_t>(aId));
+  if (!cursor) {
+    cursor = MakeUnique<BCursor>(aId);
+  }
+  return cursor.get();
+}
+
+void HaikuCursor::ClearCache() {
+}
+
+UniquePtr<BCursor> HaikuCursor::CreateCustomCursor(const Cursor& aCursor) {
+  if (!aCursor.mContainer) {
+    return nullptr;
+  }
+
+  BBitmap* bitmap = CreateBBitmapFromImage(aCursor.mContainer);
+  if (!bitmap) {
+    return nullptr;
+  }
+
+  float width = bitmap->Bounds().Width() + 1.0f;
+  float height = bitmap->Bounds().Height() + 1.0f;
+  float hx = std::clamp(static_cast<float>(aCursor.mHotspotX), 0.0f, width - 1.0f);
+  float hy = std::clamp(static_cast<float>(aCursor.mHotspotY), 0.0f, height - 1.0f);
+  BPoint hotspot(hx, hy);
+
+  auto cursor = MakeUnique<BCursor>(bitmap, hotspot);
+  delete bitmap;
+  return cursor;
+}
+
+void HaikuCursor::SetCursor(HaikuWindow* aWindow, HaikuView* aView,
+                            const Cursor& aCursor,
+                            UniquePtr<BCursor>& aCustomCursorHolder) {
+  if (!aView) {
+    return;
+  }
+
+  const BCursor* cursorToSet = nullptr;
+
+  if (aCursor.mContainer) {
+    aCustomCursorHolder = CreateCustomCursor(aCursor);
+    if (aCustomCursorHolder) {
+      cursorToSet = aCustomCursorHolder.get();
+    }
+  }
+
+  if (!cursorToSet) {
+    aCustomCursorHolder = nullptr;
+
+    BCursorID id = B_CURSOR_ID_SYSTEM_DEFAULT;
+    switch (aCursor.mDefaultCursor) {
+      case eCursor_standard: id = B_CURSOR_ID_SYSTEM_DEFAULT; break;
+      case eCursor_wait: id = B_CURSOR_ID_PROGRESS; break;
+      case eCursor_select: id = B_CURSOR_ID_I_BEAM; break;
+      case eCursor_hyperlink: id = B_CURSOR_ID_FOLLOW_LINK; break;
+      case eCursor_crosshair: id = B_CURSOR_ID_CROSS_HAIR; break;
+      case eCursor_move: id = B_CURSOR_ID_MOVE; break;
+      case eCursor_help: id = B_CURSOR_ID_HELP; break;
+      case eCursor_none: id = B_CURSOR_ID_NO_CURSOR; break;
+      case eCursor_not_allowed:
+      case eCursor_no_drop: id = B_CURSOR_ID_NOT_ALLOWED; break;
+      case eCursor_grab: id = B_CURSOR_ID_GRAB; break;
+      case eCursor_grabbing: id = B_CURSOR_ID_GRABBING; break;
+      case eCursor_col_resize:
+      case eCursor_ew_resize: id = B_CURSOR_ID_RESIZE_EAST_WEST; break;
+      case eCursor_row_resize:
+      case eCursor_ns_resize: id = B_CURSOR_ID_RESIZE_NORTH_SOUTH; break;
+      case eCursor_n_resize: id = B_CURSOR_ID_RESIZE_NORTH; break;
+      case eCursor_s_resize: id = B_CURSOR_ID_RESIZE_SOUTH; break;
+      case eCursor_w_resize: id = B_CURSOR_ID_RESIZE_WEST; break;
+      case eCursor_e_resize: id = B_CURSOR_ID_RESIZE_EAST; break;
+      case eCursor_nw_resize: id = B_CURSOR_ID_RESIZE_NORTH_WEST; break;
+      case eCursor_ne_resize: id = B_CURSOR_ID_RESIZE_NORTH_EAST; break;
+      case eCursor_sw_resize: id = B_CURSOR_ID_RESIZE_SOUTH_WEST; break;
+      case eCursor_se_resize: id = B_CURSOR_ID_RESIZE_SOUTH_EAST; break;
+      case eCursor_nwse_resize: id = B_CURSOR_ID_RESIZE_NORTH_WEST_SOUTH_EAST; break;
+      case eCursor_nesw_resize: id = B_CURSOR_ID_RESIZE_NORTH_EAST_SOUTH_WEST; break;
+      case eCursor_zoom_in: id = B_CURSOR_ID_ZOOM_IN; break;
+      case eCursor_zoom_out: id = B_CURSOR_ID_ZOOM_OUT; break;
+      default: id = B_CURSOR_ID_SYSTEM_DEFAULT; break;
+    }
+    cursorToSet = GetSystemCursor(id);
+  }
+
+  if (aWindow && aWindow->LockWithTimeout(10000) == B_OK) {
+    if (cursorToSet) {
+      aView->SetViewCursor(cursorToSet);
+    }
+    aWindow->Unlock();
+  }
+}
+
+}  // namespace mozilla::widget
