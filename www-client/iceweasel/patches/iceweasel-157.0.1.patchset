diff --git a/media/libcubeb/src/cubeb_haiku.cpp b/media/libcubeb/src/cubeb_haiku.cpp
new file mode 100644
index 0000000000..93d265fdd5
--- /dev/null
+++ b/media/libcubeb/src/cubeb_haiku.cpp
@@ -0,0 +1,1587 @@
+/*
+ * Copyright © 2024-2026 Gerasim Troeglazov
+ *
+ * This program is made available under an ISC-style license. See the
+ * accompanying file LICENSE for details.
+ */
+
+#include "cubeb-internal.h"
+#include "cubeb/cubeb.h"
+#include "cubeb_resampler.h"
+#include "cubeb_ringbuffer.h"
+#include "cubeb_utils.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+// Workaround for gcc_hidden.h hack of libxul.so
+#pragma GCC visibility push(default)
+
+#include <app/Application.h>
+#include <app/Roster.h>
+#include <kernel/OS.h>
+#include <media/MediaAddOn.h>
+#include <media/MediaDefs.h>
+#include <media/MediaNode.h>
+#include <media/MediaRecorder.h>
+#include <media/MediaRoster.h>
+#include <media/SoundPlayer.h>
+#include <storage/Entry.h>
+#include <storage/NodeInfo.h>
+#include <storage/Path.h>
+#include <support/Errors.h>
+#include <support/String.h>
+#include <support/SupportDefs.h>
+
+#pragma GCC visibility pop
+
+static const int MAX_CHANNELS = 2;
+static const char DEFAULT_CONTEXT_NAME[] = "Cubeb";
+
+static const char HAIKU_DEFAULT_IN[] = "Default Input";
+static const char HAIKU_DEFAULT_OUT[] = "Default Output";
+
+#define HAIKU_DEFAULT_IN_ID ((cubeb_devid)(uintptr_t) HAIKU_DEFAULT_IN)
+#define HAIKU_DEFAULT_OUT_ID ((cubeb_devid)(uintptr_t) HAIKU_DEFAULT_OUT)
+
+// -----------------------------------------------------------------------------
+// Helper to retrieve current application binary name
+// -----------------------------------------------------------------------------
+static void
+get_application_name(char * buffer, size_t size, const char * fallback)
+{
+  app_info info;
+  if (be_app != NULL && be_app->GetAppInfo(&info) == B_OK) {
+    BPath path(&info.ref);
+    if (path.InitCheck() == B_OK && path.Leaf() != NULL) {
+      snprintf(buffer, size, "%s", path.Leaf());
+      return;
+    }
+  }
+
+  image_info img_info;
+  int32 cookie = 0;
+  while (get_next_image_info(B_CURRENT_TEAM, &cookie, &img_info) == B_OK) {
+    if (img_info.type == B_APP_IMAGE) {
+      BPath path(img_info.name);
+      if (path.InitCheck() == B_OK && path.Leaf() != NULL) {
+        snprintf(buffer, size, "%s", path.Leaf());
+        return;
+      }
+    }
+  }
+
+  snprintf(buffer, size, "%s", fallback ? fallback : DEFAULT_CONTEXT_NAME);
+}
+
+// -----------------------------------------------------------------------------
+// Helper for converting sample formats to float32
+// -----------------------------------------------------------------------------
+static inline float
+read_sample_to_float(const void * ptr, uint32 formatCode)
+{
+  switch (formatCode) {
+  case media_raw_audio_format::B_AUDIO_FLOAT:
+    return *static_cast<const float *>(ptr);
+  case media_raw_audio_format::B_AUDIO_INT:
+    return *static_cast<const int32 *>(ptr) / 2147483648.0f;
+  case media_raw_audio_format::B_AUDIO_SHORT:
+    return *static_cast<const int16 *>(ptr) / 32768.0f;
+  case media_raw_audio_format::B_AUDIO_UCHAR:
+    return (*static_cast<const uint8 *>(ptr) - 128) / 128.0f;
+  case media_raw_audio_format::B_AUDIO_CHAR:
+    return *static_cast<const int8 *>(ptr) / 128.0f;
+  default:
+    return 0.0f;
+  }
+}
+
+// -----------------------------------------------------------------------------
+// Audio Capture Helper Internal Class
+// -----------------------------------------------------------------------------
+
+typedef void (*AudioCallbackFunc)(const float * data, size_t frameCount,
+                                  void * userData);
+
+inline size_t
+getSampleSize(uint32 formatCode)
+{
+  switch (formatCode) {
+  case media_raw_audio_format::B_AUDIO_FLOAT:
+    return sizeof(float);
+  case media_raw_audio_format::B_AUDIO_INT:
+    return sizeof(int32);
+  case media_raw_audio_format::B_AUDIO_SHORT:
+    return sizeof(int16);
+  case media_raw_audio_format::B_AUDIO_CHAR:
+    return sizeof(int8);
+  case media_raw_audio_format::B_AUDIO_UCHAR:
+    return sizeof(uint8);
+  default:
+    return 0;
+  }
+}
+
+class AudioCapture {
+public:
+  AudioCapture(AudioCallbackFunc callback = NULL, void * userData = NULL,
+               uint32 targetChannels = 2,
+               const char * nodeName = "AudioCaptureClient");
+  ~AudioCapture();
+
+  status_t Start();
+  status_t Stop();
+
+  bool IsRunning() const { return mIsRecording; }
+  status_t Status() const { return mLastStatus; }
+  float DeviceSampleRate() const { return mDeviceSampleRate; }
+  uint32 InputChannelCount() const { return mDeviceChannelCount; }
+  uint32 InputFormatCode() const { return mDeviceMediaFormatCode; }
+  const char * InputDeviceName() const { return mDeviceName.String(); }
+
+  AudioCapture(const AudioCapture &) = delete;
+  AudioCapture & operator=(const AudioCapture &) = delete;
+  AudioCapture(AudioCapture &&) = delete;
+  AudioCapture & operator=(AudioCapture &&) = delete;
+
+private:
+  status_t initializeDevice();
+  void cleanupMediaResources();
+  void cleanupBuffers();
+  void processData(void * data, size_t size,
+                   const media_raw_audio_format & format) noexcept;
+
+  static void readCallbackC(void * cookie, bigtime_t timestamp, void * data,
+                            size_t size,
+                            const media_format & format) noexcept;
+  static void notifyCallbackC(void * cookie, BMediaRecorder::notification code,
+                              ...);
+
+  AudioCallbackFunc mUserCallback;
+  void * mUserData;
+  uint32 mTargetChannels;
+  BString mNodeName;
+
+  BMediaRoster * mRoster;
+  BMediaRecorder * mRecorder;
+  media_node mAudioInputNode;
+  media_format mNegotiatedFormat;
+  media_raw_audio_format mInputFormatDetails;
+
+  float mDeviceSampleRate;
+  uint32 mDeviceChannelCount;
+  uint32 mDeviceMediaFormatCode;
+  BString mDeviceName;
+
+  bool mIsInitialized;
+  bool mIsRecording;
+  status_t mLastStatus;
+
+  float * mDeviceFloatBuffer;
+  size_t mDeviceFloatBufferSize;
+};
+
+AudioCapture::AudioCapture(AudioCallbackFunc callback, void * userData,
+                           uint32 targetChannels, const char * nodeName)
+    : mUserCallback(callback), mUserData(userData),
+      mTargetChannels(targetChannels > 0 ? targetChannels : 2),
+      mNodeName(nodeName), mRoster(NULL), mRecorder(NULL),
+      mDeviceSampleRate(0.0f), mDeviceChannelCount(0),
+      mDeviceMediaFormatCode(0), mIsInitialized(false), mIsRecording(false),
+      mLastStatus(B_NO_INIT), mDeviceFloatBuffer(NULL),
+      mDeviceFloatBufferSize(0)
+{
+  mLastStatus = initializeDevice();
+  if (mLastStatus == B_OK) {
+    mIsInitialized = true;
+  } else {
+    fprintf(stderr,
+            "Cubeb Haiku (AudioCapture): Failed to initialize device: %s\n",
+            strerror(mLastStatus));
+  }
+}
+
+AudioCapture::~AudioCapture()
+{
+  Stop();
+}
+
+status_t
+AudioCapture::initializeDevice()
+{
+  status_t status = B_OK;
+
+  mRoster = BMediaRoster::CurrentRoster();
+  if (!mRoster) {
+    mRoster = BMediaRoster::Roster(&status);
+    if (!mRoster || status != B_OK) {
+      return status != B_OK ? status : B_ERROR;
+    }
+  }
+
+  status = mRoster->GetAudioInput(&mAudioInputNode);
+  if (status != B_OK)
+    return status;
+
+  if (mAudioInputNode == media_node::null)
+    return B_DEVICE_NOT_FOUND;
+
+  live_node_info liveInfo;
+  status = mRoster->GetLiveNodeInfo(mAudioInputNode, &liveInfo);
+  if (status == B_OK)
+    mDeviceName.SetTo(liveInfo.name);
+
+  media_output audioOutput;
+  int32 count = 0;
+  status = mRoster->GetFreeOutputsFor(mAudioInputNode, &audioOutput, 1, &count,
+                                      B_MEDIA_RAW_AUDIO);
+  if (status != B_OK || count < 1) {
+    fprintf(stderr,
+            "Cubeb Haiku (AudioCapture): Could not find free raw audio "
+            "output.\n");
+    return (status != B_OK) ? status : B_ERROR;
+  }
+
+  mInputFormatDetails = audioOutput.format.u.raw_audio;
+  mDeviceSampleRate = mInputFormatDetails.frame_rate;
+  mDeviceChannelCount = mInputFormatDetails.channel_count;
+  mDeviceMediaFormatCode = mInputFormatDetails.format;
+
+  return B_OK;
+}
+
+status_t
+AudioCapture::Start()
+{
+  if (mIsRecording)
+    return B_OK;
+
+  if (!mIsInitialized)
+    return mLastStatus;
+
+  if (mRecorder != NULL) {
+    cleanupMediaResources();
+    cleanupBuffers();
+  }
+
+  status_t status = B_OK;
+
+  mRecorder = new BMediaRecorder(mNodeName.String(), B_MEDIA_RAW_AUDIO);
+  if (!mRecorder) {
+    mLastStatus = B_NO_MEMORY;
+    return mLastStatus;
+  }
+
+  status = mRecorder->InitCheck();
+  if (status != B_OK) {
+    delete mRecorder;
+    mRecorder = NULL;
+    mLastStatus = status;
+    return status;
+  }
+
+  status = mRecorder->SetHooks(readCallbackC, notifyCallbackC, this);
+  if (status != B_OK) {
+    delete mRecorder;
+    mRecorder = NULL;
+    mLastStatus = status;
+    return status;
+  }
+
+  media_output audioOutput;
+  int32 count = 0;
+  status = mRoster->GetFreeOutputsFor(mAudioInputNode, &audioOutput, 1, &count,
+                                      B_MEDIA_RAW_AUDIO);
+  if (status != B_OK || count < 1) {
+    cleanupMediaResources();
+    mLastStatus = (status != B_OK) ? status : B_ERROR;
+    return mLastStatus;
+  }
+
+  media_format connectionFormat = audioOutput.format;
+  connectionFormat.type = B_MEDIA_RAW_AUDIO;
+  status =
+      mRecorder->Connect(mAudioInputNode, &audioOutput, &connectionFormat);
+  if (status != B_OK) {
+    cleanupMediaResources();
+    mLastStatus = status;
+    return status;
+  }
+
+  mNegotiatedFormat = mRecorder->AcceptedFormat();
+  if (mNegotiatedFormat.type != B_MEDIA_RAW_AUDIO) {
+    Stop();
+    mLastStatus = B_MISMATCHED_VALUES;
+    return mLastStatus;
+  }
+  mInputFormatDetails = mNegotiatedFormat.u.raw_audio;
+
+  mDeviceSampleRate = mInputFormatDetails.frame_rate;
+  mDeviceChannelCount = mInputFormatDetails.channel_count;
+  mDeviceMediaFormatCode = mInputFormatDetails.format;
+
+  status = mRecorder->Start();
+  if (status != B_OK) {
+    Stop();
+    mLastStatus = status;
+    return status;
+  }
+
+  mIsRecording = true;
+  mLastStatus = B_OK;
+  return B_OK;
+}
+
+status_t
+AudioCapture::Stop()
+{
+  mIsRecording = false;
+
+  if (mRecorder) {
+    cleanupMediaResources();
+    cleanupBuffers();
+    mLastStatus = B_OK;
+    return mLastStatus;
+  } else {
+    cleanupBuffers();
+  }
+
+  return B_OK;
+}
+
+void
+AudioCapture::cleanupMediaResources()
+{
+  if (!mRecorder)
+    return;
+
+  mRecorder->Stop();
+  if (mRecorder->IsConnected()) {
+    mRecorder->Disconnect();
+  }
+
+  mRecorder->SetHooks(NULL, NULL, NULL);
+
+  delete mRecorder;
+  mRecorder = NULL;
+}
+
+void
+AudioCapture::cleanupBuffers()
+{
+  free(mDeviceFloatBuffer);
+  mDeviceFloatBuffer = NULL;
+  mDeviceFloatBufferSize = 0;
+}
+
+void
+AudioCapture::readCallbackC(void * cookie, bigtime_t /*timestamp*/, void * data,
+                            size_t size,
+                            const media_format & format) noexcept
+{
+  AudioCapture * self = static_cast<AudioCapture *>(cookie);
+  if (self && self->mIsRecording && format.type == B_MEDIA_RAW_AUDIO) {
+    self->processData(data, size, format.u.raw_audio);
+  }
+}
+
+void
+AudioCapture::notifyCallbackC(void * cookie, BMediaRecorder::notification code,
+                              ...)
+{
+  AudioCapture * self = static_cast<AudioCapture *>(cookie);
+  if (!self)
+    return;
+
+  switch (code) {
+  case BMediaRecorder::B_WILL_STOP:
+    if (self->mIsRecording)
+      self->mIsRecording = false;
+    break;
+  default:
+    break;
+  }
+}
+
+void
+AudioCapture::processData(void * data, size_t size,
+                          const media_raw_audio_format & inputFormat) noexcept
+{
+  if (!mUserCallback || size == 0 || !data)
+    return;
+
+  const uint32 inChannels = inputFormat.channel_count;
+  const size_t sampleSize = getSampleSize(inputFormat.format);
+  if (inChannels == 0 || sampleSize == 0) {
+    return;
+  }
+  const size_t inFrameSize = inChannels * sampleSize;
+  const size_t frameCount = size / inFrameSize;
+
+  if (frameCount == 0)
+    return;
+
+  const uint32 outChannels = mTargetChannels;
+  const size_t neededBufferSize = frameCount * outChannels * sizeof(float);
+
+  if (mDeviceFloatBufferSize < neededBufferSize) {
+    void * newBuffer = realloc(mDeviceFloatBuffer, neededBufferSize);
+    if (!newBuffer)
+      return;
+    mDeviceFloatBuffer = static_cast<float *>(newBuffer);
+    mDeviceFloatBufferSize = neededBufferSize;
+  }
+
+  float * outPtr = mDeviceFloatBuffer;
+  const char * inPtr = static_cast<const char *>(data);
+
+  for (size_t f = 0; f < frameCount; ++f) {
+    const char * framePtr = inPtr + f * inFrameSize;
+
+    if (outChannels == 1) {
+      if (inChannels == 1) {
+        *outPtr++ = read_sample_to_float(framePtr, inputFormat.format);
+      } else {
+        float ch0 = read_sample_to_float(framePtr, inputFormat.format);
+        float ch1 = read_sample_to_float(framePtr + sampleSize, inputFormat.format);
+        *outPtr++ = 0.5f * (ch0 + ch1);
+      }
+    } else if (outChannels == 2) {
+      if (inChannels >= 2) {
+        *outPtr++ = read_sample_to_float(framePtr, inputFormat.format);
+        *outPtr++ = read_sample_to_float(framePtr + sampleSize, inputFormat.format);
+      } else {
+        float ch0 = read_sample_to_float(framePtr, inputFormat.format);
+        *outPtr++ = ch0;
+        *outPtr++ = ch0;
+      }
+    }
+  }
+
+  mUserCallback(mDeviceFloatBuffer, frameCount, mUserData);
+}
+
+// -----------------------------------------------------------------------------
+// Cubeb Haiku Backend Implementation
+// -----------------------------------------------------------------------------
+
+extern "C" {
+int haiku_init(cubeb ** context, char const * context_name);
+}
+static void haiku_destroy(cubeb * context);
+static char const * haiku_get_backend_id(cubeb * context);
+static int haiku_get_max_channel_count(cubeb * ctx, uint32_t * max_channels);
+static int haiku_get_min_latency(cubeb * ctx, cubeb_stream_params params,
+                                 uint32_t * latency_frames);
+static int haiku_get_preferred_sample_rate(cubeb * ctx, uint32_t * rate);
+static int haiku_stream_init(cubeb * context, cubeb_stream ** stream,
+                             char const * stream_name, cubeb_devid input_device,
+                             cubeb_stream_params * input_stream_params,
+                             cubeb_devid output_device,
+                             cubeb_stream_params * output_stream_params,
+                             unsigned int latency_frames,
+                             cubeb_data_callback data_callback,
+                             cubeb_state_callback state_callback,
+                             void * user_ptr);
+static void haiku_stream_destroy(cubeb_stream * stream);
+static int haiku_stream_start(cubeb_stream * stream);
+static int haiku_stream_stop(cubeb_stream * stream);
+static int haiku_stream_get_position(cubeb_stream * stream,
+                                      uint64_t * position);
+static int haiku_stream_get_latency(cubeb_stream * stream,
+                                     uint32_t * latency_frames);
+static int haiku_stream_set_volume(cubeb_stream * stream, float volume);
+static int haiku_stream_get_current_device(cubeb_stream * stream,
+                                            cubeb_device ** const device);
+static int haiku_enumerate_devices(cubeb * context, cubeb_device_type type,
+                                   cubeb_device_collection * collection);
+static int haiku_device_collection_destroy(cubeb * context,
+                                           cubeb_device_collection * collection);
+
+static struct cubeb_ops const cubeb_haiku_ops = {
+    .init = haiku_init,
+    .get_backend_id = haiku_get_backend_id,
+    .get_max_channel_count = haiku_get_max_channel_count,
+    .get_min_latency = haiku_get_min_latency,
+    .get_preferred_sample_rate = haiku_get_preferred_sample_rate,
+    .get_supported_input_processing_params = NULL,
+    .enumerate_devices = haiku_enumerate_devices,
+    .device_collection_destroy = haiku_device_collection_destroy,
+    .destroy = haiku_destroy,
+    .stream_init = haiku_stream_init,
+    .stream_destroy = haiku_stream_destroy,
+    .stream_start = haiku_stream_start,
+    .stream_stop = haiku_stream_stop,
+    .stream_get_position = haiku_stream_get_position,
+    .stream_get_latency = haiku_stream_get_latency,
+    .stream_set_volume = haiku_stream_set_volume,
+    .stream_set_name = NULL,
+    .stream_get_current_device = haiku_stream_get_current_device,
+    .stream_set_input_mute = NULL,
+    .stream_set_input_processing_params = NULL,
+    .stream_device_destroy = NULL,
+    .stream_register_device_changed_callback = NULL,
+    .register_device_collection_changed = NULL,
+};
+
+static void * input_thread_func(void * user_data);
+static void * output_thread_func(void * user_data);
+
+struct cubeb_stream {
+  /* Note: Must match cubeb_stream layout in cubeb.c. */
+  cubeb * context;
+  void * user_ptr;
+  /**/
+
+  pthread_mutex_t mutex;
+
+  cubeb_data_callback data_callback;
+  cubeb_state_callback state_callback;
+  cubeb_resampler * resampler;
+
+  // Output related members
+  cubeb_stream_params output_params;
+  BSoundPlayer * sound_player;
+  media_raw_audio_format output_format_haiku;
+  uint64_t output_position;
+  std::atomic<bool> output_pause;
+  float output_volume;
+
+  lock_free_audio_ring_buffer<float> * output_ring_buffer;
+  float * output_temp_buffer;
+  size_t output_temp_buffer_capacity;
+
+  pthread_t output_thread;
+  sem_id output_sem;
+  std::atomic<bool> output_thread_running;
+  std::atomic<bool> output_thread_created;
+
+  // Input related members
+  cubeb_stream_params input_params;
+  AudioCapture * audio_capturer;
+  lock_free_audio_ring_buffer<float> * input_ring_buffer;
+  float * input_temp_buffer;
+  size_t input_temp_buffer_capacity;
+  bool input_enabled;
+
+  // Input thread & synchronization
+  pthread_t input_thread;
+  sem_id input_sem;
+  std::atomic<bool> input_thread_running;
+  std::atomic<bool> input_thread_created;
+
+  char stream_name[256];
+};
+
+struct cubeb {
+  struct cubeb_ops const * ops;
+  pthread_mutex_t mutex;
+  char context_name[256];
+};
+
+// AudioCapture Callback (Input)
+static void
+haiku_audio_input_callback(const float * data, size_t frameCount,
+                            void * userData)
+{
+  cubeb_stream * stm = static_cast<cubeb_stream *>(userData);
+
+  if (stm && stm->input_enabled && stm->input_ring_buffer) {
+    stm->input_ring_buffer->enqueue(const_cast<float *>(data), frameCount);
+    if (stm->input_sem >= B_OK) {
+      release_sem_etc(stm->input_sem, 1, B_DO_NOT_RESCHEDULE);
+    }
+  }
+}
+
+// BSoundPlayer Callback (Output)
+static void
+haiku_audio_output_callback(void * cookie, void * buffer, size_t size,
+                            const media_raw_audio_format & format)
+{
+  cubeb_stream * stm = static_cast<cubeb_stream *>(cookie);
+
+  if (buffer == nullptr || cookie == nullptr) {
+    return;
+  }
+
+  long output_frames = 0;
+  uint32_t output_bytes_per_frame = 0;
+  if (format.channel_count > 0) {
+    if (format.format == media_raw_audio_format::B_AUDIO_FLOAT) {
+      output_bytes_per_frame = format.channel_count * sizeof(float);
+    } else {
+      memset(buffer, 0, size);
+      return;
+    }
+    if (output_bytes_per_frame > 0) {
+      output_frames = size / output_bytes_per_frame;
+    }
+  }
+
+  if (output_frames <= 0) {
+    return;
+  }
+
+  if (stm->output_pause.load(std::memory_order_relaxed)) {
+    memset(buffer, 0, size);
+    return;
+  }
+
+  int frames_read = 0;
+  if (stm->output_ring_buffer) {
+    frames_read = stm->output_ring_buffer->dequeue(
+        static_cast<float *>(buffer), output_frames);
+  }
+
+  if (frames_read < output_frames) {
+    size_t remaining = output_frames - frames_read;
+    size_t offset_bytes = frames_read * output_bytes_per_frame;
+    memset((char *)buffer + offset_bytes, 0, remaining * output_bytes_per_frame);
+  }
+
+  pthread_mutex_lock(&stm->mutex);
+  stm->output_position += frames_read;
+  pthread_mutex_unlock(&stm->mutex);
+
+  if (stm->output_sem >= B_OK) {
+    release_sem_etc(stm->output_sem, 1, B_DO_NOT_RESCHEDULE);
+  }
+}
+
+// Output Pump Thread Function
+static void *
+output_thread_func(void * user_data)
+{
+  cubeb_stream * stm = static_cast<cubeb_stream *>(user_data);
+  if (!stm || !stm->output_ring_buffer) {
+    return NULL;
+  }
+
+  set_thread_priority(find_thread(NULL), B_REAL_TIME_PRIORITY);
+
+  bool drained_notified = false;
+
+  while (stm->output_thread_running.load(std::memory_order_relaxed)) {
+    status_t sem_res =
+        acquire_sem_etc(stm->output_sem, 1, B_RELATIVE_TIMEOUT, 20000);
+
+    if (!stm->output_thread_running.load(std::memory_order_relaxed)) {
+      break;
+    }
+
+    if (sem_res != B_OK && sem_res != B_TIMED_OUT) {
+      break;
+    }
+
+    int available_space = stm->output_ring_buffer->available_write();
+
+    if (available_space >= 512) {
+      int fill_chunk = 512;
+
+      void * input_buffer_ptr = nullptr;
+      long input_frames_read = 0;
+
+      if (pthread_mutex_lock(&stm->mutex) == 0) {
+        if (stm->input_enabled && stm->input_ring_buffer &&
+            stm->input_temp_buffer) {
+          input_frames_read = stm->input_ring_buffer->dequeue(
+              stm->input_temp_buffer, fill_chunk);
+          input_buffer_ptr = stm->input_temp_buffer;
+        }
+        pthread_mutex_unlock(&stm->mutex);
+      }
+
+      long frames_processed = 0;
+      if (stm->resampler) {
+        long in_frames = input_frames_read;
+        frames_processed = cubeb_resampler_fill(
+            stm->resampler, input_buffer_ptr, &in_frames,
+            stm->output_temp_buffer, fill_chunk);
+      } else {
+        frames_processed = stm->data_callback(
+            stm, stm->user_ptr, input_buffer_ptr, stm->output_temp_buffer,
+            fill_chunk);
+      }
+
+      if (frames_processed > 0) {
+        stm->output_ring_buffer->enqueue(stm->output_temp_buffer,
+                                         frames_processed);
+      }
+
+      if (frames_processed >= 0 && frames_processed < fill_chunk) {
+        while (stm->output_thread_running.load(std::memory_order_relaxed) &&
+               stm->output_ring_buffer->available_read() > 0) {
+          snooze(5000);
+        }
+
+        if (!drained_notified &&
+            stm->output_thread_running.load(std::memory_order_relaxed)) {
+          drained_notified = true;
+          stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_DRAINED);
+        }
+        break;
+      } else if (frames_processed < 0) {
+        stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_ERROR);
+        break;
+      }
+    }
+  }
+
+  return NULL;
+}
+
+// Input Thread Function
+static void *
+input_thread_func(void * user_data)
+{
+  cubeb_stream * stm = static_cast<cubeb_stream *>(user_data);
+  if (!stm || !stm->input_enabled || !stm->input_ring_buffer) {
+    return NULL;
+  }
+
+  set_thread_priority(find_thread(NULL), B_REAL_TIME_PRIORITY);
+
+  unsigned int frames_per_iteration = (stm->input_params.rate * 20) / 1000;
+  if (frames_per_iteration < 128)
+    frames_per_iteration = 128;
+
+  float * read_buffer = (float *)malloc(
+      frames_per_iteration * stm->input_params.channels * sizeof(float));
+  if (!read_buffer) {
+    stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_ERROR);
+    stm->input_thread_running.store(false);
+    return NULL;
+  }
+
+  while (stm->input_thread_running.load(std::memory_order_relaxed)) {
+    status_t sem_res =
+        acquire_sem_etc(stm->input_sem, 1, B_RELATIVE_TIMEOUT, 50000);
+
+    if (!stm->input_thread_running.load(std::memory_order_relaxed)) {
+      break;
+    }
+
+    if (sem_res != B_OK && sem_res != B_TIMED_OUT) {
+      break;
+    }
+
+    int frames_available = stm->input_ring_buffer->available_read();
+
+    if (frames_available >= (int)frames_per_iteration) {
+      int frames_read = stm->input_ring_buffer->dequeue(read_buffer,
+                                                         frames_per_iteration);
+
+      if (frames_read > 0) {
+        long frames_processed = 0;
+        if (stm->resampler) {
+          long in_frames = frames_read;
+          frames_processed = cubeb_resampler_fill(
+              stm->resampler, read_buffer, &in_frames, nullptr, frames_read);
+        } else {
+          frames_processed = stm->data_callback(
+              stm, stm->user_ptr, read_buffer, nullptr, frames_read);
+        }
+
+        if (frames_processed < 0 || frames_processed > frames_read) {
+          stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_ERROR);
+        }
+      }
+    }
+  }
+
+  free(read_buffer);
+  return NULL;
+}
+
+static size_t
+calculate_haiku_buffer_size(cubeb_stream_params * params,
+                            unsigned int /*latency_frames*/)
+{
+  if (!params || params->rate == 0 || params->channels == 0)
+    return 4096;
+
+  unsigned int target_frames = 512;
+  return target_frames * params->channels * sizeof(float);
+}
+
+static media_raw_audio_format
+cubeb_format_to_haiku(cubeb_stream_params * params, size_t buffer_size_bytes)
+{
+  media_raw_audio_format format;
+  memset(&format, 0, sizeof(format));
+  if (!params)
+    return format;
+
+  format.frame_rate = params->rate;
+  format.channel_count = params->channels;
+  format.buffer_size = buffer_size_bytes;
+  format.byte_order = B_MEDIA_HOST_ENDIAN;
+
+  if (params->format == CUBEB_SAMPLE_FLOAT32NE) {
+    format.format = media_raw_audio_format::B_AUDIO_FLOAT;
+  } else {
+    format.format = 0;
+  }
+  return format;
+}
+
+int
+haiku_init(cubeb ** context, char const * context_name)
+{
+  *context = NULL;
+  cubeb * ctx = (cubeb *)calloc(1, sizeof(*ctx));
+  if (!ctx)
+    return CUBEB_ERROR;
+
+  ctx->ops = &cubeb_haiku_ops;
+  if (pthread_mutex_init(&ctx->mutex, NULL) != 0) {
+    free(ctx);
+    return CUBEB_ERROR;
+  }
+
+  if (context_name && strlen(context_name) > 0) {
+    snprintf(ctx->context_name, sizeof(ctx->context_name), "%s", context_name);
+  } else {
+    get_application_name(ctx->context_name, sizeof(ctx->context_name),
+                         DEFAULT_CONTEXT_NAME);
+  }
+
+  *context = ctx;
+
+  return CUBEB_OK;
+}
+
+static void
+haiku_destroy(cubeb * context)
+{
+  if (!context)
+    return;
+
+  pthread_mutex_destroy(&context->mutex);
+  free(context);
+}
+
+static char const *
+haiku_get_backend_id(cubeb * context)
+{
+  return "haiku";
+}
+
+static int
+haiku_get_max_channel_count(cubeb * ctx, uint32_t * max_channels)
+{
+  *max_channels = MAX_CHANNELS;
+  return CUBEB_OK;
+}
+
+static int
+haiku_get_min_latency(cubeb * ctx, cubeb_stream_params params,
+                      uint32_t * latency_frames)
+{
+  if (params.rate == 0)
+    return CUBEB_ERROR_INVALID_PARAMETER;
+
+  *latency_frames = (params.rate * 20) / 1000;
+  if (*latency_frames < 512)
+    *latency_frames = 512;
+
+  return CUBEB_OK;
+}
+
+static int
+haiku_get_preferred_sample_rate(cubeb * ctx, uint32_t * rate)
+{
+  *rate = 48000;
+  return CUBEB_OK;
+}
+
+static int
+haiku_stream_init(cubeb * context, cubeb_stream ** stream,
+                  char const * stream_name, cubeb_devid input_device,
+                  cubeb_stream_params * input_stream_params,
+                  cubeb_devid output_device,
+                  cubeb_stream_params * output_stream_params,
+                  unsigned int latency_frames,
+                  cubeb_data_callback data_callback,
+                  cubeb_state_callback state_callback, void * user_ptr)
+{
+  if (!context || !stream || !data_callback || !state_callback)
+    return CUBEB_ERROR_INVALID_PARAMETER;
+
+  if (!input_stream_params && !output_stream_params)
+    return CUBEB_ERROR_INVALID_PARAMETER;
+
+  if (output_stream_params) {
+    if (output_stream_params->format != CUBEB_SAMPLE_FLOAT32NE)
+      return CUBEB_ERROR_INVALID_FORMAT;
+    if (output_stream_params->rate == 0 || output_stream_params->channels == 0 ||
+        output_stream_params->channels > MAX_CHANNELS)
+      return CUBEB_ERROR_INVALID_PARAMETER;
+    if (output_device != NULL && output_device != HAIKU_DEFAULT_OUT_ID)
+      return CUBEB_ERROR_DEVICE_UNAVAILABLE;
+    if (output_stream_params->prefs & CUBEB_STREAM_PREF_LOOPBACK)
+      return CUBEB_ERROR_NOT_SUPPORTED;
+  }
+
+  if (input_stream_params) {
+    if (input_stream_params->format != CUBEB_SAMPLE_FLOAT32NE)
+      return CUBEB_ERROR_INVALID_FORMAT;
+    if (input_stream_params->rate == 0 || input_stream_params->channels == 0 ||
+        input_stream_params->channels > MAX_CHANNELS)
+      return CUBEB_ERROR_INVALID_PARAMETER;
+    if (input_device != NULL && input_device != HAIKU_DEFAULT_IN_ID)
+      return CUBEB_ERROR_DEVICE_UNAVAILABLE;
+    if (input_stream_params->prefs & CUBEB_STREAM_PREF_LOOPBACK)
+      return CUBEB_ERROR_NOT_SUPPORTED;
+  }
+
+  *stream = NULL;
+  cubeb_stream * stm =
+      reinterpret_cast<cubeb_stream *>(calloc(1, sizeof(*stm)));
+  if (!stm)
+    return CUBEB_ERROR;
+
+  stm->context = context;
+  stm->user_ptr = user_ptr;
+  stm->data_callback = data_callback;
+  stm->state_callback = state_callback;
+  stm->output_volume = 1.0f;
+  stm->output_position = 0;
+  stm->output_pause.store(true);
+  stm->sound_player = nullptr;
+  stm->output_ring_buffer = nullptr;
+  stm->output_temp_buffer = nullptr;
+  stm->output_temp_buffer_capacity = 0;
+  stm->output_sem = -1;
+  stm->output_thread_created.store(false);
+  stm->output_thread_running.store(false);
+  stm->audio_capturer = nullptr;
+  stm->input_ring_buffer = nullptr;
+  stm->input_temp_buffer = nullptr;
+  stm->input_temp_buffer_capacity = 0;
+  stm->input_sem = -1;
+  stm->resampler = nullptr;
+  stm->input_thread_created.store(false);
+  stm->input_thread_running.store(false);
+
+  pthread_mutex_lock(&context->mutex);
+  if (stream_name && strcmp(stream_name, "AudioStream") != 0 &&
+      strcmp(stream_name, "cubeb") != 0 && strlen(stream_name) > 0) {
+    snprintf(stm->stream_name, sizeof(stm->stream_name), "%s", stream_name);
+  } else {
+    snprintf(stm->stream_name, sizeof(stm->stream_name), "%s",
+             context->context_name);
+  }
+  pthread_mutex_unlock(&context->mutex);
+
+  if (pthread_mutex_init(&stm->mutex, NULL) != 0) {
+    free(stm);
+    return CUBEB_ERROR;
+  }
+
+  pthread_mutex_lock(&stm->mutex);
+
+  size_t max_buffer_frames = latency_frames * 8;
+  if (max_buffer_frames < 8192)
+    max_buffer_frames = 8192;
+
+  cubeb_stream_params in_resampler_params;
+  cubeb_stream_params out_resampler_params;
+  uint32_t target_rate = 0;
+
+  if (input_stream_params) {
+    stm->input_enabled = true;
+    stm->input_params = *input_stream_params;
+
+    stm->audio_capturer = new AudioCapture(
+        haiku_audio_input_callback, stm, input_stream_params->channels,
+        stm->stream_name);
+    if (!stm->audio_capturer || stm->audio_capturer->Status() != B_OK) {
+      goto init_error;
+    }
+
+    stm->input_ring_buffer = new lock_free_audio_ring_buffer<float>(
+        stm->input_params.channels, max_buffer_frames);
+    if (!stm->input_ring_buffer) {
+      goto init_error_nomem;
+    }
+
+    stm->input_temp_buffer = (float *)malloc(
+        max_buffer_frames * stm->input_params.channels * sizeof(float));
+    if (!stm->input_temp_buffer) {
+      goto init_error_nomem;
+    }
+    stm->input_temp_buffer_capacity = max_buffer_frames;
+
+    stm->input_sem = create_sem(0, "cubeb_input_sem");
+    if (stm->input_sem < B_OK) {
+      goto init_error;
+    }
+
+    in_resampler_params = *input_stream_params;
+    in_resampler_params.rate = stm->audio_capturer->DeviceSampleRate();
+    target_rate = input_stream_params->rate;
+  } else {
+    stm->input_enabled = false;
+  }
+
+  if (output_stream_params) {
+    stm->output_params = *output_stream_params;
+    size_t buffer_size_bytes =
+        calculate_haiku_buffer_size(&stm->output_params, latency_frames);
+    stm->output_format_haiku =
+        cubeb_format_to_haiku(&stm->output_params, buffer_size_bytes);
+    if (stm->output_format_haiku.format == 0) {
+      goto init_error_format;
+    }
+
+    stm->output_ring_buffer = new lock_free_audio_ring_buffer<float>(
+        stm->output_params.channels, max_buffer_frames);
+    if (!stm->output_ring_buffer) {
+      goto init_error_nomem;
+    }
+
+    stm->output_temp_buffer = (float *)malloc(
+        max_buffer_frames * stm->output_params.channels * sizeof(float));
+    if (!stm->output_temp_buffer) {
+      goto init_error_nomem;
+    }
+    stm->output_temp_buffer_capacity = max_buffer_frames;
+
+    stm->output_sem = create_sem(0, "cubeb_output_sem");
+    if (stm->output_sem < B_OK) {
+      goto init_error;
+    }
+
+    out_resampler_params = *output_stream_params;
+    uint32_t haiku_out_rate = 48000;
+    haiku_get_preferred_sample_rate(context, &haiku_out_rate);
+    out_resampler_params.rate = haiku_out_rate;
+    target_rate = output_stream_params->rate;
+  } else {
+    memset(&stm->output_params, 0, sizeof(stm->output_params));
+  }
+
+  stm->resampler = cubeb_resampler_create(
+      stm, input_stream_params ? &in_resampler_params : nullptr,
+      output_stream_params ? &out_resampler_params : nullptr, target_rate,
+      data_callback, user_ptr, CUBEB_RESAMPLER_QUALITY_DESKTOP,
+      CUBEB_RESAMPLER_RECLOCK_NONE);
+
+  if (!stm->resampler) {
+    goto init_error;
+  }
+
+  *stream = stm;
+
+  pthread_mutex_unlock(&stm->mutex);
+
+  return CUBEB_OK;
+
+init_error_nomem:
+  if (stm->resampler)
+    cubeb_resampler_destroy(stm->resampler);
+  if (stm->audio_capturer)
+    delete stm->audio_capturer;
+  if (stm->input_ring_buffer)
+    delete stm->input_ring_buffer;
+  if (stm->output_ring_buffer)
+    delete stm->output_ring_buffer;
+  free(stm->input_temp_buffer);
+  free(stm->output_temp_buffer);
+  if (stm->input_sem >= B_OK)
+    delete_sem(stm->input_sem);
+  if (stm->output_sem >= B_OK)
+    delete_sem(stm->output_sem);
+  pthread_mutex_unlock(&stm->mutex);
+  pthread_mutex_destroy(&stm->mutex);
+  free(stm);
+  return CUBEB_ERROR;
+
+init_error_format:
+  if (stm->resampler)
+    cubeb_resampler_destroy(stm->resampler);
+  if (stm->audio_capturer)
+    delete stm->audio_capturer;
+  if (stm->input_ring_buffer)
+    delete stm->input_ring_buffer;
+  if (stm->output_ring_buffer)
+    delete stm->output_ring_buffer;
+  free(stm->input_temp_buffer);
+  free(stm->output_temp_buffer);
+  if (stm->input_sem >= B_OK)
+    delete_sem(stm->input_sem);
+  if (stm->output_sem >= B_OK)
+    delete_sem(stm->output_sem);
+  pthread_mutex_unlock(&stm->mutex);
+  pthread_mutex_destroy(&stm->mutex);
+  free(stm);
+  return CUBEB_ERROR_INVALID_FORMAT;
+
+init_error:
+  if (stm->resampler)
+    cubeb_resampler_destroy(stm->resampler);
+  if (stm->audio_capturer)
+    delete stm->audio_capturer;
+  if (stm->input_ring_buffer)
+    delete stm->input_ring_buffer;
+  if (stm->output_ring_buffer)
+    delete stm->output_ring_buffer;
+  free(stm->input_temp_buffer);
+  free(stm->output_temp_buffer);
+  if (stm->input_sem >= B_OK)
+    delete_sem(stm->input_sem);
+  if (stm->output_sem >= B_OK)
+    delete_sem(stm->output_sem);
+  pthread_mutex_unlock(&stm->mutex);
+  pthread_mutex_destroy(&stm->mutex);
+  free(stm);
+  return CUBEB_ERROR;
+}
+
+static int
+haiku_stream_stop_internal(cubeb_stream * stm, bool send_callback)
+{
+  if (!stm)
+    return CUBEB_ERROR_INVALID_PARAMETER;
+
+  bool needs_stopped_cb = false;
+
+  if (stm->output_thread_created.load()) {
+    stm->output_thread_running.store(false);
+    if (stm->output_sem >= B_OK) {
+      release_sem(stm->output_sem);
+    }
+    pthread_join(stm->output_thread, NULL);
+    stm->output_thread_created.store(false);
+    needs_stopped_cb = true;
+  }
+
+  if (stm->input_thread_created.load()) {
+    stm->input_thread_running.store(false);
+    if (stm->input_sem >= B_OK) {
+      release_sem(stm->input_sem);
+    }
+    pthread_join(stm->input_thread, NULL);
+    stm->input_thread_created.store(false);
+    needs_stopped_cb = true;
+  }
+
+  pthread_mutex_lock(&stm->mutex);
+
+  if (stm->input_enabled && stm->audio_capturer &&
+      stm->audio_capturer->IsRunning()) {
+    stm->audio_capturer->Stop();
+    needs_stopped_cb = true;
+  }
+
+  if (stm->sound_player) {
+    stm->output_pause.store(true);
+    stm->sound_player->SetHasData(false);
+    stm->sound_player->Stop();
+    delete stm->sound_player;
+    stm->sound_player = nullptr;
+    needs_stopped_cb = true;
+  }
+
+  if (stm->output_ring_buffer) {
+    int remaining = stm->output_ring_buffer->available_read();
+    if (remaining > 0) {
+      stm->output_ring_buffer->dequeue(nullptr, remaining);
+    }
+  }
+
+  pthread_mutex_unlock(&stm->mutex);
+
+  if (send_callback && needs_stopped_cb)
+    stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_STOPPED);
+
+  return CUBEB_OK;
+}
+
+static int
+haiku_stream_stop(cubeb_stream * stm)
+{
+  return haiku_stream_stop_internal(stm, true);
+}
+
+static void
+haiku_stream_destroy(cubeb_stream * stm)
+{
+  if (!stm)
+    return;
+
+  haiku_stream_stop_internal(stm, false);
+
+  pthread_mutex_lock(&stm->mutex);
+
+  if (stm->resampler) {
+    cubeb_resampler_destroy(stm->resampler);
+    stm->resampler = nullptr;
+  }
+
+  free(stm->input_temp_buffer);
+  stm->input_temp_buffer = nullptr;
+
+  free(stm->output_temp_buffer);
+  stm->output_temp_buffer = nullptr;
+
+  if (stm->output_ring_buffer) {
+    delete stm->output_ring_buffer;
+    stm->output_ring_buffer = nullptr;
+  }
+
+  if (stm->output_sem >= B_OK) {
+    delete_sem(stm->output_sem);
+    stm->output_sem = -1;
+  }
+
+  if (stm->input_sem >= B_OK) {
+    delete_sem(stm->input_sem);
+    stm->input_sem = -1;
+  }
+
+  if (stm->audio_capturer) {
+    delete stm->audio_capturer;
+    stm->audio_capturer = nullptr;
+  }
+
+  if (stm->input_ring_buffer) {
+    delete stm->input_ring_buffer;
+    stm->input_ring_buffer = nullptr;
+  }
+
+  pthread_mutex_unlock(&stm->mutex);
+  pthread_mutex_destroy(&stm->mutex);
+
+  free(stm);
+}
+
+static int
+haiku_stream_start(cubeb_stream * stm)
+{
+  if (!stm)
+    return CUBEB_ERROR_INVALID_PARAMETER;
+
+  int rc = CUBEB_OK;
+  bool input_started = false, output_started = false;
+
+  pthread_mutex_lock(&stm->mutex);
+
+  if (stm->output_thread_created.load()) {
+    stm->output_thread_running.store(false);
+    if (stm->output_sem >= B_OK) {
+      release_sem(stm->output_sem);
+    }
+    pthread_join(stm->output_thread, NULL);
+    stm->output_thread_created.store(false);
+  }
+
+  if (stm->input_thread_created.load()) {
+    stm->input_thread_running.store(false);
+    if (stm->input_sem >= B_OK) {
+      release_sem(stm->input_sem);
+    }
+    pthread_join(stm->input_thread, NULL);
+    stm->input_thread_created.store(false);
+  }
+
+  if (stm->input_enabled && stm->audio_capturer &&
+      !stm->audio_capturer->IsRunning()) {
+    status_t capture_status = stm->audio_capturer->Start();
+    if (capture_status == B_OK) {
+      input_started = true;
+    } else {
+      rc = CUBEB_ERROR;
+    }
+  } else if (stm->input_enabled && stm->audio_capturer &&
+             stm->audio_capturer->IsRunning()) {
+    input_started = true;
+  }
+
+  if (rc == CUBEB_OK && input_started && !stm->sound_player &&
+      stm->output_params.rate == 0 && !stm->input_thread_created.load()) {
+    stm->input_thread_running.store(true);
+    if (pthread_create(&stm->input_thread, NULL, input_thread_func, stm) == 0) {
+      stm->input_thread_created.store(true);
+    } else {
+      stm->input_thread_running.store(false);
+      rc = CUBEB_ERROR;
+
+      if (stm->audio_capturer)
+        stm->audio_capturer->Stop();
+
+      input_started = false;
+    }
+  }
+
+  if (rc == CUBEB_OK && stm->output_params.rate > 0 &&
+      !stm->output_thread_created.load()) {
+    stm->output_thread_running.store(true);
+    if (pthread_create(&stm->output_thread, NULL, output_thread_func, stm) ==
+        0) {
+      stm->output_thread_created.store(true);
+      if (stm->output_sem >= B_OK) {
+        release_sem(stm->output_sem);
+      }
+    } else {
+      stm->output_thread_running.store(false);
+      rc = CUBEB_ERROR;
+    }
+  }
+
+  if (rc == CUBEB_OK && stm->output_params.rate > 0) {
+    if (!stm->sound_player) {
+      stm->sound_player =
+          new BSoundPlayer(&stm->output_format_haiku, stm->stream_name,
+                           haiku_audio_output_callback, nullptr, stm);
+      if (!stm->sound_player || stm->sound_player->InitCheck() != B_OK) {
+        delete stm->sound_player;
+        stm->sound_player = nullptr;
+        rc = CUBEB_ERROR;
+
+        if (input_started && stm->audio_capturer)
+          stm->audio_capturer->Stop();
+
+        if (stm->input_thread_created.load()) {
+          stm->input_thread_running.store(false);
+          if (stm->input_sem >= B_OK) {
+            release_sem(stm->input_sem);
+          }
+        }
+
+        if (stm->output_thread_created.load()) {
+          stm->output_thread_running.store(false);
+          if (stm->output_sem >= B_OK) {
+            release_sem(stm->output_sem);
+          }
+        }
+      } else {
+        stm->output_pause.store(false);
+        stm->sound_player->SetHasData(true);
+        stm->sound_player->SetVolume(stm->output_volume);
+        stm->sound_player->Start();
+        output_started = true;
+      }
+    } else {
+      stm->output_pause.store(false);
+      stm->sound_player->SetHasData(true);
+      output_started = true;
+    }
+  }
+
+  pthread_mutex_unlock(&stm->mutex);
+
+  if (rc == CUBEB_OK && (input_started || output_started)) {
+    stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_STARTED);
+  } else if (rc != CUBEB_OK) {
+    stm->state_callback(stm, stm->user_ptr, CUBEB_STATE_ERROR);
+  }
+
+  return rc;
+}
+
+static int
+haiku_stream_get_position(cubeb_stream * stm, uint64_t * position)
+{
+  if (!stm || !position)
+    return CUBEB_ERROR_INVALID_PARAMETER;
+
+  pthread_mutex_lock(&stm->mutex);
+  *position = stm->output_position;
+  pthread_mutex_unlock(&stm->mutex);
+
+  return CUBEB_OK;
+}
+
+static int
+haiku_stream_get_latency(cubeb_stream * stm, uint32_t * latency_frames)
+{
+  if (!stm || !latency_frames)
+    return CUBEB_ERROR_INVALID_PARAMETER;
+
+  pthread_mutex_lock(&stm->mutex);
+  if (stm->sound_player && stm->output_format_haiku.channel_count > 0) {
+    uint32_t bytes_per_frame =
+        stm->output_format_haiku.channel_count * sizeof(float);
+    uint32_t buffer_frames =
+        (bytes_per_frame > 0)
+            ? (stm->output_format_haiku.buffer_size / bytes_per_frame)
+            : 0;
+
+    uint32_t hardware_latency = buffer_frames * 2 + 256;
+
+    uint32_t ring_latency = stm->output_ring_buffer
+                                ? stm->output_ring_buffer->available_read()
+                                : 0;
+
+    *latency_frames = hardware_latency + ring_latency;
+  } else if (stm->input_enabled && stm->input_ring_buffer) {
+    size_t ring_buffer_latency = stm->input_ring_buffer->capacity() / 2;
+    uint32_t capture_latency_est = (stm->input_params.rate * 15) / 1000;
+    *latency_frames = capture_latency_est + ring_buffer_latency;
+  } else {
+    *latency_frames = 0;
+  }
+  pthread_mutex_unlock(&stm->mutex);
+
+  return CUBEB_OK;
+}
+
+static int
+haiku_stream_set_volume(cubeb_stream * stm, float volume)
+{
+  if (!stm)
+    return CUBEB_ERROR_INVALID_PARAMETER;
+
+  float clamped_volume = std::max(0.0f, std::min(1.0f, volume));
+
+  pthread_mutex_lock(&stm->mutex);
+
+  stm->output_volume = clamped_volume;
+
+  if (stm->sound_player)
+    stm->sound_player->SetVolume(stm->output_volume);
+
+  pthread_mutex_unlock(&stm->mutex);
+
+  return CUBEB_OK;
+}
+
+static int
+haiku_stream_get_current_device(cubeb_stream * stm,
+                                cubeb_device ** const device)
+{
+  if (!stm || !device)
+    return CUBEB_ERROR_INVALID_PARAMETER;
+
+  static cubeb_device output_device_info;
+  static cubeb_device input_device_info;
+  static bool static_devices_initialized = false;
+
+  if (!static_devices_initialized) {
+    output_device_info.output_name = (char *)HAIKU_DEFAULT_OUT;
+    output_device_info.input_name = NULL;
+    input_device_info.input_name = (char *)HAIKU_DEFAULT_IN;
+    input_device_info.output_name = NULL;
+    static_devices_initialized = true;
+  }
+
+  pthread_mutex_lock(&stm->mutex);
+  bool has_output = (stm->output_params.rate > 0);
+  bool has_input = stm->input_enabled;
+  pthread_mutex_unlock(&stm->mutex);
+
+  if (has_output) {
+    *device = &output_device_info;
+  } else if (has_input) {
+    *device = &input_device_info;
+  } else {
+    return CUBEB_ERROR;
+  }
+
+  return CUBEB_OK;
+}
+
+static int
+haiku_enumerate_devices(cubeb * context, cubeb_device_type type,
+                        cubeb_device_collection * collection)
+{
+  if (!context || !collection)
+    return CUBEB_ERROR_INVALID_PARAMETER;
+
+  collection->device = NULL;
+  collection->count = 0;
+  int device_count = 0;
+
+  if (type & CUBEB_DEVICE_TYPE_OUTPUT)
+    device_count++;
+
+  if (type & CUBEB_DEVICE_TYPE_INPUT)
+    device_count++;
+
+  if (device_count == 0)
+    return CUBEB_OK;
+
+  cubeb_device_info * devices =
+      (cubeb_device_info *)calloc(device_count, sizeof(cubeb_device_info));
+  if (!devices)
+    return CUBEB_ERROR;
+
+  uint32_t rate;
+  haiku_get_preferred_sample_rate(context, &rate);
+
+  uint32_t latency;
+  haiku_get_min_latency(context, {}, &latency);
+
+  int current_index = 0;
+
+  if (type & CUBEB_DEVICE_TYPE_OUTPUT) {
+    cubeb_device_info * cur = &devices[current_index++];
+    cur->devid = HAIKU_DEFAULT_OUT_ID;
+    cur->device_id = HAIKU_DEFAULT_OUT;
+    cur->friendly_name = HAIKU_DEFAULT_OUT;
+    cur->group_id = HAIKU_DEFAULT_OUT;
+    cur->vendor_name = "MediaKit";
+    cur->type = CUBEB_DEVICE_TYPE_OUTPUT;
+    cur->state = CUBEB_DEVICE_STATE_ENABLED;
+    cur->preferred = CUBEB_DEVICE_PREF_ALL;
+    cur->format = CUBEB_DEVICE_FMT_F32NE;
+    cur->default_format = CUBEB_DEVICE_FMT_F32NE;
+    cur->max_channels = MAX_CHANNELS;
+    cur->min_rate = rate;
+    cur->max_rate = rate;
+    cur->default_rate = rate;
+    cur->latency_lo = latency;
+    cur->latency_hi = latency * 4;
+    collection->count++;
+  }
+
+  if (type & CUBEB_DEVICE_TYPE_INPUT) {
+    cubeb_device_info * cur = &devices[current_index++];
+    cur->devid = HAIKU_DEFAULT_IN_ID;
+    cur->device_id = HAIKU_DEFAULT_IN;
+    cur->friendly_name = HAIKU_DEFAULT_IN;
+    cur->group_id = HAIKU_DEFAULT_IN;
+    cur->vendor_name = "MediaKit";
+    cur->type = CUBEB_DEVICE_TYPE_INPUT;
+    cur->state = CUBEB_DEVICE_STATE_ENABLED;
+    cur->preferred = CUBEB_DEVICE_PREF_ALL;
+    cur->format = CUBEB_DEVICE_FMT_F32NE;
+    cur->default_format = CUBEB_DEVICE_FMT_F32NE;
+    cur->max_channels = MAX_CHANNELS;
+    cur->min_rate = rate;
+    cur->max_rate = rate;
+    cur->default_rate = rate;
+    cur->latency_lo = latency;
+    cur->latency_hi = latency * 4;
+    collection->count++;
+  }
+
+  collection->device = devices;
+
+  return CUBEB_OK;
+}
+
+static int
+haiku_device_collection_destroy(cubeb * context,
+                                cubeb_device_collection * collection)
+{
+  if (!context || !collection)
+    return CUBEB_ERROR_INVALID_PARAMETER;
+
+  if (collection->device) {
+    free(collection->device);
+    collection->device = NULL;
+    collection->count = 0;
+  }
+
+  return CUBEB_OK;
+}
