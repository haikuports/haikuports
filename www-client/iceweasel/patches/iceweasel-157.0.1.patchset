+#endif  // mozilla_widget_NativeKeyBindings_h
diff --git a/widget/haiku/ScreenHelperHaiku.cpp b/widget/haiku/ScreenHelperHaiku.cpp
new file mode 100644
index 0000000000..29041eb03d
--- /dev/null
+++ b/widget/haiku/ScreenHelperHaiku.cpp
@@ -0,0 +1,62 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "ScreenHelperHaiku.h"
+#include "HaikuUtils.h"
+
+namespace mozilla::widget {
+
+ScreenHelperHaiku* ScreenHelperHaiku::sInstance = nullptr;
+
+ScreenHelperHaiku::ScreenHelperHaiku() {
+  sInstance = this;
+  RefreshScreens();
+}
+
+ScreenHelperHaiku::~ScreenHelperHaiku() {
+  sInstance = nullptr;
+}
+
+void ScreenHelperHaiku::RefreshScreens() {
+  ::BScreen bScreen(B_MAIN_SCREEN_ID);
+  if (!bScreen.IsValid()) {
+    return;
+  }
+
+  ::BRect frame = bScreen.Frame();
+
+  double scale = GetHaikuSystemScale();
+
+  DesktopToLayoutDeviceScale contentsScaleFactor(1.0);
+  CSSToLayoutDeviceScale defaultCssScaleFactor(scale);
+
+  int32_t width = int32_t(frame.Width()) + 1;
+  int32_t height = int32_t(frame.Height()) + 1;
+  int32_t x = int32_t(frame.left);
+  int32_t y = int32_t(frame.top);
+
+  LayoutDeviceIntRect rect(x, y, width, height);
+  LayoutDeviceIntRect availRect = rect;
+
+  float dpi = 96.0f;
+  uint32_t pixelDepth = 24;
+  color_space cs = bScreen.ColorSpace();
+  if (cs == B_RGBA32 || cs == B_RGB32) {
+    pixelDepth = 32;
+  }
+
+  int32_t fps = 60;
+  float sdrContentBrightness = 100.0f;
+  float hdrPeakBrightness = 100.0f;
+
+  AutoTArray<RefPtr<Screen>, 1> screenList;
+  screenList.AppendElement(MakeRefPtr<Screen>(
+      rect, availRect, pixelDepth, pixelDepth, fps, contentsScaleFactor,
+      defaultCssScaleFactor, dpi, Screen::IsPseudoDisplay::No,
+      Screen::IsHDR::No, sdrContentBrightness, hdrPeakBrightness));
+
+  ScreenManager::Refresh(std::move(screenList));
+}
+
+}  // namespace mozilla::widget
