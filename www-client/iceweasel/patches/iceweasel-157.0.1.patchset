+NS_IMETHODIMP
+nsPrinterListHaiku::InitPrintSettingsFromPrinter(
+    const nsAString& aPrinterName,
+    nsIPrintSettings* aSettings) {
+  NS_ENSURE_ARG_POINTER(aSettings);
+
+  aSettings->SetPaperSizeUnit(nsIPrintSettings::kPaperSizeMillimeters);
+  aSettings->SetPaperWidth(210.0);
+  aSettings->SetPaperHeight(297.0);
+
+  aSettings->SetIsInitializedFromPrinter(true);
+  return NS_OK;
+}
