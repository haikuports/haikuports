+void nsWindow::LockNativePointer(NativePointerLockMode aNativePointerLockMode) {
+  if (mView && mWindow && mWindow->LockWithTimeout(50000) == B_OK) {
+    mView->LockPointer();
+    mWindow->Unlock();
+  }
+}
+
+void nsWindow::UnlockNativePointer() {
+  if (mView && mWindow && mWindow->LockWithTimeout(50000) == B_OK) {
+    mView->UnlockPointer();
+    mWindow->Unlock();
+  }
+}
+
+void nsWindow::OnHaikuFrameResized(int32_t aWidth, int32_t aHeight) {
+  if (mIsPopup) {
+    return;
+  }
+
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuFrameResized", [self, aWidth, aHeight]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener || !self->mWindow) {
+          return;
+        }
+
+        if (self->mClientSize.width == aWidth && self->mClientSize.height == aHeight) {
+          return;
+        }
+
+        self->mClientSize = LayoutDeviceIntSize(aWidth, aHeight);
+        self->UpdateBounds();
+
+        if (self->mSizeMode == nsSizeMode_Maximized && !self->mSettingSizeMode) {
+          self->mSizeMode = nsSizeMode_Normal;
+          self->mRestoredBounds = Nothing();
+          self->mWidgetListener->SizeModeChanged(nsSizeMode_Normal);
+        }
+
+        self->mWidgetListener->WindowResized(self, self->mClientSize);
+      }));
+}
+
+void nsWindow::OnHaikuFrameMoved(int32_t aX, int32_t aY) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuFrameMoved", [self, aX, aY]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener || !self->mWindow) {
+          return;
+        }
+
+        self->mBounds.MoveTo(aX, aY);
+
+        if (self->mSizeMode == nsSizeMode_Maximized && !self->mSettingSizeMode) {
+          self->mSizeMode = nsSizeMode_Normal;
+          self->mRestoredBounds = Nothing();
+          self->mWidgetListener->SizeModeChanged(nsSizeMode_Normal);
+        }
+
+        self->NotifyWindowMoved(LayoutDeviceIntPoint(aX, aY));
+      }));
+}
+
+void nsWindow::OnHaikuZoom(bool aIsZoomed) {
+  if (mSettingSizeMode) {
+    return;
+  }
+
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuZoom", [self, aIsZoomed]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        if (aIsZoomed) {
+          if (self->mSizeMode == nsSizeMode_Normal) {
+            self->UpdateBounds();
+            self->mRestoredBounds = Some(self->mBounds);
+          }
+          self->mSizeMode = nsSizeMode_Maximized;
+        } else {
+          self->mSizeMode = nsSizeMode_Normal;
+          self->mRestoredBounds = Nothing();
+        }
+
+        self->UpdateBounds();
+        self->mWidgetListener->WindowResized(self, self->mClientSize);
+        self->mWidgetListener->SizeModeChanged(self->mSizeMode);
+      }));
+}
+
+void nsWindow::OnHaikuMinimize(bool aMinimize) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuMinimize", [self, aMinimize]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        if (aMinimize && self->mSizeMode == nsSizeMode_Normal) {
+          self->UpdateBounds();
+          self->mRestoredBounds = Some(self->mBounds);
+        }
+
+        nsSizeMode newMode = aMinimize ? nsSizeMode_Minimized : nsSizeMode_Normal;
+        self->mSizeMode = newMode;
+        self->mWidgetListener->SizeModeChanged(newMode);
+      }));
+}
+
+void nsWindow::OnHaikuWindowActivated(bool aActive) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuWindowActivated", [self, aActive]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        if (!aActive) {
+          nsIRollupListener* rollupListener = nsIWidget::GetActiveRollupListener();
+          if (rollupListener) {
+            rollupListener->Rollup({});
+          }
+        } else if (self->mSizeMode == nsSizeMode_Minimized) {
+          self->mSizeMode = nsSizeMode_Normal;
+          self->mWidgetListener->SizeModeChanged(nsSizeMode_Normal);
+        }
+
+        if (self->mWidgetListener) {
+          if (aActive) {
+            self->mWidgetListener->WindowActivated();
+          } else {
+            self->mWidgetListener->WindowDeactivated();
+          }
+        }
+      }));
+}
+
+void nsWindow::OnHaikuQuitRequested() {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuQuitRequested", [self]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+        self->mWidgetListener->RequestWindowClose(self);
+      }));
+}
+
+void nsWindow::OnHaikuMouseDown(float aX, float aY, int32_t aChangedButton, int32_t aAllButtons, int32_t aClickCount, int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuMouseDown", [self, aX, aY, aChangedButton, aAllButtons, aClickCount, aModifiers]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        nsIRollupListener* rollupListener = nsIWidget::GetActiveRollupListener();
+        if (rollupListener) {
+          nsCOMPtr<nsIWidget> rollupWidget = rollupListener->GetRollupWidget();
+          if (rollupWidget && rollupWidget != self) {
+            rollupListener->Rollup({});
+          }
+        }
+
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        MouseButton button = MouseButton::ePrimary;
+        if (aChangedButton & B_SECONDARY_MOUSE_BUTTON) {
+          button = MouseButton::eSecondary;
+        } else if (aChangedButton & B_TERTIARY_MOUSE_BUTTON) {
+          button = MouseButton::eMiddle;
+        }
+
+        WidgetMouseEvent event(true, eMouseDown, self, WidgetMouseEvent::eReal);
+        event.mRefPoint = LayoutDeviceIntPoint(int32_t(aX), int32_t(aY));
+        event.mButton = button;
+        event.mButtons = GetGeckoButtonsMask(aAllButtons);
+        event.mClickCount = std::max(1, aClickCount);
+        event.mModifiers = GetGeckoModifiers(aModifiers);
+        event.mTimeStamp = TimeStamp::Now();
+
+        self->DispatchInputEvent(&event);
+
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        if (button == MouseButton::eSecondary) {
+          WidgetPointerEvent contextMenuEvent(true, eContextMenu, self);
+          contextMenuEvent.mRefPoint = event.mRefPoint;
+          contextMenuEvent.mButton = MouseButton::eSecondary;
+          contextMenuEvent.mButtons = event.mButtons;
+          contextMenuEvent.mClickCount = 1;
+          contextMenuEvent.mModifiers = event.mModifiers;
+          contextMenuEvent.mTimeStamp = event.mTimeStamp;
+
+          self->DispatchInputEvent(&contextMenuEvent);
+        }
+      }));
+}
+
+void nsWindow::OnHaikuMouseUp(float aX, float aY, int32_t aReleasedButton, int32_t aRemainingButtons, int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuMouseUp", [self, aX, aY, aReleasedButton, aRemainingButtons, aModifiers]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        MouseButton button = MouseButton::ePrimary;
+        if (aReleasedButton & B_SECONDARY_MOUSE_BUTTON) {
+          button = MouseButton::eSecondary;
+        } else if (aReleasedButton & B_TERTIARY_MOUSE_BUTTON) {
+          button = MouseButton::eMiddle;
+        }
+
+        WidgetMouseEvent event(true, eMouseUp, self, WidgetMouseEvent::eReal);
+        event.mRefPoint = LayoutDeviceIntPoint(int32_t(aX), int32_t(aY));
+        event.mButton = button;
+        event.mButtons = GetGeckoButtonsMask(aRemainingButtons);
+        event.mClickCount = 1;
+        event.mModifiers = GetGeckoModifiers(aModifiers);
+        event.mTimeStamp = TimeStamp::Now();
+
+        self->DispatchInputEvent(&event);
+      }));
+}
+
+void nsWindow::OnHaikuMouseMoved(float aX, float aY, int32_t aButtons, int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuMouseMoved", [self, aX, aY, aButtons, aModifiers]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        WidgetMouseEvent event(true, eMouseMove, self, WidgetMouseEvent::eReal);
+        event.mRefPoint = LayoutDeviceIntPoint(int32_t(aX), int32_t(aY));
+        event.mButton = MouseButton::eNotPressed;
+        event.mButtons = GetGeckoButtonsMask(aButtons);
+        event.mClickCount = 0;
+        event.mModifiers = GetGeckoModifiers(aModifiers);
+        event.mTimeStamp = TimeStamp::Now();
+
+        self->DispatchInputEvent(&event);
+      }));
+}
+
+void nsWindow::OnHaikuPointerLockMove(float aX, float aY, int32_t aButtons, int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuPointerLockMove", [self, aX, aY, aButtons, aModifiers]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        WidgetMouseEvent event(true, eMouseMove, self, WidgetMouseEvent::eReal);
+        event.mRefPoint = LayoutDeviceIntPoint(int32_t(std::round(aX)),
+                                               int32_t(std::round(aY)));
+        event.mButton = MouseButton::eNotPressed;
+        event.mButtons = GetGeckoButtonsMask(aButtons);
+        event.mClickCount = 0;
+        event.mModifiers = GetGeckoModifiers(aModifiers);
+        event.mTimeStamp = TimeStamp::Now();
+
+        self->DispatchInputEvent(&event);
+      }));
+}
+
+void nsWindow::OnHaikuMouseEnter(float aX, float aY, int32_t aButtons, int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuMouseEnter", [self, aX, aY, aButtons, aModifiers]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        WidgetMouseEvent event(true, eMouseEnterIntoWidget, self, WidgetMouseEvent::eReal);
+        event.mRefPoint = LayoutDeviceIntPoint(int32_t(aX), int32_t(aY));
+        event.mButton = MouseButton::eNotPressed;
+        event.mButtons = GetGeckoButtonsMask(aButtons);
+        event.mClickCount = 0;
+        event.mModifiers = GetGeckoModifiers(aModifiers);
+        event.mTimeStamp = TimeStamp::Now();
+
+        self->DispatchInputEvent(&event);
+      }));
+}
+
+void nsWindow::OnHaikuMouseExit(float aX, float aY, int32_t aButtons, int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuMouseExit", [self, aX, aY, aButtons, aModifiers]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        WidgetMouseEvent event(true, eMouseExitFromWidget, self, WidgetMouseEvent::eReal);
+        event.mRefPoint = LayoutDeviceIntPoint(int32_t(aX), int32_t(aY));
+        event.mButton = MouseButton::eNotPressed;
+        event.mButtons = GetGeckoButtonsMask(aButtons);
+        event.mClickCount = 0;
+        event.mModifiers = GetGeckoModifiers(aModifiers);
+        event.mExitFrom = Some(WidgetMouseEvent::ePlatformTopLevel);
+        event.mTimeStamp = TimeStamp::Now();
+
+        self->DispatchInputEvent(&event);
+      }));
+}
+
+void nsWindow::OnHaikuWheelEvent(float aX, float aY, float aDeltaX, float aDeltaY, int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuWheelEvent", [self, aX, aY, aDeltaX, aDeltaY, aModifiers]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        WidgetWheelEvent event(true, eWheel, self);
+        event.mRefPoint = LayoutDeviceIntPoint(int32_t(aX), int32_t(aY));
+        event.mDeltaX = aDeltaX * 3.0;
+        event.mDeltaY = aDeltaY * 3.0;
+        event.mDeltaMode = 1;
+        event.mWheelTicksX = aDeltaX;
+        event.mWheelTicksY = aDeltaY;
+        event.mLineOrPageDeltaX = int32_t(aDeltaX);
+        event.mLineOrPageDeltaY = int32_t(aDeltaY);
+        event.mModifiers = GetGeckoModifiers(aModifiers);
+        event.mTimeStamp = TimeStamp::Now();
+
+        self->DispatchInputEvent(&event);
+      }));
+}
+
+void nsWindow::OnHaikuKeyEvent(bool aIsDown, int32_t aKey, int32_t aRawChar, int32_t aModifiers,
+                               const char* aBytes, int32_t aNumBytes) {
+  HaikuKeyboard::DispatchKeyEvent(this, aIsDown, aKey, aRawChar, aModifiers, aBytes, aNumBytes);
+}
+
+void nsWindow::OnHaikuInputMethodEvent(BMessage* aMessage) {
+  if (mIMEHandler) {
+    mIMEHandler->ProcessInputMethodEvent(aMessage);
+  }
+}
+
+RefPtr<nsDragSession> nsWindow::GetOrCreateDragSession(const BMessage* aMessage, int32_t aModifiers) {
+  nsDragService* dragService = nsDragService::GetInstance();
+  if (!dragService) {
+    return nullptr;
+  }
+
+  nsCOMPtr<nsIDragSession> session;
+  dragService->GetCurrentSession(nullptr, getter_AddRefs(session));
+  if (!session) {
+    session = dragService->StartDragSession(static_cast<nsIWidget*>(this));
+  }
+  if (!session) {
+    return nullptr;
+  }
+
+  auto* haikuSession = static_cast<nsDragSession*>(session.get());
+  haikuSession->SetHaikuDragMessage(aMessage);
+  haikuSession->SetOverGeckoWindow(true);
+
+  mozilla::Modifiers geckoMods = GetGeckoModifiers(aModifiers);
+  uint32_t action = nsIDragService::DRAGDROP_ACTION_MOVE;
+  if (geckoMods & mozilla::MODIFIER_ALTGRAPH) {
+    action = nsIDragService::DRAGDROP_ACTION_COPY;
+  }
+  session->SetDragAction(action);
+
+  return haikuSession;
+}
+
+void nsWindow::OnHaikuDragEnter(float aX, float aY, const BMessage* aMessage, int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  BMessage msg(*aMessage);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuDragEnter", [self, aX, aY, msg, aModifiers]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        self->GetOrCreateDragSession(&msg, aModifiers);
+
+        nsIWidget* widget = static_cast<nsIWidget*>(self.get());
+        WidgetDragEvent event(true, eDragEnter, widget);
+        event.mRefPoint = LayoutDeviceIntPoint(int32_t(aX), int32_t(aY));
+        event.mModifiers = GetGeckoModifiers(aModifiers);
+        event.mTimeStamp = TimeStamp::Now();
+        self->DispatchInputEvent(&event);
+      }));
+}
+
+void nsWindow::OnHaikuDragOver(float aX, float aY, const BMessage* aMessage, int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  BMessage msg(*aMessage);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuDragOver", [self, aX, aY, msg, aModifiers]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        self->GetOrCreateDragSession(&msg, aModifiers);
+
+        nsIWidget* widget = static_cast<nsIWidget*>(self.get());
+        WidgetDragEvent event(true, eDragOver, widget);
+        event.mRefPoint = LayoutDeviceIntPoint(int32_t(aX), int32_t(aY));
+        event.mModifiers = GetGeckoModifiers(aModifiers);
+        event.mTimeStamp = TimeStamp::Now();
+        self->DispatchInputEvent(&event);
+      }));
+}
+
+void nsWindow::OnHaikuDragExit(int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuDragExit", [self, aModifiers]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        nsDragService* dragService = nsDragService::GetInstance();
+        if (dragService) {
+          nsCOMPtr<nsIDragSession> session;
+          dragService->GetCurrentSession(nullptr, getter_AddRefs(session));
+          if (session) {
+            static_cast<nsDragSession*>(session.get())->SetOverGeckoWindow(false);
+          }
+        }
+
+        nsIWidget* widget = static_cast<nsIWidget*>(self.get());
+        WidgetDragEvent event(true, eDragExit, widget);
+        event.mModifiers = GetGeckoModifiers(aModifiers);
+        event.mTimeStamp = TimeStamp::Now();
+        self->DispatchInputEvent(&event);
+      }));
+}
+
+void nsWindow::OnHaikuDrop(float aX, float aY, const BMessage* aMessage, int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  BMessage msg(*aMessage);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuDrop", [self, aX, aY, msg, aModifiers]() {
+        if (self->mOnDestroyCalled || !self->mWidgetListener) {
+          return;
+        }
+
+        RefPtr<nsDragSession> session = self->GetOrCreateDragSession(&msg, aModifiers);
+        if (session) {
+          session->SetCanDrop(true);
+        }
+
+        nsIWidget* widget = static_cast<nsIWidget*>(self.get());
+        WidgetDragEvent event(true, eDrop, widget);
+        event.mRefPoint = LayoutDeviceIntPoint(int32_t(aX), int32_t(aY));
+        event.mModifiers = GetGeckoModifiers(aModifiers);
+        event.mTimeStamp = TimeStamp::Now();
+        self->DispatchInputEvent(&event);
+
+        if (session) {
+          uint32_t action = nsIDragService::DRAGDROP_ACTION_NONE;
+          session->GetDragAction(&action);
+
+          if (RefPtr<dom::DataTransfer> dataTransfer = session->GetDataTransfer()) {
+            dataTransfer->SetDropEffectInt(action);
+          }
+
+          session->EndDragSession(action != nsIDragService::DRAGDROP_ACTION_NONE,
+                                  GetGeckoModifiers(aModifiers));
+        }
+      }));
+}
+
+void nsWindow::OnHaikuCopyTargetDone() {
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuCopyTargetDone", []() {
+        nsDragService* ds = nsDragService::GetInstance();
+        if (ds) {
+          nsCOMPtr<nsIDragSession> s;
+          ds->GetCurrentSession(nullptr, getter_AddRefs(s));
+          if (s) {
+            s->EndDragSession(true, 0);
+          }
+        }
+      }));
+}
+
+void nsWindow::OnHaikuDragEndedOutside(float aScreenX, float aScreenY, int32_t aModifiers) {
+  RefPtr<nsWindow> self(this);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsWindow::OnHaikuDragEndedOutside", [self, aScreenX, aScreenY, aModifiers]() {
+        if (self->mOnDestroyCalled) {
+          return;
+        }
+        nsDragService* ds = nsDragService::GetInstance();
+        if (ds) {
+          nsCOMPtr<nsIDragSession> s;
+          ds->GetCurrentSession(nullptr, getter_AddRefs(s));
+          if (s) {
+            auto* hs = static_cast<nsDragSession*>(s.get());
+            hs->DragEndedOutside(BPoint(aScreenX, aScreenY), aModifiers);
+          }
+        }
+      }));
+}
+
+already_AddRefed<nsIWidget> nsIWidget::CreateTopLevelWindow() {
+  nsCOMPtr<nsIWidget> window = new nsWindow();
+  return window.forget();
+}
+
+already_AddRefed<nsIWidget> nsIWidget::CreateChildWindow() {
+  nsCOMPtr<nsIWidget> window = new nsWindow();
+  return window.forget();
+}
diff --git a/widget/haiku/nsWindow.h b/widget/haiku/nsWindow.h
new file mode 100644
index 0000000000..412ca1dbd2
--- /dev/null
+++ b/widget/haiku/nsWindow.h
@@ -0,0 +1,168 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_widget_nsWindow_h
+#define mozilla_widget_nsWindow_h
+
+#include "HaikuUtils.h"
+#include "HaikuView.h"
+#include "HaikuIMEHandler.h"
+#include "HaikuCursor.h"
+#include "HaikuWindowBuffer.h"
+
+#include "nsIWidget.h"
+#include "mozilla/Maybe.h"
+#include "mozilla/RefPtr.h"
+#include "mozilla/UniquePtr.h"
+
+class nsDragSession;
+
+#define NS_WINDOW_IID \
+  {0x5e6fd559, 0xb3f9, 0x40c9, {0x92, 0xd1, 0xef, 0x80, 0xb4, 0xf9, 0x69, 0xe9}}
+
+class nsWindow final : public nsIWidget {
+ public:
+  nsWindow();
+
+  NS_INLINE_DECL_STATIC_IID(NS_WINDOW_IID)
+  NS_DECL_ISUPPORTS_INHERITED
+
+  [[nodiscard]] nsresult Create(nsIWidget* aParent,
+                                const LayoutDeviceIntRect& aRect,
+                                const mozilla::widget::InitData& aInitData) override;
+  void Destroy() override;
+  void Show(bool aState) override;
+  bool IsVisible() const override {
+    return mVisible;
+  }
+  void Enable(bool aState) override {
+    mEnabled = aState;
+  }
+  bool IsEnabled() const override {
+    return mEnabled;
+  }
+  bool IsPopup() const {
+    return mIsPopup;
+  }
+  bool IsDestroyed() const {
+    return mOnDestroyCalled;
+  }
+  void SetFocus(Raise aRaise, mozilla::dom::CallerType aCallerType) override;
+
+  LayoutDeviceIntPoint WidgetToScreenOffset() override;
+  LayoutDeviceIntPoint GetClientOffset() override;
+  LayoutDeviceIntRect GetScreenBounds() override;
+  LayoutDeviceIntRect GetBounds() override;
+  LayoutDeviceIntRect GetClientBounds() override;
+  LayoutDeviceIntSize GetClientSize() override;
+  [[nodiscard]] nsresult GetRestoredBounds(LayoutDeviceIntRect& aRect) override;
+
+  void SetBackgroundColor(const nscolor& aColor) override {}
+  void* GetNativeData(uint32_t aDataType) override;
+
+  void Move(const DesktopPoint& aPoint) override;
+  void Resize(const DesktopSize& aSize, bool aRepaint) override;
+  void Resize(const DesktopRect& aRect, bool aRepaint) override;
+  void Invalidate(const LayoutDeviceIntRect& aRect) override;
+
+  void SetCursor(const Cursor& aCursor) override;
+  void SetSizeConstraints(const SizeConstraints& aConstraints) override;
+
+  nsSizeMode SizeMode() override {
+    return mSizeMode;
+  }
+  void SetSizeMode(nsSizeMode aMode) override;
+  nsresult MakeFullScreen(bool aFullScreen) override;
+
+  float GetDPI() override;
+  double GetDefaultScaleInternal() override;
+  mozilla::DesktopToLayoutDeviceScale GetDesktopToDeviceScale() const override;
+  int32_t RoundsWidgetCoordinatesTo() override {
+    return 1;
+  }
+
+  nsresult SetTitle(const nsAString& aTitle) override;
+
+  void SetInputContext(const InputContext& aContext,
+                       const InputContextAction& aAction) override {
+    mInputContext = aContext;
+  }
+  InputContext GetInputContext() override {
+    return mInputContext;
+  }
+
+  MOZ_CAN_RUN_SCRIPT bool GetEditCommands(
+      mozilla::NativeKeyBindingsType aType,
+      const mozilla::WidgetKeyboardEvent& aEvent,
+      nsTArray<mozilla::CommandInt>& aCommands) override;
+  mozilla::widget::TextEventDispatcherListener*
+      GetNativeTextEventDispatcherListener() override;
+
+  already_AddRefed<mozilla::gfx::DrawTarget> StartRemoteDrawingInRegion(
+      const LayoutDeviceIntRegion& aInvalidRegion) override;
+  void EndRemoteDrawingInRegion(
+      mozilla::gfx::DrawTarget* aDrawTarget,
+      const LayoutDeviceIntRegion& aInvalidRegion) override;
+
+  void DrawToHaikuView(BView* aView, BRect aRect);
+
+  void LockNativePointer(NativePointerLockMode aNativePointerLockMode) override;
+  void UnlockNativePointer() override;
+
+  void OnHaikuFrameResized(int32_t aWidth, int32_t aHeight);
+  void OnHaikuFrameMoved(int32_t aX, int32_t aY);
+  void OnHaikuZoom(bool aIsZoomed);
+  void OnHaikuMinimize(bool aMinimize);
+  void OnHaikuWindowActivated(bool aActive);
+  void OnHaikuQuitRequested();
+  void OnHaikuMouseDown(float aX, float aY, int32_t aChangedButton, int32_t aAllButtons, int32_t aClickCount, int32_t aModifiers);
+  void OnHaikuMouseUp(float aX, float aY, int32_t aReleasedButton, int32_t aRemainingButtons, int32_t aModifiers);
+  void OnHaikuMouseMoved(float aX, float aY, int32_t aButtons, int32_t aModifiers);
+  void OnHaikuPointerLockMove(float aX, float aY, int32_t aButtons, int32_t aModifiers);
+  void OnHaikuMouseEnter(float aX, float aY, int32_t aButtons, int32_t aModifiers);
+  void OnHaikuMouseExit(float aX, float aY, int32_t aButtons, int32_t aModifiers);
+  void OnHaikuWheelEvent(float aX, float aY, float aDeltaX, float aDeltaY, int32_t aModifiers);
+  void OnHaikuKeyEvent(bool aIsDown, int32_t aKey, int32_t aRawChar, int32_t aModifiers,
+                       const char* aBytes, int32_t aNumBytes);
+  void OnHaikuInputMethodEvent(BMessage* aMessage);
+  void OnHaikuDragEnter(float aX, float aY, const BMessage* aMessage, int32_t aModifiers);
+  void OnHaikuDragOver(float aX, float aY, const BMessage* aMessage, int32_t aModifiers);
+  void OnHaikuDragExit(int32_t aModifiers);
+  void OnHaikuDrop(float aX, float aY, const BMessage* aMessage, int32_t aModifiers);
+  void OnHaikuCopyTargetDone();
+  void OnHaikuDragEndedOutside(float aScreenX, float aScreenY, int32_t aModifiers);
+
+ protected:
+  ~nsWindow() override;
+
+ private:
+  void EnsureFrameIsOnScreen();
+  void UpdateBounds();
+  nsresult DoMakeFullScreen(bool aFullScreen);
+  RefPtr<nsDragSession> GetOrCreateDragSession(const BMessage* aMessage, int32_t aModifiers);
+
+  HaikuWindow* mWindow;
+  HaikuView* mView;
+  RefPtr<mozilla::widget::HaikuIMEHandler> mIMEHandler;
+  mozilla::widget::HaikuWindowBuffer mBuffer;
+
+  mozilla::UniquePtr<BCursor> mCustomCursor;
+
+  LayoutDeviceIntRect mBounds;
+  LayoutDeviceIntSize mClientSize;
+  mozilla::Maybe<LayoutDeviceIntRect> mRestoredBounds;
+  nsSizeMode mSizeMode;
+  InputContext mInputContext;
+
+  bool mVisible;
+  bool mEnabled;
+  bool mIsPopup;
+  bool mOnDestroyCalled;
+  bool mSettingSizeMode;
+  bool mHasBeenShown;
+
+  BRect mSavedFrame;
+};
+
+#endif  // mozilla_widget_nsWindow_h
