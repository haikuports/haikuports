new file mode 100644
index 0000000000..6324d3e4ad
--- /dev/null
+++ b/widget/haiku/nsWindow.cpp
@@ -0,0 +1,1203 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsWindow.h"
+
+#include <cctype>
+#include <cstdio>
+#include <algorithm>
+
+#include "HaikuKeyboard.h"
+#include "HaikuUtils.h"
+#include "HaikuView.h"
+#include "HaikuIMEHandler.h"
+#include "HaikuCursor.h"
+#include "HaikuWindowBuffer.h"
+#include "NativeKeyBindings.h"
+
+#include "mozilla/BasicEvents.h"
+#include "mozilla/EventForwards.h"
+#include "mozilla/MouseEvents.h"
+#include "mozilla/TextEventDispatcher.h"
+#include "mozilla/TextEvents.h"
+#include "mozilla/TimeStamp.h"
+#include "mozilla/UniquePtr.h"
+#include "mozilla/dom/DataTransfer.h"
+#include "mozilla/gfx/2D.h"
+#include "mozilla/WidgetUtils.h"
+#include "mozilla/widget/ScreenManager.h"
+
+#include "imgIContainer.h"
+#include "nsThreadUtils.h"
+#include "nsIRollupListener.h"
+#include "nsDragService.h"
+
+using namespace mozilla;
+using namespace mozilla::gfx;
+using namespace mozilla::widget;
+
+NS_IMPL_ISUPPORTS_INHERITED0(nsWindow, nsIWidget)
+
+static int16_t GetGeckoButtonsMask(int32_t aHaikuButtons) {
+  int16_t buttons = 0;
+  if (aHaikuButtons & B_PRIMARY_MOUSE_BUTTON) {
+    buttons |= static_cast<int16_t>(MouseButtonsFlag::ePrimaryFlag);
+  }
+  if (aHaikuButtons & B_SECONDARY_MOUSE_BUTTON) {
+    buttons |= static_cast<int16_t>(MouseButtonsFlag::eSecondaryFlag);
+  }
+  if (aHaikuButtons & B_TERTIARY_MOUSE_BUTTON) {
+    buttons |= static_cast<int16_t>(MouseButtonsFlag::eMiddleFlag);
+  }
+  return buttons;
+}
+
+nsWindow::nsWindow()
+    : mWindow(nullptr),
+      mView(nullptr),
+      mIMEHandler(nullptr),
+      mClientSize(0, 0),
+      mSizeMode(nsSizeMode_Normal),
+      mVisible(false),
+      mEnabled(true),
+      mIsPopup(false),
+      mOnDestroyCalled(false),
+      mSettingSizeMode(false),
+      mHasBeenShown(false) {}
+
+nsWindow::~nsWindow() {
+  Destroy();
+}
+
+void nsWindow::UpdateBounds() {
+  if (!mWindow) {
+    return;
+  }
+
+  BRect f = mWindow->Frame();
+  mClientSize = LayoutDeviceIntSize(std::max(1, int32_t(f.Width()) + 1),
+                                   std::max(1, int32_t(f.Height()) + 1));
+  mBounds = LayoutDeviceIntRect(int32_t(f.left), int32_t(f.top),
+                               mClientSize.width, mClientSize.height);
+}
+
+void nsWindow::EnsureFrameIsOnScreen() {
+  if (!mWindow || mIsPopup || mSizeMode == nsSizeMode_Fullscreen || mWindow->IsHidden()) {
+    return;
+  }
+
+  BScreen screen(B_MAIN_SCREEN_ID);
+  if (!screen.IsValid()) {
+    return;
+  }
+  BRect screenFrame = screen.Frame();
+
+  BRect d = mWindow->DecoratorFrame();
+  BRect f = mWindow->Frame();
+  if (!d.IsValid() || !f.IsValid() || d.Width() <= 0 || d.Height() <= 0) {
+    return;
+  }
+
+  if (d.left > f.left || d.top > f.top || d.right < f.right || d.bottom < f.bottom) {
+    return;
+  }
+
+  float moveX = 0;
+  float moveY = 0;
+
+  if (d.left < screenFrame.left) {
+    moveX = screenFrame.left - d.left;
+  } else if (d.right > screenFrame.right) {
+    moveX = screenFrame.right - d.right;
+  }
+
+  if (d.top < screenFrame.top) {
+    moveY = screenFrame.top - d.top;
+  } else if (d.bottom > screenFrame.bottom) {
+    moveY = screenFrame.bottom - d.bottom;
+  }
+
+  if (d.left + moveX < screenFrame.left) {
+    moveX = screenFrame.left - d.left;
+  }
+  if (d.top + moveY < screenFrame.top) {
+    moveY = screenFrame.top - d.top;
+  }
+
+  if (moveX != 0 || moveY != 0) {
+    mWindow->MoveBy(moveX, moveY);
+    UpdateBounds();
+  }
+}
+
+nsresult nsWindow::Create(nsIWidget* aParent,
+                          const LayoutDeviceIntRect& aRect,
+                          const mozilla::widget::InitData& aInitData) {
+  BaseCreate(aParent, aInitData);
+
+  mIsPopup = (aInitData.mWindowType == WindowType::Popup);
+
+  int32_t initialWidth = aRect.width > 0 ? aRect.width : 1024;
+  int32_t initialHeight = aRect.height > 0 ? aRect.height : 768;
+
+  if (mIsPopup) {
+    if (initialWidth <= 0) {
+      initialWidth = 10;
+    }
+    if (initialHeight <= 0) {
+      initialHeight = 10;
+    }
+  }
+
+  window_look wlook = B_TITLED_WINDOW_LOOK;
+  window_feel wfeel = B_NORMAL_WINDOW_FEEL;
+  uint32 wflag = 0;
+
+  switch (aInitData.mWindowType) {
+    case WindowType::Popup: {
+      wlook = B_NO_BORDER_WINDOW_LOOK;
+      wfeel = B_FLOATING_APP_WINDOW_FEEL;
+      wflag = B_AVOID_FOCUS |
+              B_NO_WORKSPACE_ACTIVATION |
+              B_NOT_ANCHORED_ON_ACTIVATE |
+              B_NOT_MOVABLE |
+              B_NOT_RESIZABLE |
+              B_NOT_ZOOMABLE |
+              B_NOT_MINIMIZABLE;
+      break;
+    }
+    case WindowType::Dialog: {
+      wlook = B_TITLED_WINDOW_LOOK;
+      if (aParent) {
+        wfeel = B_MODAL_SUBSET_WINDOW_FEEL;
+      } else {
+        wfeel = B_MODAL_APP_WINDOW_FEEL;
+      }
+      wflag = B_NOT_ZOOMABLE | B_NOT_MINIMIZABLE;
+      break;
+    }
+    case WindowType::Invisible: {
+      wlook = B_NO_BORDER_WINDOW_LOOK;
+      wfeel = B_NORMAL_WINDOW_FEEL;
+      wflag = B_AVOID_FOCUS |
+              B_NO_WORKSPACE_ACTIVATION |
+              B_NOT_MOVABLE | B_NOT_RESIZABLE | B_NOT_ZOOMABLE | B_NOT_MINIMIZABLE;
+      break;
+    }
+    default: {
+      if (aInitData.mBorderStyle == BorderStyle::None) {
+        wlook = B_NO_BORDER_WINDOW_LOOK;
+      } else {
+        wlook = B_TITLED_WINDOW_LOOK;
+      }
+
+      if (aInitData.mAlwaysOnTop) {
+        wfeel = B_FLOATING_ALL_WINDOW_FEEL;
+      } else {
+        wfeel = B_NORMAL_WINDOW_FEEL;
+      }
+      break;
+    }
+  }
+
+  int32_t posX = aRect.x;
+  int32_t posY = aRect.y;
+
+  if (!mIsPopup && (posX < 0 || posY < 0)) {
+    BScreen screen(B_MAIN_SCREEN_ID);
+    if (screen.IsValid()) {
+      BRect sf = screen.Frame();
+      posX = int32_t(sf.left + (sf.Width() - initialWidth) / 2);
+      posY = int32_t(sf.top + (sf.Height() - initialHeight) / 2);
+    } else {
+      posX = 50;
+      posY = 50;
+    }
+  }
+
+  BRect frame(posX, posY, posX + initialWidth - 1, posY + initialHeight - 1);
+
+  const char* title = mIsPopup ? "" : "Iceweasel";
+  mWindow = new HaikuWindow(frame, title, wlook, wfeel, wflag, this);
+
+  if (mIsPopup) {
+    mWindow->SetSizeLimits(1, 32767, 1, 32767);
+  }
+
+  UpdateBounds();
+
+  if (aParent && (wfeel == B_MODAL_SUBSET_WINDOW_FEEL || wfeel == B_FLOATING_SUBSET_WINDOW_FEEL)) {
+    auto* parentWin = static_cast<HaikuWindow*>(aParent->GetNativeData(NS_NATIVE_WINDOW));
+    if (parentWin) {
+      mWindow->AddToSubset(parentWin);
+    }
+  }
+
+  mView = new HaikuView(mWindow->Bounds(), this);
+  mWindow->AddChild(mView);
+
+  mIMEHandler = MakeRefPtr<HaikuIMEHandler>(this);
+
+  return NS_OK;
+}
+
+void nsWindow::Destroy() {
+  if (mOnDestroyCalled) {
+    return;
+  }
+  mOnDestroyCalled = true;
+
+  nsCOMPtr<nsIWidget> kungFuDeathGrip(this);
+
+  NotifyWindowDestroyed();
+
+  if (mWidgetListener) {
+    mWidgetListener = nullptr;
+  }
+
+  if (mIMEHandler) {
+    mIMEHandler->Detach();
+    mIMEHandler = nullptr;
+  }
+
+  if (mWindow) {
+    if (mView) {
+      mView->DetachGeckoWindow();
+    }
+    mWindow->DetachGeckoWindow();
+
+    if (mWindow->LockWithTimeout(100000) == B_OK) {
+      mWindow->Quit();
+    } else {
+      mWindow->PostMessage(B_QUIT_REQUESTED);
+    }
+    mWindow = nullptr;
+    mView = nullptr;
+  }
+
+  mBuffer.Destroy();
+
+  nsIWidget::Destroy();
+}
+
+void nsWindow::Show(bool aState) {
+  mVisible = aState;
+  if (!mWindow) {
+    return;
+  }
+
+  if (mWindow->LockWithTimeout(50000) == B_OK) {
+    if (aState) {
+      if (mWindow->IsHidden()) {
+        mWindow->Show();
+      }
+      if (mWindow->IsMinimized()) {
+        mWindow->Minimize(false);
+      }
+      if (!mIsPopup) {
+        mWindow->Activate(true);
+      }
+      if (!mHasBeenShown && !mIsPopup) {
+        EnsureFrameIsOnScreen();
+        mHasBeenShown = true;
+      }
+      UpdateBounds();
+    } else {
+      if (!mWindow->IsHidden()) {
+        mWindow->Hide();
+      }
+    }
+    mWindow->Unlock();
+  }
+}
+
+void nsWindow::SetFocus(Raise aRaise, dom::CallerType aCallerType) {
+  if (mIsPopup) {
+    return;
+  }
+
+  if (mWindow && mWindow->LockWithTimeout(50000) == B_OK) {
+    if (mWindow->IsMinimized()) {
+      mWindow->Minimize(false);
+    }
+    mWindow->Activate(true);
+    if (mView) {
+      mView->MakeFocus(true);
+    }
+    mWindow->Unlock();
+  }
+}
+
+void* nsWindow::GetNativeData(uint32_t aDataType) {
+  switch (aDataType) {
+    case NS_NATIVE_WINDOW:
+    case NS_NATIVE_SHELLWIDGET:
+      return static_cast<void*>(mWindow);
+    case NS_NATIVE_WIDGET:
+      return static_cast<void*>(mView);
+    default:
+      return nullptr;
+  }
+}
