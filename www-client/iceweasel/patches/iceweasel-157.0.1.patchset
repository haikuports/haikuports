diff --git a/widget/haiku/GfxInfo.cpp b/widget/haiku/GfxInfo.cpp
new file mode 100644
index 0000000000..4000f2e9ac
--- /dev/null
+++ b/widget/haiku/GfxInfo.cpp
@@ -0,0 +1,121 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "GfxInfo.h"
+#include "nsString.h"
+
+#pragma GCC visibility push(default)
+#include <kernel/OS.h>
+#pragma GCC visibility pop
+
+static nsString sAdapterVendor;
+static nsString sAdapterRenderer;
+static nsString sAdapterVersion;
+
+namespace mozilla::widget {
+
+void UpdateHaikuGfxInfo(const nsACString& aVendor,
+                        const nsACString& aRenderer,
+                        const nsACString& aVersion) {
+  if (!aVendor.IsEmpty()) {
+    CopyUTF8toUTF16(aVendor, sAdapterVendor);
+  }
+  if (!aRenderer.IsEmpty()) {
+    CopyUTF8toUTF16(aRenderer, sAdapterRenderer);
+  }
+  if (!aVersion.IsEmpty()) {
+    CopyUTF8toUTF16(aVersion, sAdapterVersion);
+  }
+}
+
+nsresult GfxInfo::Init() {
+  EnsureInitialized();
+  return GfxInfoBase::Init();
+}
+
+void GfxInfo::EnsureInitialized() {
+  if (mInitialized) {
+    return;
+  }
+  mInitialized = true;
+
+  mAdapterDriver.AssignLiteral("BGLView (Mesa)");
+  mAdapterDescription.AssignLiteral("Software / Unknown");
+  mAdapterDriverVendor.AssignLiteral("Haiku");
+  mAdapterDriverVersion = EmptyString();
+
+  system_info sysInfo;
+  if (get_system_info(&sysInfo) == B_OK) {
+    mAdapterRAM = static_cast<uint32_t>(
+        (static_cast<uint64_t>(sysInfo.max_pages) * B_PAGE_SIZE) / (1024 * 1024));
+  }
+}
+
+NS_IMETHODIMP GfxInfo::GetFeatureStatus(int32_t aFeature, nsACString& aFailureId,
+                                        int32_t* aStatus) {
+  if (aFeature == nsIGfxInfo::FEATURE_WEBGL_OPENGL ||
+      aFeature == nsIGfxInfo::FEATURE_WEBGL2) {
+    *aStatus = nsIGfxInfo::FEATURE_STATUS_OK;
+    return NS_OK;
+  }
+  return GfxInfoBase::GetFeatureStatus(aFeature, aFailureId, aStatus);
+}
+
+NS_IMETHODIMP GfxInfo::GetAdapterDescription(nsAString& aDesc) {
+  EnsureInitialized();
+  aDesc = !sAdapterRenderer.IsEmpty() ? sAdapterRenderer : mAdapterDescription;
+  return NS_OK;
+}
+
+NS_IMETHODIMP GfxInfo::GetAdapterDriver(nsAString& aDriver) {
+  EnsureInitialized();
+  aDriver = mAdapterDriver;
+  return NS_OK;
+}
+
+NS_IMETHODIMP GfxInfo::GetAdapterDriverVendor(nsAString& aVendor) {
+  EnsureInitialized();
+  aVendor = !sAdapterVendor.IsEmpty() ? sAdapterVendor : mAdapterDriverVendor;
+  return NS_OK;
+}
+
+NS_IMETHODIMP GfxInfo::GetAdapterDriverVersion(nsAString& aVersion) {
+  EnsureInitialized();
+  aVersion = !sAdapterVersion.IsEmpty() ? sAdapterVersion : mAdapterDriverVersion;
+  return NS_OK;
+}
+
+NS_IMETHODIMP GfxInfo::GetAdapterVendorID(nsAString& aVendorID) {
+  aVendorID = EmptyString();
+  return NS_OK;
+}
+
+NS_IMETHODIMP GfxInfo::GetAdapterDeviceID(nsAString& aDeviceID) {
+  aDeviceID = EmptyString();
+  return NS_OK;
+}
+
+NS_IMETHODIMP GfxInfo::GetAdapterSubsysID(nsAString& aSubsysID) {
+  return NS_ERROR_FAILURE;
+}
+
+NS_IMETHODIMP GfxInfo::GetAdapterRAM(uint32_t* aRAM) {
+  EnsureInitialized();
+  *aRAM = mAdapterRAM;
+  return NS_OK;
+}
+
+NS_IMETHODIMP GfxInfo::GetAdapterDriverDate(nsAString& aDate) {
+  return NS_ERROR_FAILURE;
+}
+
+const nsTArray<RefPtr<GfxDriverInfo>>& GfxInfo::GetGfxDriverInfo() {
+  if (!sDriverInfo) {
+    static nsTArray<RefPtr<GfxDriverInfo>> sEmptyDriverInfo;
+    return sEmptyDriverInfo;
+  }
+  return *sDriverInfo;
+}
+
+}
diff --git a/widget/haiku/GfxInfo.h b/widget/haiku/GfxInfo.h
new file mode 100644
index 0000000000..4c4fdf193c
--- /dev/null
+++ b/widget/haiku/GfxInfo.h
@@ -0,0 +1,134 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_widget_GfxInfo_h
+#define mozilla_widget_GfxInfo_h
+
+#include "GfxDriverInfo.h"
+#include "GfxInfoBase.h"
+
+namespace mozilla::widget {
+
+void UpdateHaikuGfxInfo(const nsACString& aVendor,
+                        const nsACString& aRenderer,
+                        const nsACString& aVersion);
+
+class GfxInfo : public GfxInfoBase {
+ public:
+  GfxInfo() = default;
+
+  nsresult Init() override;
+
+  OperatingSystem GetOperatingSystem() override {
+    return OperatingSystem::Haiku;
+  }
+
+  NS_IMETHOD GetFeatureStatus(int32_t aFeature, nsACString& aFailureId,
+                              int32_t* aStatus) override;
+
+  NS_IMETHOD GetDWriteEnabled(bool* aDWriteEnabled) override {
+    return NS_ERROR_FAILURE;
+  }
+
+  NS_IMETHOD GetEmbeddedInFirefoxReality(bool* aEmbedded) override {
+    *aEmbedded = false;
+    return NS_OK;
+  }
+
+  NS_IMETHOD GetHasBattery(bool* aHasBattery) override {
+    return NS_ERROR_NOT_IMPLEMENTED;
+  }
+
+  NS_IMETHOD GetDWriteVersion(nsAString& aDwriteVersion) override {
+    return NS_ERROR_FAILURE;
+  }
+
+  NS_IMETHOD GetCleartypeParameters(nsAString& aCleartypeParams) override {
+    return NS_ERROR_FAILURE;
+  }
+
+  NS_IMETHOD GetWindowProtocol(nsAString& aWindowProtocol) override {
+    return NS_ERROR_NOT_IMPLEMENTED;
+  }
+
+  NS_IMETHOD GetTestType(nsAString& aTestType) override {
+    return NS_ERROR_NOT_IMPLEMENTED;
+  }
+
+  NS_IMETHOD GetAdapterDescription(nsAString& aDesc) override;
+  NS_IMETHOD GetAdapterDriver(nsAString& aDriver) override;
+  NS_IMETHOD GetAdapterVendorID(nsAString& aVendorID) override;
+  NS_IMETHOD GetAdapterDeviceID(nsAString& aDeviceID) override;
+  NS_IMETHOD GetAdapterSubsysID(nsAString& aSubsysID) override;
+  NS_IMETHOD GetAdapterRAM(uint32_t* aRAM) override;
+  NS_IMETHOD GetAdapterDriverVendor(nsAString& aVendor) override;
+  NS_IMETHOD GetAdapterDriverVersion(nsAString& aVersion) override;
+  NS_IMETHOD GetAdapterDriverDate(nsAString& aDate) override;
+
+  NS_IMETHOD GetAdapterDescription2(nsAString& aDesc) override {
+    return NS_ERROR_FAILURE;
+  }
+
+  NS_IMETHOD GetAdapterDriver2(nsAString& aDriver) override {
+    return NS_ERROR_FAILURE;
+  }
+
+  NS_IMETHOD GetAdapterVendorID2(nsAString& aVendorID) override {
+    aVendorID = EmptyString();
+    return NS_OK;
+  }
+
+  NS_IMETHOD GetAdapterDeviceID2(nsAString& aDeviceID) override {
+    aDeviceID = EmptyString();
+    return NS_OK;
+  }
+
+  NS_IMETHOD GetAdapterSubsysID2(nsAString& aSubsysID) override {
+    return NS_ERROR_FAILURE;
+  }
+
+  NS_IMETHOD GetAdapterRAM2(uint32_t* aRAM) override {
+    return NS_ERROR_FAILURE;
+  }
+
+  NS_IMETHOD GetAdapterDriverVendor2(nsAString& aVendor) override {
+    return NS_ERROR_FAILURE;
+  }
+
+  NS_IMETHOD GetAdapterDriverVersion2(nsAString& aVersion) override {
+    aVersion = EmptyString();
+    return NS_OK;
+  }
+
+  NS_IMETHOD GetAdapterDriverDate2(nsAString& aDate) override {
+    return NS_ERROR_FAILURE;
+  }
+
+  NS_IMETHOD GetIsGPU2Active(bool* aIsActive) override {
+    return NS_ERROR_FAILURE;
+  }
+
+  NS_IMETHOD GetDrmRenderDevice(nsACString& aDevice) override {
+    return NS_ERROR_NOT_IMPLEMENTED;
+  }
+
+ protected:
+  const nsTArray<RefPtr<GfxDriverInfo>>& GetGfxDriverInfo() override;
+
+ private:
+  ~GfxInfo() = default;
+
+  void EnsureInitialized();
+
+  bool mInitialized = false;
+  nsString mAdapterDescription;
+  nsString mAdapterDriver;
+  nsString mAdapterDriverVendor;
+  nsString mAdapterDriverVersion;
+  uint32_t mAdapterRAM = 0;
+};
+
+}  // namespace mozilla::widget
+
+#endif  // mozilla_widget_GfxInfo_h
diff --git a/widget/haiku/HaikuAlerts.cpp b/widget/haiku/HaikuAlerts.cpp
new file mode 100644
index 0000000000..41041d680f
--- /dev/null
+++ b/widget/haiku/HaikuAlerts.cpp
@@ -0,0 +1,211 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "HaikuAlerts.h"
+
+#include <utility>
+
+#include "imgIContainer.h"
+#include "nsComponentManagerUtils.h"
+#include "nsString.h"
+
+using namespace mozilla;
+using namespace mozilla::widget;
+
+HaikuAlerts::NotificationMap* HaikuAlerts::sNotifications = nullptr;
+
+NS_IMPL_ISUPPORTS(HaikuAlerts, nsIAlertsService)
+
+static const uint32_t kMaxTitleLength = 100;
+static const uint32_t kMaxContentLength = 280;
+static const uint32_t kMaxContentLines = 4;
+
+static void SanitizeTitle(nsAutoString& aTitle) {
+  for (size_t i = 0; i < aTitle.Length(); ++i) {
+    if (aTitle[i] == u'\r' || aTitle[i] == u'\n') {
+      aTitle.SetCharAt(u' ', i);
+    }
+  }
+
+  if (aTitle.Length() > kMaxTitleLength) {
+    aTitle.Truncate(kMaxTitleLength);
+    aTitle.Append(char16_t(0x2026));
+  }
+}
+
+static void SanitizeContent(nsAutoString& aText) {
+  uint32_t lines = 0;
+  for (size_t i = 0; i < aText.Length(); ++i) {
+    if (aText[i] == u'\n') {
+      lines++;
+      if (lines >= kMaxContentLines) {
+        aText.Truncate(i);
+        aText.Append(char16_t(0x2026));
+        break;
+      }
+    }
+  }
+
+  if (aText.Length() > kMaxContentLength) {
+    aText.Truncate(kMaxContentLength);
+    aText.Append(char16_t(0x2026));
+  }
+}
+
+class AlertCallbacksToObserver final : public nsIObserver {
+ public:
+  NS_DECL_ISUPPORTS
+
+  explicit AlertCallbacksToObserver(nsIAlertCallbacks* aCallbacks)
+      : mCallbacks(aCallbacks) {
+    MOZ_ASSERT(aCallbacks);
+  }
+
+  NS_IMETHODIMP Observe(nsISupports* aSubject, const char* aTopic,
+                        const char16_t* aData) override {
+    nsCOMPtr<nsIAlertCallbacks> callbacks = mCallbacks;
+    if (!callbacks) {
+      return NS_OK;
+    }
+
+    if (!strcmp("alertshow", aTopic)) {
+      callbacks->OnAlertShow();
+      return NS_OK;
+    }
+    if (!strcmp("alertfinished", aTopic)) {
+      if (aData && nsDependentString(aData) == u"close"_ns) {
+        callbacks->OnAlertClosed();
+      } else {
+        callbacks->OnAlertFinished();
+      }
+      return NS_OK;
+    }
+    return NS_OK;
+  }
+
+ private:
+  ~AlertCallbacksToObserver() = default;
+  nsCOMPtr<nsIAlertCallbacks> mCallbacks;
+};
+
+NS_IMPL_ISUPPORTS(AlertCallbacksToObserver, nsIObserver)
+
+HaikuAlerts::HaikuAlerts() {
+  if (!sNotifications) {
+    sNotifications = new NotificationMap();
+  }
+}
+
+HaikuAlerts::~HaikuAlerts() = default;
+
+NS_IMETHODIMP HaikuAlerts::ShowAlertWithCallbacks(
+    nsIAlertNotification* aAlert, nsIAlertCallbacks* aAlertCallbacks) {
+  RefPtr<nsIObserver> observer = new AlertCallbacksToObserver(aAlertCallbacks);
+  return ShowAlert(aAlert, observer);
+}
+
+NS_IMETHODIMP HaikuAlerts::ShowAlert(nsIAlertNotification* aAlert,
+                                     nsIObserver* aAlertListener) {
+  NS_ENSURE_ARG_POINTER(aAlert);
+
+  nsAutoString title;
+  nsAutoString text;
+  nsAutoString name;
+  aAlert->GetTitle(title);
+  aAlert->GetText(text);
+  aAlert->GetName(name);
+
+  bool requireInteraction = false;
+  aAlert->GetRequireInteraction(&requireInteraction);
+
+  SanitizeTitle(title);
+  SanitizeContent(text);
+
+  NS_ConvertUTF16toUTF8 u8Title(title);
+  NS_ConvertUTF16toUTF8 u8Text(text);
+  NS_ConvertUTF16toUTF8 u8Name(name);
+
+  BNotification notification(B_INFORMATION_NOTIFICATION);
+  if (notification.InitCheck() != B_OK) {
+    return NS_ERROR_FAILURE;
+  }
+
+  notification.SetGroup(BString("Iceweasel"));
+  notification.SetTitle(BString(u8Title.IsEmpty() ? "Iceweasel" : u8Title.get()));
+  notification.SetContent(BString(u8Text.get()));
+
+  if (!u8Name.IsEmpty()) {
+    notification.SetMessageID(BString(u8Name.get()));
+  }
+
+  nsCOMPtr<imgIContainer> image;
+  if (NS_SUCCEEDED(aAlert->GetImage(getter_AddRefs(image))) && image) {
+    BBitmap* bitmap = CreateBBitmapFromImage(image, 1.0f, 64, 64);
+    if (bitmap) {
+      notification.SetIcon(bitmap);
+      delete bitmap;
+    }
+  }
+
+  bigtime_t timeout = requireInteraction ? 15000000 : -1;
+  status_t err = notification.Send(timeout);
+  if (err != B_OK) {
+    return NS_ERROR_FAILURE;
+  }
+
+  if (sNotifications) {
+    if (auto tuple = sNotifications->Extract(name)) {
+      if (tuple->mObserver) {
+        tuple->mObserver->Observe(nullptr, "alertfinished", u"close");
+      }
+    }
+
+    NotificationEntry entry;
+    entry.mObserver = aAlertListener;
+    entry.mAlert = aAlert;
+    sNotifications->InsertOrUpdate(name, std::move(entry));
+  }
+
+  if (aAlertListener) {
+    aAlertListener->Observe(nullptr, "alertshow", nullptr);
+  }
+
+  return NS_OK;
+}
+
+NS_IMETHODIMP HaikuAlerts::CloseAlert(const nsAString& aAlertName,
+                                      bool aContextClosed) {
+  if (!sNotifications) {
+    return NS_OK;
+  }
+
+  if (auto tuple = sNotifications->Extract(aAlertName)) {
+    if (tuple->mObserver) {
+      tuple->mObserver->Observe(nullptr, "alertfinished", u"close");
+    }
+  }
+
+  return NS_OK;
+}
+
+NS_IMETHODIMP HaikuAlerts::GetHistory(nsTArray<nsString>& aResult) {
+  return NS_ERROR_NOT_IMPLEMENTED;
+}
+
+NS_IMETHODIMP HaikuAlerts::Teardown() {
+  if (sNotifications) {
+    delete sNotifications;
+    sNotifications = nullptr;
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP HaikuAlerts::PbmTeardown() {
+  return NS_ERROR_NOT_IMPLEMENTED;
+}
+
+NS_IMETHODIMP HaikuAlerts::IsFullscreen(bool* aRetVal) {
+  *aRetVal = false;
+  return NS_OK;
+}
diff --git a/widget/haiku/HaikuAlerts.h b/widget/haiku/HaikuAlerts.h
new file mode 100644
index 0000000000..1fb972996d
--- /dev/null
+++ b/widget/haiku/HaikuAlerts.h
@@ -0,0 +1,39 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_widget_HaikuAlerts_h
+#define mozilla_widget_HaikuAlerts_h
+
+#include "HaikuUtils.h"
+#include "nsCOMPtr.h"
+#include "nsIAlertsService.h"
+#include "nsIObserver.h"
+#include "nsTHashMap.h"
+#include "nsString.h"
+#include "mozilla/RefPtr.h"
+
+namespace mozilla::widget {
+
+class HaikuAlerts final : public nsIAlertsService {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSIALERTSSERVICE
+
+  HaikuAlerts();
+
+ private:
+  virtual ~HaikuAlerts();
+
+  struct NotificationEntry {
+    nsCOMPtr<nsIObserver> mObserver;
+    nsCOMPtr<nsIAlertNotification> mAlert;
+  };
+
+  using NotificationMap = nsTHashMap<nsStringHashKey, NotificationEntry>;
+  static NotificationMap* sNotifications;
+};
+
+}  // namespace mozilla::widget
+
+#endif  // mozilla_widget_HaikuAlerts_h
diff --git a/widget/haiku/HaikuApplication.cpp b/widget/haiku/HaikuApplication.cpp
new file mode 100644
index 0000000000..9708a178ad
--- /dev/null
+++ b/widget/haiku/HaikuApplication.cpp
@@ -0,0 +1,203 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "HaikuApplication.h"
+#include "HaikuAlerts.h"
+#include "nsAppShell.h"
+
+#include <unistd.h>
+#include <utility>
+
+#include "nsAppRunner.h"
+
+namespace mozilla::widget {
+
+HaikuApplication* HaikuApplication::sInstance = nullptr;
+sem_id HaikuApplication::sGeckoTerminatedSem = B_BAD_SEM_ID;
+
+static const char* kFirefoxSignature = "application/x-vnd.iceweasel";
+static sem_id sInitSem = B_BAD_SEM_ID;
+
+void HaikuApplication::EnsureInitialized() {
+  if (be_app || sInstance) {
+    return;
+  }
+
+  if (!XRE_IsParentProcess()) {
+    return;
+  }
+
+  sInitSem = create_sem(0, "gecko_app_init_sem");
+
+  thread_id thread = spawn_thread(sAppThreadFunc, "BApplication_thread",
+                                  B_NORMAL_PRIORITY, nullptr);
+  if (thread >= B_OK) {
+    resume_thread(thread);
+    acquire_sem_etc(sInitSem, 1, B_RELATIVE_TIMEOUT, 10000000);
+  }
+
+  if (sInitSem >= B_OK) {
+    delete_sem(sInitSem);
+    sInitSem = B_BAD_SEM_ID;
+  }
+}
+
+void HaikuApplication::Shutdown() {
+  if (sGeckoTerminatedSem >= B_OK) {
+    delete_sem(sGeckoTerminatedSem);
+    sGeckoTerminatedSem = B_BAD_SEM_ID;
+  }
+
+  if (!sInstance) {
+    return;
+  }
+
+  if (sInstance->LockLooper()) {
+    sInstance->Quit();
+  }
+  sInstance = nullptr;
+}
+
+void HaikuApplication::NotifyGeckoExited() {
+  if (sGeckoTerminatedSem >= B_OK) {
+    release_sem(sGeckoTerminatedSem);
+  }
+}
+
+int32 HaikuApplication::sAppThreadFunc(void* aData) {
+  sInstance = new HaikuApplication(kFirefoxSignature);
+  sInstance->mThread = find_thread(nullptr);
+  sInstance->Run();
+  return B_OK;
+}
+
+HaikuApplication::HaikuApplication(const char* aSignature)
+    : BApplication(aSignature),
+      mThread(-1) {}
+
+HaikuApplication::~HaikuApplication() = default;
+
+void HaikuApplication::ReadyToRun() {
+  if (sInitSem >= B_OK) {
+    release_sem(sInitSem);
+  }
+}
+
+void HaikuApplication::MessageReceived(BMessage* aMessage) {
+  switch (aMessage->what) {
+    case B_SILENT_RELAUNCH: {
+      be_roster->ActivateApp(be_app->Team());
+      nsAppShell::DispatchRelaunch();
+      break;
+    }
+
+    case B_CLIPBOARD_CHANGED: {
+      break;
+    }
+
+    default:
+      BApplication::MessageReceived(aMessage);
+      break;
+  }
+}
+
+void HaikuApplication::RefsReceived(BMessage* aMessage) {
+  uint32 type;
+  int32 count = 0;
+  if (aMessage->GetInfo("refs", &type, &count) != B_OK || type != B_REF_TYPE) {
+    return;
+  }
+
+  nsTArray<nsCString> paths;
+  entry_ref ref;
+  for (int32 i = 0; i < count; ++i) {
+    if (aMessage->FindRef("refs", i, &ref) == B_OK) {
+      BNode node(&ref);
+      if (node.InitCheck() == B_OK) {
+        char urlBuf[2048];
+        ssize_t bytes = node.ReadAttr("META:url", B_STRING_TYPE, 0, urlBuf, sizeof(urlBuf) - 1);
+        if (bytes > 0) {
+          urlBuf[bytes] = '\0';
+          paths.AppendElement(nsCString(urlBuf));
+          continue;
+        }
+      }
+
+      BPath path(&ref);
+      if (path.InitCheck() == B_OK) {
+        paths.AppendElement(nsCString(path.Path()));
+      }
+    }
+  }
+
+  if (!paths.IsEmpty()) {
+    nsAppShell::DispatchRefs(std::move(paths));
+  }
+}
+
+void HaikuApplication::ArgvReceived(int32 aArgc, char** aArgv) {
+  static bool sInitialArgvHandled = false;
+  if (!sInitialArgvHandled) {
+    sInitialArgvHandled = true;
+    return;
+  }
+
+  if (aArgc <= 1 || !aArgv) {
+    return;
+  }
+
+  nsTArray<nsCString> args;
+  for (int i = 0; i < aArgc; ++i) {
+    args.AppendElement(nsCString(aArgv[i]));
+  }
+
+  nsAppShell::DispatchArgv(std::move(args));
+}
+
+void HaikuApplication::AppActivated(bool aActive) {
+  BApplication::AppActivated(aActive);
+}
+
+bool HaikuApplication::QuitRequested() {
+  if (!XRE_IsParentProcess()) {
+    return true;
+  }
+
+  if (sGeckoTerminatedSem >= B_OK) {
+    delete_sem(sGeckoTerminatedSem);
+  }
+  sGeckoTerminatedSem = create_sem(0, "gecko_terminated_sem");
+  if (sGeckoTerminatedSem < B_OK) {
+    return false;
+  }
+
+  sem_id checkSem = create_sem(0, "gecko_quit_check_sem");
+  if (checkSem < B_OK) {
+    delete_sem(sGeckoTerminatedSem);
+    sGeckoTerminatedSem = B_BAD_SEM_ID;
+    return false;
+  }
+
+  bool allowedQuit = false;
+  nsAppShell::DispatchQuit(checkSem, &allowedQuit);
+
+  status_t checkRes = acquire_sem_etc(checkSem, 1, B_RELATIVE_TIMEOUT, 5000000);
+  delete_sem(checkSem);
+
+  if (checkRes != B_OK || !allowedQuit) {
+    delete_sem(sGeckoTerminatedSem);
+    sGeckoTerminatedSem = B_BAD_SEM_ID;
+    return false;
+  }
+
+  status_t termRes = acquire_sem_etc(sGeckoTerminatedSem, 1, B_RELATIVE_TIMEOUT, 5000000);
+  if (sGeckoTerminatedSem >= B_OK) {
+    delete_sem(sGeckoTerminatedSem);
+    sGeckoTerminatedSem = B_BAD_SEM_ID;
+  }
+
+  return (termRes == B_OK);
+}
+
+}  // namespace mozilla::widget
