+LayoutDeviceIntPoint nsWindow::WidgetToScreenOffset() {
+  return mBounds.TopLeft();
+}
+
+LayoutDeviceIntPoint nsWindow::GetClientOffset() {
+  return LayoutDeviceIntPoint(0, 0);
+}
+
+LayoutDeviceIntRect nsWindow::GetScreenBounds() {
+  return mBounds;
+}
+
+LayoutDeviceIntRect nsWindow::GetBounds() {
+  return mBounds;
+}
+
+LayoutDeviceIntRect nsWindow::GetClientBounds() {
+  return mBounds;
+}
+
+LayoutDeviceIntSize nsWindow::GetClientSize() {
+  return mClientSize;
+}
+
+nsresult nsWindow::GetRestoredBounds(LayoutDeviceIntRect& aRect) {
+  if (mSizeMode == nsSizeMode_Normal) {
+    aRect = GetScreenBounds();
+    return NS_OK;
+  }
+  if (mRestoredBounds.isSome()) {
+    aRect = *mRestoredBounds;
+    return NS_OK;
+  }
+  return NS_ERROR_FAILURE;
+}
+
+void nsWindow::Move(const DesktopPoint& aPoint) {
+  if (!mWindow) {
+    return;
+  }
+
+  if (mWindow->LockWithTimeout(50000) == B_OK) {
+    mWindow->MoveTo(aPoint.x, aPoint.y);
+    UpdateBounds();
+    mWindow->Unlock();
+  }
+
+  NotifyWindowMoved(mBounds.TopLeft());
+}
+
+void nsWindow::Resize(const DesktopSize& aSize, bool aRepaint) {
+  if (!mWindow) {
+    return;
+  }
+
+  int32_t clientW = std::max(1, int32_t(aSize.width));
+  int32_t clientH = std::max(1, int32_t(aSize.height));
+
+  if (mWindow->LockWithTimeout(50000) == B_OK) {
+    mWindow->ResizeTo(clientW - 1, clientH - 1);
+    UpdateBounds();
+    mWindow->Unlock();
+  }
+
+  if (mWidgetListener) {
+    mWidgetListener->WindowResized(this, mClientSize);
+  }
+
+  if (aRepaint) {
+    Invalidate(LayoutDeviceIntRect(0, 0, clientW, clientH));
+  }
+}
+
+void nsWindow::Resize(const DesktopRect& aRect, bool aRepaint) {
+  if (!mWindow) {
+    return;
+  }
+
+  int32_t clientW = std::max(1, int32_t(aRect.width));
+  int32_t clientH = std::max(1, int32_t(aRect.height));
+
+  if (mWindow->LockWithTimeout(50000) == B_OK) {
+    mWindow->MoveTo(aRect.x, aRect.y);
+    mWindow->ResizeTo(clientW - 1, clientH - 1);
+    UpdateBounds();
+    mWindow->Unlock();
+  }
+
+  if (mWidgetListener) {
+    mWidgetListener->WindowResized(this, mClientSize);
+  }
+
+  NotifyWindowMoved(mBounds.TopLeft());
+
+  if (aRepaint) {
+    Invalidate(LayoutDeviceIntRect(0, 0, clientW, clientH));
+  }
+}
+
+void nsWindow::SetCursor(const Cursor& aCursor) {
+  HaikuCursor::SetCursor(mWindow, mView, aCursor, mCustomCursor);
+}
+
+void nsWindow::SetSizeConstraints(const SizeConstraints& aConstraints) {
+  if (!mWindow || mIsPopup || mSizeMode == nsSizeMode_Fullscreen) {
+    return;
+  }
+
+  if (mWindow->LockWithTimeout(50000) == B_OK) {
+    float minW = aConstraints.mMinSize.width > 0 ? aConstraints.mMinSize.width : 100;
+    float minH = aConstraints.mMinSize.height > 0 ? aConstraints.mMinSize.height : 100;
+    float maxW = aConstraints.mMaxSize.width < 0x7fff ? aConstraints.mMaxSize.width : 32767;
+    float maxH = aConstraints.mMaxSize.height < 0x7fff ? aConstraints.mMaxSize.height : 32767;
+
+    mWindow->SetSizeLimits(minW, maxW, minH, maxH);
+    mWindow->Unlock();
+  }
+}
+
+nsresult nsWindow::DoMakeFullScreen(bool aFullScreen) {
+  if (!mWindow) {
+    return NS_OK;
+  }
+
+  if (aFullScreen) {
+    if (mSizeMode == nsSizeMode_Fullscreen) {
+      return NS_OK;
+    }
+
+    if (mSizeMode == nsSizeMode_Normal) {
+      UpdateBounds();
+      mRestoredBounds = Some(mBounds);
+    }
+    mSavedFrame = mWindow->Frame();
+
+    if (mWindow->LockWithTimeout(50000) == B_OK) {
+      mWindow->SetSizeLimits(0, 32767, 0, 32767);
+
+      BScreen screen(B_MAIN_SCREEN_ID);
+      BRect screenFrame = screen.Frame();
+
+      mWindow->MoveTo(screenFrame.left, screenFrame.top);
+      mWindow->ResizeTo(screenFrame.Width(), screenFrame.Height());
+      mWindow->Activate(true);
+
+      mSizeMode = nsSizeMode_Fullscreen;
+      UpdateBounds();
+      mWindow->Unlock();
+    }
+
+    nsIWidget::InfallibleMakeFullScreen(true);
+
+    if (mWidgetListener) {
+      mWidgetListener->WindowResized(this, mClientSize);
+      mWidgetListener->SizeModeChanged(mSizeMode);
+    }
+
+    Invalidate(LayoutDeviceIntRect(0, 0, mClientSize.width, mClientSize.height));
+  } else {
+    if (mSizeMode != nsSizeMode_Fullscreen) {
+      return NS_OK;
+    }
+
+    if (mWindow->LockWithTimeout(50000) == B_OK) {
+      if (mRestoredBounds.isSome()) {
+        mWindow->MoveTo(mRestoredBounds->x, mRestoredBounds->y);
+        mWindow->ResizeTo(mRestoredBounds->width - 1, mRestoredBounds->height - 1);
+        mRestoredBounds = Nothing();
+      } else {
+        mWindow->MoveTo(mSavedFrame.left, mSavedFrame.top);
+        mWindow->ResizeTo(mSavedFrame.Width(), mSavedFrame.Height());
+      }
+
+      mSizeMode = nsSizeMode_Normal;
+      UpdateBounds();
+      mWindow->Activate(true);
+      mWindow->Unlock();
+    }
+
+    nsIWidget::InfallibleMakeFullScreen(false);
+
+    if (mWidgetListener) {
+      mWidgetListener->WindowResized(this, mClientSize);
+      mWidgetListener->SizeModeChanged(mSizeMode);
+    }
+
+    Invalidate(LayoutDeviceIntRect(0, 0, mClientSize.width, mClientSize.height));
+  }
+
+  return NS_OK;
+}
+
+nsresult nsWindow::MakeFullScreen(bool aFullScreen) {
+  return DoMakeFullScreen(aFullScreen);
+}
+
+void nsWindow::SetSizeMode(nsSizeMode aMode) {
+  if (mSizeMode == aMode || !mWindow) {
+    return;
+  }
+
+  if (aMode == nsSizeMode_Fullscreen) {
+    DoMakeFullScreen(true);
+    return;
+  }
+
+  if (mSizeMode == nsSizeMode_Fullscreen) {
+    DoMakeFullScreen(false);
+    if (aMode == nsSizeMode_Normal) {
+      return;
+    }
+  }
+
+  if (mSizeMode == nsSizeMode_Normal) {
+    UpdateBounds();
+    mRestoredBounds = Some(mBounds);
+  }
+
+  nsSizeMode oldMode = mSizeMode;
+  mSizeMode = aMode;
+
+  mSettingSizeMode = true;
+
+  if (mWindow->LockWithTimeout(50000) == B_OK) {
+    switch (aMode) {
+      case nsSizeMode_Normal: {
+        if (oldMode == nsSizeMode_Maximized) {
+          if (mRestoredBounds.isSome()) {
+            mWindow->MoveTo(mRestoredBounds->x, mRestoredBounds->y);
+            mWindow->ResizeTo(mRestoredBounds->width - 1, mRestoredBounds->height - 1);
+            mRestoredBounds = Nothing();
+          } else {
+            mWindow->Zoom();
+          }
+        } else if (mWindow->IsMinimized()) {
+          mWindow->Minimize(false);
+        }
+        break;
+      }
+
+      case nsSizeMode_Minimized: {
+        if (!mWindow->IsMinimized()) {
+          mWindow->Minimize(true);
+        }
+        break;
+      }
+
+      case nsSizeMode_Maximized: {
+        if (mWindow->IsMinimized()) {
+          mWindow->Minimize(false);
+        }
+        mWindow->Zoom();
+        break;
+      }
+
+      default:
+        break;
+    }
+
+    UpdateBounds();
+    mWindow->Unlock();
+  }
+
+  mSettingSizeMode = false;
+
+  if (mWidgetListener) {
+    mWidgetListener->WindowResized(this, mClientSize);
+    mWidgetListener->SizeModeChanged(mSizeMode);
+  }
+}
+
+void nsWindow::Invalidate(const LayoutDeviceIntRect& aRect) {
+  if (!mWindow || aRect.IsEmpty()) {
+    return;
+  }
+  BMessage msg(kMsgGeckoInvalidate);
+  msg.AddRect("rect", BRect(aRect.x, aRect.y, aRect.XMost() - 1, aRect.YMost() - 1));
+  mWindow->PostMessage(&msg);
+}
+
+nsresult nsWindow::SetTitle(const nsAString& aTitle) {
+  if (mWindow && mWindow->LockWithTimeout(50000) == B_OK) {
+    NS_ConvertUTF16toUTF8 utf8(aTitle);
+    mWindow->SetTitle(utf8.get());
+    mWindow->Unlock();
+  }
+  return NS_OK;
+}
