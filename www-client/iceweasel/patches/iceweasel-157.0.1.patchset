diff --git a/widget/haiku/moz.build b/widget/haiku/moz.build
new file mode 100644
index 0000000000..85114cf5b3
--- /dev/null
+++ b/widget/haiku/moz.build
@@ -0,0 +1,68 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+with Files("**"):
+    BUG_COMPONENT = ("Core", "Widget")
+
+EXPORTS.mozilla.widget += [
+    "nsWindow.h",
+]
+
+SOURCES += [
+    "GfxInfo.cpp",
+    "HaikuAlerts.cpp",
+    "HaikuApplication.cpp",
+    "HaikuCursor.cpp",
+    "HaikuIMEHandler.cpp",
+    "HaikuKeyboard.cpp",
+    "HaikuUtils.cpp",
+    "HaikuView.cpp",
+    "HaikuWindowBuffer.cpp",
+    "NativeKeyBindings.cpp",
+    "nsAppShell.cpp",
+    "nsBidiKeyboard.cpp",
+    "nsClipboardHaiku.cpp",    
+    "nsDragService.cpp",
+    "nsFilePicker.cpp",
+    "nsLookAndFeel.cpp",
+    "nsUserIdleServiceHaiku.cpp",
+    "nsWidgetFactory.cpp",
+    "nsWindow.cpp",
+    "ScreenHelperHaiku.cpp",
+]
+
+include("/ipc/chromium/chromium-config.mozbuild")
+
+FINAL_LIBRARY = "xul"
+
+LOCAL_INCLUDES += [
+    "/gfx/thebes",
+    "/widget",
+    "/widget/headless",
+    "/xpcom/components",
+]
+
+if CONFIG["NS_PRINTING"]:
+    UNIFIED_SOURCES += [
+        "nsDeviceContextSpecHaiku.cpp",
+        "nsPrinterListHaiku.cpp",
+        "nsPrintSettingsServiceHaiku.cpp",
+    ]
+
+if CONFIG["MOZ_ENABLE_SKIA_PDF"]:
+    LOCAL_INCLUDES += CONFIG["SKIA_INCLUDES"]
+
+XPCOM_MANIFESTS += [
+    "components.conf",
+]
+
+OS_LIBS += [
+    "-lbe",
+    "-lroot",
+    "-ltranslation",
+    "-ltracker",
+]
+
+SOURCES["HaikuView.cpp"].flags += ["-frtti"]
+SOURCES["HaikuApplication.cpp"].flags += ["-frtti"]
diff --git a/widget/haiku/nsAppShell.cpp b/widget/haiku/nsAppShell.cpp
new file mode 100644
index 0000000000..f77182db14
--- /dev/null
+++ b/widget/haiku/nsAppShell.cpp
@@ -0,0 +1,258 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsAppShell.h"
+#include "HaikuApplication.h"
+#include "ScreenHelperHaiku.h"
+
+#include <csignal>
+#include <unistd.h>
+#include <utility>
+
+#include "mozilla/BackgroundHangMonitor.h"
+#include "mozilla/Components.h"
+#include "mozilla/Hal.h"
+#include "mozilla/widget/ScreenManager.h"
+#include "mozilla/widget/ThemeChangeKind.h"
+#include "mozilla/widget/WidgetMessageUtils.h"
+#include "nsAppRunner.h"
+#include "nsIAppStartup.h"
+#include "nsCommandLine.h"
+#include "nsICommandLine.h"
+#include "nsICommandLineRunner.h"
+#include "nsIWindowWatcher.h"
+#include "nsPIDOMWindow.h"
+#include "nsThreadUtils.h"
+#include "nsServiceManagerUtils.h"
+#include "nsIFile.h"
+#include "nsDirectoryServiceDefs.h"
+
+using namespace mozilla;
+using namespace mozilla::widget;
+
+static const int32_t kGeckoWakeupMsg = 'GWKP';
+static const int32_t kGeckoQuitMsg   = 'GQIT';
+
+nsAppShell* nsAppShell::sAppShell = nullptr;
+
+nsAppShell::nsAppShell()
+    : mWakeupPort(-1),
+      mWakeupPending(false) {
+  sAppShell = this;
+}
+
+nsAppShell::~nsAppShell() {
+  sAppShell = nullptr;
+
+  mozilla::hal::Shutdown();
+
+  if (mWakeupPort >= B_OK) {
+    delete_port(mWakeupPort);
+    mWakeupPort = -1;
+  }
+}
+
+void nsAppShell::TermSignalHandler(int aSigno) {
+  if (aSigno != SIGTERM) {
+    return;
+  }
+  if (sAppShell) {
+    sAppShell->ScheduleQuitEvent();
+  }
+}
+
+void nsAppShell::InstallTermSignalHandler() {
+  if (!XRE_IsParentProcess() || getenv("MOZ_DISABLE_SIG_HANDLER")) {
+    return;
+  }
+
+  struct sigaction act = {}, oldact;
+  act.sa_handler = TermSignalHandler;
+  sigfillset(&act.sa_mask);
+
+  if (sigaction(SIGTERM, nullptr, &oldact) != 0) {
+    return;
+  }
+  if (oldact.sa_handler != SIG_DFL) {
+    NS_WARNING("SIGTERM signal handler is already set");
+  }
+
+  sigaction(SIGTERM, &act, nullptr);
+}
+
+nsresult nsAppShell::Init() {
+  HaikuApplication::EnsureInitialized();
+
+  mozilla::hal::Init();
+  InstallTermSignalHandler();
+
+  mWakeupPort = create_port(100, "gecko_appshell_wakeup");
+
+  if (XRE_IsParentProcess()) {
+    ScreenManager& screenMgr = ScreenManager::GetSingleton();
+    screenMgr.SetHelper(mozilla::MakeUnique<ScreenHelperHaiku>());
+  }
+
+  return nsBaseAppShell::Init();
+}
+
+void nsAppShell::ScheduleNativeEventCallback() {
+  if (mWakeupPort >= B_OK) {
+    if (!mWakeupPending.exchange(true)) {
+      int32 msg = kGeckoWakeupMsg;
+      if (write_port_etc(mWakeupPort, msg, nullptr, 0, B_TIMEOUT, 0) != B_OK) {
+        mWakeupPending = false;
+      }
+    }
+  }
+}
+
+void nsAppShell::ScheduleQuitEvent() {
+  if (mWakeupPort >= B_OK) {
+    int32 msg = kGeckoQuitMsg;
+    write_port_etc(mWakeupPort, msg, nullptr, 0, B_TIMEOUT, 0);
+  }
+}
+
+bool nsAppShell::ProcessNextNativeEvent(bool aMayWait) {
+  if (mWakeupPort < B_OK) {
+    return false;
+  }
+
+  int32 msgCode = 0;
+  status_t res;
+
+  if (aMayWait) {
+    mozilla::BackgroundHangMonitor().NotifyWait();
+    res = read_port(mWakeupPort, &msgCode, nullptr, 0);
+    mozilla::BackgroundHangMonitor().NotifyActivity();
+  } else {
+    res = read_port_etc(mWakeupPort, &msgCode, nullptr, 0, B_TIMEOUT, 0);
+  }
+
+  if (res == B_OK) {
+    mWakeupPending = false;
+
+    if (msgCode == kGeckoQuitMsg) {
+      Exit();
+      return true;
+    }
+
+    while (port_count(mWakeupPort) > 0) {
+      int32 extraMsg = 0;
+      read_port_etc(mWakeupPort, &extraMsg, nullptr, 0, B_TIMEOUT, 0);
+      if (extraMsg == kGeckoQuitMsg) {
+        Exit();
+        return true;
+      }
+    }
+
+    NativeEventCallback();
+    return true;
+  }
+
+  return false;
+}
+
+NS_IMETHODIMP nsAppShell::Run(void) {
+  nsresult rv = nsBaseAppShell::Run();
+  HaikuApplication::NotifyGeckoExited();
+  return rv;
+}
+
+NS_IMETHODIMP nsAppShell::Exit(void) {
+  ScheduleNativeEventCallback();
+  nsresult rv = nsBaseAppShell::Exit();
+  HaikuApplication::NotifyGeckoExited();
+  return rv;
+}
+
+void nsAppShell::DispatchRelaunch() {
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsAppShell::DispatchRelaunch", []() {
+        nsCOMPtr<nsIWindowWatcher> ww = do_GetService(NS_WINDOWWATCHER_CONTRACTID);
+        if (ww) {
+          nsCOMPtr<mozIDOMWindowProxy> activeWin;
+          ww->GetActiveWindow(getter_AddRefs(activeWin));
+          if (activeWin) {
+            nsCOMPtr<nsPIDOMWindowOuter> pwin = nsPIDOMWindowOuter::From(activeWin);
+            if (pwin) {
+              pwin->Focus(mozilla::dom::CallerType::System);
+            }
+          }
+        }
+      }));
+}
+
+void nsAppShell::DispatchThemeChanged() {
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "HaikuApplication::ColorsChanged", []() {
+        LookAndFeel::NotifyChangedAllWindows(ThemeChangeKind::StyleAndLayout);
+      }));
+}
+
+void nsAppShell::DispatchRefs(nsTArray<nsCString>&& aPaths) {
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsAppShell::DispatchRefs", [paths = std::move(aPaths)]() {
+        nsCOMPtr<nsICommandLineRunner> cmdLine(new nsCommandLine());
+
+        nsTArray<nsCString> args;
+        args.AppendElement("iceweasel"_ns);
+        for (const auto& path : paths) {
+          args.AppendElement("-url"_ns);
+          args.AppendElement(path);
+        }
+
+        AutoTArray<const char*, 16> argv;
+        for (const auto& arg : args) {
+          argv.AppendElement(arg.get());
+        }
+
+        nsCOMPtr<nsIFile> workingDir;
+        NS_GetSpecialDirectory(NS_OS_CURRENT_WORKING_DIR, getter_AddRefs(workingDir));
+
+        cmdLine->Init(argv.Length(), argv.Elements(), workingDir,
+                      nsICommandLine::STATE_REMOTE_EXPLICIT);
+        cmdLine->Run();
+        DispatchRelaunch();
+      }));
+}
+
+void nsAppShell::DispatchArgv(nsTArray<nsCString>&& aArgs) {
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsAppShell::DispatchArgv", [args = std::move(aArgs)]() {
+        nsCOMPtr<nsICommandLineRunner> cmdLine(new nsCommandLine());
+
+        AutoTArray<const char*, 16> argv;
+        for (const auto& arg : args) {
+          argv.AppendElement(arg.get());
+        }
+
+        nsCOMPtr<nsIFile> workingDir;
+        NS_GetSpecialDirectory(NS_OS_CURRENT_WORKING_DIR, getter_AddRefs(workingDir));
+
+        cmdLine->Init(argv.Length(), argv.Elements(), workingDir,
+                      nsICommandLine::STATE_REMOTE_EXPLICIT);
+        cmdLine->Run();
+        DispatchRelaunch();
+      }));
+}
+
+void nsAppShell::DispatchQuit(sem_id aCheckSem, bool* aAllowedQuit) {
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "nsAppShell::DispatchQuit", [aCheckSem, aAllowedQuit]() {
+        nsCOMPtr<nsIAppStartup> appStartup =
+            mozilla::components::AppStartup::Service();
+        if (appStartup) {
+          bool userAllowedQuit = false;
+          appStartup->Quit(nsIAppStartup::eAttemptQuit, 0, &userAllowedQuit);
+          if (aAllowedQuit) {
+            *aAllowedQuit = userAllowedQuit;
+          }
+        }
+        if (aCheckSem >= B_OK) {
+          release_sem(aCheckSem);
+        }
+      }));
+}
diff --git a/widget/haiku/nsAppShell.h b/widget/haiku/nsAppShell.h
new file mode 100644
index 0000000000..7a194bf1b3
--- /dev/null
+++ b/widget/haiku/nsAppShell.h
@@ -0,0 +1,50 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_widget_nsAppShell_h
+#define mozilla_widget_nsAppShell_h
+
+#include "nsBaseAppShell.h"
+#include "HaikuUtils.h"
+#include "mozilla/Atomics.h"
+#include "nsTArray.h"
+#include "nsString.h"
+
+class nsAppShell : public nsBaseAppShell {
+ public:
+  nsAppShell();
+
+  nsresult Init();
+
+  NS_IMETHOD Run(void) override;
+  NS_IMETHOD Exit(void) override;
+
+  void ScheduleQuitEvent();
+  static nsAppShell* GetAppShell() {
+    return sAppShell;
+  }
+
+  static void DispatchRelaunch();
+  static void DispatchThemeChanged();
+  static void DispatchRefs(nsTArray<nsCString>&& aPaths);
+  static void DispatchArgv(nsTArray<nsCString>&& aArgs);
+  static void DispatchQuit(sem_id aCheckSem, bool* aAllowedQuit);
+
+ protected:
+  ~nsAppShell() override;
+
+  void ScheduleNativeEventCallback() override;
+  bool ProcessNextNativeEvent(bool aMayWait) override;
+
+ private:
+  static void TermSignalHandler(int aSigno);
+  void InstallTermSignalHandler();
+
+  static nsAppShell* sAppShell;
+
+  port_id mWakeupPort;
+  mozilla::Atomic<bool> mWakeupPending;
+};
+
+#endif  // mozilla_widget_nsAppShell_h
