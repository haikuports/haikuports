diff --git a/widget/haiku/nsDragService.cpp b/widget/haiku/nsDragService.cpp
new file mode 100644
index 0000000000..2ebc9385ce
--- /dev/null
+++ b/widget/haiku/nsDragService.cpp
@@ -0,0 +1,805 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsDragService.h"
+#include "nsWindow.h"
+#include "HaikuView.h"
+#include "HaikuUtils.h"
+#include "HaikuKeyboard.h"
+
+#include <cmath>
+#include <cstdio>
+#include <algorithm>
+
+#include "imgIContainer.h"
+#include "mozilla/ArrayUtils.h"
+#include "mozilla/PresShell.h"
+#include "mozilla/dom/DataTransfer.h"
+#include "mozilla/dom/Document.h"
+#include "mozilla/gfx/2D.h"
+#include "nsArrayUtils.h"
+#include "nsComponentManagerUtils.h"
+#include "nsIFile.h"
+#include "nsNetUtil.h"
+#include "nsISupportsPrimitives.h"
+#include "nsPrimitiveHelpers.h"
+#include "nsString.h"
+#include "nsStringStream.h"
+#include "nsServiceManagerUtils.h"
+#include "nsCRTGlue.h"
+#include "nsThreadUtils.h"
+
+using namespace mozilla;
+using namespace mozilla::gfx;
+using namespace mozilla::widget;
+
+NS_IMPL_ISUPPORTS_INHERITED0(nsDragSession, nsBaseDragSession)
+NS_IMPL_ISUPPORTS_INHERITED0(nsDragService, nsBaseDragService)
+
+nsDragSession::nsDragSession() = default;
+nsDragSession::~nsDragSession() {
+  CleanUpDrag();
+}
+
+void nsDragSession::CleanUpDrag() {
+  mDataItems = nullptr;
+  mCurrentMessage = false;
+  mIsDragging = false;
+  mOverGeckoWindow = false;
+  mDragSourceView = nullptr;
+  mWatcherThread = -1;
+  mDragEnding = false;
+  mDragEnded = false;
+}
+
+void nsDragSession::DragEndedOutside(const BPoint& aScreenPoint, int32_t aModifiers) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  if (mDragEnded) {
+    return;
+  }
+  mDragEnded = true;
+  mIsDragging = false;
+  mOverGeckoWindow = false;
+
+  double scale = GetHaikuSystemScale();
+
+  BPoint localPt = aScreenPoint;
+  if (mDragSourceView && mDragSourceView->Window()) {
+    BWindow* win = mDragSourceView->Window();
+    if (win->LockWithTimeout(10000) == B_OK) {
+      mDragSourceView->ConvertFromScreen(&localPt);
+      win->Unlock();
+    } else {
+      BRect f = win->Frame();
+      localPt.x -= f.left;
+      localPt.y -= f.top;
+    }
+  }
+
+  LayoutDeviceIntPoint devLocalPt(int32_t(localPt.x), int32_t(localPt.y));
+  SetDragEndPoint(devLocalPt);
+
+  mScreenPosition = CSSIntPoint(int32_t(std::round(aScreenPoint.x / scale)),
+                               int32_t(std::round(aScreenPoint.y / scale)));
+
+  if (RefPtr<dom::DataTransfer> dataTransfer = GetDataTransfer()) {
+    dataTransfer->SetDropEffectInt(nsIDragService::DRAGDROP_ACTION_NONE);
+  }
+
+  EndDragSession(true, GetGeckoModifiers(aModifiers));
+}
+
+void nsDragSession::SetHaikuDragMessage(const BMessage* aMessage) {
+  if (aMessage) {
+    mDropMessage = *aMessage;
+    mCurrentMessage = true;
+  } else {
+    mCurrentMessage = false;
+  }
+}
+
+already_AddRefed<nsIDragSession> nsDragService::CreateDragSession() {
+  RefPtr<nsDragSession> session = new nsDragSession();
+  return session.forget();
+}
+
+nsDragService* nsDragService::GetInstance() {
+  nsCOMPtr<nsIDragService> service = do_GetService("@mozilla.org/widget/dragservice;1");
+  return static_cast<nsDragService*>(service.get());
+}
+
+static void SanitizeFileName(BString& aName) {
+  aName.ReplaceAll('/', '-');
+  aName.Trim();
+  if (aName.IsEmpty()) {
+    aName = "Web Bookmark";
+  }
+  if (aName.Length() > 200) {
+    aName.Truncate(200);
+  }
+}
+
+static void ParseMozUrl(const nsAString& aMozUrl, BString& aOutUrl, BString& aOutTitle) {
+  NS_ConvertUTF16toUTF8 u8(aMozUrl);
+  BString raw(u8.get());
+  int32 nl = raw.FindFirst('\n');
+  if (nl >= 0) {
+    raw.CopyInto(aOutUrl, 0, nl);
+    raw.CopyInto(aOutTitle, nl + 1, raw.Length() - nl - 1);
+  } else {
+    aOutUrl = raw;
+  }
+  aOutUrl.Trim();
+  aOutTitle.Trim();
+}
+
+static status_t DecodeURLPath(const BString& aEncoded, BString& aDecoded) {
+  aDecoded = "";
+  int32 len = aEncoded.Length();
+  for (int32 i = 0; i < len; ++i) {
+    if (aEncoded[i] == '%' && i + 2 < len) {
+      char hex[3] = { aEncoded[i + 1], aEncoded[i + 2], '\0' };
+      char* endPtr = nullptr;
+      long byteVal = strtol(hex, &endPtr, 16);
+      if (endPtr != hex + 2) {
+        return B_BAD_VALUE;
+      }
+      aDecoded.Append(static_cast<char>(byteVal), 1);
+      i += 2;
+    } else {
+      aDecoded.Append(aEncoded[i], 1);
+    }
+  }
+  return B_OK;
+}
+
+BBitmap* nsDragSession::CreateDragBitmap(
+    nsINode* aDOMNode, const Maybe<CSSIntRegion>& aRegion,
+    const mozilla::LayoutDeviceIntPoint& aWindowOrigin,
+    const BPoint& aMousePos, BPoint* aHotspot) {
+  LayoutDeviceIntRect dragRect(0, 0, 20, 20);
+  RefPtr<SourceSurface> surface;
+  nsPresContext* pc = nullptr;
+
+  nsresult rv = DrawDrag(aDOMNode, aRegion, mScreenPosition, &dragRect, &surface, &pc);
+  if (NS_FAILED(rv) || !surface) {
+    return nullptr;
+  }
+
+  BBitmap* bitmap = CreateBBitmapFromSurface(surface, DRAG_TRANSLUCENCY);
+  if (!bitmap) {
+    return nullptr;
+  }
+
+  if (aHotspot) {
+    float elemViewX = float(dragRect.x - aWindowOrigin.x);
+    float elemViewY = float(dragRect.y - aWindowOrigin.y);
+
+    float hx = aMousePos.x - elemViewX;
+    float hy = aMousePos.y - elemViewY;
+
+    float width = bitmap->Bounds().Width() + 1.0f;
+    float height = bitmap->Bounds().Height() + 1.0f;
+
+    if (hx >= 0.0f && hx < width && hy >= 0.0f && hy < height) {
+      aHotspot->x = hx;
+      aHotspot->y = hy;
+    } else {
+      aHotspot->x = std::clamp(float(mScreenPosition.x - dragRect.x), 0.0f, width - 1.0f);
+      aHotspot->y = std::clamp(float(mScreenPosition.y - dragRect.y), 0.0f, height - 1.0f);
+    }
+  }
+
+  return bitmap;
+}
+
+NS_IMETHODIMP nsDragSession::EndDragSession(bool aDoneDrop, uint32_t aKeyModifiers) {
+  mIsDragging = false;
+  mOverGeckoWindow = false;
+
+  if (mDragSourceView) {
+    if (mDragSourceView->Window() && mDragSourceView->Window()->LockWithTimeout(10000) == B_OK) {
+      mDragSourceView->SetMouseEventMask(0, 0);
+      mDragSourceView->Window()->Unlock();
+    }
+    mDragSourceView = nullptr;
+  }
+
+  nsresult rv = nsBaseDragSession::EndDragSession(aDoneDrop, aKeyModifiers);
+
+  CleanUpDrag();
+  mLastDragUrl.Truncate(0);
+  mLastDragTitle.Truncate(0);
+  mLastDragFilePath.Truncate(0);
+  return rv;
+}
+
+BMessage* nsDragSession::ConvertTransferableToHaikuMessage(
+    nsIArray* aTransferableArray, const BPoint& aHotspot) {
+  mLastDragUrl.Truncate(0);
+  mLastDragTitle.Truncate(0);
+  mLastDragFilePath.Truncate(0);
+
+  auto* msg = new BMessage(B_SIMPLE_DATA);
+  msg->AddPoint("click_pt", aHotspot);
+
+  if (!aTransferableArray) {
+    return msg;
+  }
+
+  uint32_t count = 0;
+  aTransferableArray->GetLength(&count);
+
+  BString urlStr;
+  BString titleStr;
+  bool hasFileRefs = false;
+  bool isTabDrag = false;
+  entry_ref firstFileRef;
+
+  for (uint32_t i = 0; i < count; ++i) {
+    nsCOMPtr<nsITransferable> trans = do_QueryElementAt(aTransferableArray, i);
+    if (!trans) {
+      continue;
+    }
+
+    if (!isTabDrag) {
+      auto hasTabFlavor = [](nsITransferable* aTrans) {
+        nsTArray<nsCString> flavors;
+        if (NS_SUCCEEDED(aTrans->FlavorsTransferableCanExport(flavors))) {
+          for (const auto& flavor : flavors) {
+            if (flavor.EqualsLiteral("application/x-moz-tabbrowser-tab")) {
+              return true;
+            }
+          }
+        }
+        flavors.Clear();
+        if (NS_SUCCEEDED(aTrans->FlavorsTransferableCanImport(flavors))) {
+          for (const auto& flavor : flavors) {
+            if (flavor.EqualsLiteral("application/x-moz-tabbrowser-tab")) {
+              return true;
+            }
+          }
+        }
+        return false;
+      };
+
+      if (hasTabFlavor(trans)) {
+        msg->AddString("application/x-moz-tabbrowser-tab", "tab");
+        isTabDrag = true;
+      }
+    }
+
+    nsCOMPtr<nsISupports> data;
+
+    if (NS_SUCCEEDED(trans->GetTransferData(kFileMime, getter_AddRefs(data))) && data) {
+      if (nsCOMPtr<nsIFile> file = do_QueryInterface(data)) {
+        nsAutoCString path;
+        if (NS_SUCCEEDED(file->GetNativePath(path))) {
+          entry_ref ref;
+          BEntry entry(path.get(), true);
+          if (entry.GetRef(&ref) == B_OK) {
+            msg->AddRef("refs", &ref);
+            if (!hasFileRefs) {
+              firstFileRef = ref;
+              hasFileRefs = true;
+            }
+          }
+        }
+      }
+    }
+
+    data = nullptr;
+    if (NS_SUCCEEDED(trans->GetTransferData(kURLMime, getter_AddRefs(data))) && data) {
+      if (nsCOMPtr<nsISupportsString> str = do_QueryInterface(data)) {
+        nsAutoString u16;
+        str->GetData(u16);
+        ParseMozUrl(u16, urlStr, titleStr);
+      }
+    }
+
+    if (urlStr.IsEmpty() && NS_SUCCEEDED(trans->GetTransferData(kURLDataMime, getter_AddRefs(data))) && data) {
+      if (nsCOMPtr<nsISupportsString> str = do_QueryInterface(data)) {
+        nsAutoString u16;
+        str->GetData(u16);
+        NS_ConvertUTF16toUTF8 u8(u16);
+        urlStr = u8.get();
+        urlStr.Trim();
+      }
+    }
+
+    if (titleStr.IsEmpty() && NS_SUCCEEDED(trans->GetTransferData(kURLDescriptionMime, getter_AddRefs(data))) && data) {
+      if (nsCOMPtr<nsISupportsString> str = do_QueryInterface(data)) {
+        nsAutoString u16;
+        str->GetData(u16);
+        NS_ConvertUTF16toUTF8 u8(u16);
+        titleStr = u8.get();
+        titleStr.Trim();
+      }
+    }
+
+    data = nullptr;
+    if (NS_SUCCEEDED(trans->GetTransferData(kTextMime, getter_AddRefs(data))) && data) {
+      if (nsCOMPtr<nsISupportsString> str = do_QueryInterface(data)) {
+        nsAutoString u16;
+        str->GetData(u16);
+        NS_ConvertUTF16toUTF8 u8(u16);
+        msg->AddData("text/plain", B_MIME_TYPE, u8.get(), u8.Length());
+      }
+    }
+
+    data = nullptr;
+    if (NS_SUCCEEDED(trans->GetTransferData(kHTMLMime, getter_AddRefs(data))) && data) {
+      if (nsCOMPtr<nsISupportsString> str = do_QueryInterface(data)) {
+        nsAutoString u16;
+        str->GetData(u16);
+        NS_ConvertUTF16toUTF8 u8(u16);
+        msg->AddData("text/html", B_MIME_TYPE, u8.get(), u8.Length());
+      }
+    }
+  }
+
+  if (urlStr.StartsWith("file://")) {
+    BString encodedPath;
+    urlStr.CopyInto(encodedPath, 7, urlStr.Length() - 7);
+    BString decodedPath;
+    if (DecodeURLPath(encodedPath, decodedPath) == B_OK) {
+      BEntry entry(decodedPath.String(), true);
+      entry_ref ref;
+      if (entry.Exists() && entry.GetRef(&ref) == B_OK) {
+        if (!hasFileRefs) {
+          msg->AddRef("refs", &ref);
+          firstFileRef = ref;
+          hasFileRefs = true;
+        }
+      }
+    }
+  }
+
+  if (hasFileRefs) {
+    BPath path(&firstFileRef);
+    if (path.InitCheck() == B_OK) {
+      mLastDragFilePath = path.Path();
+
+      msg->AddInt32("be:actions", B_COPY_TARGET);
+      msg->AddString("be:clip_name", firstFileRef.name);
+      msg->AddString("name", firstFileRef.name);
+      msg->AddString("be:filetypes", "application/octet-stream");
+      msg->AddString("be:types", "application/octet-stream");
+
+      BMessage originatorData(B_SIMPLE_DATA);
+      originatorData.AddString("file_path", path.Path());
+      originatorData.AddRef("refs", &firstFileRef);
+      msg->AddMessage("be:originator-data", &originatorData);
+    }
+
+    BString uriList;
+    entry_ref ref;
+    for (int32 i = 0; msg->FindRef("refs", i, &ref) == B_OK; ++i) {
+      BPath p(&ref);
+      if (p.InitCheck() == B_OK) {
+        uriList << "file://" << p.Path() << "\r\n";
+      }
+    }
+    if (uriList.Length() > 0) {
+      msg->AddData("text/uri-list", B_MIME_TYPE, uriList.String(), uriList.Length());
+    }
+  }
+
+  if (!urlStr.IsEmpty() && !hasFileRefs) {
+    urlStr.Trim();
+    titleStr.Trim();
+    BString bookmarkTitle = titleStr.IsEmpty() ? "Web Bookmark" : titleStr;
+    BString bookmarkFileName = bookmarkTitle;
+    SanitizeFileName(bookmarkFileName);
+
+    mLastDragUrl = urlStr;
+    mLastDragTitle = bookmarkTitle;
+
+    msg->AddString("META:url", urlStr);
+    msg->AddString("META:title", bookmarkTitle);
+
+    if (!isTabDrag) {
+      msg->AddString("BEOS:TYPE", "application/x-vnd.Be-bookmark");
+      msg->AddString("name", bookmarkFileName);
+
+      msg->AddInt32("be:actions", B_COPY_TARGET);
+      msg->AddString("be:clip_name", bookmarkFileName);
+      msg->AddString("be:filetypes", "application/x-vnd.Be-bookmark");
+      msg->AddString("be:types", "application/octet-stream");
+
+      BMessage originatorData(B_SIMPLE_DATA);
+      originatorData.AddString("url", urlStr);
+      originatorData.AddString("title", bookmarkTitle);
+      msg->AddMessage("be:originator-data", &originatorData);
+    }
+
+    BString uriList = urlStr;
+    uriList << "\r\n";
+    msg->AddData("text/uri-list", B_MIME_TYPE, uriList.String(), uriList.Length());
+
+    if (!msg->HasData("text/plain", B_MIME_TYPE)) {
+      msg->AddData("text/plain", B_MIME_TYPE, urlStr.String(), urlStr.Length());
+    }
+  }
+
+  return msg;
+}
+
+int32 nsDragSession::sDragWatcherThread(void* aData) {
+  RefPtr<nsDragSession> session = static_cast<nsDragSession*>(aData);
+  BPoint lastScreenPt;
+  uint32 lastLoggedButtons = 0xFFFFFFFF;
+
+  while (session->mIsDragging) {
+    snooze(25000);
+
+    uint32 buttons = 0;
+    BPoint pt;
+    bool lockOk = false;
+
+    HaikuView* view = session->mDragSourceView;
+    if (view && view->Window()) {
+      BWindow* win = view->Window();
+      if (win->LockWithTimeout(10000) == B_OK) {
+        lockOk = true;
+        view->GetMouse(&pt, &buttons, false);
+        view->ConvertToScreen(&pt);
+        lastScreenPt = pt;
+        win->Unlock();
+      }
+    }
+
+    if (!lockOk) {
+      continue;
+    }
+
+    if (buttons != lastLoggedButtons) {
+      lastLoggedButtons = buttons;
+    }
+
+    if (buttons == 0 && session->mIsDragging) {
+      snooze(40000);
+
+      if (session->mIsDragging && !session->mOverGeckoWindow) {
+        if (session->MarkDragEnding()) {
+          int32_t mods = ::modifiers();
+
+          NS_DispatchToMainThread(NS_NewRunnableFunction(
+              "nsDragSession::DragEndedOutsideWatcher",
+              [session, lastScreenPt, mods]() {
+                session->DragEndedOutside(lastScreenPt, mods);
+              }));
+        }
+      }
+      break;
+    }
+  }
+
+  session->Release();
+  return 0;
+}
+
+nsresult nsDragSession::InvokeDragSessionImpl(
+    nsIWidget* aWidget, nsIArray* aTransferableArray,
+    const Maybe<CSSIntRegion>& aRegion, uint32_t aActionType) {
+  if (!aWidget) {
+    return NS_ERROR_FAILURE;
+  }
+
+  auto* window = static_cast<nsWindow*>(aWidget);
+  auto* view = static_cast<HaikuView*>(window->GetNativeData(NS_NATIVE_WIDGET));
+  if (!view || !view->Window()) {
+    return NS_ERROR_FAILURE;
+  }
+
+  if (view->Window()->LockWithTimeout(50000) != B_OK) {
+    return NS_ERROR_FAILURE;
+  }
+
+  mDataItems = aTransferableArray;
+  mIsDragging = true;
+  mOverGeckoWindow = true;
+  mDragEnding = false;
+  mDragEnded = false;
+  mDragSourceView = view;
+
+  BPoint mousePos;
+  uint32 mouseButtons = 0;
+  view->GetMouse(&mousePos, &mouseButtons);
+
+  view->SetMouseEventMask(B_POINTER_EVENTS, B_LOCK_WINDOW_FOCUS | B_NO_POINTER_HISTORY);
+
+  LayoutDeviceIntRect winBounds = window->GetScreenBounds();
+
+  BPoint hotspot(14, 14);
+  BBitmap* dragBitmap = CreateDragBitmap(mSourceNode, aRegion, winBounds.TopLeft(), mousePos, &hotspot);
+
+  BMessage* dragMsg = ConvertTransferableToHaikuMessage(aTransferableArray, hotspot);
+
+  this->AddRef();
+  mWatcherThread = spawn_thread(sDragWatcherThread, "DragWatcherThread", B_NORMAL_PRIORITY, this);
+  if (mWatcherThread >= B_OK) {
+    resume_thread(mWatcherThread);
+  } else {
+    this->Release();
+  }
+
+  if (dragBitmap) {
+    view->DragMessage(dragMsg, dragBitmap, B_OP_ALPHA, hotspot, view);
+  } else {
+    double scale = GetHaikuSystemScale();
+    float halfSize = std::round(14.0f * static_cast<float>(scale));
+
+    BRect r(mousePos.x - halfSize, mousePos.y - halfSize,
+            mousePos.x + halfSize, mousePos.y + halfSize);
+
+    view->DragMessage(dragMsg, r, view);
+  }
+
+  view->Window()->Unlock();
+  return NS_OK;
+}
+
+static bool CheckBookmarkRef(const entry_ref& aRef, BString& aOutUrl, BString& aOutTitle) {
+  BNode node(&aRef);
+  if (node.InitCheck() != B_OK) {
+    return false;
+  }
+  char attrBuf[1024];
+  ssize_t attrSize = node.ReadAttr("META:url", B_STRING_TYPE, 0, attrBuf, sizeof(attrBuf) - 1);
+  if (attrSize > 0) {
+    attrBuf[attrSize] = '\0';
+    aOutUrl = attrBuf;
+    aOutUrl.Trim();
+    attrSize = node.ReadAttr("META:title", B_STRING_TYPE, 0, attrBuf, sizeof(attrBuf) - 1);
+    if (attrSize > 0) {
+      attrBuf[attrSize] = '\0';
+      aOutTitle = attrBuf;
+      aOutTitle.Trim();
+    }
+    if (aOutTitle.IsEmpty()) {
+      aOutTitle = aRef.name;
+    }
+    return !aOutUrl.IsEmpty();
+  }
+  return false;
+}
+
+NS_IMETHODIMP
+nsDragSession::GetData(nsITransferable* aTransferable, uint32_t aItemIndex) {
+  NS_ENSURE_ARG_POINTER(aTransferable);
+
+  nsTArray<nsCString> flavors;
+  nsresult rv = aTransferable->FlavorsTransferableCanImport(flavors);
+  if (NS_FAILED(rv)) {
+    return NS_ERROR_FAILURE;
+  }
+
+  if (mDataItems) {
+    nsCOMPtr<nsITransferable> srcTrans = do_QueryElementAt(mDataItems, aItemIndex);
+    if (!srcTrans) {
+      return NS_ERROR_FAILURE;
+    }
+
+    bool copiedAny = false;
+    for (const auto& flavor : flavors) {
+      nsCOMPtr<nsISupports> data;
+      if (NS_SUCCEEDED(srcTrans->GetTransferData(flavor.get(), getter_AddRefs(data))) && data) {
+        aTransferable->SetTransferData(flavor.get(), data);
+        copiedAny = true;
+      }
+    }
+    return copiedAny ? NS_OK : NS_ERROR_FAILURE;
+  }
+
+  if (!mCurrentMessage) {
+    return NS_ERROR_FAILURE;
+  }
+
+  const BMessage& msg = mDropMessage;
+
+  auto setTransferString = [&](const void* aData, ssize_t aSize, const char* aFlavor) -> nsresult {
+    if (!aData || aSize <= 0) {
+      return NS_ERROR_FAILURE;
+    }
+    nsAutoString u16;
+    CopyUTF8toUTF16(Span(static_cast<const char*>(aData), aSize), u16);
+    nsCOMPtr<nsISupportsString> str = do_CreateInstance(NS_SUPPORTS_STRING_CONTRACTID);
+    if (!str) {
+      return NS_ERROR_FAILURE;
+    }
+    str->SetData(u16);
+    return aTransferable->SetTransferData(aFlavor, str);
+  };
+
+  for (const auto& flavor : flavors) {
+    if (flavor.EqualsLiteral(kTextMime) || flavor.EqualsLiteral("text/plain")) {
+      const void* data = nullptr;
+      ssize_t size = 0;
+      if (msg.FindData("text/plain", B_MIME_TYPE, &data, &size) == B_OK && data && size > 0) {
+        return setTransferString(data, size, flavor.get());
+      }
+    }
+
+    if (flavor.EqualsLiteral(kHTMLMime) || flavor.EqualsLiteral("text/html")) {
+      const void* data = nullptr;
+      ssize_t size = 0;
+      if (msg.FindData("text/html", B_MIME_TYPE, &data, &size) == B_OK && data && size > 0) {
+        return setTransferString(data, size, flavor.get());
+      }
+    }
+
+    if (flavor.EqualsLiteral(kURLMime) || flavor.EqualsLiteral("text/x-moz-url") ||
+        flavor.EqualsLiteral(kURLDataMime)) {
+      BString url;
+      BString title;
+      if (msg.FindString("META:url", &url) == B_OK && !url.IsEmpty()) {
+        msg.FindString("META:title", &title);
+      } else {
+        entry_ref ref;
+        if (msg.FindRef("refs", int32(aItemIndex), &ref) == B_OK) {
+          CheckBookmarkRef(ref, url, title);
+        }
+      }
+
+      if (!url.IsEmpty()) {
+        if (flavor.EqualsLiteral(kURLDataMime)) {
+          return setTransferString(url.String(), url.Length(), flavor.get());
+        }
+        BString mozUrl = url;
+        mozUrl << "\n" << (title.IsEmpty() ? url : title);
+        return setTransferString(mozUrl.String(), mozUrl.Length(), flavor.get());
+      }
+    }
+
+    if (flavor.EqualsLiteral(kFileMime)) {
+      entry_ref ref;
+      if (msg.FindRef("refs", int32(aItemIndex), &ref) == B_OK) {
+        BEntry entry(&ref, true);
+        BPath path;
+        if (entry.GetPath(&path) == B_OK) {
+          nsCOMPtr<nsIFile> file;
+          if (NS_SUCCEEDED(NS_NewNativeLocalFile(nsDependentCString(path.Path()), getter_AddRefs(file)))) {
+            aTransferable->SetTransferData(flavor.get(), file);
+            return NS_OK;
+          }
+        }
+      }
+    }
+
+    if (flavor.EqualsLiteral("text/uri-list")) {
+      const void* data = nullptr;
+      ssize_t size = 0;
+      if (msg.FindData("text/uri-list", B_MIME_TYPE, &data, &size) == B_OK && data && size > 0) {
+        return setTransferString(data, size, flavor.get());
+      }
+
+      entry_ref ref;
+      if (msg.FindRef("refs", int32(aItemIndex), &ref) == B_OK) {
+        BEntry entry(&ref, true);
+        BPath path;
+        if (entry.GetPath(&path) == B_OK) {
+          BString uri = "file://";
+          uri << path.Path() << "\r\n";
+          return setTransferString(uri.String(), uri.Length(), flavor.get());
+        }
+      }
+    }
+  }
+
+  return NS_ERROR_FAILURE;
+}
+
+NS_IMETHODIMP
+nsDragSession::IsDataFlavorSupported(const char* aDataFlavor, bool* aRetVal) {
+  NS_ENSURE_ARG_POINTER(aRetVal);
+  *aRetVal = false;
+
+  nsDependentCString flavor(aDataFlavor);
+
+  if (mDataItems) {
+    uint32_t count = 0;
+    mDataItems->GetLength(&count);
+    for (uint32_t i = 0; i < count; ++i) {
+      nsCOMPtr<nsITransferable> trans = do_QueryElementAt(mDataItems, i);
+      if (!trans) {
+        continue;
+      }
+
+      auto checkFlavorList = [&](nsresult (NS_STDCALL nsITransferable::*aFunc)(nsTArray<nsCString>&)) {
+        nsTArray<nsCString> flavorList;
+        if (NS_SUCCEEDED((trans->*aFunc)(flavorList))) {
+          for (const auto& f : flavorList) {
+            if (flavor.Equals(f)) {
+              return true;
+            }
+          }
+        }
+        return false;
+      };
+
+      if (checkFlavorList(&nsITransferable::FlavorsTransferableCanImport) ||
+          checkFlavorList(&nsITransferable::FlavorsTransferableCanExport)) {
+        *aRetVal = true;
+        return NS_OK;
+      }
+    }
+    return NS_OK;
+  }
+
+  if (!mCurrentMessage) {
+    return NS_OK;
+  }
+
+  const BMessage& msg = mDropMessage;
+
+  if (msg.HasData(aDataFlavor, B_MIME_TYPE)) {
+    *aRetVal = true;
+    return NS_OK;
+  }
+
+  if (flavor.EqualsLiteral(kTextMime) || flavor.EqualsLiteral("text/plain")) {
+    if (msg.HasData("text/plain", B_MIME_TYPE) || msg.HasString("META:url")) {
+      *aRetVal = true;
+      return NS_OK;
+    }
+  }
+
+  if (flavor.EqualsLiteral(kHTMLMime) || flavor.EqualsLiteral("text/html")) {
+    if (msg.HasData("text/html", B_MIME_TYPE)) {
+      *aRetVal = true;
+      return NS_OK;
+    }
+  }
+
+  if (flavor.EqualsLiteral(kURLMime) || flavor.EqualsLiteral("text/x-moz-url") ||
+      flavor.EqualsLiteral(kURLDataMime)) {
+    if (msg.HasString("META:url")) {
+      *aRetVal = true;
+      return NS_OK;
+    }
+    entry_ref ref;
+    if (msg.FindRef("refs", 0, &ref) == B_OK) {
+      BString url;
+      BString title;
+      if (CheckBookmarkRef(ref, url, title)) {
+        *aRetVal = true;
+        return NS_OK;
+      }
+    }
+  }
+
+  if (flavor.EqualsLiteral(kFileMime) || flavor.EqualsLiteral("text/uri-list")) {
+    if (msg.HasRef("refs") || msg.HasData("text/uri-list", B_MIME_TYPE)) {
+      *aRetVal = true;
+      return NS_OK;
+    }
+  }
+
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+nsDragSession::GetNumDropItems(uint32_t* aNumItems) {
+  NS_ENSURE_ARG_POINTER(aNumItems);
+
+  if (mDataItems) {
+    return mDataItems->GetLength(aNumItems);
+  }
+
+  if (!mCurrentMessage) {
+    return NS_OK;
+  }
+
+  type_code type;
+  int32 count = 0;
+  if (mDropMessage.GetInfo("refs", &type, &count) == B_OK && count > 0) {
+    *aNumItems = count;
+  } else {
+    *aNumItems = 1;
+  }
+
+  return NS_OK;
+}
diff --git a/widget/haiku/nsDragService.h b/widget/haiku/nsDragService.h
new file mode 100644
index 0000000000..e1065c079f
--- /dev/null
+++ b/widget/haiku/nsDragService.h
@@ -0,0 +1,112 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_widget_nsDragService_h
+#define mozilla_widget_nsDragService_h
+
+#include "HaikuUtils.h"
+#include "nsBaseDragService.h"
+#include "nsIArray.h"
+#include "mozilla/Atomics.h"
+#include "mozilla/RefPtr.h"
+#include "Units.h"
+
+class nsWindow;
+class HaikuView;
+
+class nsDragSession : public nsBaseDragSession {
+ public:
+  NS_DECL_ISUPPORTS_INHERITED
+
+  nsDragSession();
+
+  NS_IMETHOD GetData(nsITransferable* aTransferable, uint32_t aItemIndex) override;
+  NS_IMETHOD IsDataFlavorSupported(const char* aDataFlavor, bool* aRetVal) override;
+  NS_IMETHOD GetNumDropItems(uint32_t* aNumItems) override;
+  NS_IMETHOD EndDragSession(bool aDoneDrop, uint32_t aKeyModifiers) override;
+
+  void SetHaikuDragMessage(const BMessage* aMessage);
+  const BMessage* GetHaikuDragMessage() const {
+    return mCurrentMessage ? &mDropMessage : nullptr;
+  }
+
+  void CleanUpDrag();
+
+  bool IsDragging() const {
+    return mIsDragging;
+  }
+  bool IsOverGeckoWindow() const {
+    return mOverGeckoWindow;
+  }
+  void SetOverGeckoWindow(bool aOver) {
+    mOverGeckoWindow = aOver;
+  }
+  bool MarkDragEnding() {
+    return !mDragEnding.exchange(true);
+  }
+  void DragEndedOutside(const BPoint& aScreenPoint, int32_t aModifiers);
+
+  void GetLastDragBookmarkInfo(BString& aOutUrl, BString& aOutTitle) const {
+    aOutUrl = mLastDragUrl;
+    aOutTitle = mLastDragTitle;
+  }
+
+  void GetLastDragFilePath(BString& aOutFilePath) const {
+    aOutFilePath = mLastDragFilePath;
+  }
+
+  HaikuView* GetDragSourceView() const {
+    return mDragSourceView;
+  }
+
+ protected:
+  ~nsDragSession() override;
+
+  MOZ_CAN_RUN_SCRIPT nsresult InvokeDragSessionImpl(
+      nsIWidget* aWidget, nsIArray* aTransferableArray,
+      const mozilla::Maybe<mozilla::CSSIntRegion>& aRegion,
+      uint32_t aActionType) override;
+
+  BBitmap* CreateDragBitmap(nsINode* aDOMNode,
+                           const mozilla::Maybe<mozilla::CSSIntRegion>& aRegion,
+                           const mozilla::LayoutDeviceIntPoint& aWindowOrigin,
+                           const BPoint& aMousePos,
+                           BPoint* aHotspot);
+
+ private:
+  static int32 sDragWatcherThread(void* aData);
+
+  BMessage* ConvertTransferableToHaikuMessage(nsIArray* aTransferableArray, const BPoint& aHotspot);
+
+  nsCOMPtr<nsIArray> mDataItems;
+  bool mCurrentMessage = false;
+  BMessage mDropMessage;
+
+  bool mIsDragging = false;
+  bool mOverGeckoWindow = false;
+  mozilla::Atomic<bool> mDragEnding{false};
+  bool mDragEnded = false;
+  HaikuView* mDragSourceView = nullptr;
+  thread_id mWatcherThread = -1;
+
+  BString mLastDragUrl;
+  BString mLastDragTitle;
+  BString mLastDragFilePath;
+};
+
+class nsDragService final : public nsBaseDragService {
+ public:
+  NS_DECL_ISUPPORTS_INHERITED
+
+  nsDragService() = default;
+
+  already_AddRefed<nsIDragSession> CreateDragSession() override;
+
+  static nsDragService* GetInstance();
+
+ private:
+  ~nsDragService() override = default;
+};
+
+#endif  // mozilla_widget_nsDragService_h
diff --git a/widget/haiku/nsFilePicker.cpp b/widget/haiku/nsFilePicker.cpp
new file mode 100644
index 0000000000..ec64600e53
--- /dev/null
+++ b/widget/haiku/nsFilePicker.cpp
@@ -0,0 +1,301 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsFilePicker.h"
+#include "HaikuUtils.h"
+#include "HaikuView.h"
+
+#include <cstdio>
+#include "nsArrayEnumerator.h"
+#include "nsComponentManagerUtils.h"
+#include "nsNetUtil.h"
+#include "nsReadableUtils.h"
+#include "nsThreadUtils.h"
+
+using namespace mozilla;
+
+struct PickerResultData {
+  nsIFilePicker::ResultCode mResult = nsIFilePicker::returnCancel;
+  nsTArray<nsCString> mPaths;
+};
+
+class FilePanelLooper : public BLooper {
+ public:
+  explicit FilePanelLooper(nsFilePicker* aPicker)
+      : BLooper("FilePanelLooper"),
+        mPicker(aPicker) {}
+
+  void DetachPicker() {
+    mPicker = nullptr;
+  }
+
+  void MessageReceived(BMessage* aMessage) override {
+    PickerResultData data;
+
+    switch (aMessage->what) {
+      case B_REFS_RECEIVED: {
+        uint32 type;
+        int32 count = 0;
+        aMessage->GetInfo("refs", &type, &count);
+        if (type == B_REF_TYPE && count > 0) {
+          entry_ref ref;
+          for (int32 i = 0; i < count; ++i) {
+            if (aMessage->FindRef("refs", i, &ref) == B_OK) {
+              BPath path(&ref);
+              if (path.InitCheck() == B_OK) {
+                data.mPaths.AppendElement(nsCString(path.Path()));
+              }
+            }
+          }
+        }
+        if (!data.mPaths.IsEmpty()) {
+          data.mResult = nsIFilePicker::returnOK;
+        }
+        break;
+      }
+      case B_SAVE_REQUESTED: {
+        entry_ref dirRef;
+        const char* name = nullptr;
+
+        if (aMessage->FindRef("directory", &dirRef) == B_OK &&
+            aMessage->FindString("name", &name) == B_OK && name) {
+          BDirectory dir(&dirRef);
+          BPath path(&dir, nullptr, false);
+          path.Append(name);
+
+          if (path.InitCheck() == B_OK) {
+            data.mPaths.AppendElement(nsCString(path.Path()));
+            BEntry entry(path.Path());
+            if (entry.Exists()) {
+              data.mResult = nsIFilePicker::returnReplace;
+            } else {
+              data.mResult = nsIFilePicker::returnOK;
+            }
+          }
+        }
+        break;
+      }
+      case B_CANCEL:
+      default:
+        data.mResult = nsIFilePicker::returnCancel;
+        break;
+    }
+
+    RefPtr<nsFilePicker> picker = mPicker;
+    if (picker) {
+      NS_DispatchToMainThread(NS_NewRunnableFunction(
+          "nsFilePicker::OnPanelDone",
+          [picker = std::move(picker), data = std::move(data)]() {
+            picker->OnPanelClosed(data);
+          }));
+    }
+  }
+
+ private:
+  nsFilePicker* mPicker;
+};
+
+NS_IMPL_ISUPPORTS(nsFilePicker, nsIFilePicker)
+
+nsFilePicker::nsFilePicker() = default;
+
+nsFilePicker::~nsFilePicker() {
+  if (mLooper) {
+    mLooper->DetachPicker();
+    if (mLooper->Lock()) {
+      mLooper->Quit();
+    }
+    mLooper = nullptr;
+  }
+
+  if (mPanel) {
+    delete mPanel;
+    mPanel = nullptr;
+  }
+}
+
+void nsFilePicker::InitNative(nsIWidget* aParent, const nsAString& aTitle) {
+  mParentWidget = aParent;
+  mTitle = aTitle;
+}
+
+NS_IMETHODIMP
+nsFilePicker::Open(nsIFilePickerShownCallback* aCallback) {
+  if (MaybeBlockFilePicker(aCallback)) {
+    return NS_OK;
+  }
+
+  mCallback = aCallback;
+
+  if (mPanel) {
+    delete mPanel;
+    mPanel = nullptr;
+  }
+
+  file_panel_mode panelMode = B_OPEN_PANEL;
+  uint32 nodeFlavors = B_FILE_NODE | B_SYMLINK_NODE;
+  bool allowMultiple = false;
+
+  switch (mMode) {
+    case modeOpen:
+      panelMode = B_OPEN_PANEL;
+      allowMultiple = false;
+      break;
+    case modeOpenMultiple:
+      panelMode = B_OPEN_PANEL;
+      allowMultiple = true;
+      break;
+    case modeGetFolder:
+      panelMode = B_OPEN_PANEL;
+      nodeFlavors = B_DIRECTORY_NODE;
+      allowMultiple = false;
+      break;
+    case modeSave:
+      panelMode = B_SAVE_PANEL;
+      allowMultiple = false;
+      break;
+    default:
+      if (mCallback) {
+        mCallback->Done(returnCancel);
+        mCallback = nullptr;
+      }
+      return NS_OK;
+  }
+
+  if (!mLooper) {
+    mLooper = new FilePanelLooper(this);
+    mLooper->Run();
+  }
+
+  BMessenger target(mLooper);
+
+  mPanel = new BFilePanel(panelMode, &target, nullptr, nodeFlavors,
+                          allowMultiple, nullptr, nullptr, false, true);
+
+  if (mDisplayDirectory) {
+    nsAutoCString dirPath;
+    if (NS_SUCCEEDED(mDisplayDirectory->GetNativePath(dirPath))) {
+      BEntry dirEntry(dirPath.get(), true);
+      entry_ref dirRef;
+      if (dirEntry.GetRef(&dirRef) == B_OK) {
+        mPanel->SetPanelDirectory(&dirRef);
+      }
+    }
+  }
+
+  if (mMode == modeSave && !mDefaultFilename.IsEmpty()) {
+    NS_ConvertUTF16toUTF8 defaultName(mDefaultFilename);
+    mPanel->SetSaveText(defaultName.get());
+  }
+
+  if (mPanel->Window()) {
+    BWindow* win = mPanel->Window();
+    if (win->LockWithTimeout(50000) == B_OK) {
+      if (!mTitle.IsEmpty()) {
+        NS_ConvertUTF16toUTF8 title(mTitle);
+        win->SetTitle(title.get());
+      }
+
+      if (mParentWidget) {
+        auto* parentWin = static_cast<HaikuWindow*>(
+            mParentWidget->GetNativeData(NS_NATIVE_WINDOW));
+        if (parentWin && parentWin->LockWithTimeout(10000) == B_OK) {
+          win->CenterIn(parentWin->Frame());
+          parentWin->Unlock();
+        } else {
+          win->CenterOnScreen();
+        }
+      } else {
+        win->CenterOnScreen();
+      }
+      win->Unlock();
+    }
+  }
+
+  RecordLastShownTime();
+  mPanel->Show();
+
+  return NS_OK;
+}
+
+void nsFilePicker::OnPanelClosed(const PickerResultData& aData) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  mFiles.Clear();
+  for (const auto& path : aData.mPaths) {
+    nsCOMPtr<nsIFile> file;
+    if (NS_SUCCEEDED(NS_NewNativeLocalFile(path, getter_AddRefs(file)))) {
+      mFiles.AppendObject(file);
+    }
+  }
+
+  if (mCallback) {
+    nsCOMPtr<nsIFilePickerShownCallback> callback = mCallback.forget();
+    callback->Done(aData.mResult);
+  }
+}
+
+NS_IMETHODIMP nsFilePicker::GetFile(nsIFile** aFile) {
+  NS_ENSURE_ARG_POINTER(aFile);
+  *aFile = nullptr;
+
+  if (mFiles.Count() > 0) {
+    *aFile = mFiles.ObjectAt(0);
+    NS_IF_ADDREF(*aFile);
+  }
+
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::GetFileURL(nsIURI** aFileURL) {
+  NS_ENSURE_ARG_POINTER(aFileURL);
+  *aFileURL = nullptr;
+
+  if (mFiles.Count() == 0) {
+    return NS_OK;
+  }
+
+  return NS_NewFileURI(aFileURL, mFiles.ObjectAt(0));
+}
+
+NS_IMETHODIMP nsFilePicker::GetFiles(nsISimpleEnumerator** aFiles) {
+  return NS_NewArrayEnumerator(aFiles, mFiles, NS_GET_IID(nsIFile));
+}
+
+NS_IMETHODIMP nsFilePicker::SetDefaultString(const nsAString& aString) {
+  mDefaultFilename = aString;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::GetDefaultString(nsAString& aString) {
+  aString = mDefaultFilename;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::GetDefaultExtension(nsAString& aExtension) {
+  aExtension = mDefaultExtension;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::SetDefaultExtension(const nsAString& aExtension) {
+  mDefaultExtension = aExtension;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::AppendFilter(const nsAString& aTitle,
+                                        const nsAString& aFilter) {
+  mFilters.AppendElement(aFilter);
+  mTitles.AppendElement(aTitle);
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::GetFilterIndex(int32_t* aFilterIndex) {
+  *aFilterIndex = mSelectedTypeIndex;
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsFilePicker::SetFilterIndex(int32_t aFilterIndex) {
+  mSelectedTypeIndex = aFilterIndex;
+  return NS_OK;
+}
diff --git a/widget/haiku/nsFilePicker.h b/widget/haiku/nsFilePicker.h
new file mode 100644
index 0000000000..a678e53cf7
--- /dev/null
+++ b/widget/haiku/nsFilePicker.h
@@ -0,0 +1,67 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_widget_nsFilePicker_h
+#define mozilla_widget_nsFilePicker_h
+
+#include "HaikuUtils.h"
+#include "nsBaseFilePicker.h"
+#include "nsCOMArray.h"
+#include "nsIFile.h"
+#include "nsString.h"
+#include "nsTArray.h"
+
+class BMessage;
+class BFilePanel;
+class FilePanelLooper;
+struct PickerResultData;
+
+#define NS_FILEPICKER_CID \
+  {0xe5170091, 0xc16b, 0x492d, {0xbf, 0x00, 0xf4, 0x5d, 0x72, 0x47, 0x05, 0x53}}
+
+class nsFilePicker final : public nsBaseFilePicker {
+ public:
+  nsFilePicker();
+
+  using nsIFilePicker::ResultCode;
+
+  NS_DECL_ISUPPORTS
+
+  MOZ_CAN_RUN_SCRIPT NS_IMETHOD Open(nsIFilePickerShownCallback* aCallback) override;
+  NS_IMETHOD GetFile(nsIFile** aFile) override;
+  NS_IMETHOD GetFileURL(nsIURI** aFileURL) override;
+  NS_IMETHOD GetFiles(nsISimpleEnumerator** aFiles) override;
+  NS_IMETHOD AppendFilter(const nsAString& aTitle, const nsAString& aFilter) override;
+  NS_IMETHOD GetDefaultString(nsAString& aDefaultString) override;
+  NS_IMETHOD SetDefaultString(const nsAString& aDefaultString) override;
+  NS_IMETHOD GetDefaultExtension(nsAString& aDefaultExtension) override;
+  NS_IMETHOD SetDefaultExtension(const nsAString& aDefaultExtension) override;
+  NS_IMETHOD GetFilterIndex(int32_t* aFilterIndex) override;
+  NS_IMETHOD SetFilterIndex(int32_t aFilterIndex) override;
+
+  void OnPanelClosed(const PickerResultData& aData);
+  bool HasFiles() const { return mFiles.Count() > 0; }
+
+ protected:
+  virtual ~nsFilePicker();
+
+  void InitNative(nsIWidget* aParent, const nsAString& aTitle) override;
+
+ private:
+  nsCOMPtr<nsIWidget> mParentWidget;
+  nsCOMPtr<nsIFilePickerShownCallback> mCallback;
+  nsString mTitle;
+  nsCOMArray<nsIFile> mFiles;
+  nsString mDefaultFilename;
+  nsString mDefaultExtension;
+
+  nsTArray<nsString> mFilters;
+  nsTArray<nsString> mTitles;
+  int32_t mSelectedTypeIndex = 0;
+
+  BFilePanel* mPanel = nullptr;
+  FilePanelLooper* mLooper = nullptr;
+};
+
+#endif  // mozilla_widget_nsFilePicker_h
diff --git a/widget/haiku/nsLookAndFeel.cpp b/widget/haiku/nsLookAndFeel.cpp
new file mode 100644
index 0000000000..eda4981566
--- /dev/null
+++ b/widget/haiku/nsLookAndFeel.cpp
@@ -0,0 +1,508 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsLookAndFeel.h"
+#include "gfxFont.h"
+#include "gfxFontConstants.h"
+#include "mozilla/FontPropertyTypes.h"
+#include "nsStyleConsts.h"
+#include "HaikuUtils.h"
+
+#include <cstdint>
+#include <cstdlib>
+
+#pragma GCC visibility push(default)
+#include <interface/Menu.h>
+#pragma GCC visibility pop
+
+using namespace mozilla;
+
+static inline nscolor ToNSColor(rgb_color c) {
+  return NS_RGBA(c.red, c.green, c.blue, c.alpha);
+}
+
+static inline rgb_color BlendDisabled(rgb_color fg, rgb_color bg) {
+  rgb_color res = fg;
+  res.red = static_cast<uint8>((int32(bg.red) + int32(fg.red) + 1) / 2);
+  res.green = static_cast<uint8>((int32(bg.green) + int32(fg.green) + 1) / 2);
+  res.blue = static_cast<uint8>((int32(bg.blue) + int32(fg.blue) + 1) / 2);
+  return res;
+}
+
+static float ConvertFontSize(float aFontSize) {
+  if (!be_plain_font || aFontSize <= 0.0f) {
+    return 12.0f;
+  }
+  float plainSize = be_plain_font->Size();
+  if (plainSize <= 12.0f) {
+    return aFontSize;
+  }
+  return aFontSize - (plainSize - 12.0f);
+}
+
+nsresult nsLookAndFeel::NativeGetColor(ColorID aID, ColorScheme aColorScheme, nscolor& aResult) {
+  EnsureInit();
+
+  if (!be_app) {
+    aResult = GetStandinForNativeColor(aID, aColorScheme);
+    return NS_OK;
+  }
+
+  const rgb_color listSelectedBg = ui_color(B_LIST_SELECTED_BACKGROUND_COLOR);
+  const rgb_color listSelectedText = ui_color(B_LIST_SELECTED_ITEM_TEXT_COLOR);
+
+  switch (aID) {
+    case ColorID::Accentcolor:
+    case ColorID::Highlight:
+    case ColorID::Selecteditem:
+      aResult = ToNSColor(listSelectedBg);
+      return NS_OK;
+
+    case ColorID::Accentcolortext:
+    case ColorID::Highlighttext:
+    case ColorID::Selecteditemtext:
+      aResult = ToNSColor(listSelectedText);
+      return NS_OK;
+
+    default:
+      break;
+  }
+
+  if (aColorScheme == ColorScheme::Dark) {
+    if (auto darkColor = GenericDarkColor(aID)) {
+      aResult = *darkColor;
+      return NS_OK;
+    }
+  }
+
+  const rgb_color panelBg = ui_color(B_PANEL_BACKGROUND_COLOR);
+  const rgb_color panelText = ui_color(B_PANEL_TEXT_COLOR);
+  rgb_color controlBg = ui_color(B_CONTROL_BACKGROUND_COLOR);
+  const rgb_color controlBorder = ui_color(B_CONTROL_BORDER_COLOR);
+  const rgb_color controlHighlight = ui_color(B_CONTROL_HIGHLIGHT_COLOR);
+  const rgb_color docBg = ui_color(B_DOCUMENT_BACKGROUND_COLOR);
+  const rgb_color docText = ui_color(B_DOCUMENT_TEXT_COLOR);
+
+  if (std::abs(int(controlBg.red) - int(panelBg.red)) < 15 &&
+      std::abs(int(controlBg.green) - int(panelBg.green)) < 15 &&
+      std::abs(int(controlBg.blue) - int(panelBg.blue)) < 15) {
+    controlBg = tint_color(panelBg, B_LIGHTEN_2_TINT);
+  }
+
+  static constexpr nscolor kDarkText = NS_RGB(0x1b, 0x1b, 0x1b);
+
+  switch (aID) {
+    case ColorID::Window:
+    case ColorID::Appworkspace:
+    case ColorID::MozDialog:
+    case ColorID::MozHeaderbar:
+    case ColorID::MozHeaderbarinactive:
+      aResult = ToNSColor(panelBg);
+      break;
+
+    case ColorID::Windowtext:
+    case ColorID::MozDialogtext:
+    case ColorID::Captiontext:
+    case ColorID::Inactivecaptiontext:
+    case ColorID::MozHeaderbartext:
+    case ColorID::MozHeaderbarinactivetext:
+    case ColorID::MozColheadertext:
+    case ColorID::MozColheaderhovertext:
+    case ColorID::MozColheaderactivetext:
+    case ColorID::MozSidebartext:
+    case ColorID::MozComboboxtext:
+    case ColorID::Buttontext:
+    case ColorID::MozButtonhovertext:
+    case ColorID::MozButtonactivetext:
+      aResult = kDarkText;
+      break;
+
+    case ColorID::MozSidebar:
+      aResult = ToNSColor(docBg);
+      break;
+
+    case ColorID::MozSidebarborder:
+      aResult = ToNSColor(controlBorder);
+      break;
+
+    case ColorID::Graytext:
+      aResult = ToNSColor(BlendDisabled(panelText, panelBg));
+      break;
+
+    case ColorID::Field:
+      aResult = ToNSColor(docBg);
+      break;
+
+    case ColorID::Fieldtext:
+      aResult = ToNSColor(docText);
+      break;
+
+    case ColorID::Buttonface:
+    case ColorID::Threedface:
+      aResult = ToNSColor(controlBg);
+      break;
+
+    case ColorID::MozButtonhoverface:
+      aResult = ToNSColor(tint_color(controlBg, B_DARKEN_1_TINT));
+      break;
+
+    case ColorID::MozButtonactiveface:
+      aResult = ToNSColor(tint_color(controlBg, B_DARKEN_2_TINT));
+      break;
+
+    case ColorID::MozButtondisabledface:
+      aResult = ToNSColor(tint_color(controlBg, B_LIGHTEN_1_TINT));
+      break;
+
+    case ColorID::Buttonborder:
+      aResult = ToNSColor(controlBorder);
+      break;
+
+    case ColorID::MozButtonhoverborder:
+    case ColorID::MozButtonactiveborder:
+      aResult = ToNSColor(controlHighlight);
+      break;
+
+    case ColorID::MozButtondisabledborder:
+      aResult = ToNSColor(tint_color(controlBorder, B_LIGHTEN_2_TINT));
+      break;
+
+    case ColorID::Menu:
+      aResult = ToNSColor(ui_color(B_MENU_BACKGROUND_COLOR));
+      break;
+
+    case ColorID::Menutext:
+      aResult = ToNSColor(ui_color(B_MENU_ITEM_TEXT_COLOR));
+      break;
+
+    case ColorID::MozMenuhover:
+      aResult = ToNSColor(ui_color(B_MENU_SELECTED_BACKGROUND_COLOR));
+      break;
+
+    case ColorID::MozMenuhovertext:
+      aResult = ToNSColor(ui_color(B_MENU_SELECTED_ITEM_TEXT_COLOR));
+      break;
+
+    case ColorID::Linktext:
+      aResult = ToNSColor(ui_color(B_LINK_TEXT_COLOR));
+      break;
+
+    case ColorID::Visitedtext:
+      aResult = ToNSColor(ui_color(B_LINK_VISITED_COLOR));
+      break;
+
+    case ColorID::Activetext:
+      aResult = ToNSColor(ui_color(B_LINK_ACTIVE_COLOR));
+      break;
+
+    case ColorID::Infobackground:
+      aResult = ToNSColor(ui_color(B_TOOL_TIP_BACKGROUND_COLOR));
+      break;
+
+    case ColorID::Infotext:
+      aResult = ToNSColor(ui_color(B_TOOL_TIP_TEXT_COLOR));
+      break;
+
+    case ColorID::Scrollbar:
+    case ColorID::ThemedScrollbar: {
+      rgb_color track = panelBg;
+      track = tint_color(track, 1.08f);
+      aResult = ToNSColor(track);
+      break;
+    }
+
+    case ColorID::ThemedScrollbarThumb: {
+      rgb_color thumb = ui_color(B_SCROLL_BAR_THUMB_COLOR);
+      if (thumb.red == panelBg.red && thumb.green == panelBg.green && thumb.blue == panelBg.blue) {
+        thumb = tint_color(thumb, 0.96f);
+      }
+      aResult = ToNSColor(thumb);
+      break;
+    }
+
+    case ColorID::ThemedScrollbarThumbHover: {
+      rgb_color thumb = ui_color(B_SCROLL_BAR_THUMB_COLOR);
+      thumb = tint_color(thumb, B_LIGHTEN_1_TINT);
+      aResult = ToNSColor(thumb);
+      break;
+    }
+
+    case ColorID::ThemedScrollbarThumbActive: {
+      rgb_color thumb = ui_color(B_SCROLL_BAR_THUMB_COLOR);
+      thumb = tint_color(thumb, B_LIGHTEN_2_TINT);
+      aResult = ToNSColor(thumb);
+      break;
+    }
+
+    case ColorID::Buttonshadow:
+    case ColorID::Threedshadow:
+      aResult = ToNSColor(ui_color(B_SHADOW_COLOR));
+      break;
+
+    case ColorID::Buttonhighlight:
+    case ColorID::Threedhighlight:
+      aResult = ToNSColor(ui_color(B_SHINE_COLOR));
+      break;
+
+    default:
+      aResult = GetStandinForNativeColor(aID, aColorScheme);
+      break;
+  }
+
+  return NS_OK;
+}
+
+nsresult nsLookAndFeel::NativeGetInt(IntID aID, int32_t& aResult) {
+  EnsureInit();
+
+  switch (aID) {
+    case IntID::IMERawInputUnderlineStyle:
+    case IntID::IMEConvertedTextUnderlineStyle:
+      aResult = static_cast<int32_t>(StyleTextDecorationStyle::Solid);
+      break;
+    case IntID::IMESelectedRawTextUnderlineStyle:
+    case IntID::IMESelectedConvertedTextUnderline:
+      aResult = static_cast<int32_t>(StyleTextDecorationStyle::None);
+      break;
+    case IntID::SpellCheckerUnderlineStyle:
+      aResult = static_cast<int32_t>(StyleTextDecorationStyle::Wavy);
+      break;
+    case IntID::CaretBlinkTime:
+      aResult = 500;
+      break;
+    case IntID::CaretWidth:
+      aResult = 1;
+      break;
+    case IntID::SelectTextfieldsOnKeyFocus:
+      aResult = 1;
+      break;
+    case IntID::SubmenuDelay:
+      aResult = 200;
+      break;
+    case IntID::MenusCanOverlapOSBar:
+      aResult = 0;
+      break;
+    case IntID::SkipNavigatingDisabledMenuItem:
+      aResult = 1;
+      break;
+    case IntID::DragThresholdX:
+    case IntID::DragThresholdY:
+      aResult = 4;
+      break;
+
+    case IntID::ScrollArrowStyle: {
+      scroll_bar_info info;
+      if (get_scroll_bar_info(&info) == B_OK && info.double_arrows) {
+        aResult = eScrollArrowStyle_BothAtEachEnd;
+      } else {
+        aResult = eScrollArrowStyle_Single;
+      }
+      break;
+    }
+
+    case IntID::UseOverlayScrollbars:
+    case IntID::AllowOverlayScrollbarsOverlap:
+      aResult = 0;
+      break;
+    case IntID::ScrollbarDisplayOnMouseMove:
+      aResult = 0;
+      break;
+    case IntID::ScrollbarFadeBeginDelay:
+      aResult = 0;
+      break;
+    case IntID::ScrollbarFadeDuration:
+      aResult = 0;
+      break;
+    case IntID::TreeOpenDelay:
+      aResult = 1000;
+      break;
+    case IntID::TreeCloseDelay:
+      aResult = 1000;
+      break;
+    case IntID::TreeLazyScrollDelay:
+      aResult = 150;
+      break;
+    case IntID::TreeScrollDelay:
+      aResult = 100;
+      break;
+    case IntID::TreeScrollLinesMax:
+      aResult = 3;
+      break;
+    case IntID::ScrollToClick:
+      aResult = 0;
+      break;
+    case IntID::ChosenMenuItemsShouldBlink:
+      aResult = 1;
+      break;
+    case IntID::ContextMenuOffsetVertical:
+    case IntID::ContextMenuOffsetHorizontal:
+      aResult = 2;
+      break;
+    case IntID::SystemUsesDarkTheme: {
+      aResult = mSystemIsDark ? 1 : 0;
+      break;
+    }
+    case IntID::PrefersReducedMotion:
+      aResult = 0;
+      break;
+    case IntID::PrefersReducedTransparency:
+      aResult = 0;
+      break;
+    case IntID::InvertedColors:
+      aResult = 0;
+      break;
+    case IntID::TouchDeviceSupportPresent:
+      aResult = 0;
+      break;
+
+    case IntID::PrimaryPointerCapabilities:
+    case IntID::AllPointerCapabilities:
+      aResult = static_cast<int32_t>(PointerCapabilities::Fine |
+                                     PointerCapabilities::Hover);
+      break;
+
+    default:
+      aResult = 0;
+      return NS_ERROR_FAILURE;
+  }
+  return NS_OK;
+}
+
+nsresult nsLookAndFeel::NativeGetFloat(FloatID aID, float& aResult) {
+  EnsureInit();
+
+  switch (aID) {
+    case FloatID::IMEUnderlineRelativeSize:
+      aResult = 2.0f;
+      break;
+    case FloatID::SpellCheckerUnderlineRelativeSize:
+      aResult = 2.0f;
+      break;
+    default:
+      aResult = -1.0f;
+      return NS_ERROR_FAILURE;
+  }
+  return NS_OK;
+}
+
+void nsLookAndFeel::InitSystemFont(const char* aFamily, float aSize,
+                                   uint16_t aFace, SystemFontInfo& aInfo) {
+  if (!aFamily || aFamily[0] == '\0') {
+    aInfo.mName.AssignLiteral("sans-serif");
+  } else {
+    CopyUTF8toUTF16(Span(aFamily, strlen(aFamily)), aInfo.mName);
+  }
+
+  aInfo.mStyle.size = aSize > 0.0f ? aSize : 12.0f;
+  aInfo.mStyle.systemFont = true;
+
+  if (aFace & B_ITALIC_FACE) {
+    aInfo.mStyle.style = FontSlantStyle::ITALIC;
+  } else {
+    aInfo.mStyle.style = FontSlantStyle::NORMAL;
+  }
+
+  if (aFace & B_HEAVY_FACE) {
+    aInfo.mStyle.weight = FontWeight::FromFloat(800.0f);
+  } else if (aFace & B_BOLD_FACE) {
+    aInfo.mStyle.weight = FontWeight::BOLD;
+  } else if (aFace & B_LIGHT_FACE) {
+    aInfo.mStyle.weight = FontWeight::FromFloat(300.0f);
+  } else {
+    aInfo.mStyle.weight = FontWeight::NORMAL;
+  }
+
+  if (aFace & B_CONDENSED_FACE) {
+    aInfo.mStyle.width = FontWidth::CONDENSED;
+  } else {
+    aInfo.mStyle.width = FontWidth::NORMAL;
+  }
+}
+
+bool nsLookAndFeel::NativeGetFont(FontID aID, nsString& aFontName, gfxFontStyle& aFontStyle) {
+  EnsureInit();
+
+  if (!mInitialized) {
+    aFontStyle.style = FontSlantStyle::NORMAL;
+    aFontStyle.weight = FontWeight::NORMAL;
+    aFontStyle.width = FontWidth::NORMAL;
+    aFontStyle.size = 12.0f;
+    aFontStyle.systemFont = true;
+    aFontName.AssignLiteral("sans-serif");
+    return true;
+  }
+
+  switch (aID) {
+    case FontID::Menu:
+    case FontID::MozPullDownMenu:
+      aFontName = mMenuFont.mName;
+      aFontStyle = mMenuFont.mStyle;
+      break;
+
+    case FontID::Caption:
+    case FontID::SmallCaption:
+      aFontName = mBoldFont.mName;
+      aFontStyle = mBoldFont.mStyle;
+      break;
+
+    default:
+      aFontName = mPlainFont.mName;
+      aFontStyle = mPlainFont.mStyle;
+      break;
+  }
+
+  if (aFontName.IsEmpty()) {
+    aFontName.AssignLiteral("sans-serif");
+    aFontStyle.style = FontSlantStyle::NORMAL;
+    aFontStyle.weight = FontWeight::NORMAL;
+    aFontStyle.width = FontWidth::NORMAL;
+    aFontStyle.size = 12.0f;
+    aFontStyle.systemFont = true;
+  }
+
+  return true;
+}
+
+void nsLookAndFeel::EnsureInit() {
+  if (mInitialized) {
+    return;
+  }
+  mozilla::widget::EnsureHaikuApplication();
+  if (!be_app) {
+    return;
+  }
+  mInitialized = true;
+
+  rgb_color bg = ui_color(B_PANEL_BACKGROUND_COLOR);
+  mSystemIsDark = bg.IsDark();
+
+  if (be_plain_font) {
+    font_family plainFamily;
+    font_style plainStyle;
+    be_plain_font->GetFamilyAndStyle(&plainFamily, &plainStyle);
+    InitSystemFont(plainFamily, ConvertFontSize(be_plain_font->Size()),
+                   be_plain_font->Face(), mPlainFont);
+  }
+
+  if (be_bold_font) {
+    font_family boldFamily;
+    font_style boldStyle;
+    be_bold_font->GetFamilyAndStyle(&boldFamily, &boldStyle);
+    InitSystemFont(boldFamily, ConvertFontSize(be_bold_font->Size() * 0.96f),
+                   be_bold_font->Face(), mBoldFont);
+  }
+
+  menu_info menuInfo;
+  if (get_menu_info(&menuInfo) == B_OK) {
+    InitSystemFont(menuInfo.f_family, ConvertFontSize(menuInfo.font_size),
+                   0, mMenuFont);
+  } else if (be_plain_font) {
+    mMenuFont = mPlainFont;
+  }
+}
+
+void nsLookAndFeel::RefreshImpl() {
+  mInitialized = false;
+  nsXPLookAndFeel::RefreshImpl();
+}
diff --git a/widget/haiku/nsLookAndFeel.h b/widget/haiku/nsLookAndFeel.h
new file mode 100644
index 0000000000..4b0446e7e5
--- /dev/null
