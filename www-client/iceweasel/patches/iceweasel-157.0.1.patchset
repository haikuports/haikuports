+  BEntry entry(mPath.get());
+  if (!entry.Exists()) {
+    return NS_ERROR_FILE_NOT_FOUND;
+  }
+
+  entry_ref fileRef;
+  if (entry.GetRef(&fileRef) != B_OK) {
+    return NS_ERROR_FILE_NOT_FOUND;
+  }
+
+  BMessenger tracker("application/x-vnd.Be-TRAK");
+  if (!tracker.IsValid()) {
+    return NS_ERROR_FAILURE;
+  }
+
+  BMessage message(B_REFS_RECEIVED);
+  if (entry.IsDirectory()) {
+    message.AddRef("refs", &fileRef);
+  } else {
+    BEntry parentEntry;
+    if (entry.GetParent(&parentEntry) != B_OK) {
+      return NS_ERROR_FAILURE;
+    }
+    entry_ref parentRef;
+    if (parentEntry.GetRef(&parentRef) != B_OK) {
+      return NS_ERROR_FAILURE;
+    }
+
+    message.AddRef("refs", &parentRef);
+    message.AddRef("findRef", &fileRef);
+  }
+
+  if (tracker.SendMessage(&message) == B_OK) {
+    return NS_OK;
+  }
+  return NS_ERROR_FAILURE;
