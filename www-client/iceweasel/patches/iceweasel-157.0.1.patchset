diff --git a/toolkit/components/remote/nsHaikuRemoteServer.cpp b/toolkit/components/remote/nsHaikuRemoteServer.cpp
new file mode 100644
index 0000000000..dab213280b
--- /dev/null
+++ b/toolkit/components/remote/nsHaikuRemoteServer.cpp
@@ -0,0 +1,149 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsHaikuRemoteServer.h"
+#include "RemoteUtils.h"
+
+#include "nsCommandLine.h"
+#include "nsICommandLineRunner.h"
+#include "nsICommandLine.h"
+#include "nsCOMPtr.h"
+#include "nsThreadUtils.h"
+#include "nsIFile.h"
+#include "nsNetUtil.h"
+#include "nsIWindowWatcher.h"
+#include "nsPIDOMWindow.h"
+#include "nsServiceManagerUtils.h"
+
+#include <cstring>
+#include <utility>
+#include <vector>
+
+nsHaikuRemoteServer::nsHaikuRemoteServer()
+    : fRunning(false), fPort(B_BAD_PORT_ID) {}
+
+nsHaikuRemoteServer::~nsHaikuRemoteServer() {
+  Shutdown();
+}
+
+nsresult nsHaikuRemoteServer::Startup(const char* aAppName, const char* aProfileName) {
+  nsString className;
+  BuildClassName(aAppName, aProfileName, className);
+  BString portName;
+  portName.SetTo(NS_ConvertUTF16toUTF8(className.get()).get());
+
+  if (portName.Length() >= B_OS_NAME_LENGTH) {
+    portName.Truncate(B_OS_NAME_LENGTH - 1);
+  }
+
+  fPort = create_port(10, portName.String());
+  if (fPort < 0) {
+    return NS_ERROR_FAILURE;
+  }
+
+  fRunning = true;
+  fListenerThread = std::thread([this]() { ListenLoop(); });
+
+  return NS_OK;
+}
+
+void nsHaikuRemoteServer::Shutdown() {
+  fRunning = false;
+  if (fPort >= 0) {
+    port_id port = fPort;
+    fPort = B_BAD_PORT_ID;
+    delete_port(port);
+  }
+  if (fListenerThread.joinable()) {
+    fListenerThread.join();
+  }
+}
+
+void nsHaikuRemoteServer::ListenLoop() {
+  char buffer[8192];
+  int32 code = 0;
+
+  while (fRunning) {
+    ssize_t len = read_port(fPort, &code, buffer, sizeof(buffer));
+    if (len >= B_OK) {
+      std::vector<char> data(buffer, buffer + len);
+      NS_DispatchToMainThread(NS_NewRunnableFunction(
+          "nsHaikuRemoteServer::HandleMessage",
+          [this, d = std::move(data)]() mutable {
+            this->HandleMessageOnMainThread(std::move(d));
+          }));
+    } else if (len == B_INTERRUPTED) {
+      continue;
+    } else {
+      break;
+    }
+  }
+}
+
+void nsHaikuRemoteServer::HandleMessageOnMainThread(std::vector<char> aData) {
+  if (aData.empty()) {
+    return;
+  }
+
+  bool activate = (aData[0] == '1');
+
+  size_t offset = 1;
+  nsCOMPtr<nsIFile> workingDir;
+
+  if (offset < aData.size()) {
+    const char* cwdStr = aData.data() + offset;
+    size_t cwdLen = strnlen(cwdStr, aData.size() - offset);
+    if (cwdLen > 0) {
+      NS_NewNativeLocalFile(nsDependentCString(cwdStr, cwdLen), getter_AddRefs(workingDir));
+    }
+    offset += cwdLen + 1;
+  }
+
+  std::vector<const char*> argv;
+  while (offset < aData.size()) {
+    const char* str = aData.data() + offset;
+    size_t strLen = strnlen(str, aData.size() - offset);
+    if (strLen > 0) {
+      argv.push_back(str);
+    }
+    offset += strLen + 1;
+  }
+
+  auto raiseWindow = [activate]() {
+    if (!activate) {
+      return;
+    }
+
+    team_info teamInfo;
+    if (get_team_info(B_CURRENT_TEAM, &teamInfo) == B_OK) {
+      be_roster->ActivateApp(teamInfo.team);
+    }
+
+    nsCOMPtr<nsIWindowWatcher> ww = do_GetService(NS_WINDOWWATCHER_CONTRACTID);
+    if (ww) {
+      nsCOMPtr<mozIDOMWindowProxy> activeWin;
+      ww->GetActiveWindow(getter_AddRefs(activeWin));
+      if (activeWin) {
+        nsCOMPtr<nsPIDOMWindowOuter> pwin = nsPIDOMWindowOuter::From(activeWin);
+        if (pwin) {
+          pwin->Focus(mozilla::dom::CallerType::System);
+        }
+      }
+    }
+  };
+
+  if (argv.empty()) {
+    raiseWindow();
+    return;
+  }
+
+  nsCOMPtr<nsICommandLineRunner> cmdLine(new nsCommandLine());
+  nsresult rv = cmdLine->Init(argv.size(), argv.data(), workingDir,
+                              nsICommandLine::STATE_REMOTE_AUTO);
+
+  if (NS_SUCCEEDED(rv)) {
+    cmdLine->Run();
+    raiseWindow();
+  }
+}
