diff --git a/gfx/gl/GLContextProviderBGL.cpp b/gfx/gl/GLContextProviderBGL.cpp
new file mode 100644
index 0000000000..f8f3c5fd21
--- /dev/null
+++ b/gfx/gl/GLContextProviderBGL.cpp
@@ -0,0 +1,235 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "GLContextBGL.h"
+#include "GLContextProvider.h"
+#include "GLLibraryLoader.h"
+#include "nsDebug.h"
+#include "prlink.h"
+#include "nsIWidget.h"
+#include "mozilla/widget/CompositorWidget.h"
+
+#include <cstdio>
+
+#pragma GCC visibility push(default)
+#include <Screen.h>
+#include <Autolock.h>
+#include <Locker.h>
+#include <algorithm>
+#pragma GCC visibility pop
+
+namespace mozilla::widget {
+void UpdateHaikuGfxInfo(const nsACString& aVendor,
+                        const nsACString& aRenderer,
+                        const nsACString& aVersion);
+}
+
+namespace mozilla::gl {
+
+static PRLibrary* sGLLibrary = nullptr;
+static BLocker sBGLGlobalLock("Gecko BGL Lock");
+static thread_local const GLContextBGL* sCurrentThreadBGLContext = nullptr;
+static BGLView* sDisplayKeeper = nullptr;
+
+BGLView* EnsureBGLDisplayKeeper() {
+  BAutolock lock(sBGLGlobalLock);
+  if (!sDisplayKeeper) {
+    if (!sGLLibrary) {
+      sGLLibrary = PR_LoadLibrary("libGL.so");
+    }
+    ulong options = BGL_RGB | BGL_ALPHA | BGL_DEPTH | BGL_DOUBLE;
+    sDisplayKeeper = new BGLView(BRect(0, 0, 1, 1), "GeckoBGLDisplayKeeper",
+                                 B_FOLLOW_NONE, B_WILL_DRAW, options);
+  }
+  return sDisplayKeeper;
+}
+
+static PRFuncPtr GLAPIENTRY BGLGetProcAddress(const char* const aProcName) {
+  if (GLContext::sCurrentContext.init()) {
+    const auto* current = GLContext::sCurrentContext.get();
+    if (current && current->GetContextType() == GLContextType::BGL) {
+      const auto* bgl = static_cast<const GLContextBGL*>(current);
+      BGLView* view = bgl->GetGLView();
+      if (view) {
+        void* proc = view->GetGLProcAddress(aProcName);
+        if (proc) {
+          return reinterpret_cast<PRFuncPtr>(proc);
+        }
+      }
+    }
+  }
+
+  if (sGLLibrary) {
+    return PR_FindFunctionSymbol(sGLLibrary, aProcName);
+  }
+
+  return nullptr;
+}
+
+GLContextBGL::GLContextBGL(const GLContextDesc& aDesc, RefPtr<BGLViewHandle> aHandle)
+    : GLContext(aDesc, nullptr, true),
+      mHandle(std::move(aHandle)) {}
+
+GLContextBGL::~GLContextBGL() {
+  MarkDestroyed();
+
+  if (mHandle) {
+    MutexAutoLock lock(mHandle->mLock);
+    if (mHandle->mView) {
+      if (mIsLocked) {
+        mHandle->mView->UnlockGL();
+        mIsLocked = false;
+        if (sCurrentThreadBGLContext == this) {
+          sCurrentThreadBGLContext = nullptr;
+        }
+      }
+      delete mHandle->mView;
+      mHandle->mView = nullptr;
+    }
+  }
+}
+
+bool GLContextBGL::MakeCurrentImpl() const {
+  if (!mHandle) {
+    return false;
+  }
+
+  if (sCurrentThreadBGLContext == this && mIsLocked) {
+    return true;
+  }
+
+  if (sCurrentThreadBGLContext && sCurrentThreadBGLContext != this) {
+    const GLContextBGL* prev = sCurrentThreadBGLContext;
+    sCurrentThreadBGLContext = nullptr;
+
+    if (prev->mHandle) {
+      MutexAutoLock prevLock(prev->mHandle->mLock);
+      if (prev->mHandle->mView && prev->mIsLocked) {
+        prev->mHandle->mView->UnlockGL();
+        prev->mIsLocked = false;
+      }
+    }
+  }
+
+  MutexAutoLock lock(mHandle->mLock);
+  if (!mHandle->mView) {
+    return false;
+  }
+
+  GLContext::ResetTLSCurrentContext();
+
+  mHandle->mView->LockGL();
+  mIsLocked = true;
+  sCurrentThreadBGLContext = this;
+
+  return true;
+}
+
+bool GLContextBGL::IsCurrentImpl() const {
+  return mIsLocked;
+}
+
+bool GLContextBGL::SwapBuffers() {
+  if (!mHandle) {
+    return false;
+  }
+
+  MutexAutoLock lock(mHandle->mLock);
+  if (mHandle->mView && mIsLocked) {
+    mHandle->mView->SwapBuffers();
+    mHandle->mView->UnlockGL();
+    mIsLocked = false;
+    if (sCurrentThreadBGLContext == this) {
+      sCurrentThreadBGLContext = nullptr;
+    }
+    GLContext::ResetTLSCurrentContext();
+    return true;
+  }
+  return false;
+}
+
+void GLContextBGL::GetWSIInfo(nsCString* const aOut) const {
+  aOut->AppendLiteral("Haiku BGLView");
+}
+
+Maybe<SymbolLoader> GLContextBGL::GetSymbolLoader() const {
+  return Some(SymbolLoader(&BGLGetProcAddress));
+}
+
+already_AddRefed<GLContext> GLContextProviderBGL::CreateHeadless(
+    const GLContextCreateDesc& aDesc, nsACString* const aOutFailureId) {
+  BAutolock lock(sBGLGlobalLock);
+
+  EnsureBGLDisplayKeeper();
+
+  if (!sGLLibrary) {
+    sGLLibrary = PR_LoadLibrary("libGL.so");
+    if (!sGLLibrary) {
+      NS_WARNING("Failed to load libGL.so on Haiku!");
+      *aOutFailureId = "FEATURE_FAILURE_LIBGL_LOAD"_ns;
+      return nullptr;
+    }
+  }
+
+  ulong options = BGL_RGB | BGL_ALPHA | BGL_DEPTH | BGL_DOUBLE;
+
+  BScreen screen(B_MAIN_SCREEN_ID);
+  BRect frame = screen.IsValid() ? screen.Frame() : BRect(0, 0, 1023, 767);
+  int32 width = std::max(512, static_cast<int32>(frame.Width() + 1));
+  int32 height = std::max(512, static_cast<int32>(frame.Height() + 1));
+
+  BRect bounds(0, 0, width - 1, height - 1);
+  auto* glView = new BGLView(bounds, "GeckoWebGLOffscreen", B_FOLLOW_NONE,
+                             B_WILL_DRAW, options);
+  if (!glView) {
+    *aOutFailureId = "FEATURE_FAILURE_BGLVIEW_CREATE"_ns;
+    return nullptr;
+  }
+
+  auto fullDesc = GLContextDesc{aDesc};
+  fullDesc.isOffscreen = true;
+
+  auto handle = MakeRefPtr<BGLViewHandle>(glView);
+  RefPtr<GLContextBGL> gl = new GLContextBGL(fullDesc, handle);
+  if (!gl->Init()) {
+    NS_WARNING("GLContextBGL::Init failed!");
+    *aOutFailureId = "FEATURE_FAILURE_BGL_INIT"_ns;
+    return nullptr;
+  }
+
+  static bool sGfxInfoQueried = false;
+  if (!sGfxInfoQueried) {
+    sGfxInfoQueried = true;
+    const char* vendor = reinterpret_cast<const char*>(gl->fGetString(LOCAL_GL_VENDOR));
+    const char* renderer = reinterpret_cast<const char*>(gl->fGetString(LOCAL_GL_RENDERER));
+    const char* version = reinterpret_cast<const char*>(gl->fGetString(LOCAL_GL_VERSION));
+    nsAutoCString vendorStr(vendor ? vendor : "");
+    nsAutoCString rendererStr(renderer ? renderer : "");
+    nsAutoCString versionStr(version ? version : "");
+    mozilla::widget::UpdateHaikuGfxInfo(vendorStr, rendererStr, versionStr);
+  }
+
+  return gl.forget();
+}
+
+already_AddRefed<GLContext> GLContextProviderBGL::CreateForCompositorWidget(
+    mozilla::widget::CompositorWidget* aCompositorWidget,
+    bool aHardwareWebRender, bool aForceAccelerated) {
+  return nullptr;
+}
+
+GLContext* GLContextProviderBGL::GetGlobalContext() {
+  return nullptr;
+}
+
+void GLContextProviderBGL::Shutdown() {
+  BAutolock lock(sBGLGlobalLock);
+  if (sDisplayKeeper) {
+    delete sDisplayKeeper;
+    sDisplayKeeper = nullptr;
+  }
+  sGLLibrary = nullptr;
+}
+
+}
