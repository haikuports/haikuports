@@ -2825,6 +2839,72 @@ gfxPlatformFontList::PrefFontList* gfxFcPlatformFontList::FindGenericFamilies(
         if (!entry) {
           // if not found, ask fontconfig to pick the appropriate font
           RefPtr<FcPattern> genericPattern = dont_AddRef(FcPatternCreate());
+#ifdef MOZ_WIDGET_HAIKU
+          if (be_app) {
+            if (aGeneric.EqualsLiteral("sans-serif") ||
+                aGeneric.EqualsLiteral("-moz-default")) {
+              if (be_plain_font) {
+                font_family plainFamily;
+                font_style plainStyle;
+                be_plain_font->GetFamilyAndStyle(&plainFamily, &plainStyle);
+                FcPatternAddString(genericPattern, FC_FAMILY,
+                                   ToFcChar8Ptr(plainFamily));
+              }
+            } else if (aGeneric.EqualsLiteral("monospace")) {
+              if (be_fixed_font) {
+                font_family fixedFamily;
+                font_style fixedStyle;
+                be_fixed_font->GetFamilyAndStyle(&fixedFamily, &fixedStyle);
+                FcPatternAddString(genericPattern, FC_FAMILY,
+                                   ToFcChar8Ptr(fixedFamily));
+              }
+            } else if (aGeneric.EqualsLiteral("serif")) {
+              static const char* const kKnownSerifFonts[] = {
+                  "Noto Serif",
+                  "DejaVu Serif",
+                  "Liberation Serif",
+                  "Droid Serif",
+              };
+
+              nsAutoCString primarySerif;
+              if (be_plain_font) {
+                font_family plainFamily;
+                font_style plainStyle;
+                be_plain_font->GetFamilyAndStyle(&plainFamily, &plainStyle);
+
+                nsDependentCString familyStr(plainFamily);
+                int32_t spaceIdx = familyStr.FindChar(' ');
+                uint32_t prefixLen =
+                    spaceIdx != -1 ? uint32_t(spaceIdx) : familyStr.Length();
+                const nsDependentCSubstring prefix =
+                    Substring(familyStr, 0, prefixLen);
+
+                if (!prefix.IsEmpty()) {
+                  for (const auto* serifFont : kKnownSerifFonts) {
+                    if (StringBeginsWith(nsDependentCString(serifFont), prefix)) {
+                      primarySerif.Assign(serifFont);
+                      break;
+                    }
+                  }
+                }
+              }
+
+              if (primarySerif.IsEmpty()) {
+                primarySerif.Assign(kKnownSerifFonts[0]);
+              }
+
+              FcPatternAddString(genericPattern, FC_FAMILY,
+                                 ToFcChar8Ptr(primarySerif.get()));
+
+              for (const auto* serifFont : kKnownSerifFonts) {
+                if (!primarySerif.Equals(serifFont)) {
+                  FcPatternAddString(genericPattern, FC_FAMILY,
+                                     ToFcChar8Ptr(serifFont));
+                }
+              }
+            }
+          }
+#endif
           FcPatternAddString(genericPattern, FC_FAMILY,
                              ToFcChar8Ptr(aGeneric.get()));
 
@@ -3221,7 +3301,9 @@ bool gfxFcPlatformFontList::UpdateSystemFontOptions() {
       gdk_screen_get_font_options(gdk_screen_get_default());
   if (!options) {
     bool changed = !!mSystemFontOptions;
+#ifdef MOZ_WIDGET_GTK
     ClearSystemFontOptions();
+#endif
     return changed;
   }
 
