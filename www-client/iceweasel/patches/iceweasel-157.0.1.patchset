+#endif  // mozilla_widget_HaikuWindowBuffer_h
diff --git a/widget/haiku/NativeKeyBindings.cpp b/widget/haiku/NativeKeyBindings.cpp
new file mode 100644
index 0000000000..112e5004ca
--- /dev/null
+++ b/widget/haiku/NativeKeyBindings.cpp
@@ -0,0 +1,198 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "NativeKeyBindings.h"
+
+#include "mozilla/NativeKeyBindingsType.h"
+#include "mozilla/TextEvents.h"
+#include "mozilla/WritingModes.h"
+
+namespace mozilla::widget {
+
+NativeKeyBindings* NativeKeyBindings::sInstanceForSingleLineEditor = nullptr;
+NativeKeyBindings* NativeKeyBindings::sInstanceForMultiLineEditor = nullptr;
+
+NativeKeyBindings* NativeKeyBindings::GetInstance(NativeKeyBindingsType aType) {
+  switch (aType) {
+    case NativeKeyBindingsType::SingleLineEditor:
+      if (!sInstanceForSingleLineEditor) {
+        sInstanceForSingleLineEditor = new NativeKeyBindings();
+        sInstanceForSingleLineEditor->mType = aType;
+      }
+      return sInstanceForSingleLineEditor;
+
+    default:
+    case NativeKeyBindingsType::MultiLineEditor:
+    case NativeKeyBindingsType::RichTextEditor:
+      if (!sInstanceForMultiLineEditor) {
+        sInstanceForMultiLineEditor = new NativeKeyBindings();
+        sInstanceForMultiLineEditor->mType = aType;
+      }
+      return sInstanceForMultiLineEditor;
+  }
+}
+
+void NativeKeyBindings::Shutdown() {
+  delete sInstanceForSingleLineEditor;
+  sInstanceForSingleLineEditor = nullptr;
+  delete sInstanceForMultiLineEditor;
+  sInstanceForMultiLineEditor = nullptr;
+}
+
+void NativeKeyBindings::GetEditCommands(const WidgetKeyboardEvent& aEvent,
+                                        const Maybe<WritingMode>& aWritingMode,
+                                        nsTArray<CommandInt>& aCommands) {
+  MOZ_ASSERT(aCommands.IsEmpty());
+
+  if (aEvent.IsAlt() || aEvent.IsMeta()) {
+    return;
+  }
+
+  Command command = Command::DoNothing;
+  const KeyNameIndex remappedKeyNameIndex =
+      aWritingMode.isSome() ? aEvent.GetRemappedKeyNameIndex(aWritingMode.ref())
+                            : aEvent.mKeyNameIndex;
+
+  const bool extendSelection = aEvent.IsShift();
+
+  switch (remappedKeyNameIndex) {
+    case KEY_NAME_INDEX_USE_STRING:
+      switch (aEvent.PseudoCharCode()) {
+        case 'a':
+        case 'A':
+          if (aEvent.IsControl()) {
+            command = Command::SelectAll;
+          }
+          break;
+        case 'c':
+        case 'C':
+          if (aEvent.IsControl() && !extendSelection) {
+            command = Command::Copy;
+          }
+          break;
+        case 'v':
+        case 'V':
+          if (aEvent.IsControl() && !extendSelection) {
+            command = Command::Paste;
+          }
+          break;
+        case 'x':
+        case 'X':
+          if (aEvent.IsControl() && !extendSelection) {
+            command = Command::Cut;
+          }
+          break;
+        case 'z':
+        case 'Z':
+          if (aEvent.IsControl()) {
+            command = extendSelection ? Command::HistoryRedo : Command::HistoryUndo;
+          }
+          break;
+        case 'y':
+        case 'Y':
+          if (aEvent.IsControl()) {
+            command = Command::HistoryRedo;
+          }
+          break;
+        default:
+          break;
+      }
+      break;
+
+    case KEY_NAME_INDEX_Insert:
+      if (aEvent.IsControl() && !extendSelection) {
+        command = Command::Copy;
+      } else if (extendSelection && !aEvent.IsControl()) {
+        command = Command::Paste;
+      }
+      break;
+
+    case KEY_NAME_INDEX_Delete:
+      if (extendSelection && !aEvent.IsControl()) {
+        command = Command::Cut;
+      } else if (aEvent.IsControl()) {
+        command = Command::DeleteWordForward;
+      } else {
+        command = Command::DeleteCharForward;
+      }
+      break;
+
+    case KEY_NAME_INDEX_Backspace:
+      if (aEvent.IsControl()) {
+        command = Command::DeleteWordBackward;
+      } else {
+        command = Command::DeleteCharBackward;
+      }
+      break;
+
+    case KEY_NAME_INDEX_ArrowLeft:
+      if (aEvent.IsControl()) {
+        command = extendSelection ? Command::SelectWordPrevious : Command::WordPrevious;
+      } else {
+        command = extendSelection ? Command::SelectCharPrevious : Command::CharPrevious;
+      }
+      break;
+
+    case KEY_NAME_INDEX_ArrowRight:
+      if (aEvent.IsControl()) {
+        command = extendSelection ? Command::SelectWordNext : Command::WordNext;
+      } else {
+        command = extendSelection ? Command::SelectCharNext : Command::CharNext;
+      }
+      break;
+
+    case KEY_NAME_INDEX_ArrowUp:
+      if (mType == NativeKeyBindingsType::SingleLineEditor) {
+        command = extendSelection ? Command::SelectBeginLine : Command::BeginLine;
+      } else {
+        command = extendSelection ? Command::SelectLinePrevious : Command::LinePrevious;
+      }
+      break;
+
+    case KEY_NAME_INDEX_ArrowDown:
+      if (mType == NativeKeyBindingsType::SingleLineEditor) {
+        command = extendSelection ? Command::SelectEndLine : Command::EndLine;
+      } else {
+        command = extendSelection ? Command::SelectLineNext : Command::LineNext;
+      }
+      break;
+
+    case KEY_NAME_INDEX_Home:
+      if (aEvent.IsControl()) {
+        command = extendSelection ? Command::SelectTop : Command::MoveTop;
+      } else {
+        command = extendSelection ? Command::SelectBeginLine : Command::BeginLine;
+      }
+      break;
+
+    case KEY_NAME_INDEX_End:
+      if (aEvent.IsControl()) {
+        command = extendSelection ? Command::SelectBottom : Command::MoveBottom;
+      } else {
+        command = extendSelection ? Command::SelectEndLine : Command::EndLine;
+      }
+      break;
+
+    case KEY_NAME_INDEX_PageUp:
+      if (mType != NativeKeyBindingsType::SingleLineEditor) {
+        command = extendSelection ? Command::SelectPageUp : Command::MovePageUp;
+      }
+      break;
+
+    case KEY_NAME_INDEX_PageDown:
+      if (mType != NativeKeyBindingsType::SingleLineEditor) {
+        command = extendSelection ? Command::SelectPageDown : Command::MovePageDown;
+      }
+      break;
+
+    default:
+      break;
+  }
+
+  if (command != Command::DoNothing) {
+    aCommands.AppendElement(static_cast<CommandInt>(command));
+  }
+}
+
+}  // namespace mozilla::widget
