index 0000000000..1c7499f6a8
--- /dev/null
+++ b/widget/haiku/HaikuView.cpp
@@ -0,0 +1,584 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "HaikuView.h"
+#include "HaikuUtils.h"
+#include "HaikuKeyboard.h"
+#include "nsWindow.h"
+#include "nsAppShell.h"
+#include "nsDragService.h"
+#include "mozilla/UniquePtr.h"
+
+#include <cmath>
+#include <cctype>
+#include <cstdio>
+#include <cstring>
+
+static status_t CopyFileAndAttributes(const char* aSrcPath, BDirectory* aDstDir,
+                                      const char* aDstName) {
+  BEntry srcEntry(aSrcPath, true);
+  if (!srcEntry.Exists()) {
+    return B_ENTRY_NOT_FOUND;
+  }
+
+  BEntry dstEntry(aDstDir, aDstName, true);
+  if (srcEntry == dstEntry) {
+    return B_OK;
+  }
+
+  BFile src(&srcEntry, B_READ_ONLY);
+  if (src.InitCheck() != B_OK) {
+    return src.InitCheck();
+  }
+
+  BFile dst(aDstDir, aDstName, B_READ_WRITE | B_CREATE_FILE | B_ERASE_FILE);
+  if (dst.InitCheck() != B_OK) {
+    return dst.InitCheck();
+  }
+
+  char buffer[65536];
+  ssize_t bytesRead;
+  while ((bytesRead = src.Read(buffer, sizeof(buffer))) > 0) {
+    dst.Write(buffer, bytesRead);
+  }
+
+  char attrName[B_ATTR_NAME_LENGTH];
+  src.RewindAttrs();
+  while (src.GetNextAttrName(attrName) == B_OK) {
+    attr_info info;
+    if (src.GetAttrInfo(attrName, &info) == B_OK && info.size > 0) {
+      auto attrData = mozilla::MakeUnique<char[]>(info.size);
+      if (attrData) {
+        if (src.ReadAttr(attrName, info.type, 0, attrData.get(), info.size) == info.size) {
+          dst.WriteAttr(attrName, info.type, 0, attrData.get(), info.size);
+        }
+      }
+    }
+  }
+  return B_OK;
+}
+
+HaikuWindow::HaikuWindow(BRect aFrame, const char* aTitle, window_look aLook,
+                         window_feel aFeel, uint32 aFlags, nsWindow* aGeckoWindow)
+    : BWindow(aFrame, aTitle, aLook, aFeel, aFlags),
+      mGeckoWindow(aGeckoWindow) {
+  RemoveShortcut('W', B_COMMAND_KEY);
+  RemoveShortcut('Q', B_COMMAND_KEY);
+  RemoveShortcut('X', B_COMMAND_KEY);
+  RemoveShortcut('C', B_COMMAND_KEY);
+  RemoveShortcut('V', B_COMMAND_KEY);
+  RemoveShortcut('A', B_COMMAND_KEY);
+
+  RemoveShortcut('M', B_COMMAND_KEY | B_CONTROL_KEY);
+  RemoveShortcut('Z', B_COMMAND_KEY | B_CONTROL_KEY);
+  RemoveShortcut('Z', B_SHIFT_KEY | B_COMMAND_KEY | B_CONTROL_KEY);
+  RemoveShortcut('H', B_COMMAND_KEY | B_CONTROL_KEY);
+  RemoveShortcut('F', B_COMMAND_KEY | B_CONTROL_KEY);
+  RemoveShortcut('B', B_COMMAND_KEY | B_CONTROL_KEY);
+}
+
+void HaikuWindow::DispatchMessage(BMessage* aMessage, BHandler* aHandler) {
+  switch (aMessage->what) {
+    case B_UNMAPPED_KEY_DOWN:
+    case B_UNMAPPED_KEY_UP:
+    case B_KEY_DOWN:
+    case B_KEY_UP: {
+      int32 key = 0;
+      aMessage->FindInt32("key", &key);
+      if (key == 0x0e) {
+        break;
+      }
+
+      if (mGeckoWindow) {
+        int32 rawChar = 0;
+        int32 modifiers = 0;
+        const char* bytes = nullptr;
+
+        if (aMessage->FindInt32("modifiers", &modifiers) != B_OK) {
+          modifiers = ::modifiers();
+        }
+        aMessage->FindInt32("raw_char", &rawChar);
+        aMessage->FindString("bytes", &bytes);
+
+        bool isDown = (aMessage->what == B_KEY_DOWN ||
+                       aMessage->what == B_UNMAPPED_KEY_DOWN);
+
+        mGeckoWindow->OnHaikuKeyEvent(isDown, key, rawChar, modifiers,
+                                     bytes ? bytes : "",
+                                     bytes ? strlen(bytes) : 0);
+      }
+      break;
+    }
+    default:
+      break;
+  }
+  BWindow::DispatchMessage(aMessage, aHandler);
+}
+
+bool HaikuWindow::QuitRequested() {
+  if (mGeckoWindow) {
+    mGeckoWindow->OnHaikuQuitRequested();
+    return false;
+  }
+  return true;
+}
+
+void HaikuWindow::WindowActivated(bool aActive) {
+  if (mGeckoWindow) {
+    mGeckoWindow->OnHaikuWindowActivated(aActive);
+  }
+  BWindow::WindowActivated(aActive);
+}
+
+void HaikuWindow::FrameMoved(BPoint aNewPosition) {
+  BWindow::FrameMoved(aNewPosition);
+  if (mGeckoWindow) {
+    mGeckoWindow->OnHaikuFrameMoved(int32_t(aNewPosition.x), int32_t(aNewPosition.y));
+  }
+}
+
+void HaikuWindow::Zoom(BPoint aOrigin, float aWidth, float aHeight) {
+  BRect before = Frame();
+  BWindow::Zoom(aOrigin, aWidth, aHeight);
+  BRect after = Frame();
+  if (mGeckoWindow) {
+    bool isZoomed = (after.Width() * after.Height()) > (before.Width() * before.Height());
+    mGeckoWindow->OnHaikuZoom(isZoomed);
+  }
+}
+
+void HaikuWindow::Minimize(bool aMinimize) {
+  BWindow::Minimize(aMinimize);
+  if (mGeckoWindow) {
+    mGeckoWindow->OnHaikuMinimize(aMinimize);
+  }
+}
+
+void HaikuWindow::MessageReceived(BMessage* aMessage) {
+  switch (aMessage->what) {
+    case kMsgGeckoInvalidate: {
+      BRect r;
+      if (aMessage->FindRect("rect", &r) == B_OK && r.IsValid()) {
+        BView* view = FindView("GeckoRootView");
+        if (view && mGeckoWindow) {
+          mGeckoWindow->DrawToHaikuView(view, r);
+          view->Sync();
+        }
+      }
+      break;
+    }
+    default:
+      BWindow::MessageReceived(aMessage);
+      break;
+  }
+}
+
+HaikuView::HaikuView(BRect aFrame, nsWindow* aGeckoWindow)
+    : BView(aFrame, "GeckoRootView", B_FOLLOW_ALL,
+            B_WILL_DRAW | B_FRAME_EVENTS | B_NAVIGABLE | B_INPUT_METHOD_AWARE),
+      mGeckoWindow(aGeckoWindow),
+      mLastButtons(0) {
+  SetViewColor(B_TRANSPARENT_COLOR);
+}
+
+void HaikuView::AttachedToWindow() {
+  if (mGeckoWindow && !mGeckoWindow->IsPopup()) {
+    MakeFocus(true);
+  }
+  BView::AttachedToWindow();
+
+  if (mGeckoWindow && !mGeckoWindow->IsPopup()) {
+    BRect b = Bounds();
+    mGeckoWindow->OnHaikuFrameResized(int32_t(b.Width()) + 1, int32_t(b.Height()) + 1);
+  }
+}
+
+void HaikuView::Draw(BRect aUpdateRect) {
+  if (!mGeckoWindow) {
+    return;
+  }
+  mGeckoWindow->DrawToHaikuView(this, aUpdateRect);
+}
+
+void HaikuView::FrameResized(float aNewWidth, float aNewHeight) {
+  if (mGeckoWindow && !mGeckoWindow->IsPopup()) {
+    mGeckoWindow->OnHaikuFrameResized(int32_t(aNewWidth) + 1, int32_t(aNewHeight) + 1);
+  }
+}
+
+void HaikuView::GetCurrentMouseState(int32_t& aButtons, int32_t& aModifiers) {
+  aButtons = 0;
+  aModifiers = 0;
+  if (Window() && Window()->CurrentMessage()) {
+    Window()->CurrentMessage()->FindInt32("buttons", &aButtons);
+    if (Window()->CurrentMessage()->FindInt32("modifiers", &aModifiers) != B_OK) {
+      aModifiers = ::modifiers();
+    }
+  } else {
+    aModifiers = ::modifiers();
+  }
+}
+
+void HaikuView::LockPointer() {
+  if (mPointerLocked) {
+    return;
+  }
+  mPointerLocked = true;
+
+  SetMouseEventMask(B_POINTER_EVENTS | B_NO_POINTER_HISTORY, B_LOCK_WINDOW_FOCUS);
+
+  uint32 btns = 0;
+  GetMouse(&mPointerLockPos, &btns, false);
+
+  BRect bounds = Bounds();
+  mPointerLockCenter = BPoint(std::floor(bounds.Width() / 2.0f),
+                              std::floor(bounds.Height() / 2.0f));
+
+  BPoint screenCenter = mPointerLockCenter;
+  ConvertToScreen(&screenCenter);
+  set_mouse_position(int32(std::round(screenCenter.x)),
+                     int32(std::round(screenCenter.y)));
+
+  if (!be_app->IsCursorHidden()) {
+    be_app->HideCursor();
+  }
+}
+
+void HaikuView::UnlockPointer() {
+  if (!mPointerLocked) {
+    return;
+  }
+  mPointerLocked = false;
+
+  SetMouseEventMask(0, 0);
+
+  if (be_app->IsCursorHidden()) {
+    be_app->ShowCursor();
+  }
+}
+
+void HaikuView::MessageReceived(BMessage* aMessage) {
+  if (aMessage->what == B_INPUT_METHOD_EVENT && mGeckoWindow) {
+    mGeckoWindow->OnHaikuInputMethodEvent(aMessage);
+    return;
+  }
+
+  if (aMessage->WasDropped() && mGeckoWindow) {
+    mIsDragOver = false;
+
+    nsDragService* dragService = nsDragService::GetInstance();
+    if (dragService) {
+      nsCOMPtr<nsIDragSession> session;
+      dragService->GetCurrentSession(nullptr, getter_AddRefs(session));
+      if (session) {
+        static_cast<nsDragSession*>(session.get())->SetOverGeckoWindow(true);
+      }
+    }
+
+    int32_t modifiers = 0;
+    if (aMessage->FindInt32("modifiers", &modifiers) != B_OK) {
+      modifiers = ::modifiers();
+    }
+
+    BPoint dropPoint = aMessage->DropPoint();
+    ConvertFromScreen(&dropPoint);
+    mGeckoWindow->OnHaikuDrop(dropPoint.x, dropPoint.y, aMessage, modifiers);
+    return;
+  }
+
+  switch (aMessage->what) {
+    case B_COPY_TARGET: {
+      entry_ref dirRef;
+      const char* name = nullptr;
+      if (aMessage->FindRef("directory", &dirRef) == B_OK &&
+          aMessage->FindString("name", &name) == B_OK && name) {
+        BDirectory dir(&dirRef);
+
+        BString srcFilePath;
+        BString url;
+        BString title;
+
+        nsDragService* dragService = nsDragService::GetInstance();
+        if (dragService) {
+          nsCOMPtr<nsIDragSession> session;
+          dragService->GetCurrentSession(nullptr, getter_AddRefs(session));
+          if (session) {
+            auto* haikuSession = static_cast<nsDragSession*>(session.get());
+            haikuSession->GetLastDragFilePath(srcFilePath);
+            haikuSession->GetLastDragBookmarkInfo(url, title);
+          }
+        }
+
+        if (srcFilePath.IsEmpty()) {
+          BMessage orig;
+          if (aMessage->FindMessage("be:originator-data", &orig) == B_OK) {
+            orig.FindString("file_path", &srcFilePath);
+            if (srcFilePath.IsEmpty()) {
+              entry_ref fileRef;
+              if (orig.FindRef("refs", &fileRef) == B_OK) {
+                BPath p(&fileRef);
+                if (p.InitCheck() == B_OK) {
+                  srcFilePath = p.Path();
+                }
+              }
+            }
+          }
+        }
+
+        if (!srcFilePath.IsEmpty()) {
+          CopyFileAndAttributes(srcFilePath.String(), &dir, name);
+        } else {
+          if (url.IsEmpty()) {
+            if (aMessage->FindString("META:url", &url) != B_OK || url.IsEmpty()) {
+              BMessage orig;
+              if (aMessage->FindMessage("be:originator-data", &orig) == B_OK) {
+                orig.FindString("url", &url);
+                orig.FindString("title", &title);
+              }
+            }
+          }
+
+          if (title.IsEmpty()) {
+            title = name;
+          }
+
+          if (!url.IsEmpty()) {
+            BFile file(&dir, name, B_READ_WRITE | B_CREATE_FILE | B_ERASE_FILE);
+            if (file.InitCheck() == B_OK) {
+              BNodeInfo nodeInfo(&file);
+              nodeInfo.SetType("application/x-vnd.Be-bookmark");
+              file.WriteAttr("META:url", B_STRING_TYPE, 0, url.String(), url.Length() + 1);
+              file.WriteAttr("META:title", B_STRING_TYPE, 0, title.String(), title.Length() + 1);
+            }
+          }
+        }
+
+        BMessage reply(B_MIME_DATA);
+        reply.AddInt32("be:actions", B_COPY_TARGET);
+        aMessage->SendReply(&reply);
+
+        if (mGeckoWindow) {
+          mGeckoWindow->OnHaikuCopyTargetDone();
+        }
+      }
+      break;
+    }
+
+    case B_MOUSE_WHEEL_CHANGED: {
+      if (!mGeckoWindow) {
+        break;
+      }
+      float deltaX = 0.0f;
+      float deltaY = 0.0f;
+      int32_t modifiers = 0;
+      aMessage->FindFloat("be:wheel_delta_x", &deltaX);
+      aMessage->FindFloat("be:wheel_delta_y", &deltaY);
+      if (aMessage->FindInt32("modifiers", &modifiers) != B_OK) {
+        modifiers = ::modifiers();
+      }
+
+      BPoint where;
+      uint32 buttons = 0;
+      GetMouse(&where, &buttons, false);
+
+      mGeckoWindow->OnHaikuWheelEvent(where.x, where.y, deltaX, deltaY, modifiers);
+      break;
+    }
+
+    case B_COLORS_UPDATED: {
+      nsAppShell::DispatchThemeChanged();
+      break;
+    }
+
+    default:
+      BView::MessageReceived(aMessage);
+      break;
+  }
+}
+
+void HaikuView::MouseDown(BPoint aPoint) {
+  if (!mGeckoWindow) {
+    return;
+  }
+  int32_t buttons = 0;
+  int32_t clicks = 1;
+  int32_t modifiers = 0;
+
+  GetCurrentMouseState(buttons, modifiers);
+  if (Window() && Window()->CurrentMessage()) {
+    Window()->CurrentMessage()->FindInt32("clicks", &clicks);
+  }
+
+  int32_t changedButton = buttons & ~mLastButtons;
+  if (!changedButton) {
+    changedButton = buttons;
+  }
+  mLastButtons = buttons;
+
+  if (!mPointerLocked) {
+    SetMouseEventMask(B_POINTER_EVENTS, B_LOCK_WINDOW_FOCUS);
+  }
+
+  BPoint targetPoint = mPointerLocked ? mPointerLockPos : aPoint;
+  mGeckoWindow->OnHaikuMouseDown(targetPoint.x, targetPoint.y, changedButton, buttons, clicks, modifiers);
+}
+
+void HaikuView::MouseUp(BPoint aPoint) {
+  if (!mGeckoWindow) {
+    return;
+  }
+  int32_t remainingButtons = 0;
+  int32_t modifiers = 0;
+
+  GetCurrentMouseState(remainingButtons, modifiers);
+
+  int32_t releasedButton = mLastButtons & ~remainingButtons;
+  if (!releasedButton) {
+    releasedButton = mLastButtons;
+  }
+  mLastButtons = remainingButtons;
+
+  if (remainingButtons == 0 && !mPointerLocked) {
+    SetMouseEventMask(0, 0);
+  }
+
+  nsDragService* dragService = nsDragService::GetInstance();
+  nsDragSession* haikuSession = nullptr;
+  nsCOMPtr<nsIDragSession> session;
+  if (dragService) {
+    dragService->GetCurrentSession(nullptr, getter_AddRefs(session));
+    if (session) {
+      haikuSession = static_cast<nsDragSession*>(session.get());
+    }
+  }
+
+  if (haikuSession && haikuSession->IsDragging() && !haikuSession->IsOverGeckoWindow()) {
+    if (!haikuSession->MarkDragEnding()) {
+      return;
+    }
+    BPoint screenPt = aPoint;
+    ConvertToScreen(&screenPt);
+    mGeckoWindow->OnHaikuDragEndedOutside(screenPt.x, screenPt.y, modifiers);
+    return;
+  }
+
+  BPoint targetPoint = mPointerLocked ? mPointerLockPos : aPoint;
+  mGeckoWindow->OnHaikuMouseUp(targetPoint.x, targetPoint.y, releasedButton, remainingButtons, modifiers);
+}
+
+void HaikuView::MouseMoved(BPoint aPoint, uint32 aTransit, const BMessage* aMessage) {
+  if (!mGeckoWindow) {
+    return;
+  }
+
+  if (mPointerLocked) {
+    int32 deltaX = int32(std::round(aPoint.x)) - int32(mPointerLockCenter.x);
+    int32 deltaY = int32(std::round(aPoint.y)) - int32(mPointerLockCenter.y);
+
+    if (deltaX != 0 || deltaY != 0) {
+      BPoint screenCenter = mPointerLockCenter;
+      ConvertToScreen(&screenCenter);
+      set_mouse_position(int32(std::round(screenCenter.x)),
+                         int32(std::round(screenCenter.y)));
+
+      mPointerLockPos.x += deltaX;
+      mPointerLockPos.y += deltaY;
+
+      int32_t buttons = 0;
+      int32_t modifiers = 0;
+      GetCurrentMouseState(buttons, modifiers);
+      mLastButtons = buttons;
+
+      mGeckoWindow->OnHaikuPointerLockMove(mPointerLockPos.x, mPointerLockPos.y,
+                                           buttons, modifiers);
+    }
+    return;
+  }
+
+  int32_t buttons = 0;
+  int32_t modifiers = 0;
+  GetCurrentMouseState(buttons, modifiers);
+  mLastButtons = buttons;
+
+  if (aMessage != nullptr) {
+    int32_t dragModifiers = 0;
+    if (aMessage->FindInt32("modifiers", &dragModifiers) != B_OK) {
+      dragModifiers = modifiers;
+    }
+
+    switch (aTransit) {
+      case B_ENTERED_VIEW: {
+        mIsDragOver = true;
+        nsDragService* dragService = nsDragService::GetInstance();
+        if (dragService) {
+          nsCOMPtr<nsIDragSession> session;
+          dragService->GetCurrentSession(nullptr, getter_AddRefs(session));
+          if (session) {
+            static_cast<nsDragSession*>(session.get())->SetOverGeckoWindow(true);
+          }
+        }
+        mGeckoWindow->OnHaikuDragEnter(aPoint.x, aPoint.y, aMessage, dragModifiers);
+        return;
+      }
+      case B_INSIDE_VIEW: {
+        mGeckoWindow->OnHaikuDragOver(aPoint.x, aPoint.y, aMessage, dragModifiers);
+        return;
+      }
+      case B_EXITED_VIEW: {
+        mIsDragOver = false;
+        nsDragService* dragService = nsDragService::GetInstance();
+        if (dragService) {
+          nsCOMPtr<nsIDragSession> session;
+          dragService->GetCurrentSession(nullptr, getter_AddRefs(session));
+          if (session) {
+            static_cast<nsDragSession*>(session.get())->SetOverGeckoWindow(false);
+          }
+        }
+        mGeckoWindow->OnHaikuDragExit(dragModifiers);
+        return;
+      }
+      case B_OUTSIDE_VIEW: {
+        nsDragService* dragService = nsDragService::GetInstance();
+        if (dragService) {
+          nsCOMPtr<nsIDragSession> session;
+          dragService->GetCurrentSession(nullptr, getter_AddRefs(session));
+          if (session) {
+            static_cast<nsDragSession*>(session.get())->SetOverGeckoWindow(false);
+          }
+        }
+        return;
+      }
+      default:
+        break;
+    }
+  } else if (mIsDragOver) {
+    mIsDragOver = false;
+    mGeckoWindow->OnHaikuDragExit(modifiers);
+  }
+
+  switch (aTransit) {
+    case B_ENTERED_VIEW:
+      mGeckoWindow->OnHaikuMouseEnter(aPoint.x, aPoint.y, buttons, modifiers);
+      mGeckoWindow->OnHaikuMouseMoved(aPoint.x, aPoint.y, buttons, modifiers);
+      break;
+
+    case B_INSIDE_VIEW:
+      mGeckoWindow->OnHaikuMouseMoved(aPoint.x, aPoint.y, buttons, modifiers);
+      break;
+
+    case B_EXITED_VIEW:
+      mGeckoWindow->OnHaikuMouseExit(aPoint.x, aPoint.y, buttons, modifiers);
+      break;
+
+    case B_OUTSIDE_VIEW:
+      if (buttons != 0) {
+        mGeckoWindow->OnHaikuMouseMoved(aPoint.x, aPoint.y, buttons, modifiers);
+      }
+      break;
+
+    default:
+      mGeckoWindow->OnHaikuMouseMoved(aPoint.x, aPoint.y, buttons, modifiers);
+      break;
+  }
+}
diff --git a/widget/haiku/HaikuView.h b/widget/haiku/HaikuView.h
new file mode 100644
index 0000000000..a70912e7d7
--- /dev/null
+++ b/widget/haiku/HaikuView.h
@@ -0,0 +1,73 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_widget_HaikuView_h
+#define mozilla_widget_HaikuView_h
+
+#include "HaikuUtils.h"
+
+class nsWindow;
+
+static const uint32_t kMsgGeckoInvalidate = 'GINV';
+
+class HaikuWindow : public BWindow {
+ public:
+  using BWindow::Zoom;
+
+  HaikuWindow(BRect aFrame, const char* aTitle, window_look aLook,
+              window_feel aFeel, uint32 aFlags, nsWindow* aGeckoWindow);
+  ~HaikuWindow() override = default;
+
+  void DispatchMessage(BMessage* aMessage, BHandler* aHandler) override;
+  bool QuitRequested() override;
+  void WindowActivated(bool aActive) override;
+  void MessageReceived(BMessage* aMessage) override;
+  void FrameMoved(BPoint aNewPosition) override;
+  void Zoom(BPoint aOrigin, float aWidth, float aHeight) override;
+  void Minimize(bool aMinimize) override;
+
+  void DetachGeckoWindow() {
+    mGeckoWindow = nullptr;
+  }
+
+ private:
+  nsWindow* mGeckoWindow;
+};
+
+class HaikuView : public BView {
+ public:
+  HaikuView(BRect aFrame, nsWindow* aGeckoWindow);
+  ~HaikuView() override = default;
+
+  void AttachedToWindow() override;
+  void Draw(BRect aUpdateRect) override;
+  void FrameResized(float aNewWidth, float aNewHeight) override;
+
+  void MessageReceived(BMessage* aMessage) override;
+
+  void MouseDown(BPoint aPoint) override;
+  void MouseUp(BPoint aPoint) override;
+  void MouseMoved(BPoint aPoint, uint32 aTransit, const BMessage* aMessage) override;
+
+  void LockPointer();
+  void UnlockPointer();
+  bool IsPointerLocked() const { return mPointerLocked; }
+
+  void DetachGeckoWindow() {
+    mGeckoWindow = nullptr;
+  }
+
+ private:
+  void GetCurrentMouseState(int32_t& aButtons, int32_t& aModifiers);
+
+  nsWindow* mGeckoWindow;
+  int32_t mLastButtons = 0;
+  bool mIsDragOver = false;
+
+  bool mPointerLocked = false;
+  BPoint mPointerLockCenter;
+  BPoint mPointerLockPos;
+};
+
+#endif  // mozilla_widget_HaikuView_h
diff --git a/widget/haiku/HaikuWindowBuffer.cpp b/widget/haiku/HaikuWindowBuffer.cpp
new file mode 100644
index 0000000000..20293096ce
--- /dev/null
+++ b/widget/haiku/HaikuWindowBuffer.cpp
@@ -0,0 +1,196 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "HaikuWindowBuffer.h"
+#include "HaikuView.h"
+#include "nsWindow.h"
+
+#include <algorithm>
+#include <cstring>
+
+using namespace mozilla::gfx;
+
+namespace mozilla::widget {
+
+HaikuWindowBuffer::HaikuWindowBuffer()
+    : mRenderingLock("HaikuWindowBuffer::mRenderingLock"),
+      mBackBitmap(nullptr),
+      mFrontBitmap(nullptr) {}
+
+HaikuWindowBuffer::~HaikuWindowBuffer() {
+  Destroy();
+}
+
+void HaikuWindowBuffer::Destroy() {
+  MutexAutoLock lock(mRenderingLock);
+  delete mBackBitmap;
+  mBackBitmap = nullptr;
+  delete mFrontBitmap;
+  mFrontBitmap = nullptr;
+}
+
+already_AddRefed<DrawTarget> HaikuWindowBuffer::StartRemoteDrawingInRegion(
+    const LayoutDeviceIntSize& aClientSize,
+    const LayoutDeviceIntRegion& aInvalidRegion) {
+  MutexAutoLock lock(mRenderingLock);
+
+  int32_t width = aClientSize.width;
+  int32_t height = aClientSize.height;
+
+  if (width <= 0 || height <= 0) {
+    return nullptr;
+  }
+
+  if (!mBackBitmap ||
+      int32_t(mBackBitmap->Bounds().Width()) + 1 != width ||
+      int32_t(mBackBitmap->Bounds().Height()) + 1 != height) {
+
+    BBitmap* oldBitmap = mBackBitmap;
+    mBackBitmap = new BBitmap(BRect(0, 0, width - 1, height - 1), 0, B_RGBA32);
+
+    if (!mBackBitmap || mBackBitmap->InitCheck() != B_OK || !mBackBitmap->Bits()) {
+      delete mBackBitmap;
+      mBackBitmap = nullptr;
+      delete oldBitmap;
+      return nullptr;
+    }
+
+    uint32_t bgPixel = GetHaikuPanelColorPixel();
+    uint8_t* dstBits = static_cast<uint8_t*>(mBackBitmap->Bits());
+    int32_t dstStride = mBackBitmap->BytesPerRow();
+
+    for (int32_t y = 0; y < height; ++y) {
+      uint32_t* row = reinterpret_cast<uint32_t*>(dstBits + y * dstStride);
+      std::fill_n(row, width, bgPixel);
+    }
+
+    BBitmap* srcBitmap = mFrontBitmap ? mFrontBitmap : oldBitmap;
+    if (srcBitmap && srcBitmap->IsValid() && srcBitmap->Bits()) {
+      int32_t srcWidth = int32_t(srcBitmap->Bounds().Width()) + 1;
+      int32_t srcHeight = int32_t(srcBitmap->Bounds().Height()) + 1;
+
+      int32_t copyW = std::min(width, srcWidth);
+      int32_t copyH = std::min(height, srcHeight);
+
+      uint8_t* srcBits = static_cast<uint8_t*>(srcBitmap->Bits());
+      int32_t srcStride = srcBitmap->BytesPerRow();
+
+      for (int32_t y = 0; y < copyH; ++y) {
+        memcpy(dstBits + y * dstStride, srcBits + y * srcStride, copyW * 4);
+      }
+    }
+
+    delete oldBitmap;
+  }
+
+  IntSize size(width, height);
+  return Factory::CreateDrawTargetForData(
+      BackendType::SKIA,
+      static_cast<uint8_t*>(mBackBitmap->Bits()),
+      size,
+      mBackBitmap->BytesPerRow(),
+      SurfaceFormat::B8G8R8A8);
+}
+
+void HaikuWindowBuffer::EndRemoteDrawingInRegion(
+    nsWindow* aGeckoWindow,
+    HaikuWindow* aWindow,
+    HaikuView* aView,
+    DrawTarget* aDrawTarget,
+    const LayoutDeviceIntRegion& aInvalidRegion) {
+  int32_t curWidth = 0;
+  int32_t curHeight = 0;
+  LayoutDeviceIntRect dirtyRect;
+
+  {
+    MutexAutoLock lock(mRenderingLock);
+    if (!mBackBitmap) {
+      return;
+    }
+
+    curWidth = int32_t(mBackBitmap->Bounds().Width()) + 1;
+    curHeight = int32_t(mBackBitmap->Bounds().Height()) + 1;
+
+    if (!mFrontBitmap || mFrontBitmap->Bounds() != mBackBitmap->Bounds()) {
+      delete mFrontBitmap;
+      mFrontBitmap = new BBitmap(mBackBitmap->Bounds(), 0, B_RGBA32);
+      if (mFrontBitmap && mFrontBitmap->IsValid()) {
+        memcpy(mFrontBitmap->Bits(), mBackBitmap->Bits(), mBackBitmap->BitsLength());
+      }
+      dirtyRect = LayoutDeviceIntRect(0, 0, curWidth, curHeight);
+    } else {
+      dirtyRect = aInvalidRegion.GetBounds();
+      BRect bounds = mBackBitmap->Bounds();
+      int32_t bmpWidth = int32_t(bounds.Width()) + 1;
+      int32_t bmpHeight = int32_t(bounds.Height()) + 1;
+
+      int32_t startY = std::max(0, dirtyRect.y);
+      int32_t endY = std::min(bmpHeight, dirtyRect.YMost());
+      int32_t startX = std::max(0, dirtyRect.x);
+      int32_t copyWidth = std::min(bmpWidth - startX, dirtyRect.width);
+
+      if (copyWidth > 0 && startY < endY) {
+        uint8_t* dst = static_cast<uint8_t*>(mFrontBitmap->Bits());
+        uint8_t* src = static_cast<uint8_t*>(mBackBitmap->Bits());
+        int32_t stride = mBackBitmap->BytesPerRow();
+
+        for (int32_t y = startY; y < endY; ++y) {
+          memcpy(dst + y * stride + startX * 4,
+                 src + y * stride + startX * 4,
+                 copyWidth * 4);
+        }
+      }
+    }
+  }
+
+  if (dirtyRect.IsEmpty()) {
+    return;
+  }
+
+  if (aWindow && aView) {
+    if (aWindow->LockWithTimeout(15000) == B_OK) {
+      BRect r(dirtyRect.x, dirtyRect.y,
+              dirtyRect.XMost() - 1, dirtyRect.YMost() - 1);
+      {
+        MutexAutoLock lock(mRenderingLock);
+        if (mFrontBitmap && mFrontBitmap->IsValid()) {
+          BRect bmpBounds = mFrontBitmap->Bounds();
+          BRect srcRect = r & bmpBounds;
+          if (srcRect.IsValid()) {
+            aView->DrawBitmap(mFrontBitmap, srcRect, srcRect);
+            aView->Sync();
+          }
+        }
+      }
+      aWindow->Unlock();
+      return;
+    }
+  }
+
+  if (aGeckoWindow) {
+    aGeckoWindow->Invalidate(dirtyRect);
+  }
+}
+
+void HaikuWindowBuffer::DrawToView(BView* aView, BRect aRect) {
+  MutexAutoLock lock(mRenderingLock);
+  if (!aView) {
+    return;
+  }
+
+  rgb_color bgColor = ui_color(B_PANEL_BACKGROUND_COLOR);
+
+  if (mFrontBitmap && mFrontBitmap->IsValid()) {
+    BRect bmpBounds = mFrontBitmap->Bounds();
+    BRect srcRect = aRect & bmpBounds;
+    if (srcRect.IsValid()) {
+      aView->DrawBitmap(mFrontBitmap, srcRect, srcRect);
+    }
+  } else {
+    aView->SetHighColor(bgColor);
+    aView->FillRect(aRect);
+  }
+}
+
+}  // namespace mozilla::widget
