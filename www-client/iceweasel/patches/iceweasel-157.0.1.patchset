+
+static bool RenderEmbeddedVectorIcon(const unsigned char* aData, size_t aSize,
+                                     BBitmap* aBitmap) {
+  return BIconUtils::GetVectorIcon(
+             reinterpret_cast<const uint8*>(aData), aSize, aBitmap) == B_OK;
+}
+
+static bool RenderVectorIcon(const uint8* aData, size_t aSize,
+                             BBitmap* aBitmap) {
+  return aData && aSize > 0 &&
+         BIconUtils::GetVectorIcon(aData, aSize, aBitmap) == B_OK;
+}
+
+static bool GetMimeVectorIcon(BMimeType& aMime, BBitmap* aBitmap) {
+  if (aMime.InitCheck() != B_OK) {
+    return false;
+  }
+
+  uint8* data = nullptr;
+  size_t size = 0;
+  if (aMime.GetIcon(&data, &size) == B_OK) {
+    bool ok = RenderVectorIcon(data, size, aBitmap);
+    free(data);
+    if (ok) {
+      return true;
+    }
+  }
+
+  char preferredApp[B_MIME_TYPE_LENGTH] = {0};
+  if (aMime.GetPreferredApp(preferredApp) == B_OK && preferredApp[0] != '\0') {
+    BMimeType appMime(preferredApp);
+    if (appMime.InitCheck() == B_OK &&
+        appMime.GetIconForType(aMime.Type(), &data, &size) == B_OK) {
+      bool ok = RenderVectorIcon(data, size, aBitmap);
+      free(data);
+      if (ok) {
+        return true;
+      }
+    }
+  }
+
+  BMimeType superMime;
+  if (aMime.GetSupertype(&superMime) == B_OK && superMime.InitCheck() == B_OK) {
+    if (superMime.GetIcon(&data, &size) == B_OK) {
+      bool ok = RenderVectorIcon(data, size, aBitmap);
+      free(data);
+      if (ok) {
+        return true;
+      }
+    }
+  }
+
+  return false;
+}
+
+static bool GetNodeIcon(BNode* aNode, BBitmap* aBitmap,
+                        icon_size aFallbackSize) {
+  if (!aNode || aNode->InitCheck() != B_OK) {
+    return false;
+  }
+
+  if (BIconUtils::GetIcon(aNode, "BEOS:ICON", nullptr, nullptr, aFallbackSize,
+                          aBitmap) == B_OK) {
+    return true;
+  }
+
+  BNodeInfo nodeInfo(aNode);
+  if (nodeInfo.InitCheck() == B_OK) {
+    return nodeInfo.GetTrackerIcon(aBitmap, aFallbackSize) == B_OK;
+  }
+
+  return false;
+}
+
+static nsresult moz_icon_to_channel(nsIMozIconURI* aIconURI,
+                                    nsILoadInfo* aLoadInfo, uint32_t aIconSize,
+                                    nsIChannel** aChannel) {
+  NS_ENSURE_TRUE(aIconURI, NS_ERROR_NULL_POINTER);
+  NS_ENSURE_TRUE(aIconSize < 256, NS_ERROR_UNEXPECTED);
+
+  uint32_t width = (aIconSize == 0) ? 16 : aIconSize;
+  uint32_t height = width;
+  icon_size fallbackSize = (width <= 16) ? B_MINI_ICON : B_LARGE_ICON;
+
+  BRect rect(0, 0, width - 1, height - 1);
+  BBitmap bitmap(rect, B_RGBA32);
+  if (bitmap.InitCheck() != B_OK || !bitmap.Bits()) {
+    return NS_ERROR_OUT_OF_MEMORY;
+  }
+  memset(bitmap.Bits(), 0, bitmap.BitsLength());
+
+  bool gotIcon = false;
+
+  nsAutoCString nativePath;
+  nsCOMPtr<nsIURL> iconURL;
+  aIconURI->GetIconURL(getter_AddRefs(iconURL));
+  if (iconURL) {
+    nsCOMPtr<nsIFileURL> fileURL = do_QueryInterface(iconURL);
+    if (fileURL) {
+      nsCOMPtr<nsIFile> file;
+      fileURL->GetFile(getter_AddRefs(file));
+      if (file) {
+        file->GetNativePath(nativePath);
+      }
+    }
+  }
+
+  if (nativePath.IsEmpty()) {
+    nsAutoCString spec;
+    aIconURI->GetSpec(spec);
+    if (StringBeginsWith(spec, "moz-icon:///"_ns)) {
+      int32_t start = sizeof("moz-icon://") - 1;
+      int32_t qMark = spec.FindChar('?', start);
+      if (qMark != kNotFound) {
+        NS_UnescapeURL(Substring(spec, start, qMark - start), 0, nativePath);
+      } else {
+        NS_UnescapeURL(Substring(spec, start), 0, nativePath);
+      }
+    }
+  }
+
+  if (!nativePath.IsEmpty()) {
+    if (nativePath.EqualsLiteral("/")) {
+      nativePath.AssignLiteral("/boot");
+    }
+
+    BEntry entry(nativePath.get(), true);
+    if (entry.Exists()) {
+      BNode node(&entry);
+      gotIcon = GetNodeIcon(&node, &bitmap, fallbackSize);
+    }
+  }
+
+  nsAutoCString stockIcon;
+  aIconURI->GetStockIcon(stockIcon);
+  if (!gotIcon && !stockIcon.IsEmpty()) {
+    if (stockIcon.EqualsLiteral("save") ||
+        stockIcon.EqualsLiteral("document-save") ||
+        stockIcon.EqualsLiteral("gtk-save")) {
+      gotIcon = RenderEmbeddedVectorIcon(kIconSave, sizeof(kIconSave), &bitmap);
+    } else if (stockIcon.EqualsLiteral("folder") ||
+               stockIcon.EqualsLiteral("directory") ||
+               stockIcon.EqualsLiteral("gtk-directory") ||
+               stockIcon.EqualsLiteral("places")) {
+      BMimeType folderMime("application/x-vnd.Be-directory");
+      gotIcon = GetMimeVectorIcon(folderMime, &bitmap) ||
+                (folderMime.GetIcon(&bitmap, fallbackSize) == B_OK);
+    } else if (stockIcon.EqualsLiteral("trash") ||
+               stockIcon.EqualsLiteral("user-trash")) {
+      BMimeType trashMime("application/x-vnd.Be-trash");
+      gotIcon = GetMimeVectorIcon(trashMime, &bitmap) ||
+                (trashMime.GetIcon(&bitmap, fallbackSize) == B_OK);
+    } else if (stockIcon.EqualsLiteral("drive") ||
+               stockIcon.EqualsLiteral("harddisk") ||
+               stockIcon.EqualsLiteral("drive-harddisk")) {
+      BMimeType volumeMime("application/x-vnd.Be-volume");
+      gotIcon = GetMimeVectorIcon(volumeMime, &bitmap) ||
+                (volumeMime.GetIcon(&bitmap, fallbackSize) == B_OK);
+    } else {
+      printf("[HaikuIconChannel] Unhandled stock icon requested: '%s' (size: %u)\n",
+             stockIcon.get(), width);
+    }
+  }
+
+  nsAutoCString contentType;
+  aIconURI->GetContentType(contentType);
+
+  nsAutoCString fileExt;
+  aIconURI->GetFileExtension(fileExt);
+
+  if (!gotIcon && contentType.IsEmpty() && !fileExt.IsEmpty()) {
+    nsAutoCString dummyName("file");
+    if (fileExt.First() != '.') {
+      dummyName.Append('.');
+    }
+    dummyName.Append(fileExt);
+
+    BMimeType guessed;
+    if (BMimeType::GuessMimeType(dummyName.get(), &guessed) == B_OK &&
+        guessed.InitCheck() == B_OK) {
+      contentType = guessed.Type();
+    }
+  }
+
+  if (!gotIcon && !contentType.IsEmpty()) {
+    BMimeType mime(contentType.get());
+    gotIcon = GetMimeVectorIcon(mime, &bitmap) ||
+              (mime.GetIcon(&bitmap, fallbackSize) == B_OK);
+  }
+
+  if (!gotIcon) {
+    BMimeType genericDoc("application/octet-stream");
+    gotIcon = GetMimeVectorIcon(genericDoc, &bitmap) ||
+              (genericDoc.GetIcon(&bitmap, fallbackSize) == B_OK);
+  }
+
+  if (!gotIcon) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
+  const int32_t channels = 4;
+  CheckedInt32 buf_size =
+      4 + channels * CheckedInt32(height) * CheckedInt32(width);
+  if (!buf_size.isValid()) {
+    return NS_ERROR_OUT_OF_MEMORY;
+  }
+
+  uint8_t* const buf = static_cast<uint8_t*>(moz_xmalloc(buf_size.value()));
+  uint8_t* out = buf;
+
+  *(out++) = width;
+  *(out++) = height;
+  *(out++) = uint8_t(mozilla::gfx::SurfaceFormat::B8G8R8A8);
+  *(out++) = 0xFF;
+
+  const uint8_t* src = static_cast<const uint8_t*>(bitmap.Bits());
+  const int32_t srcBpr = bitmap.BytesPerRow();
+  for (uint32_t y = 0; y < height; ++y) {
+    memcpy(out, src, width * channels);
+    out += width * channels;
+    src += srcBpr;
+  }
+
+  nsresult rv;
+  nsCOMPtr<nsIStringInputStream> stream =
+      do_CreateInstance("@mozilla.org/io/string-input-stream;1", &rv);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  rv = stream->AdoptData(reinterpret_cast<char*>(buf), buf_size.value());
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  return NS_NewInputStreamChannelInternal(
+      aChannel, aIconURI, stream.forget(), nsLiteralCString(IMAGE_ICON_MS),
+      ""_ns, aLoadInfo);
+}
+
+nsresult nsIconChannel::Init(nsIURI* aURI, nsILoadInfo* aLoadInfo) {
+  nsCOMPtr<nsIMozIconURI> iconURI = do_QueryInterface(aURI);
+  NS_ENSURE_TRUE(iconURI, NS_ERROR_UNEXPECTED);
+
+  uint32_t desiredImageSize = 16;
+  iconURI->GetImageSize(&desiredImageSize);
+
+  return moz_icon_to_channel(iconURI, aLoadInfo, desiredImageSize,
+                             getter_AddRefs(mRealChannel));
+}
