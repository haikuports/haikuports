diff --git a/gfx/gl/GLContextBGL.h b/gfx/gl/GLContextBGL.h
new file mode 100644
index 0000000000..b51dc4bf85
--- /dev/null
+++ b/gfx/gl/GLContextBGL.h
@@ -0,0 +1,81 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef GLCONTEXTBGL_H_
+#define GLCONTEXTBGL_H_
+
+#include "GLContext.h"
+#include "nsISupportsImpl.h"
+#include "mozilla/Mutex.h"
+
+#pragma GCC visibility push(default)
+#include <GLView.h>
+#pragma GCC visibility pop
+
+namespace mozilla::gl {
+
+class GLContextProviderBGL;
+
+BGLView* EnsureBGLDisplayKeeper();
+
+class BGLViewHandle final {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(BGLViewHandle)
+
+  explicit BGLViewHandle(BGLView* aView)
+      : mLock("BGLViewHandle::mLock"), mView(aView) {}
+
+  void Detach() {
+    MutexAutoLock lock(mLock);
+    mView = nullptr;
+  }
+
+  Mutex mLock;
+  BGLView* mView;
+
+ private:
+  ~BGLViewHandle() = default;
+};
+
+class GLContextBGL final : public GLContext {
+  friend class GLContextProviderBGL;
+
+ public:
+  MOZ_DECLARE_REFCOUNTED_VIRTUAL_TYPENAME(GLContextBGL, override)
+
+  GLContextBGL(const GLContextDesc& aDesc, RefPtr<BGLViewHandle> aHandle);
+  ~GLContextBGL() override;
+
+  GLContextType GetContextType() const override {
+    return GLContextType::BGL;
+  }
+
+  static GLContextBGL* Cast(GLContext* aGL) {
+    MOZ_RELEASE_ASSERT(aGL->GetContextType() == GLContextType::BGL);
+    return static_cast<GLContextBGL*>(aGL);
+  }
+
+  bool MakeCurrentImpl() const override;
+  bool IsCurrentImpl() const override;
+  bool IsDoubleBuffered() const override { return true; }
+  bool SwapBuffers() override;
+  void GetWSIInfo(nsCString* const aOut) const override;
+  Maybe<SymbolLoader> GetSymbolLoader() const override;
+
+  BGLView* GetGLView() const {
+    if (!mHandle) {
+      return nullptr;
+    }
+    MutexAutoLock lock(mHandle->mLock);
+    return mHandle->mView;
+  }
+
+ private:
+  RefPtr<BGLViewHandle> mHandle;
+  mutable bool mIsLocked = false;
+};
+
+}
+
+#endif
