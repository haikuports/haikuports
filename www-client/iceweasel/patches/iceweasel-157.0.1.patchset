diff --git a/widget/haiku/HaikuIMEHandler.cpp b/widget/haiku/HaikuIMEHandler.cpp
new file mode 100644
index 0000000000..7388fbec0e
--- /dev/null
+++ b/widget/haiku/HaikuIMEHandler.cpp
@@ -0,0 +1,211 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "HaikuIMEHandler.h"
+#include "nsWindow.h"
+#include "HaikuView.h"
+
+#include "mozilla/TextEvents.h"
+#include "mozilla/TextEventDispatcher.h"
+#include "nsThreadUtils.h"
+
+namespace mozilla::widget {
+
+NS_IMPL_ISUPPORTS(HaikuIMEHandler, TextEventDispatcherListener,
+                  nsSupportsWeakReference)
+
+HaikuIMEHandler::HaikuIMEHandler(nsWindow* aWindow)
+    : mWindow(aWindow),
+      mCaretScreenPos(100, 100),
+      mCaretHeight(20.0f) {}
+
+void HaikuIMEHandler::Detach() {
+  mWindow = nullptr;
+}
+
+IMENotificationRequests HaikuIMEHandler::GetIMENotificationRequests() {
+  return IMENotificationRequests(NOTIFY_IME_OF_POSITION_CHANGE);
+}
+
+NS_IMETHODIMP HaikuIMEHandler::NotifyIME(
+    TextEventDispatcher* aTextEventDispatcher,
+    const IMENotification& aIMENotification) {
+  if (!mWindow) {
+    return NS_OK;
+  }
+
+  switch (aIMENotification.mMessage) {
+    case NOTIFY_IME_OF_POSITION_CHANGE:
+    case NOTIFY_IME_OF_SELECTION_CHANGE: {
+      LayoutDeviceIntRect targetRect(0, 0, 0, 0);
+      bool foundRect = false;
+
+      WidgetQueryContentEvent queryCaret(true, eQueryCaretRect, mWindow);
+      WidgetQueryContentEvent::Options options;
+      options.mRelativeToInsertionPoint = true;
+      queryCaret.InitForQueryCaretRect(0, options);
+      mWindow->DispatchEvent(&queryCaret);
+      if (queryCaret.Succeeded() && queryCaret.mReply.isSome() &&
+          (queryCaret.mReply->mRect.width > 0 || queryCaret.mReply->mRect.height > 0)) {
+        targetRect = queryCaret.mReply->mRect;
+        foundRect = true;
+      }
+
+      if (!foundRect) {
+        WidgetQueryContentEvent queryText(true, eQueryTextRectArray, mWindow);
+        WidgetQueryContentEvent::Options textOptions;
+        textOptions.mRelativeToInsertionPoint = true;
+        queryText.InitForQueryTextRectArray(0, 1, textOptions);
+        mWindow->DispatchEvent(&queryText);
+        if (queryText.Succeeded() && queryText.mReply.isSome() &&
+            !queryText.mReply->mRectArray.IsEmpty()) {
+          targetRect = queryText.mReply->mRectArray[0];
+          foundRect = true;
+        }
+      }
+
+      if (foundRect && (targetRect.width > 0 || targetRect.height > 0)) {
+        BPoint localPt(targetRect.x, targetRect.y);
+        auto* view = static_cast<HaikuView*>(mWindow->GetNativeData(NS_NATIVE_WIDGET));
+        auto* win = static_cast<HaikuWindow*>(mWindow->GetNativeData(NS_NATIVE_WINDOW));
+        if (view && win && win->LockWithTimeout(5000) == B_OK) {
+          view->ConvertToScreen(&localPt);
+          win->Unlock();
+          mCaretScreenPos = localPt;
+          mCaretHeight = targetRect.height > 0 ? float(targetRect.height) : 20.0f;
+        } else {
+          LayoutDeviceIntPoint origin = mWindow->WidgetToScreenOffset();
+          mCaretScreenPos = BPoint(targetRect.x + origin.x, targetRect.y + origin.y);
+          mCaretHeight = targetRect.height > 0 ? float(targetRect.height) : 20.0f;
+        }
+      }
+      break;
+    }
+
+    case NOTIFY_IME_OF_BLUR: {
+      if (mIMEReplyTo.IsValid()) {
+        BMessage msg(B_INPUT_METHOD_EVENT);
+        msg.AddInt32("be:opcode", B_INPUT_METHOD_STOPPED);
+        mIMEReplyTo.SendMessage(&msg);
+      }
+      break;
+    }
+
+    default:
+      break;
+  }
+  return NS_OK;
+}
+
+void HaikuIMEHandler::ProcessInputMethodEvent(BMessage* aMessage) {
+  if (!mWindow) {
+    return;
+  }
+
+  int32 opcode = -1;
+  if (aMessage->FindInt32("be:opcode", &opcode) != B_OK) {
+    return;
+  }
+
+  switch (opcode) {
+    case B_INPUT_METHOD_STARTED: {
+      BMessenger replyTo;
+      if (aMessage->FindMessenger("be:reply_to", &replyTo) == B_OK) {
+        mIMEReplyTo = replyTo;
+      }
+      break;
+    }
+
+    case B_INPUT_METHOD_LOCATION_REQUEST: {
+      BMessage reply(B_INPUT_METHOD_EVENT);
+      reply.AddInt32("be:opcode", B_INPUT_METHOD_LOCATION_REQUEST);
+      for (int32 i = 0; i < 64; ++i) {
+        reply.AddPoint("be:location_reply", mCaretScreenPos);
+        reply.AddFloat("be:height_reply", mCaretHeight);
+      }
+      if (mIMEReplyTo.IsValid()) {
+        mIMEReplyTo.SendMessage(&reply);
+      } else {
+        aMessage->SendReply(&reply);
+      }
+      break;
+    }
+
+    case B_INPUT_METHOD_CHANGED: {
+      const char* str = nullptr;
+      aMessage->FindString("be:string", &str);
+
+      bool confirmed = false;
+      aMessage->FindBool("be:confirmed", &confirmed);
+
+      RefPtr<HaikuIMEHandler> self(this);
+      nsCString text(str ? str : "");
+      NS_DispatchToMainThread(NS_NewRunnableFunction(
+          "HaikuIMEHandler::ProcessInputMethodEvent", [self, text, confirmed]() {
+            if (!self->mWindow || self->mWindow->IsDestroyed()) {
+              return;
+            }
+
+            RefPtr<TextEventDispatcher> dispatcher = self->mWindow->GetTextEventDispatcher();
+            if (!dispatcher) {
+              return;
+            }
+
+            if (!dispatcher->IsInNativeInputTransaction()) {
+              dispatcher->BeginInputTransaction(self);
+            }
+
+            nsEventStatus status = nsEventStatus_eIgnore;
+            nsAutoString u16Text;
+            if (!text.IsEmpty()) {
+              CopyUTF8toUTF16(text, u16Text);
+            }
+
+            if (confirmed) {
+              if (dispatcher->IsComposing()) {
+                dispatcher->CommitComposition(status, &u16Text);
+              } else if (!u16Text.IsEmpty()) {
+                dispatcher->StartComposition(status);
+                dispatcher->CommitComposition(status, &u16Text);
+              }
+            } else {
+              if (!u16Text.IsEmpty()) {
+                if (!dispatcher->IsComposing()) {
+                  dispatcher->StartComposition(status);
+                }
+                dispatcher->SetPendingComposition(u16Text, nullptr);
+                dispatcher->FlushPendingComposition(status);
+              } else if (dispatcher->IsComposing()) {
+                nsAutoString emptyStr;
+                dispatcher->CommitComposition(status, &emptyStr);
+              }
+            }
+          }));
+      break;
+    }
+
+    case B_INPUT_METHOD_STOPPED: {
+      RefPtr<HaikuIMEHandler> self(this);
+      NS_DispatchToMainThread(NS_NewRunnableFunction(
+          "HaikuIMEHandler::ProcessInputMethodEvent", [self]() {
+            if (!self->mWindow || self->mWindow->IsDestroyed()) {
+              return;
+            }
+
+            RefPtr<TextEventDispatcher> dispatcher = self->mWindow->GetTextEventDispatcher();
+            if (dispatcher && dispatcher->IsComposing()) {
+              nsEventStatus status = nsEventStatus_eIgnore;
+              nsAutoString emptyStr;
+              dispatcher->CommitComposition(status, &emptyStr);
+            }
+          }));
+      break;
+    }
+
+    default:
+      break;
+  }
+}
+
+}  // namespace mozilla::widget
