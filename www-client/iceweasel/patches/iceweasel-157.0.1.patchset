diff --git a/gfx/thebes/gfxPlatformHaiku.cpp b/gfx/thebes/gfxPlatformHaiku.cpp
new file mode 100644
index 0000000000..1ac6f97f29
--- /dev/null
+++ b/gfx/thebes/gfxPlatformHaiku.cpp
@@ -0,0 +1,69 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "gfxPlatformHaiku.h"
+
+#include "gfxFcPlatformFontList.h"
+#include "gfxImageSurface.h"
+#include "SoftwareVsyncSource.h"
+#include "mozilla/gfx/2D.h"
+#include "mozilla/gfx/Logging.h"
+
+#include <fontconfig/fontconfig.h>
+#include <ft2build.h>
+#include FT_FREETYPE_H
+
+using namespace mozilla;
+using namespace mozilla::gfx;
+
+static FT_Library gPlatformFTLibrary = nullptr;
+
+gfxPlatformHaiku::gfxPlatformHaiku() {
+  InitBackendPrefs(GetBackendPrefs());
+
+  gPlatformFTLibrary = Factory::NewFTLibrary();
+  MOZ_RELEASE_ASSERT(gPlatformFTLibrary);
+  Factory::SetFTLibrary(gPlatformFTLibrary);
+}
+
+gfxPlatformHaiku::~gfxPlatformHaiku() {
+  Factory::ReleaseFTLibrary(gPlatformFTLibrary);
+  gPlatformFTLibrary = nullptr;
+}
+
+already_AddRefed<gfxASurface> gfxPlatformHaiku::CreateOffscreenSurface(
+    const IntSize& aSize, gfxImageFormat aFormat) {
+  if (!Factory::AllowedSurfaceSize(aSize)) {
+    return nullptr;
+  }
+  RefPtr<gfxASurface> newSurface = new gfxImageSurface(aSize, aFormat);
+  return newSurface.forget();
+}
+
+bool gfxPlatformHaiku::CreatePlatformFontList() {
+  return gfxPlatformFontList::Initialize(new gfxFcPlatformFontList);
+}
+
+void gfxPlatformHaiku::ReadSystemFontList(mozilla::dom::SystemFontList* retValue) {
+  gfxFcPlatformFontList::PlatformFontList()->ReadSystemFontList(retValue);
+}
+
+nsresult gfxPlatformHaiku::GetFontList(nsAtom* aLangGroup,
+                                       const nsACString& aGenericFamily,
+                                       nsTArray<nsString>& aListOfFonts) {
+  gfxPlatformFontList::PlatformFontList()->GetFontList(
+      aLangGroup, aGenericFamily, aListOfFonts);
+  return NS_OK;
+}
+
+already_AddRefed<mozilla::gfx::VsyncSource>
+gfxPlatformHaiku::CreateGlobalHardwareVsyncSource() {
+  return GetSoftwareVsyncSource();
+}
+
+bool gfxPlatformHaiku::CheckVariationFontSupport() {
+  FT_Int major, minor, patch;
+  FT_Library_Version(Factory::GetFTLibrary(), &major, &minor, &patch);
+  return major * 1000000 + minor * 1000 + patch >= 2007001;
+}
diff --git a/gfx/thebes/gfxPlatformHaiku.h b/gfx/thebes/gfxPlatformHaiku.h
new file mode 100644
index 0000000000..9601cf9a3b
--- /dev/null
+++ b/gfx/thebes/gfxPlatformHaiku.h
@@ -0,0 +1,34 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef GFX_PLATFORM_HAIKU_H
+#define GFX_PLATFORM_HAIKU_H
+
+#include "gfxPlatform.h"
+
+class gfxPlatformHaiku final : public gfxPlatform {
+ public:
+  gfxPlatformHaiku();
+  virtual ~gfxPlatformHaiku();
+
+  static gfxPlatformHaiku* GetPlatform() {
+    return static_cast<gfxPlatformHaiku*>(gfxPlatform::GetPlatform());
+  }
+
+  already_AddRefed<gfxASurface> CreateOffscreenSurface(
+      const IntSize& aSize, gfxImageFormat aFormat) override;
+
+  bool CreatePlatformFontList() override;
+  void ReadSystemFontList(mozilla::dom::SystemFontList* retValue) override;
+  nsresult GetFontList(nsAtom* aLangGroup, const nsACString& aGenericFamily,
+                       nsTArray<nsString>& aListOfFonts) override;
+
+  already_AddRefed<mozilla::gfx::VsyncSource> CreateGlobalHardwareVsyncSource() override;
+
+  static bool CheckVariationFontSupport();
+
+  bool SupportsApzWheelInput() const override { return true; }
+};
+
+#endif /* GFX_PLATFORM_HAIKU_H */
