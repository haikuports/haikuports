+
+class nsDeviceContextSpecHaiku : public nsIDeviceContextSpec {
+ public:
+  NS_DECL_ISUPPORTS
+
+  nsDeviceContextSpecHaiku() = default;
+
+  NS_IMETHOD Init(nsIPrintSettings* aPS, bool aIsPrintPreview) override;
+  already_AddRefed<mozilla::gfx::PrintTarget> MakePrintTarget() override;
+  NS_IMETHOD BeginDocument(const nsAString& aTitle,
+                           const nsAString& aPrintToFileName,
+                           mozilla::dom::WindowContext*, int32_t aStartPage,
+                           int32_t aEndPage) override {
+    return NS_OK;
+  }
+  RefPtr<mozilla::gfx::PrintEndDocumentPromise> EndDocument() override;
+  NS_IMETHOD BeginPage(const mozilla::gfx::IntSize& aSizeInPoints) override {
+    return NS_OK;
