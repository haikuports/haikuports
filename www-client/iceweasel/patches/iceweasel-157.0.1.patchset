diff --git a/dom/gamepad/haiku/HaikuGamepad.cpp b/dom/gamepad/haiku/HaikuGamepad.cpp
new file mode 100644
index 0000000000..813a4fa610
--- /dev/null
+++ b/dom/gamepad/haiku/HaikuGamepad.cpp
@@ -0,0 +1,301 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include <vector>
+#include <string>
+#include <cmath>
+
+#include "mozilla/Tainting.h"
+using mozilla::Tainted;
+
+#include "mozilla/dom/GamepadHandle.h"
+#include "mozilla/dom/GamepadMonitoring.h"
+#include "mozilla/dom/GamepadPlatformService.h"
+#include "nsThreadUtils.h"
+
+#pragma GCC visibility push(default)
+#include <device/Joystick.h>
+#include <OS.h>
+#pragma GCC visibility pop
+
+namespace {
+
+using namespace mozilla::dom;
+
+struct HaikuGamepadDevice {
+  std::string deviceName;
+  BJoystick* joystick = nullptr;
+  GamepadHandle handle;
+  
+  int32 numAxes = 0;
+  int32 numButtons = 0;
+  int32 numHats = 0;
+
+  std::vector<int16> lastAxes;
+  uint32 lastButtons = 0;
+  std::vector<uint8> lastHats;
+};
+
+class HaikuGamepadService {
+ public:
+  HaikuGamepadService() : mThread(-1), mRunning(false) {}
+  ~HaikuGamepadService() { Shutdown(); }
+
+  void Startup();
+  void Shutdown();
+
+ private:
+  static int32 ThreadEntry(void* aArg);
+  void PollLoop();
+  void ScanDevices();
+  void CloseDevices();
+
+  thread_id mThread;
+  bool mRunning;
+  std::vector<HaikuGamepadDevice> mDevices;
+};
+
+HaikuGamepadService* gService = nullptr;
+
+static inline double NormalizeAxis(int16 aRawValue) {
+  const int16 kDeadZone = 1200;
+  if (std::abs(aRawValue) < kDeadZone) {
+    return 0.0;
+  }
+  double val = (double)aRawValue / 32767.0;
+  if (val > 1.0) val = 1.0;
+  if (val < -1.0) val = -1.0;
+  return val;
+}
+
+void HaikuGamepadService::ScanDevices() {
+  RefPtr<GamepadPlatformService> service =
+      GamepadPlatformService::GetParentService();
+  if (!service) {
+    return;
+  }
+
+  BJoystick probe;
+  int32 count = probe.CountDevices();
+
+  for (int32 i = 0; i < count; i++) {
+    char nameBuf[B_OS_NAME_LENGTH];
+    status_t status = probe.GetDeviceName(i, nameBuf);
+    if (status != B_OK) {
+      continue;
+    }
+
+    auto joy = new BJoystick();
+    int fd = joy->Open(nameBuf, true);
+    if (fd < 0) {
+      fd = joy->Open(nameBuf, false);
+    }
+
+    if (fd < 0) {
+      delete joy;
+      continue;
+    }
+
+    HaikuGamepadDevice dev;
+    dev.deviceName = nameBuf;
+    dev.joystick = joy;
+    dev.numAxes = joy->CountAxes();
+    dev.numButtons = joy->CountButtons();
+    dev.numHats = joy->CountHats();
+
+    dev.lastAxes.resize(dev.numAxes, 0);
+    dev.lastHats.resize(dev.numHats, 0);
+    dev.lastButtons = 0;
+
+    uint32 totalButtons = dev.numButtons + (dev.numHats * 4);
+
+    dev.handle = service->AddGamepad(
+        dev.deviceName.c_str(),
+        GamepadMappingType::Standard,
+        GamepadHand::_empty,
+        totalButtons,
+        dev.numAxes,
+        0, 0, 0);
+
+    mDevices.push_back(std::move(dev));
+  }
+}
+
+void HaikuGamepadService::CloseDevices() {
+  RefPtr<GamepadPlatformService> service =
+      GamepadPlatformService::GetParentService();
+
+  for (auto& dev : mDevices) {
+    if (service) {
+      service->RemoveGamepad(dev.handle);
+    }
+    if (dev.joystick) {
+      dev.joystick->Close();
+      delete dev.joystick;
+      dev.joystick = nullptr;
+    }
+  }
+  mDevices.clear();
+}
+
+void HaikuGamepadService::Startup() {
+  if (mRunning) {
+    return;
+  }
+
+  ScanDevices();
+
+  mRunning = true;
+  mThread = spawn_thread(ThreadEntry, "GamepadPolling", B_NORMAL_PRIORITY, this);
+  if (mThread >= B_OK) {
+    resume_thread(mThread);
+  }
+}
+
+void HaikuGamepadService::Shutdown() {
+  if (!mRunning) {
+    return;
+  }
+
+  mRunning = false;
+  if (mThread >= B_OK) {
+    status_t exitVal;
+    wait_for_thread(mThread, &exitVal);
+    mThread = -1;
+  }
+
+  CloseDevices();
+}
+
+int32 HaikuGamepadService::ThreadEntry(void* aArg) {
+  auto* self = static_cast<HaikuGamepadService*>(aArg);
+  self->PollLoop();
+  return 0;
+}
+
+void HaikuGamepadService::PollLoop() {
+  std::vector<int16> curAxes;
+  std::vector<uint8> curHats;
+  uint32 scanCounter = 0;
+
+  while (mRunning) {
+    if (++scanCounter >= 100) {
+      scanCounter = 0;
+      BJoystick probe;
+      if (probe.CountDevices() != (int32)mDevices.size()) {
+        CloseDevices();
+        ScanDevices();
+      }
+    }
+
+    RefPtr<GamepadPlatformService> service =
+        GamepadPlatformService::GetParentService();
+
+    if (service && !mDevices.empty()) {
+      for (auto& dev : mDevices) {
+        if (!dev.joystick) continue;
+
+        status_t upRes = dev.joystick->Update();
+        if (upRes != B_OK) {
+          continue;
+        }
+
+        if (dev.numAxes > 0) {
+          curAxes.resize(dev.numAxes);
+          dev.joystick->GetAxisValues(curAxes.data());
+
+          for (int32 a = 0; a < dev.numAxes; a++) {
+            if (curAxes[a] != dev.lastAxes[a]) {
+              double normalized = NormalizeAxis(curAxes[a]);
+              service->NewAxisMoveEvent(dev.handle, a, normalized);
+              dev.lastAxes[a] = curAxes[a];
+            }
+          }
+        }
+
+        uint32 curButtons = dev.joystick->ButtonValues();
+        if (curButtons != dev.lastButtons) {
+          for (int32 b = 0; b < dev.numButtons && b < 32; b++) {
+            bool isDown = (curButtons & (1U << b)) != 0;
+            bool wasDown = (dev.lastButtons & (1U << b)) != 0;
+            if (isDown != wasDown) {
+              service->NewButtonEvent(dev.handle, b, isDown, isDown ? 1.0 : 0.0);
+            }
+          }
+          dev.lastButtons = curButtons;
+        }
+
+        if (dev.numHats > 0) {
+          curHats.resize(dev.numHats);
+          dev.joystick->GetHatValues(curHats.data());
+
+          for (int32 h = 0; h < dev.numHats; h++) {
+            uint8 curHat = curHats[h];
+            uint8 lastHat = dev.lastHats[h];
+
+            if (curHat != lastHat) {
+              uint32 baseBtn = dev.numButtons + (h * 4);
+
+              bool up    = (curHat == 1 || curHat == 2 || curHat == 8);
+              bool right = (curHat == 2 || curHat == 3 || curHat == 4);
+              bool down  = (curHat == 4 || curHat == 5 || curHat == 6);
+              bool left  = (curHat == 6 || curHat == 7 || curHat == 8);
+
+              bool was_up    = (lastHat == 1 || lastHat == 2 || lastHat == 8);
+              bool was_right = (lastHat == 2 || lastHat == 3 || lastHat == 4);
+              bool was_down  = (lastHat == 4 || lastHat == 5 || lastHat == 6);
+              bool was_left  = (lastHat == 6 || lastHat == 7 || lastHat == 8);
+
+              if (up != was_up)       service->NewButtonEvent(dev.handle, baseBtn + 0, up, up ? 1.0 : 0.0);
+              if (down != was_down)   service->NewButtonEvent(dev.handle, baseBtn + 1, down, down ? 1.0 : 0.0);
+              if (left != was_left)   service->NewButtonEvent(dev.handle, baseBtn + 2, left, left ? 1.0 : 0.0);
+              if (right != was_right) service->NewButtonEvent(dev.handle, baseBtn + 3, right, right ? 1.0 : 0.0);
+
+              dev.lastHats[h] = curHat;
+            }
+          }
+        }
+      }
+    }
+
+    snooze(16666);
+  }
+}
+
+} // namespace
+
+namespace mozilla::dom {
+
+void StartGamepadMonitoring() {
+  MOZ_ASSERT(!NS_IsMainThread());
+
+  NS_DispatchToMainThread(NS_NewRunnableFunction("StartGamepadMonitoring", [] {
+    AssertIsOnMainThread();
+    if (!gService) {
+      gService = new HaikuGamepadService();
+      gService->Startup();
+    }
+  }));
+}
+
+void StopGamepadMonitoring() {
+  MOZ_ASSERT(!NS_IsMainThread());
+
+  NS_DispatchToMainThread(NS_NewRunnableFunction("StopGamepadMonitoring", [] {
+    AssertIsOnMainThread();
+    if (gService) {
+      gService->Shutdown();
+      delete gService;
+      gService = nullptr;
+    }
+  }));
+}
+
+void SetGamepadLightIndicatorColor(const mozilla::Tainted<GamepadHandle>& aGamepadHandle,
+                                   const mozilla::Tainted<uint32_t>& aLightColorIndex,
+                                   const uint8_t& aRed, const uint8_t& aGreen,
+                                   const uint8_t& aBlue) {
+}
+
+} // namespace mozilla::dom
