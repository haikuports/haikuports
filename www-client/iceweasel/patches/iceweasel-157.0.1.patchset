+void nsWindow::EndRemoteDrawingInRegion(
+    DrawTarget* aDrawTarget, const LayoutDeviceIntRegion& aInvalidRegion) {
+  mBuffer.EndRemoteDrawingInRegion(this, mWindow, mView, aDrawTarget, aInvalidRegion);
+}
