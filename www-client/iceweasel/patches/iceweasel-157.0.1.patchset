+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_widget_nsClipboardHaiku_h
+#define mozilla_widget_nsClipboardHaiku_h
+
+#include "HaikuUtils.h"
+#include "nsBaseClipboard.h"
+#include "mozilla/Result.h"
+
+class nsClipboardHaiku final : public nsBaseClipboard {
+ public:
+  nsClipboardHaiku();
+
+  NS_DECL_ISUPPORTS_INHERITED
+
+ protected:
+  ~nsClipboardHaiku() override;
+
+  NS_IMETHOD SetNativeClipboardData(nsITransferable* aTransferable,
+                                    ClipboardType aWhichClipboard) override;
+
+  mozilla::Result<nsCOMPtr<nsISupports>, nsresult> GetNativeClipboardData(
+      const nsACString& aFlavor, ClipboardType aWhichClipboard,
+      uint64_t aThreshold) override;
+
+  nsresult EmptyNativeClipboardData(ClipboardType aWhichClipboard) override;
+
+  mozilla::Result<bool, nsresult> HasNativeClipboardDataMatchingFlavors(
+      const nsTArray<nsCString>& aFlavorList,
+      ClipboardType aWhichClipboard) override;
+
+  mozilla::Result<int32_t, nsresult> GetNativeClipboardSequenceNumber(
+      ClipboardType aWhichClipboard) override;
+
+ private:
+  nsresult WriteStringData(BMessage* aClip, nsITransferable* aTrans,
+                           const char* aGeckoFlavor, const char* aHaikuMime,
+                           const char* aAltGeckoFlavor = nullptr);
+  nsresult WriteImage(BMessage* aClip, nsITransferable* aTrans);
+
+  mozilla::Result<nsCOMPtr<nsISupports>, nsresult> ReadStringData(
+      BMessage* aClip, const char* aMimeType);
+  mozilla::Result<nsCOMPtr<nsISupports>, nsresult> ReadImage(
+      BMessage* aClip, const nsACString& aFlavor);
+
+  int32_t mLocalSequenceNumber = 0;
+};
+
+#endif  // mozilla_widget_nsClipboardHaiku_h
diff --git a/widget/haiku/nsDeviceContextSpecHaiku.cpp b/widget/haiku/nsDeviceContextSpecHaiku.cpp
new file mode 100644
index 0000000000..1582b4f262
--- /dev/null
+++ b/widget/haiku/nsDeviceContextSpecHaiku.cpp
@@ -0,0 +1,80 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsDeviceContextSpecHaiku.h"
+#include "PrintTargetSkPDF.h"
+#include "mozilla/gfx/PrintPromise.h"
+#include "nsNetUtil.h"
+#include "nsIFile.h"
+#include "prio.h"
+
+using namespace mozilla;
+using namespace mozilla::gfx;
+
+NS_IMPL_ISUPPORTS(nsDeviceContextSpecHaiku, nsIDeviceContextSpec)
+
+NS_IMETHODIMP nsDeviceContextSpecHaiku::Init(nsIPrintSettings* aPS,
+                                             bool aIsPrintPreview) {
+  mPrintSettings = aPS;
+  if (!mPrintSettings) {
+    return NS_ERROR_FAILURE;
+  }
+
+  if (mPrintSettings->GetOutputDestination() ==
+      nsIPrintSettings::kOutputDestinationStream) {
+    mPrintSettings->GetOutputStream(getter_AddRefs(mOutputStream));
+  } else if (mPrintSettings->GetOutputDestination() ==
+             nsIPrintSettings::kOutputDestinationFile) {
+    nsAutoString toFileName;
+    mPrintSettings->GetToFileName(toFileName);
+    if (!toFileName.IsEmpty()) {
+      nsCOMPtr<nsIFile> file;
+      nsresult rv = NS_NewLocalFile(toFileName, getter_AddRefs(file));
+      NS_ENSURE_SUCCESS(rv, rv);
+      rv = NS_NewLocalFileOutputStream(getter_AddRefs(mOutputStream), file,
+                                       PR_WRONLY | PR_CREATE_FILE | PR_TRUNCATE,
+                                       0644);
+      NS_ENSURE_SUCCESS(rv, rv);
+    }
+  }
+
+  return NS_OK;
+}
+
+already_AddRefed<PrintTarget> nsDeviceContextSpecHaiku::MakePrintTarget() {
+  double width = 0;
+  double height = 0;
+  int32_t orientation = nsIPrintSettings::kPortraitOrientation;
+
+  if (mPrintSettings) {
+    mPrintSettings->GetPaperWidth(&width);
+    mPrintSettings->GetPaperHeight(&height);
+    mPrintSettings->GetOrientation(&orientation);
+  }
+
+  if (width <= 0 || height <= 0) {
+    width = 210.0;
+    height = 297.0;
+  }
+  double scale = 72.0 / 25.4;
+  IntSize size = IntSize::Ceil(width * scale, height * scale);
+
+  if (orientation == nsIPrintSettings::kLandscapeOrientation) {
+    std::swap(size.width, size.height);
+  }
+
+  if (mOutputStream) {
+    return PrintTargetSkPDF::CreateOrNull(mOutputStream, size);
+  }
+
+  return PrintTargetSkPDF::CreateOrNull(MakeUnique<SkDynamicMemoryWStream>(), size);
+}
+
+RefPtr<PrintEndDocumentPromise> nsDeviceContextSpecHaiku::EndDocument() {
+  if (mOutputStream) {
+    mOutputStream->Close();
+    mOutputStream = nullptr;
+  }
+  return PrintEndDocumentPromise::CreateAndResolve(true, __func__);
+}
