@@ -0,0 +1,48 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_widget_nsLookAndFeel_h
+#define mozilla_widget_nsLookAndFeel_h
+
+#include <cstdint>
+#include "nsXPLookAndFeel.h"
+#include "gfxFont.h"
+
+class nsLookAndFeel final : public nsXPLookAndFeel {
+ public:
+  nsLookAndFeel() = default;
+  ~nsLookAndFeel() override = default;
+
+  void NativeInit() override {
+    EnsureInit();
+  }
+  void RefreshImpl() override;
+  void EnsureInit();
+
+  nsresult NativeGetColor(ColorID aID, ColorScheme aColorScheme, nscolor& aResult) override;
+  nsresult NativeGetInt(IntID aID, int32_t& aResult) override;
+  nsresult NativeGetFloat(FloatID aID, float& aResult) override;
+  bool NativeGetFont(FontID aID, nsString& aFontName, gfxFontStyle& aFontStyle) override;
+
+  char16_t GetPasswordCharacterImpl() override {
+    return 0x2022;
+  }
+
+ private:
+  struct SystemFontInfo {
+    nsString mName;
+    gfxFontStyle mStyle;
+  };
+
+  void InitSystemFont(const char* aFamily, float aSize, uint16_t aFace, SystemFontInfo& aInfo);
+
+  bool mInitialized = false;
+  bool mSystemIsDark = false;
+
+  SystemFontInfo mPlainFont;
+  SystemFontInfo mBoldFont;
+  SystemFontInfo mMenuFont;
+};
+
+#endif  // mozilla_widget_nsLookAndFeel_h
