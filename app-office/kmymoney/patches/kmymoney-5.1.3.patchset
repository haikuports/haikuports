From b74fbf6bd9c67258afa8c658172b9ff69fd7a3de Mon Sep 17 00:00:00 2001
From: Begasus <begasus@gmail.com>
Date: Sat, 25 Nov 2023 11:29:01 +0100
Subject: Silense deprecated warnings


diff --git a/CMakeLists.txt b/CMakeLists.txt
index cf591bd..990a96d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -469,6 +469,13 @@ option(USE_QT_DESIGNER
 
 add_feature_info("QtDesigner" USE_QT_DESIGNER "Qt-Designer library support (for devs only).")
 
+################# disable deprecated warnings #################
+
+if (HAIKU)
+    add_definitions(-Wno-deprecated-declarations) # TODO too much spam for now
+endif()
+
+
 ######################### The Actual Targets ##########################
 set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
 set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
-- 
2.56.0


From 3df8e94f2576de3a83dadefaf8466e4f5896d4d9 Mon Sep 17 00:00:00 2001
From: Luc Schrijvers <begasus@gmail.com>
Date: Wed, 28 Oct 2026 16:12:18 +0100
Subject: Fix for gcc15


diff --git a/CMakeLists.txt b/CMakeLists.txt
index 990a96d..5355185 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -153,7 +153,7 @@ add_feature_info("Encryption" ENABLE_GPG "Allows to store your financial data us
 
 add_definitions(-DQT_USE_QSTRINGBUILDER -DQT_NO_CAST_TO_ASCII -DQT_NO_URL_CAST_FROM_STRING)
 add_definitions(-DTRANSLATION_DOMAIN=\"kmymoney\")
-set(CMAKE_CXX_STANDARD 14)
+set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_CXX_EXTENSIONS OFF)
 
-- 
2.56.0

