+#      define DRM_MAJOR 0
+#      define major(dev) ((int)(((dev) >> 16) & 0xffff))
+#      define minor(dev) ((int)((dev) & 0xffff))
+#      define makedev(major, minor) (((major) << 16) | ((minor) & 0xffff))
