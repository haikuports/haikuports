 void js::DateTimeInfo::internalResyncICUDefaultTimeZone() {
+#if defined(__HAIKU__)
+  BTimeZone timeZone;
+  if (BLocaleRoster::Default()->GetDefaultTimeZone(&timeZone) == B_OK) {
+    BString timeZoneID = timeZone.ID();
