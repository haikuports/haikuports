     EcnCodepoint, IO_ERROR_LOG_INTERVAL, RecvMeta, Transmit, UdpSockRef, cmsg, log_sendmsg_error,
 };
 
+// Haiku compatibility: libc crate lacks these definitions for Haiku
+#[cfg(target_os = "haiku")]
+const IPV6_RECVPKTINFO: libc::c_int = 32;
+#[cfg(not(target_os = "haiku"))]
+const IPV6_RECVPKTINFO: libc::c_int = libc::IPV6_RECVPKTINFO;
+
+#[cfg(target_os = "haiku")]
+const IPV6_PKTINFO: libc::c_int = 31;
+#[cfg(not(target_os = "haiku"))]
+const IPV6_PKTINFO: libc::c_int = libc::IPV6_PKTINFO;
+
+#[cfg(target_os = "haiku")]
+const IPV6_TCLASS: libc::c_int = 61;
+#[cfg(not(target_os = "haiku"))]
+const IPV6_TCLASS: libc::c_int = libc::IPV6_TCLASS;
+
+#[cfg(target_os = "haiku")]
+const IPV6_DONTFRAG: libc::c_int = 62;
+#[cfg(not(target_os = "haiku"))]
+const IPV6_DONTFRAG: libc::c_int = libc::IPV6_DONTFRAG;
+
+#[cfg(target_os = "haiku")]
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct In6Pktinfo {
+    pub ipi6_addr: libc::in6_addr,
+    pub ipi6_ifindex: libc::c_uint,
+}
+
+#[cfg(not(target_os = "haiku"))]
+type In6Pktinfo = libc::in6_pktinfo;
+
