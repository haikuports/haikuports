From 85d8effefe34bf2779a8ee4de886fe1910cee363 Mon Sep 17 00:00:00 2001
From: Gerasim Troeglazov <3dEyes@gmail.com>
Date: Thu, 23 Jul 2026 21:40:46 +1000
Subject: Add Haiku build support

Based on patches sourced from https://github.com/kenz-gelsoft/gecko-dev/

-   Enabled building for the Haiku.
-   Implemented the cubeb audio backend for MediaKit.
-   Made additional modifications for Haiku compatibility.
-   Implemented native notifications.
-   Implement remote server


diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
index d7f3045f1f..cc5e1cce7d 100644
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -14,7 +14,9 @@
 
 #ifdef XP_UNIX
   #ifndef XP_MACOSX
-    #define UNIX_BUT_NOT_MAC
+    #ifndef XP_HAIKU
+      #define UNIX_BUT_NOT_MAC_NOR_HAIKU
+    #endif
   #endif
 #endif
 
@@ -246,7 +248,7 @@ pref("browser.uitour.url", "https://www.mozilla.org/%LOCALE%/firefox/%VERSION%/t
 // How long to show a Hearbeat survey (two hours, in seconds)
 pref("browser.uitour.surveyDuration", 7200);
 
-#ifdef UNIX_BUT_NOT_MAC
+#ifdef UNIX_BUT_NOT_MAC_NOR_HAIKU
   pref("general.autoScroll", false);
 #else
   pref("general.autoScroll", true);
@@ -1145,7 +1147,7 @@ pref("security.allow_parent_unrestricted_js_loads", false);
 pref("browser.tabs.min_inactive_duration_before_unload", 600000);
 
 // Does middleclick paste of clipboard to new tab button
-#ifdef UNIX_BUT_NOT_MAC
+#ifdef UNIX_BUT_NOT_MAC_NOR_HAIKU
 pref("browser.tabs.searchclipboardfor.middleclick", true);
 #else
 pref("browser.tabs.searchclipboardfor.middleclick", false);
diff --git a/build/gecko_templates.mozbuild b/build/gecko_templates.mozbuild
index fa2cabfdcf..2548e3ad6d 100644
--- a/build/gecko_templates.mozbuild
+++ b/build/gecko_templates.mozbuild
@@ -42,7 +42,8 @@ def GeckoBinary(linkage="dependent", mozglue=None):
                 USE_LIBS += ["sanitizer-options"]
             DEFINES["MOZ_HAS_MOZGLUE"] = True
             if CONFIG["MOZ_GLUE_IN_PROGRAM"] and CONFIG["CC_TYPE"] in ("clang", "gcc"):
-                LDFLAGS += ["-rdynamic"]
+                #LDFLAGS += ['-rdynamic']
+                LDFLAGS += ['-Wl,-export-dynamic']
         elif mozglue == "library":
             LIBRARY_DEFINES["MOZ_HAS_MOZGLUE"] = True
             if not CONFIG["MOZ_GLUE_IN_PROGRAM"]:
diff --git a/build/moz.configure/bindgen.configure b/build/moz.configure/bindgen.configure
index 078937ddcd..68ef074a23 100644
--- a/build/moz.configure/bindgen.configure
+++ b/build/moz.configure/bindgen.configure
@@ -201,7 +201,7 @@ def bindgen_libclang_path(libclang_path, clang, library_name_info, host):
     libclang_choices.append(
         "%sclang%s" % (library_name_info.dll.prefix, library_name_info.dll.suffix)
     )
-    if host.kernel == "Linux":
+    if host.kernel == "Linux" or host.kernel == "Haiku":
         libclang_choices.append("libclang.so.*")
 
     if host.os == "OpenBSD":
diff --git a/build/moz.configure/flags.configure b/build/moz.configure/flags.configure
index 4822831ac5..3ccd4e6b47 100644
--- a/build/moz.configure/flags.configure
+++ b/build/moz.configure/flags.configure
@@ -539,7 +539,7 @@ set_config("EXPAND_LIBS_LIST_STYLE", expand_libs_list_style)
 # ---------------------------------
 @depends(building_with_gnu_compatible_cc, target)
 def moz_program_ldflags(building_with_gnu_compatible_cc, target):
-    if building_with_gnu_compatible_cc and target.kernel not in ("Darwin", "WASI"):
+    if building_with_gnu_compatible_cc and target.kernel not in ("Darwin", "WASI", "Haiku"):
         return ["-pie"]
 
 
diff --git a/build/moz.configure/init.configure b/build/moz.configure/init.configure
index 833904ff91..f3d73cfdc1 100644
--- a/build/moz.configure/init.configure
+++ b/build/moz.configure/init.configure
@@ -521,6 +521,8 @@ def split_triplet(triplet, allow_wasi=False):
         canonical_os = canonical_kernel = "DragonFly"
     elif os.startswith("freebsd"):
         canonical_os = canonical_kernel = "FreeBSD"
+    elif os.startswith("haiku"):
+        canonical_os = canonical_kernel = "Haiku"
     elif os.startswith("netbsd"):
         canonical_os = canonical_kernel = "NetBSD"
     elif os.startswith("openbsd"):
@@ -951,6 +953,15 @@ def target_is_freebsd(target):
 set_define("XP_FREEBSD", target_is_freebsd)
 
 
+@depends(target)
+def target_is_haiku(target):
+    if target.kernel == "Haiku":
+        return True
+
+
+set_define("XP_HAIKU", target_is_haiku)
+
+
 @depends(target)
 def target_is_solaris(target):
     if target.kernel == "SunOS":
diff --git a/build/moz.configure/toolchain.configure b/build/moz.configure/toolchain.configure
index 7939243559..74fecef9e0 100644
--- a/build/moz.configure/toolchain.configure
+++ b/build/moz.configure/toolchain.configure
@@ -2719,7 +2719,7 @@ def security_hardening_cflags(
 
             if (
                 c_compiler.type == "clang"
-                and target.os not in ("WINNT", "OSX", "OpenBSD", "iOS")
+                and target.os not in ("WINNT", "OSX", "OpenBSD", "iOS", "Haiku")
                 and ((c_compiler.version >= "11.0.1" and target.cpu in ("x86", "x86_64", "ppc64", "s390x"))
                     or
                      (c_compiler.version >= "18.1.0" and target.cpu == "aarch64"))
diff --git a/comm/mail/modules/DNS.worker.mjs b/comm/mail/modules/DNS.worker.mjs
index 6198d30895..f5693ccefc 100644
--- a/comm/mail/modules/DNS.worker.mjs
+++ b/comm/mail/modules/DNS.worker.mjs
@@ -39,6 +39,8 @@ class load_libresolv {
       let candidates = [];
       if (os == "freebsd") {
         candidates = [{ name: "c", suffix: ".7" }];
+      } else if (os == "haiku") {
+        candidates = [{ name: "network", suffix: "" }];
       } else if (os == "openbsd") {
         candidates = [{ name: "c", suffix: "" }];
       } else {
diff --git a/comm/mail/moz.configure b/comm/mail/moz.configure
index ab20ef7012..b4264bb199 100644
--- a/comm/mail/moz.configure
+++ b/comm/mail/moz.configure
@@ -9,8 +9,8 @@ imply_option("MOZ_APP_NAME", "thunderbird")
 
 # MOZ_APP_PROFILE: When set, used for application.ini's
 # "Profile" field, which controls profile location.
-imply_option("MOZ_APP_PROFILE", "Thunderbird", when=target_is_windows | target_is_osx)
-imply_option("MOZ_APP_PROFILE", "thunderbird", when=~target_is_windows & ~target_is_osx)
+imply_option("MOZ_APP_PROFILE", "Thunderbird", when=target_is_windows | target_is_osx | target_is_haiku)
+imply_option("MOZ_APP_PROFILE", "thunderbird", when=~target_is_windows & ~target_is_osx & ~target_is_haiku)
 
 # MOZ_APP_BASENAME: Typically stays consistent for multiple branded
 # versions of a given application (e.g. Daily and Thunderbird both use
