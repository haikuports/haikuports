SUMMARY="A secure, customizable email & news client, forked from Thunderbird"
DESCRIPTION="A secure and customizable email, news, and personal information manager \
forked from Thunderbird. Experience cross-platform, decentralized communication built \
on open standards, putting you in control of your data and workflow. This extensible \
platform offers interoperable messaging, contacts, and appointment management."
HOMEPAGE="https://directory.fsf.org/wiki/Icedove/"
COPYRIGHT="1998–2026 MZLA Technologies Corporation,"
LICENSE="MPL v2.0"
REVISION="1"
SOURCE_URI="https://ftp.mozilla.org/pub/thunderbird/releases/$portVersion/source/thunderbird-$portVersion.source.tar.xz"
CHECKSUM_SHA256="b4cbc4e010deaa66a51a5c647586c8dc41579c136155fe8baa8253f7c8b3927e"
SOURCE_DIR="thunderbird-$portVersion"
PATCHES="
	icedove-$portVersion.patchset
	icedove_launcher-$portVersion.patchset
	"

# UI backend: "NATIVE" (cairo-haiku) or "GTK" (cairo-gtk3-wayland-only)
UI_BACKEND="NATIVE"

ADDITIONAL_FILES="
	icedove.rdef.in
	icedove_addon.rdef.in
	icedove_launcher.rdef.in
	branding.zip
	mozconfig_gtk
	mozconfig_native
	fix_profile.sh
	"

ARCHITECTURES="x86_64"

POST_INSTALL_SCRIPTS="
	$relativePostInstallDir/fix_profile.sh
	"

PROVIDES="
	icedove = $portVersion
	app:Icedove = $portVersion
	cmd:icedove = $portVersion
	"
CONFLICTS="
	icedove_bin
	"
REPLACES="
	icedove_bin
	"
REQUIRES="
	haiku
	noto_emoji
	noto_emoji_color
	lib:libcairo
	lib:libevent_2.1
	lib:libffi
	lib:libfontconfig
	lib:libfreetype
	lib:libgl
	lib:libharfbuzz
	lib:libintl
	lib:libjpeg
	lib:libmediahelpers
	lib:libnspr4
	lib:libnss3
	lib:libvpx
	lib:libwebp
	lib:libzstd
	lib:libz
	"

if [ "$UI_BACKEND" = "GTK" ]; then
	REQUIRES+="
		lib:libatk_1.0
		lib:libcairo_gobject
		lib:libdbus_1
		lib:libgdk_3
		lib:libgdk_pixbuf_2.0
		lib:libglib_2.0
		lib:libgtk_3
		lib:libnotify
		lib:libpango_1.0
		lib:libpangocairo_1.0
		"
fi

BUILD_REQUIRES="
	haiku_devel
	devel:libevent
	devel:libffi
	devel:libfontconfig
	devel:libfreetype
	devel:libgl
	devel:libjpeg
	devel:libmediahelpers
	devel:libnspr4
	devel:libnss3
	devel:libvpx >= 8
	devel:libwebp
	devel:libzstd
	devel:libz
	"

if [ "$UI_BACKEND" = "GTK" ]; then
	BUILD_REQUIRES+="
		devel:libdbus_1
		devel:libdbus_glib_1
		devel:libglib_2.0
		devel:libgtk_3
		devel:libnotify
		"
fi

BUILD_PREREQUIRES="
	llvm21
	nodejs20
	rust_bin
	cmd:autoconf_2.13
	cmd:cbindgen
	cmd:clang++
	cmd:gawk
	cmd:gcc
	cmd:git
	cmd:gn >= 0.2385
	cmd:lld >= 21
	cmd:m4
	cmd:make
	cmd:nasm
	cmd:perl
	cmd:pkg_config
	cmd:python3
	cmd:tar
	cmd:unzip
	cmd:xargs
	cmd:zip
	"

PATCH()
{
	unzip $sourceDir/../../additional-files/branding.zip -o -d $sourceDir/comm/mail/branding

	find "$sourceDir/third_party/rust/" -name ".cargo-checksum.json" | while read -r file; do
		printf '{"files":{}}' > "$file"
	done

	if [ -d "$sourceDir/comm/third_party/rust/" ]; then
		find "$sourceDir/comm/third_party/rust/" -name ".cargo-checksum.json" | while read -r file; do
			printf '{"files":{}}' > "$file"
		done
	fi

	sed -i 's|.*verify_vendored_dependencies.*|\t@true|' \
    	$sourceDir/comm/mail/Makefile.in \
    	$sourceDir/comm/suite/Makefile.in

	find "$sourceDir" -name "Cargo.lock" -exec sed -i '/^checksum =/d' {} +

	chmod +x \
		$sourceDir/build/cargo-linker \
		$sourceDir/mach
}

BUILD()
{
	export MOZBUILD_STATE_PATH="$sourceDir/.mozconfig"

	export RUSTFLAGS="-C link-arg=-Wl,--no-gc-sections -C force-unwind-tables=no -C codegen-units=1"
	export RUST_BACKTRACE=full
	export RUST_MIN_STACK=33554432
	export CARGO_NET_OFFLINE=true
	export CARGO_BUILD_JOBS=1
	export CARGO_INCREMENTAL=0

	export PIP_NETWORK_INSTALL_RESTRICTED_VIRTUALENVS=mach
	export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE="none"
	export PIP_DISABLE_PIP_VERSION_CHECK=1
	export PIP_NO_INDEX=1

	python3 -m ensurepip --default-pip

	rm -f mozconfig
	if [ "$UI_BACKEND" = "GTK" ]; then
		cp -f $portDir/additional-files/mozconfig_gtk mozconfig
	else
		cp -f $portDir/additional-files/mozconfig_native mozconfig
	fi

	./mach -vv \
		--no-interactive bootstrap \
		--application-choice="Firefox for Desktop" \
		--exclude=sysroot-wasm32-wasi

	rm -f mozconfig
	if [ "$UI_BACKEND" = "GTK" ]; then
		cp -f $portDir/additional-files/mozconfig_gtk mozconfig
	else
		cp -f $portDir/additional-files/mozconfig_native mozconfig
	fi
	
	./mach build -j4

	cd tools/haiku-launcher
	gcc -o "Icedove Mail" launcher.cpp -lbe
	gcc -shared -o "Send with Icedove" addon.cpp -lbe
}

INSTALL()
{
	export MOZBUILD_STATE_PATH="$sourceDir/.mozconfig"

	export CARGO_NET_OFFLINE=true
	export PIP_NETWORK_INSTALL_RESTRICTED_VIRTUALENVS=mach
	export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE="none"
	export PIP_DISABLE_PIP_VERSION_CHECK=1
	export PIP_NO_INDEX=1

	./mach install

	mkdir -p $appsDir $binDir $addOnsDir/Tracker

	mv /usr/local/lib/thunderbird $appsDir/Icedove
	mv $appsDir/Icedove/thunderbird $appsDir/Icedove/Icedove
	mv $appsDir/Icedove/thunderbird-bin $appsDir/Icedove/icedove-bin

	cp "tools/haiku-launcher/Icedove Mail" $appsDir/Icedove
	cp "tools/haiku-launcher/Send with Icedove" $addOnsDir/Tracker
	ln -s "$appsDir/Icedove/Icedove" $binDir/icedove

	mkdir -p $postInstallDir
	cp -f $portDir/additional-files/fix_profile.sh $postInstallDir
	chmod -v a+rx $postInstallDir/fix_profile.sh

	# arranging the files in lib directory
	mkdir -p $appsDir/Icedove/lib

	pushd $appsDir/Icedove
	mv -f \
		libgkcodecs.so       \
		liblgpllibs.so       \
		libmozavcodec.so     \
		libmozavutil.so      \
		libmozinference.so   \
		libmozsqlite3.so     \
		libxul.so            \
		lib/ 2>/dev/null || true

	if [ "$UI_BACKEND" = "GTK" ]; then
		mv -f \
			libmozgtk.so     \
			libmozwayland.so \
			lib/ 2>/dev/null || true
	fi
	popd

	local APP_SIGNATURE="application/x-vnd.icedove"
	local MAJOR="`echo "$portVersion" | cut -d. -f1`"
	local MIDDLE="`echo "$portVersion" | cut -d. -f2`"
	local MINOR="0"
	local LONG_INFO="$SUMMARY"

	sed \
		-e "s|@APP_SIGNATURE@|$APP_SIGNATURE|" \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/icedove.rdef.in > icedove.rdef

	sed \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/icedove_launcher.rdef.in > icedove_launcher.rdef

	sed \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/icedove_addon.rdef.in > icedove_addon.rdef

	addResourcesToBinaries icedove.rdef $appsDir/Icedove/Icedove
	addResourcesToBinaries icedove_launcher.rdef "$appsDir/Icedove/Icedove Mail"
	addResourcesToBinaries icedove_addon.rdef "$addOnsDir/Tracker/Send with Icedove"

	addAppDeskbarSymlink $appsDir/Icedove/Icedove
}
