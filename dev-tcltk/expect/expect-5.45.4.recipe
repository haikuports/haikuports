SUMMARY="A tool to automate interactive applications"
DESCRIPTION="expect is a program that performs programmed \
dialogue with other interactive programs."
HOMEPAGE="http://www.nist.gov/el/msid/expect.cfm"
COPYRIGHT="1987-1994 The Regents of the University of California.
	1994-1997 Sun Microsystems, Inc.
	1993-1996 Lucent Technologies.
	1998-1999 Scriptics Corporation."
LICENSE="Public Domain"
REVISION="3"
SOURCE_URI="http://downloads.sourceforge.net/project/expect/Expect/$portVersion/expect$portVersion.tar.gz"
CHECKSUM_SHA256="49a7da83b0bdd9f46d04a04deec19c7767bb9a323e40c4781f89caf760b92c34"
SOURCE_DIR="expect$portVersion"
PATCHES="expect-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

commandBinDir=$binDir
commandSuffix=$secondaryArchSuffix
if [ "$targetArchitecture" = x86_gcc2 ]; then
	commandSuffix=
	commandBinDir=$prefix/bin
fi

PROVIDES="
	expect$secondaryArchSuffix = $portVersion
	cmd:autoexpect$commandSuffix
	cmd:autopasswd$commandSuffix
	cmd:cryptdir$commandSuffix
	cmd:decryptdir$commandSuffix
	cmd:dislocate$commandSuffix
	cmd:expect$commandSuffix
	cmd:ftp_rfc$commandSuffix
	cmd:kibitz$commandSuffix
	cmd:lpunlock$commandSuffix
	cmd:mkpasswd$commandSuffix
	cmd:multixterm$commandSuffix
	cmd:passmass$commandSuffix
	cmd:rftp$commandSuffix
	cmd:rlogin_cwd$commandSuffix
	cmd:timed_read$commandSuffix
	cmd:timed_run$commandSuffix
	cmd:tknewsbiff$commandSuffix
	cmd:tkpasswd$commandSuffix
	cmd:unbuffer$commandSuffix
	cmd:weather$commandSuffix
	cmd:xkibitz$commandSuffix
	cmd:xpstat$commandSuffix
	lib:libexpect$portVersion$secondaryArchSuffix
	"
REQUIRES="
	haiku$secondaryArchSuffix
	tcl$secondaryArchSuffix
	"

if [ "$targetArchitecture" = x86_gcc2 ]; then
	REPLACES="
		expect
		"
fi

PROVIDES_devel="
	expect${secondaryArchSuffix}_devel = $portVersion
	devel:libexpect$portVersion$secondaryArchSuffix
	"
REQUIRES_devel="
	expect$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	tcl${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	cmd:autoconf
	cmd:gcc$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	autoconf -f

	export LDFLAGS="-lbsd"
	export CFLAGS="-O2"

	runConfigure --omit-dirs "binDir docDir dataRootDir" ./configure \
		--bindir=$commandBinDir \
		--with-tcl=$(finddir B_SYSTEM_DEVELOP_DIRECTORY)/lib$secondaryArchSubDir \
		--with-tclinclude=$(finddir B_SYSTEM_DEVELOP_DIRECTORY)/headers$secondaryArchSubDir \
		--enable-symbols

	make $jobArgs
}

INSTALL()
{
	make install

	mv $libDir/expect$portVersion/libexpect$portVersion.so $libDir

	prepareInstalledDevelLib libexpect$portVersion

	packageEntries devel $developDir
}
