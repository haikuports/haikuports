SUMMARY="Go TrueType fonts"
DESCRIPTION="Font family from Google's Go project"
HOMEPAGE="https://go.dev/blog/go-fonts"
COPYRIGHT="2009 The Go Authors"
LICENSE="BSD (3-clause)"
REVISION="1"
SOURCE_URI="https://github.com/golang/image/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256="b1b95713f38821f3d313f0bcb9e2c8b46df0d504ab35b3dde2a83c74c64950a7"
SOURCE_DIR=""

ARCHITECTURES="any"
DISABLE_SOURCE_PACKAGE="yes"

PROVIDES="gofont = $portVersion"
REQUIRES=""

BUILD_REQUIRES=""
BUILD_PREREQUIRES="coreutils"

BUILD()
{
	true
}

INSTALL()
{
	FONTDIR=$fontsDir/ttfonts
	mkdir -p ${FONTDIR}
	find . -name \*.ttf -exec cp {} ${FONTDIR} \;
}
