ARCHITECTURES="!all x86_64"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	oh$secondaryArchSuffix = $portVersion
	cmd:oh
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libzstd$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libzstd$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	cmd:pkg_config$secondaryArchSuffix
	cmd:rustc$secondaryArchSuffix
	"

BUILD()
{
	export CARGO_HOME=$sourceDir/../cargo
	vendor=$CARGO_HOME/haiku
	mkdir -p "$vendor"
	for i in $(seq 2 465); do
		eval "srcDir=\$sourceDir$i"
		eval "sha256sum=\$CHECKSUM_SHA256_$i"
		set -- "$srcDir"/*
		ln -sf "$1" "$vendor"
		cat <<-EOF >"$vendor/${1##*/}/.cargo-checksum.json"
		{
		  "package": "$sha256sum",
		  "files": {}
		}
		EOF
	done

	cat <<-EOF >"$CARGO_HOME"/config.toml
	[source.haiku]
	directory = "$vendor"

	[source.crates-io]
	replace-with = "haiku"
	EOF

	# The bundled zstd's hidden symbols break the link on Haiku: use the system's.
	export ZSTD_SYS_USE_PKG_CONFIG=1
	export OXY_BUILD=v$portVersion
	cargo build --release --frozen -p oh
}

INSTALL()
{
	install -v -m 755 -d "$prefix"/bin "$docDir"
	install -v -m 755 ./target/release/oh "$prefix"/bin
	install -v -m 644 README.md LICENSE docs/oh.md "$docDir"
}

TEST()
{
	export CARGO_HOME=$sourceDir/../cargo
	export ZSTD_SYS_USE_PKG_CONFIG=1
	cargo test --release --frozen -p hub-api
}
