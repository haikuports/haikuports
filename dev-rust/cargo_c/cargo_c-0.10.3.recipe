SOURCE_URI_336="https://static.crates.io/crates/zeroize/zeroize-1.8.1.crate"
CHECKSUM_SHA256_336="ced3678a2879b30306d323f4542626697a464a97c0a07c9aebf7ebca65cd4dde"

ARCHITECTURES="x86_64"
if [ "$targetArchitecture" = x86_gcc2 ]; then
SECONDARY_ARCHITECTURES="x86"
fi

PROVIDES="
	cargo_c$secondaryArchSuffix = $portVersion
	cmd:cargo_capi
	cmd:cargo_cbuild
	cmd:cargo_cinstall
	cmd:cargo_ctest
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libcrypto$secondaryArchSuffix
	lib:libssl$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libcrypto$secondaryArchSuffix >= 3
	devel:libssl$secondaryArchSuffix >= 3
	devel:libz$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:cargo$secondaryArchSuffix
	cmd:gcc$secondaryArchSuffix
	cmd:pkg_config$secondaryArchSuffix
	"

defineDebugInfoPackage cargo_c$secondaryArchSuffix \
	$prefix/bin/cargo-capi \
	$prefix/bin/cargo-cbuild \
	$prefix/bin/cargo-cinstall \
	$prefix/bin/cargo-ctest

BUILD()
{
	export DISABLE_ASLR=1
	export CARGO_BUILD_JOBS=1

	export CARGO_HOME=$sourceDir/../cargo
	vendor=$CARGO_HOME/haiku
	mkdir -p "$vendor"
	for i in $(seq 2 336); do
		eval "srcDir=\$sourceDir$i"
		eval "sha256sum=\$CHECKSUM_SHA256_$i"
		set -- "$srcDir"/*
		ln -sf "$1" "$vendor"
		cat <<-EOF >"$vendor/${1##*/}/.cargo-checksum.json"
		{
		  "package": "$sha256sum",
		  "files": {}
		}
		EOF
	done

	cat <<-EOF >"$CARGO_HOME"/config.toml
	[source.haiku]
	directory = "$vendor"

	[source.crates-io]
	replace-with = "haiku"
	EOF

	cargo build --release --offline
}

INSTALL()
{
	export CARGO_HOME=$sourceDir/../cargo
	cargo install --frozen --root $prefix --path .

	rm -f $prefix/{.crates.toml,.crates2.json}
}

TEST()
{
	export CARGO_HOME=$sourceDir/../cargo
	cargo test --release --frozen
}
