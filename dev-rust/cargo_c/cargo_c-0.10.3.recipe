SUMMARY="Helper program to build and install c-like libraries"
DESCRIPTION="It produces and installs a correct pkg-config file, a static library and a \
dynamic library, and a C header to be used by any C (and C-compatible) software."
HOMEPAGE="https://github.com/lu-zero/cargo-c"
COPYRIGHT="2019-present Luca Barbato"
LICENSE="MIT"
REVISION="2"
SOURCE_URI="https://codeberg.org/Begasus/HaikuTestDrive/raw/branch/master/packages/cargo_c_x86-0.10.3-2-x86_gcc2.hpkg#noarchive"
CHECKSUM_SHA256="bba3f540d828cae20b08c98d657f7b91995ccfbb62b49c2d821e43eaf9ab3482"
SOURCE_DIR=""

ARCHITECTURES="!all"
if [ "$targetArchitecture" = x86_gcc2 ]; then
SECONDARY_ARCHITECTURES="x86"
fi

PROVIDES="
	cargo_c$secondaryArchSuffix = $portVersion
	cmd:cargo_capi
	cmd:cargo_cbuild
	cmd:cargo_cinstall
	cmd:cargo_ctest
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libcrypto$secondaryArchSuffix
	lib:libcurl$secondaryArchSuffix
	lib:libssh2$secondaryArchSuffix
	lib:libssl$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

defineDebugInfoPackage cargo_c$secondaryArchSuffix \
	$prefix/bin/cargo-capi \
	$prefix/bin/cargo-cbuild \
	$prefix/bin/cargo-cinstall \
	$prefix/bin/cargo-ctest

BUILD()
{
	package extract cargo_c_x86-0.10.3-2-x86_gcc2.hpkg
}

INSTALL()
{
	rm .PackageInfo
	rm cargo_c_x86-0.10.3-2-x86_gcc2.hpkg

	cp -r * $prefix
}
