SUMMARY="A modern GNOME media player for GTK4"
DESCRIPTION="Clapper is a modern media player designed for simplicity and ease of use. Powered \
by GStreamer and built for the GNOME desktop environment using GTK4 toolkit, it has a clean and \
stylish interface that lets you focus on enjoying your favorite videos.

This application aim is to offer all the essentials features you'd expect from a video player in \
a simple form.

Clapper uses a playback queue where you can add multiple media files. Think of it like a playlist \
that you can build. You can easily reorder items or remove them from the queue with a simple drag \
and drop operation."
HOMEPAGE="https://github.com/Rafostar/clapper"
COPYRIGHT="2026 Rafał Dzięgiel"
LICENSE="GNU GPL v3"
REVISION="1"
SOURCE_URI="https://github.com/Rafostar/clapper/archive/refs/tags/$portVersion.tar.gz"
CHECKSUM_SHA256="344c0f20e540a63c6fb44cdd5de88c168ed145bb66c1307e79b2b08124780118"
ADDITIONAL_FILES="clapper.rdef.in
	compile-schemas.sh"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="?x86"

# On x86_gcc2 we don't want to install the commands in bin/<arch>/, but in bin/.
commandSuffix=$secondaryArchSuffix
commandBinDir=$binDir
if [ "$targetArchitecture" = x86_gcc2 ]; then
	commandSuffix=
	commandBinDir=$prefix/bin
fi

libVersion="$portVersion"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

POST_INSTALL_SCRIPTS="
	$relativePostInstallDir/compile-schemas.sh
	"

PROVIDES="
	clapper$secondaryArchSuffix = $portVersion
	cmd:clapper$commandSuffix = $portVersion
	lib:libclapper_0.0$secondaryArchSuffix = $libVersionCompat
	lib:libclapper_gtk_0.0$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libadwaita_1$secondaryArchSuffix
	lib:libcgraph$secondaryArchSuffix
	lib:libgio_2.0$secondaryArchSuffix
	lib:libglib_2.0$secondaryArchSuffix
	lib:libgmodule_2.0$secondaryArchSuffix
	lib:libgobject_2.0$secondaryArchSuffix
	lib:libgraphene_1.0$secondaryArchSuffix
	lib:libgstreamer_1.0$secondaryArchSuffix
	lib:libgstvideo_1.0$secondaryArchSuffix
	lib:libgtk_4$secondaryArchSuffix
	lib:libgvc$secondaryArchSuffix
	lib:libintl$secondaryArchSuffix
	lib:libpango_1.0$secondaryArchSuffix
	lib:libpeas_2$secondaryArchSuffix
	"

PROVIDES_devel="
	clapper${secondaryArchSuffix}_devel = $portVersion
	devel:libclapper_0.0$secondaryArchSuffix = $libVersionCompat
	devel:libclapper_gtk_0.0$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	clapper$secondaryArchSuffix == $portVersion base
	devel:libpeas_2$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libadwaita_1$secondaryArchSuffix
	devel:libgirepository_1.0$secondaryArchSuffix
	devel:libGL$secondaryArchSuffix
	devel:libglib_2.0$secondaryArchSuffix
	devel:libgstgl_1.0$secondaryArchSuffix
	devel:libgstreamer_1.0$secondaryArchSuffix
	devel:libgstvideo_1.0$secondaryArchSuffix
	devel:libgtk_4$secondaryArchSuffix
	devel:libgvc$secondaryArchSuffix
	devel:libpeas_2$secondaryArchSuffix
	devel:libsoup_3.0$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	cmd:meson
	cmd:msgfmt$secondaryArchSuffix
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	cmd:vapigen
	"

BUILD()
{
	meson --buildtype=release build \
		--prefix=$prefix \
		--bindir=$commandBinDir \
		--includedir=$includeDir \
		--libdir=$libDir \
		-D enhancers-loader=enabled \
		-D gst-plugin=enabled \
		-D clapper-app=enabled \
		-D mpris=disabled \
		-Denhancers-loader=enabled --reconfigure

	ninja -v -C build
}

INSTALL()
{
	ninja -C build install

	# don't mess with shared_mime_info files
	rm -rf $dataDir/mime/{aliases,generic-icons,globs,globs2,icons,magic}
	rm -rf $dataDir/mime/{mime.cache,subclasses,treemagic,types,version,XMLnamespaces}

	rm -rf $dataDir/{applications,metainfo}
	rm -rf $dataDir/glib-2.0/schemas/gschemas.compiled
	rm -rf $dataDir/icons/hicolor/icon-theme.cache

	mkdir -p $postInstallDir
	cp -f $portDir/additional-files/compile-schemas.sh $postInstallDir
	chmod -v a+rx $postInstallDir/compile-schemas.sh

	local MAJOR="`echo "$portVersion" | cut -d. -f1`"
	local MIDDLE="`echo "$portVersion" | cut -d. -f2`"
	local MINOR="`echo "$portVersion" | cut -d. -f3`"
	local APP_NAME="Clapper"
	local LONG_INFO="$SUMMARY"
	local APP_SIGNATURE="application/x-vnd.clapper"
	sed \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		-e "s|@APP_NAME@|$APP_NAME|" \
		-e "s|@APP_SIGNATURE@|$APP_SIGNATURE|" \
		$portDir/additional-files/clapper.rdef.in > clapper.rdef

	addResourcesToBinaries clapper.rdef $commandBinDir/clapper
	addAppDeskbarSymlink $commandBinDir/clapper Clapper

	prepareInstalledDevelLibs \
		libclapper-0.0 \
		libclapper-gtk-0.0
	fixPkgconfig

	packageEntries devel \
		$developDir \
		$dataDir/gir-1.0 \
		$dataDir/vala
}
