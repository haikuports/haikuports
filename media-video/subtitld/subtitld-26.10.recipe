SUMMARY="A subtitle and caption editor"
DESCRIPTION="Subtitld creates and edits subtitles and captions. It has a \
timeline with the sound's waveform, a video preview, speakers with their own \
colours, and online synthetic voices (Microsoft Edge, Google) to dub with. It \
reads and writes the common subtitle formats: SRT, WebVTT, ASS and SSA, TTML, \
SAMI, SCC and more. Projects (.usfx) keep the video, the subtitles and the \
place you left them."
HOMEPAGE="https://subtitld.org"
COPYRIGHT="2020-2026 Jonatã Bolzan Loss"
LICENSE="GNU GPL v3"
REVISION="1"
SOURCE_URI="https://github.com/Subtitld/subtitld/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256="282f49d3cca716a20b79a928dec13f7b2c520406a8c5e40ae29503638f10aac9"
# Since the release: Haiku without a sound card, where Subtitld crashed at
# start, and silent playback, where the picture stood still.
PATCHES="subtitld-$portVersion.patchset"
ADDITIONAL_FILES="
	launcher.c
	subtitld.rdef.in
	subtitld-filetypes.sh
	"
# Subtitld's projects (.usfx) as a file type, with their icon, once installed.
POST_INSTALL_SCRIPTS="$relativePostInstallDir/subtitld-filetypes.sh"

# pyside6 is x86_64-only on Haiku, so the app follows it.
ARCHITECTURES="x86_64"

PROVIDES="
	subtitld = $portVersion
	app:Subtitld = $portVersion
	cmd:subtitld = $portVersion
	"
REQUIRES="
	haiku
	beautifulsoup4_python310
	chardet_python310
	edge_tts_python310
	gtts_python310
	lxml_python310
	numpy_python310
	opencv_python3.10
	platformdirs_python310
	pyside6
	pysubs2_python310
	python_docx_python310
	python_i18n_python310
	requests_python310
	scipy_python310
	sounddevice_python310
	soundfile_python310
	# Optional for pyside6 on Haiku, but the preview panel needs it.
	lib:libQt6Multimedia
	lib:libQt6MultimediaWidgets
	cmd:ffmpeg
	cmd:python3.10
	"

BUILD_REQUIRES="
	haiku_devel
	build_python310
	devel:libpython3.10
	installer_python310
	setuptools_python310
	wheel_python310
	"
BUILD_PREREQUIRES="
	cmd:gcc
	cmd:python3.10
	cmd:python3.10_config
	"

BUILD()
{
	# The tag's sources carry a placeholder version; the package's is this one.
	sed -i "s/^__version__ = .*/__version__ = '$portVersion'/" src/subtitld/__init__.py

	python3.10 -m build --wheel --no-isolation

	# The application itself: a native program that runs Subtitld inside the
	# system's Python, so Deskbar shows Subtitld, not Python (launcher.c).
	gcc -O2 -o subtitld-launcher $portDir/additional-files/launcher.c \
		$(python3.10-config --includes) -lpython3.10 \
		-DPYTHON="\"$prefix/bin/python3.10\""
}

INSTALL()
{
	python3.10 -m installer -p $prefix dist/*.whl

	# The application, in the apps directory: the launcher, with its
	# signature, version and icon as resources (subtitld.rdef.in).
	mkdir -p $appsDir
	cp subtitld-launcher $appsDir/Subtitld
	# A release is "26.10"; a build, "26.10.18.0446".
	local major middle minor
	IFS=. read -r major middle minor _ <<< "$portVersion"
	major=$((10#$major)) middle=$((10#${middle:-0})) minor=$((10#${minor:-0}))
	sed -e "s|@MAJOR@|$major|" -e "s|@MIDDLE@|$middle|" -e "s|@MINOR@|$minor|" \
		$portDir/additional-files/subtitld.rdef.in > subtitld.rdef
	addResourcesToBinaries subtitld.rdef $appsDir/Subtitld

	addAppDeskbarSymlink $appsDir/Subtitld

	# Adds the .usfx type to the MIME database (setmime), with its icon.
	mkdir -p $postInstallDir
	cp $portDir/additional-files/subtitld-filetypes.sh $postInstallDir/
	chmod 755 $postInstallDir/subtitld-filetypes.sh
}

TEST()
{
	# Import the UI modules headlessly; this catches missing dependencies
	# without needing app_server.
	QT_QPA_PLATFORM=offscreen python3.10 -c "
from subtitld.interface import startscreen, productionscreen, top_bar
from subtitld.modules import audioengine, file_io
print('subtitld imports OK')
"
}
