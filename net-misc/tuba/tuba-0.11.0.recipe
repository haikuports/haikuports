SUMMARY="Browse the Fediverse"
DESCRIPTION="Explore the federated social web with Tuba for GNOME. Stay connected to your \
favorite communities, family and friends with support for popular Fediverse platforms like \
Mastodon, GoToSocial, Akkoma & more!"
HOMEPAGE="https://tuba.geopjr.dev/"
COPYRIGHT="2018-2022 bleak_grey
	2022 Evangelos “GeopJr” Paterakis"
LICENSE="GNU GPL v3"
REVISION="1"
SOURCE_URI="https://codeberg.org/GeopJr/Tuba/archive/v$portVersion.tar.gz"
CHECKSUM_SHA256="169d0a8c48f1b77d1910a0f40ec4f71546eeeab3646783d7ac0148be54e4760a"
SOURCE_FILENAME="tuba-v$portVersion.tar.gz"
SOURCE_DIR="tuba"
ADDITIONAL_FILES="tuba.rdef.in
	compile-schemas.sh"

ARCHITECTURES="?all !x86_gcc2 x86_64"
SECONDARY_ARCHITECTURES="?x86"

POST_INSTALL_SCRIPTS="
	$relativePostInstallDir/compile-schemas.sh
	"

PROVIDES="
	tuba$secondaryArchSuffix = $portVersion
	app:Tuba = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libadwaita_1$secondaryArchSuffix
	lib:libcairo$secondaryArchSuffix
	lib:libclapper_gtk_0.0$secondaryArchSuffix
	lib:libgee_0.8$secondaryArchSuffix
	lib:libgexiv2$secondaryArchSuffix
	lib:libgdk_pixbuf_2.0$secondaryArchSuffix
	lib:libglib_2.0$secondaryArchSuffix
	lib:libgraphene_1.0$secondaryArchSuffix
	lib:libsoup_3.0$secondaryArchSuffix
	lib:libgstreamer_1.0$secondaryArchSuffix
	lib:libgtk_4$secondaryArchSuffix
	lib:libgtksourceview_5$secondaryArchSuffix
	lib:libicuuc$secondaryArchSuffix
	lib:libintl$secondaryArchSuffix
	lib:libjson_glib_1.0$secondaryArchSuffix
	lib:libpango_1.0$secondaryArchSuffix
	lib:libsecret_1$secondaryArchSuffix
	lib:libspelling_1$secondaryArchSuffix
	lib:libwebkitgtk_6.0$secondaryArchSuffix
	lib:libxml2$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libadwaita_1$secondaryArchSuffix
	devel:libclapper_gtk_0.0$secondaryArchSuffix
	devel:libgee_0.8$secondaryArchSuffix
	devel:libgexiv2$secondaryArchSuffix
	devel:libgirepository_1.0$secondaryArchSuffix
	devel:libglib_2.0$secondaryArchSuffix
	devel:libgstreamer_1.0$secondaryArchSuffix
	devel:libgtk_4$secondaryArchSuffix
	devel:libgtksourceview_5$secondaryArchSuffix
	devel:libicuuc$secondaryArchSuffix >= 74
	devel:libjson_glib_1.0$secondaryArchSuffix
	devel:libsecret_1$secondaryArchSuffix
	devel:libspelling_1$secondaryArchSuffix
	devel:libwebkitgtk_6.0$secondaryArchSuffix
	devel:libwebp$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:meson
	cmd:msgfmt$secondaryArchSuffix
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	cmd:vapigen
	"

PATCH()
{
	sed -i -e 's|update_desktop_database: true,|update_desktop_database: false,|' \
		meson.build
}

BUILD()
{
	meson --buildtype=release build \
		--prefix=$prefix

	ninja -C build $jobArgs
}

INSTALL()
{
	ninja -C build install

	mkdir -p $appsDir
	mv $binDir/dev.geopjr.Tuba $appsDir/Tuba

	rm -rf $dataDir/{applications,metainfo}
	rm -rf $dataDir/glib-2.0/schemas/gschemas.compiled
	rm -rf $dataDir/icons/hicolor/icon-theme.cache

	mkdir -p $postInstallDir
	cp -f $portDir/additional-files/compile-schemas.sh $postInstallDir
	chmod -v a+rx $postInstallDir/compile-schemas.sh

	local MAJOR="`echo "$portVersion" | cut -d. -f1`"
	local MIDDLE="`echo "$portVersion" | cut -d. -f2`"
	local MINOR="`echo "$portVersion" | cut -d. -f3`"
	local APP_NAME="Tuba"
	local LONG_INFO="$SUMMARY"
	local APP_SIGNATURE="application/x-vnd.tuba"
	sed \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		-e "s|@APP_NAME@|$APP_NAME|" \
		-e "s|@APP_SIGNATURE@|$APP_SIGNATURE|" \
		$portDir/additional-files/tuba.rdef.in > tuba.rdef

	addResourcesToBinaries tuba.rdef $appsDir/Tuba
	addAppDeskbarSymlink $appsDir/Tuba
}
