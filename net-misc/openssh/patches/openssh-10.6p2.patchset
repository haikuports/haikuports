From 7857f85eccb8b2f3c2a4fc2feb6ba03c92b3228e Mon Sep 17 00:00:00 2001
From: Zach Dykstra <dykstra.zachary@gmail.com>
Date: Sun, 27 Dec 2020 21:38:07 -0600
Subject: mux.c: use rename instead of unsupported hard link


diff --git a/mux.c b/mux.c
index e774938..9d9280b 100644
--- a/mux.c
+++ b/mux.c
@@ -1373,9 +1373,9 @@ muxserver_listen(struct ssh *ssh)
 	}
 
 	/* Now atomically "move" the mux socket into position */
-	if (link(options.control_path, orig_control_path) != 0) {
+	if (rename(options.control_path, orig_control_path) != 0) {
 		if (errno != EEXIST) {
-			fatal_f("link mux listener %s => %s: %s",
+			fatal_f("rename mux listener %s => %s: %s",
 			    options.control_path, orig_control_path,
 			    strerror(errno));
 		}
@@ -1384,7 +1384,6 @@ muxserver_listen(struct ssh *ssh)
 		unlink(options.control_path);
 		goto disable_mux_master;
 	}
-	unlink(options.control_path);
 	free(options.control_path);
 	options.control_path = orig_control_path;
 
-- 
2.54.0


From e3917e76499d9d3388da9be72749b85cd5dfb239 Mon Sep 17 00:00:00 2001
From: Jerome Duval <jerome.duval@gmail.com>
Date: Tue, 8 Jun 2021 14:25:15 +0200
Subject: gcc2 patch sntrup761.c


diff --git a/sntrup761.c b/sntrup761.c
index a731e56..b70c17c 100644
--- a/sntrup761.c
+++ b/sntrup761.c
@@ -1640,6 +1640,7 @@ static void crypto_sort_int32(void *array,long long n)
     for (q = top;q > p;q >>= 1) {
       if (j != i) for (;;) {
         if (j == n - q) goto done;
+{
         int32 a = x[j + p];
         for (r = q;r > p;r >>= 1)
           int32_MINMAX(a,x[j + r]);
@@ -1649,6 +1650,7 @@ static void crypto_sort_int32(void *array,long long n)
           i += 2 * p;
           break;
         }
+}
       }
       while (i + p <= n - q) {
         for (j = i;j < i + p;++j) {
-- 
2.54.0


From 737b54b66f7ca098597ae030e6c4a429c97f2f96 Mon Sep 17 00:00:00 2001
From: Sergei Reznikov <diver@gelios.net>
Date: Wed, 20 Oct 2021 16:57:50 +0300
Subject: Use a link to take a backup while replacing the known_hosts file

Based on https://github.com/termux/termux-packages/commit/e696010d8907854dd194311ce8a02da0ca77a121

diff --git a/hostfile.c b/hostfile.c
index 033b291..e077832 100644
--- a/hostfile.c
+++ b/hostfile.c
@@ -729,7 +729,11 @@ hostfile_replace_entries(const char *filename, const char *host, const char *ip,
 			r = SSH_ERR_SYSTEM_ERROR;
 			goto fail;
 		}
+#ifdef __HAIKU__
+		if (rename(filename, back) == -1) {
+#else
 		if (link(filename, back) == -1) {
+#endif
 			oerrno = errno;
 			error_f("link %.100s to %.100s: %s", filename,
 			    back, strerror(errno));
diff --git a/ssh-keygen.c b/ssh-keygen.c
index 5c2d645..408fa93 100644
--- a/ssh-keygen.c
+++ b/ssh-keygen.c
@@ -1359,7 +1359,11 @@ do_known_hosts(struct passwd *pw, const char *name, int find_host,
 		/* Backup existing file */
 		if (unlink(old) == -1 && errno != ENOENT)
 			fatal("unlink %.100s: %s", old, strerror(errno));
+#ifdef __HAIKU__
+		if (rename(identity_file, old) == -1)
+#else
 		if (link(identity_file, old) == -1)
+#endif
 			fatal("link %.100s to %.100s: %s", identity_file, old,
 			    strerror(errno));
 		/* Move new one into place */
-- 
2.54.0

