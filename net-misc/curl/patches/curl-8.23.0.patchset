From 9e65a69c201e0cf4d3e3d0524b4cf21ce3f7cd0d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?J=C3=A9r=C3=B4me=20Duval?= <jerome.duval@gmail.com>
Date: Wed, 16 Sep 2026 19:53:14 +0200
Subject: disable SOCK_NONBLOCK for Haiku


diff --git a/lib/curl_setup.h b/lib/curl_setup.h
index 0af3a67..f8e6ab8 100644
--- a/lib/curl_setup.h
+++ b/lib/curl_setup.h
@@ -1622,7 +1622,7 @@ typedef struct sockaddr_un {
 #endif
 
 /* NetBSD before 6.1 did not set SS_NBIO for SOCK_NONBLOCK. */
-#if defined(SOCK_NONBLOCK) && \
+#if defined(SOCK_NONBLOCK) && !defined(__HAIKU__) && \
   (!defined(__NetBSD__) || (__NetBSD_Version__ >= 601000000))
 #define CURL_USE_SOCK_NONBLOCK
 #endif
-- 
2.54.0

