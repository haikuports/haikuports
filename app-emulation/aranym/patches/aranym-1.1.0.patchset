--- a/src/Unix/beos/clipbrd_beos.cpp
+++ b/src/Unix/beos/clipbrd_beos.cpp
@@ -18,7 +18,9 @@
     Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
 */
 
-#include "sysdeps.h"
+#ifndef __HAIKU__
+	#include "sysdeps.h"
+#endif
 #if defined(OS_beos)
 #include <Clipboard.h>
 #include <String.h>
@@ -28,8 +30,9 @@
 #include "SDL_compat.h"
 #include "clipbrd.h"
 
-#define DEBUG 0
-#include "debug.h"
+#ifndef UNUSED
