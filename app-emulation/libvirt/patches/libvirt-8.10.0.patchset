From 97d716f34ccdcd2b22f900ebf400eb7fe949d978 Mon Sep 17 00:00:00 2001
From: Oscar Lesta <oscar.lesta@gmail.com>
Date: Fri, 31 Jul 2026 10:16:46 -0300
Subject: Undef WITH_DECL_CPU_SET_T to avoid link errors.


diff --git a/src/util/virprocess.c b/src/util/virprocess.c
index 39ca5de..66fa574 100644
--- a/src/util/virprocess.c
+++ b/src/util/virprocess.c
@@ -34,8 +34,14 @@
 # include <sys/time.h>
 # include <sys/resource.h>
 #endif
-#if WITH_SCHED_H
-# include <sched.h>
+
+#if !defined(__HAIKU__)
+    #if WITH_SCHED_H
+    # include <sched.h>
+    #endif
+#else
+    // On Haiku meson sets this to 1, but we lack CPU_ALLOC / CPU_ALLOC_SIZE / etc.
+    #undef WITH_DECL_CPU_SET_T
 #endif
 
 #if defined(__FreeBSD__) || defined(__FreeBSD_kernel__) || WITH_BSD_CPU_AFFINITY
-- 
2.54.0

