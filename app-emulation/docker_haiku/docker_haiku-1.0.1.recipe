SUMMARY="Docker Engine & Micro-VM with NVMM Acceleration for Haiku"
DESCRIPTION="Provides standard docker CLI command execution and micro-VM management on Haiku OS powered by QEMU with NVMM hardware virtualization, automatic SSH port forwarding daemon, bidirectional dev sharing via sshfs, and Deskbar tray management. Persistent user data is safely maintained in ~/config/settings/docker-vm."
HOMEPAGE="https://github.com/timmagicbeans/haiku-docker"
COPYRIGHT="2026 Haiku Docker Project"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://github.com/timmagicbeans/haiku-docker/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256="11ee5e9855d74e80230604f01fab91a17370c715647b32aaa7b5c261a4cb939b"
SOURCE_DIR="haiku-docker-$portVersion"

ARCHITECTURES="x86_64"

PROVIDES="
	docker_haiku = $portVersion
	cmd:docker = $portVersion
	cmd:docker_vm = $portVersion
	cmd:DockerDeskbar = $portVersion
	cmd:path_monitor = $portVersion
	"
REQUIRES="
	haiku >= r1~beta6
	qemu_x86 >= 8.0
	openssh
	cmd:python3
	"

BUILD_REQUIRES="
	haiku_devel >= r1~beta6
	"
BUILD_PREREQUIRES="
	cmd:g++
	cmd:make
	cmd:rc
	cmd:xres
	"

BUILD()
{
	g++ -O2 -I/boot/system/develop/headers/private/storage -o path_monitor path_monitor.cpp -lbe
	g++ -Wall -shared -fPIC -Wl,--export-dynamic -o DockerDeskbar DeskbarDocker.cpp -lbe -lnetwork
	rc -o add_deskbar.rsrc add_deskbar.rdef
	xres -o DockerDeskbar add_deskbar.rsrc
	mimeset -f DockerDeskbar
}

INSTALL()
{
	mkdir -p $binDir
	cp docker $binDir/
	cp docker_vm $binDir/
	ln -s docker_vm $binDir/docker-vm
	cp DockerDeskbar $binDir/
	cp path_monitor $binDir/
	cp fs_bridge.py $binDir/
	cp port_daemon.py $binDir/

	mkdir -p $dataDir/deskbar/menu/Applications
	addPreferencesDeskbarSymlink $binDir/docker_vm "Docker"
}
