From 4d9ad889e3ec67829f5b715d93e1e60aaf694163 Mon Sep 17 00:00:00 2001
From: Jerome Duval <jerome.duval@gmail.com>
Date: Thu, 29 Jun 2017 17:06:55 +0200
Subject: import fix from previous version
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Co-authored-by: Joachim Mairböck <j.mairboeck@gmail.com>

diff --git a/cmdbuf.c b/cmdbuf.c
index 5c6600f..96fc573 100644
--- a/cmdbuf.c
+++ b/cmdbuf.c
@@ -1486,12 +1486,19 @@ static char * histfile_find(lbool must_exist)
 	name = dirfile(lgetenv("XDG_STATE_HOME"), &LESSHISTFILE[1], must_exist);
 	if (name == NULL)
 	{
+#ifdef __HAIKU__
+		char dir[B_PATH_NAME_LENGTH+B_FILE_NAME_LENGTH];
+		dev_t volume = dev_for_path("/boot");
+		if (find_directory(B_USER_VAR_DIRECTORY, volume, true, dir, sizeof(dir)) == B_OK)
+			name = dirfile(dir, &LESSHISTFILE[1], must_exist);
+#else
 		char *dir = dirfile(home, ".local/state", TRUE);
 		if (dir != NULL)
 		{
 			name = dirfile(dir, &LESSHISTFILE[1], must_exist);
 			free(dir);
 		}
+#endif
 	}
 	if (name == NULL)
 		name = dirfile(lgetenv("XDG_DATA_HOME"), &LESSHISTFILE[1], must_exist);
diff --git a/configure.ac b/configure.ac
index 1dbe057..040ee0f 100644
--- a/configure.ac
+++ b/configure.ac
@@ -629,9 +629,15 @@ AH_TOP([
  * LESSHISTFILE is the filename of the history file
  * (in the HOME directory).
  */
+#ifdef __HAIKU__
+# define	LESSKEYFILE		"less"
+# define	LESSKEYFILE_SYS		SYSDIR "/sysless"
+# define	DEF_LESSKEYINFILE	"lesskey"
+#else
 #define LESSKEYFILE             ".less"
 #define LESSKEYFILE_SYS         SYSDIR "/sysless"
 #define DEF_LESSKEYINFILE       ".lesskey"
+#endif
 #define LESSKEYINFILE_SYS       SYSDIR "/syslesskey"
 #define LESSHISTFILE            ".lesshst"
 
diff --git a/filename.c b/filename.c
index 151647b..6d02c8b 100644
--- a/filename.c
+++ b/filename.c
@@ -313,10 +313,21 @@ public char * homefile(constant char *filename)
 {
 	char *pathname;
 
+#ifdef __HAIKU__
+	char path[B_PATH_NAME_LENGTH+B_FILE_NAME_LENGTH];
+	dev_t volume = dev_for_path("/boot");
+	if (find_directory(B_USER_SETTINGS_DIRECTORY, volume, true, path, sizeof(path)) != B_OK)
+		return (NULL);
+
+	pathname = dirfile(path, filename, 1);
+	if (pathname != NULL)
+		return (pathname);
+#else
 	/* Try $HOME/filename. */
 	pathname = dirfile(lgetenv("HOME"), filename, TRUE);
 	if (pathname != NULL)
 		return (pathname);
+#endif
 #if OS2
 	/* Try $INIT/filename. */
 	pathname = dirfile(lgetenv("INIT"), filename, TRUE);
diff --git a/less.h b/less.h
index 5814fd0..a7acdab 100644
--- a/less.h
+++ b/less.h
@@ -100,6 +100,11 @@ typedef unsigned long uintmax;
 #include <floss.h>
 #endif
 
+#ifdef __HAIKU__
+#include <FindDirectory.h>
+#include <StorageDefs.h>
+#endif
+
 #if MSDOS_COMPILER==WIN32C || OS2
 #include <io.h>
 #endif
-- 
2.54.0


