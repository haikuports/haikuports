+#if defined(USE_DBUS_ACCESSIBILITY) && !defined(__HAIKU__)
 		_isActive = ReadScreenReaderEnabled(_private->status);
+#else
+		_isActive = QAccessible::isActive();
+#endif
 	}
 }
 
