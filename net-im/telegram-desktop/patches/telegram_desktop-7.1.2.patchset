 set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
@@ -221,6 +221,8 @@ if(MSVC)
 		add_definitions(-DUSE_WINHELLO)
 	endif()
 	set(NFC_LINUX OFF)
+elseif (HAIKU)
+    set(NFC_LINUX OFF)
 else()
 	include(FindPkgConfig)
 	pkg_search_module(CBOR libcbor)
@@ -244,7 +246,7 @@ else()
 		set(CRYPTO_LIBRARIES "crypto")
