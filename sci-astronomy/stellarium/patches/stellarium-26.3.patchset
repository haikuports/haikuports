From 5403c46697abddcba72746f656ddc3e0f45621b1 Mon Sep 17 00:00:00 2001
From: "Alexander V. Wolf" <alex.v.wolf@gmail.com>
Date: Thu, 8 Oct 2026 00:02:13 +0000
Subject: Fixed compiling on Haiku


diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index eebe395..82fabe4 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -632,6 +632,10 @@ IF(ENABLE_SHOWMYSKY)
 ENDIF()
 TARGET_INCLUDE_DIRECTORIES(stelMain PRIVATE "${md4c_SOURCE_DIR}/src")
 
+IF(HAIKU)
+     TARGET_INCLUDE_DIRECTORIES(stelMain PRIVATE "/boot/system/develop/headers/private/shared")
+ENDIF()
+
 SET_TARGET_PROPERTIES(stellarium PROPERTIES ENABLE_EXPORTS TRUE)
 
 ADD_DEPENDENCIES(stellarium AllStaticPlugins)
diff --git a/src/StelSystemInfo.cpp b/src/StelSystemInfo.cpp
index 851212f..d171f73 100644
--- a/src/StelSystemInfo.cpp
+++ b/src/StelSystemInfo.cpp
@@ -60,8 +60,8 @@
 #endif
 
 #ifdef Q_OS_HAIKU
-#include <os/kernel/OS.h>
-#include <private/shared/cpu_type.h>
+#include <OS.h>
+#include <cpu_type.h>
 #endif
 
 void printSystemInfo()
