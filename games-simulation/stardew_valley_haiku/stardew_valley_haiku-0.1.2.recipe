SUMMARY="Country-life farming RPG (needs purchased game data)"
DESCRIPTION="Play Stardew Valley natively on Haiku. Inherit your grandfather's old farm, grow \
crops, raise animals, fish, mine the caves, craft, and get to know the people of Pelican Town. \
This package runs the Windows version of Stardew Valley 1.6 with the Haiku port of .NET and a \
patched MonoGame, and includes SMAPI for mods, a gamepad/controller mapping tool and a Steam \
downloader.

You need to own Stardew Valley (Steam, or the Windows build from GOG): this package contains no \
game files. On first start, setup opens in Terminal and offers to download the game with your \
own Steam account, or tells you where to copy an existing install. Game files, saves, mods, \
logs and settings are all kept in ~/config/settings/StardewValley.

This project is unofficial and not affiliated with ConcernedApe."
HOMEPAGE="https://github.com/Techniix/Stardew-Valley_HaikuOS"
COPYRIGHT="2026 Producdevity
	2026 Dalton Singleton
	2009-2021 The MonoGame Team
	Pathoschild (SMAPI)
	.NET Foundation and Contributors"
LICENSE="MIT
	GNU LGPL v3
	Ms-PL"
REVISION="1"
SOURCE_URI="https://github.com/Techniix/Stardew-Valley_HaikuOS/releases/download/haiku-v$portVersion/StardewValley-haiku.zip"
CHECKSUM_SHA256="3eafb4050ca5e5893ebe8249dd13499992c54c6ca44a541a67694afcb2187273"
SOURCE_DIR="StardewValley"
# The Haiku build of .NET (trungnt2910/dotnet-builds); only the runtime is
# installed. Unpacked in INSTALL because the archive has no top-level folder.
dotnetBuild="net10-haiku-x64-20260508.2-Release"
dotnetRuntime="10.0.7-servicing.26258.2"
SOURCE_URI_2="https://github.com/trungnt2910/dotnet-builds/releases/download/$dotnetBuild/$dotnetBuild.tar.gz#noarchive"
CHECKSUM_SHA256_2="f2e1a715a68d0277532a16d6b66e044a448d1ba7cba26717095a16757e7991e8"

ARCHITECTURES="!x86_gcc2 !x86 x86_64"
DISABLE_SOURCE_PACKAGE="yes"

PROVIDES="
	stardew_valley_haiku = $portVersion
	"
REQUIRES="
	haiku
	cmd:curl
	cmd:jq
	cmd:unzip
	lib:libgssapi_krb5
	lib:libSDL2_2.0
	lib:libssp
	lib:libunwind
	openal
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libSDL2_2.0
	"
BUILD_PREREQUIRES="
	cmd:g++
	cmd:gcc
	cmd:tar
	"

BUILD()
{
	# Native shims (Windows API stand-ins, Steam stubs, gamepad tool,
	# media-services helper), from the sources in native-src/.
	bash ./build-native.sh libs
}

INSTALL()
{
	local appDir=$appsDir/StardewValley
	mkdir -p $appDir
	cp -a . $appDir/

	# Linux launchers from the .NET and SMAPI builds; on Haiku both tools run
	# through "dotnet <name>.dll".
	rm -f $appDir/tools/MainlineGameDataPatcher/MainlineGameDataPatcher \
		$appDir/tools/SMAPIBundle/game-root/StardewModdingAPI \
		$appDir/tools/SMAPIBundle/game-root/unix-launcher.sh

	# HaikuPorter's zip extraction drops the executable bits.
	chmod 755 $appDir/*.sh $appDir/tools/udp-relay.py

	# Tells the scripts they run from a read-only package: writable data
	# goes to ~/config/settings/StardewValley and setup skips pkgman and builds.
	touch $appDir/.packaged
	rm -f $appDir/gamedata/.keep $appDir/Mods/.keep
	rmdir $appDir/gamedata $appDir/Mods 2>/dev/null || true

	# .NET runtime only (no SDK): host, hostfxr and Microsoft.NETCore.App.
	local dotnetTmp=$sourceDir/dotnet-full
	mkdir -p $dotnetTmp
	tar -xzf $sourceDir2/$dotnetBuild.tar.gz -C $dotnetTmp
	mkdir -p $appDir/dotnet/host $appDir/dotnet/shared
	cp -a $dotnetTmp/dotnet $dotnetTmp/LICENSE.txt \
		$dotnetTmp/ThirdPartyNotices.txt $appDir/dotnet/
	cp -a $dotnetTmp/host/fxr $appDir/dotnet/host/
	cp -a $dotnetTmp/shared/Microsoft.NETCore.App $appDir/dotnet/shared/
	[ -d $appDir/dotnet/shared/Microsoft.NETCore.App/$dotnetRuntime ]
	rm -rf $dotnetTmp

	addAppDeskbarSymlink $appDir/StardewValley.sh "Stardew Valley"
}
