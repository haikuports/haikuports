SUMMARY="The FlightGear flight simulator"
DESCRIPTION="a free, open-source, multi-platform flight simulator"
HOMEPAGE="https://www.flightgear.org"
COPYRIGHT="1997-2026 The FlightGear project contributors"
LICENSE="GNU GPL v2"
REVISION="1"
SOURCE_URI="https://gitlab.com/flightgear/flightgear/-/archive/$portVersion/flightgear-$portVersion.tar.bz2"
CHECKSUM_SHA256="4627c654fcd79d064eee9173ada23a0ee4bdb83b616e95f5f41e7f20e9d0b417"
PATCHES="flightgear-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	flightgear$secondaryArchSuffix = $portVersion
	app:FlightGear = $portVersion
	cmd:fgelev$secondaryArchSuffix = $portVersion
	cmd:fgfs$secondaryArchSuffix = $portVersion
	cmd:fgjs$secondaryArchSuffix = $portVersion
	cmd:fgtraffic$secondaryArchSuffix = $portVersion
	cmd:fgviewer$secondaryArchSuffix = $portVersion
	cmd:GPSsmooth$secondaryArchSuffix = $portVersion
	cmd:js_demo$secondaryArchSuffix = $portVersion
	cmd:JSBSim$secondaryArchSuffix = $portVersion
	cmd:metar$secondaryArchSuffix = $portVersion
	cmd:MIDGsmooth$secondaryArchSuffix = $portVersion
	cmd:nasal$secondaryArchSuffix = $portVersion
	cmd:UGsmooth$secondaryArchSuffix = $portVersion
	cmd:yasim$secondaryArchSuffix = $portVersion
	cmd:yasim_proptest$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libGL$secondaryArchSuffix
	lib:libosg$secondaryArchSuffix
	lib:libQt6Core$secondaryArchSuffix
	lib:libQt6Gui$secondaryArchSuffix
	lib:libQt6Network$secondaryArchSuffix
	lib:libQt6Qml$secondaryArchSuffix
	lib:libQt6Widgets$secondaryArchSuffix
	lib:libSimGearCore$secondaryArchSuffix
	lib:libSimGearScene$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	qt6_tools${secondaryArchSuffix}_devel
	boost1.90${secondaryArchSuffix}_devel
	devel:libcurl$secondaryArchSuffix
	devel:libGL$secondaryArchSuffix
	devel:liblzma$secondaryArchSuffix
	devel:libopenal$secondaryArchSuffix
	devel:libosg$secondaryArchSuffix
	devel:libplibssg$secondaryArchSuffix
	devel:libQt6Core$secondaryArchSuffix
	devel:libQt6Gui$secondaryArchSuffix
	devel:libQt6Network$secondaryArchSuffix
	devel:libQt6Qml$secondaryArchSuffix
	devel:libQt6Widgets$secondaryArchSuffix
	devel:libSimGearCore$secondaryArchSuffix
	devel:libSimGearScene$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:g++$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	export CFLAGS="-O3 -fPIC"
	export CXXFLAGS="-O3 -fPIC"
	export LDFLAGS="-Wl,--as-needed"

	cmake -S . -B build \
        $cmakeDirArgs \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_C_COMPILE_OPTIONS_PIE:STRING= \
		-DCMAKE_CXX_COMPILE_OPTIONS_PIE:STRING= \
		-DCMAKE_C_LINK_OPTIONS_PIE:STRING= \
		-DCMAKE_CXX_LINK_OPTIONS_PIE:STRING= \
		-DCMAKE_C_FLAGS="$CFLAGS" \
		-DCMAKE_CXX_FLAGS="$CXXFLAGS" \
        -DCMAKE_EXE_LINKER_FLAGS="-Wl,--as-needed" \
        -DCMAKE_SHARED_LINKER_FLAGS="-Wl,--as-needed" \
  		-DFG_DATA_DIR:PATH="$dataDir/FlightGear" \
		-DENABLE_QT:BOOL=ON \
		-DCHECK_FOR_QT5:BOOL=OFF \
		-DCHECK_FOR_QT6:BOOL=ON \
		-DENABLE_FGCOM:BOOL=OFF \
		-DENABLE_IAX:BOOL=OFF \
		-DENABLE_VR:BOOL=OFF \
		-DENABLE_SENTRY:BOOL=OFF \
		-DEVENT_INPUT:BOOL=OFF \
		-DENABLE_HID_INPUT:BOOL=OFF \
		-DENABLE_SWIFT:BOOL=OFF \
		-DENABLE_FGQCANVAS:BOOL=OFF \
		-DENABLE_AUTOTESTING:BOOL=OFF \
		-DOSG_PLUGINS_DIR=$addOnsDir \
		-DFG_BUILD_TYPE:STRING=Release

	cmake --build build $jobArgs
}

INSTALL()
{
	cmake --install build
}
