From 52d80f546fc57964cd3070d186e2b19549431a24 Mon Sep 17 00:00:00 2001
From: Ken Mays <kmays2000@gmail.com>
Date: Mon, 15 Dec 2025 20:03:42 +0600
Subject: Haiku migration


diff --git a/3rdparty/hts_engine_API/lib/HTS_misc.c b/3rdparty/hts_engine_API/lib/HTS_misc.c
index d4ff2d4..c3d8a0f 100755
--- a/3rdparty/hts_engine_API/lib/HTS_misc.c
+++ b/3rdparty/hts_engine_API/lib/HTS_misc.c
@@ -280,9 +280,9 @@ size_t HTS_ftell(HTS_File * fp)
    if (fp == NULL) {
       return 0;
    } else if (fp->type == HTS_FILE) {
-      fpos_t pos;
+      long pos;
       fgetpos((FILE *) fp->pointer, &pos);
-#if defined(_WIN32) || defined(__CYGWIN__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__ANDROID__) || defined(__OpenBSD__)
+#if defined(_WIN32) || defined(__CYGWIN__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__ANDROID__) || defined(__OpenBSD__) || defined(__HAIKU__)
       return (size_t) pos;
 #else
       return (size_t) pos.__pos;
diff --git a/3rdparty/joystick/jsNone.cxx b/3rdparty/joystick/jsNone.cxx
index 0d2452f..7a077be 100644
--- a/3rdparty/joystick/jsNone.cxx
+++ b/3rdparty/joystick/jsNone.cxx
@@ -26,6 +26,10 @@
   #define TRUE JS_TRUE
 #endif
 
+#ifdef __HAIKU__
+	#define TRUE true
+#endif 
+
 struct os_specific_s ;
 
 
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 138e397..ad3da5b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -471,7 +471,7 @@ if(CMAKE_COMPILER_IS_GNUCXX)
     if(HAVE_QT)
         # if Qt is built with reduce-relocations, applicatino code
         # needs to be compiled with -fPIC to match
-        set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+        set(CMAKE_POSITION_INDEPENDENT_CODE OFF)
     endif()
 endif(CMAKE_COMPILER_IS_GNUCXX)
 
diff --git a/src/FDM/JSBSim/CMakeLists.txt b/src/FDM/JSBSim/CMakeLists.txt
index 1592faf..fcb6f93 100644
--- a/src/FDM/JSBSim/CMakeLists.txt
+++ b/src/FDM/JSBSim/CMakeLists.txt
@@ -199,7 +199,7 @@ add_library(JSBSim STATIC ${SOURCES} ${HEADERS})
 set(VERSION_MESSAGE "compiled from FlightGear ${FLIGHTGEAR_VERSION}")
 add_definitions("-DJSBSIM_VERSION=\"${VERSION_MESSAGE}\"")
 
-target_link_libraries(JSBSim SimGearCore)
+target_link_libraries(JSBSim SimGearCore network)
 target_include_directories(JSBSim PRIVATE ${PROJECT_SOURCE_DIR}/src/FDM/JSBSim)
 
 add_executable(JSBsim_bin JSBSim.cpp )
diff --git a/src/FDM/JSBSim/input_output/string_utilities.cpp b/src/FDM/JSBSim/input_output/string_utilities.cpp
index 2031e9d..b4c5269 100644
--- a/src/FDM/JSBSim/input_output/string_utilities.cpp
+++ b/src/FDM/JSBSim/input_output/string_utilities.cpp
@@ -88,7 +88,11 @@ double atof_locale_c(const std::string& input)
 
   CNumericLocale numeric_c;
   errno = 0;          // Reset the error code
+#ifdef __HAIKU__
+  double value = strtod(first, nullptr);
+#else
   double value = strtod_l(first, nullptr, numeric_c.Locale);
+#endif
 
   // Error management
   std::stringstream s;
diff --git a/src/Instrumentation/HUD/HUD.cxx b/src/Instrumentation/HUD/HUD.cxx
index 1dfee9e..ec2413d 100644
--- a/src/Instrumentation/HUD/HUD.cxx
+++ b/src/Instrumentation/HUD/HUD.cxx
@@ -223,7 +223,7 @@ void HUD::draw3D()
     Matrixf proj
         = Matrixf::perspective(view->get_v_fov(), 1/view->get_aspect_ratio(),
                                0.1, 10);
-    glLoadMatrix(proj.ptr());
+    glLoadMatrixf(proj.ptr());
 
     glMatrixMode(GL_MODELVIEW);
     glPushMatrix();
@@ -237,7 +237,7 @@ void HUD::draw3D()
         lookat[1] = 9999; // FPU sanity
     Matrixf mv = Matrixf::lookAt(Vec3f(0.0, 0.0, 0.0), lookat,
                                  Vec3f(0.0, 1.0, 0.0));
-    glLoadMatrix(mv.ptr());
+    glLoadMatrixf(mv.ptr());
 
     // Map the -1:1 square to a 55.0x41.25 degree wide patch at z=1.
     // This is the default fgfs field of view, which the HUD files are
@@ -271,7 +271,7 @@ void HUD::draw2D(GLfloat x_start, GLfloat y_start, GLfloat x_end, GLfloat y_end)
     glMatrixMode(GL_PROJECTION);
     glPushMatrix();
     Matrixf proj = Matrixf::ortho2D(x_start, x_end, y_start, y_end);
-    glLoadMatrix(proj.ptr());
+    glLoadMatrixf(proj.ptr());
 
     glMatrixMode(GL_MODELVIEW);
     glPushMatrix();
diff --git a/src/Main/MultipleInstanceLock.cxx b/src/Main/MultipleInstanceLock.cxx
index a47d7bb..a6af54d 100644
--- a/src/Main/MultipleInstanceLock.cxx
+++ b/src/Main/MultipleInstanceLock.cxx
@@ -24,6 +24,8 @@
 #include <unistd.h>
 #endif
 
+#include <fcntl.h>
+
 namespace {
 
 #if defined(SG_WINDOWS)
diff --git a/src/Main/bootstrap.cxx b/src/Main/bootstrap.cxx
index 7fd39ff..ae8a297 100755
--- a/src/Main/bootstrap.cxx
+++ b/src/Main/bootstrap.cxx
@@ -191,14 +191,14 @@ bool checkUniversalCRTVersion()
 
 #endif
 
-#if defined(__GNUC__)
+#if defined(__GNUC__) && !defined (__HAIKU__)
 #include <execinfo.h>
 #include <cxxabi.h>
 void segfault_handler(int signo) {
 
   fprintf(stderr, "Error: caught signal %d:\n", signo);
 
-  #ifndef __OpenBSD__
+  #if !defined(__OpenBSD__) || !defined(__HAIKU__)
   void *array[128];
   size_t size;
   size = backtrace(array, 128);
-- 
2.54.0

