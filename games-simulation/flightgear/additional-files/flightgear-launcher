#!/bin/sh
# Haiku launcher for FlightGear.
#
# Tracker/Deskbar launches this file as the application.  Do not invoke fgfs
# directly here: the normal fgfs executable without --launcher starts the
# simulator immediately and can fail before the user has selected FGData.
#
# Use an installed FG_ROOT when present; otherwise let the Qt launcher locate
# or download/select the base package in the normal FlightGear way.

FG_ROOT="/system/data/FlightGear"

cd "$HOME" || exit 1

if [ -d "$FG_ROOT" ] && [ -f "$FG_ROOT/version" ]; then
	exec fgfs --launcher --fg-root="$FG_ROOT" "$@"
else
	exec fgfs --launcher "$@"
fi
