SUMMARY="Python bindings for the Qt 6 cross-platform application and UI framework"
DESCRIPTION="The Qt for Python project aims to provide a complete port of the PySide module to \
Qt. The development started on GitHub in May 2015. The project managed to port PySide to Qt 5.3, \
5.4 & 5.5. During April 2016 The Qt Company decided to properly support the port (see details ).

The module was released mid June 2018 as a Technical Preview (supporting Qt 5.11), and it was \
officially released without the Technical Preview tag, in December 2018 for Qt 5.12. In December \
2020, the module was released for Qt6, which is the latest available version, which has the \
following differences:

* It doesn't support Python 2.7,
* Dropped support for Python 3.5, keeping 3.6+ only until PySide 6.3
* PySide 6.4 is the first version that supports Python 3.7+"
HOMEPAGE="https://wiki.qt.io/Qt_for_Python"
COPYRIGHT="2015-2026 The Qt Company Ltd."
LICENSE="BSD (3-clause)
	GNU GPL v2
	GNU LGPL v3"
REVISION="2"
SOURCE_URI="https://download.qt.io/official_releases/QtForPython/pyside6/PySide6-$portVersion-src/pyside-setup-everywhere-src-$portVersion.tar.xz"
CHECKSUM_SHA256="2c7462fe0cecb5b8ac0a3d92014b8d0b88bd4d9f8646709dab5286d9416f45bc"
SOURCE_DIR="pyside-setup-everywhere-src-$portVersion"

setuptoolsBuild=true

if $setuptoolsBuild; then
PATCHES="pyside6-$portVersion-setuptools.patchset"
else
PATCHES="pyside6-$portVersion-cmake.patchset"
fi

ARCHITECTURES="?all x86_64"
SECONDARY_ARCHITECTURES="?x86"

libVersion="$portVersion"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

clangVer="21"	# Newer clang versions don't work because of changes in clang 22.
				# The necessary changes are available in pyside 6.11+
defaultPythonVersion="3.14"

if ! $setuptoolsBuild; then
PROVIDES="
	pyside6$secondaryArchSuffix = $portVersion
	lib:libpyside6.abi3$secondaryArchSuffix = $libVersionCompat
	lib:libpyside6qml.abi3$secondaryArchSuffix = $libVersionCompat
	lib:libshiboken6.abi3$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libGL$secondaryArchSuffix
	lib:libopenal$secondaryArchSuffix
	# Qt6
	lib:libQt6Core$secondaryArchSuffix
	lib:libQt6Qml$secondaryArchSuffix
	# optional -- not including these causes policy warnings
#	lib:libQt63DCore$secondaryArchSuffix
#	lib:libQt6Charts$secondaryArchSuffix
#	lib:libQt6DataVisualization$secondaryArchSuffix
#	lib:libQt6Help$secondaryArchSuffix
#	lib:libQt6Location$secondaryArchSuffix
#	lib:libQt6Multimedia$secondaryArchSuffix
#	lib:libQt6Network$secondaryArchSuffix
#	lib:libQt6Positioning$secondaryArchSuffix
#	lib:libQt6Quick$secondaryArchSuffix
#	lib:libQt6Quick3D$secondaryArchSuffix
#	lib:libQt6Scxml$secondaryArchSuffix
#	lib:libQt6Sensors$secondaryArchSuffix
#	lib:libQt6SerialPort$secondaryArchSuffix
#	lib:libQt6SpatialAudio$secondaryArchSuffix
#	lib:libQt6StateMachine$secondaryArchSuffix
#	lib:libQt6Svg$secondaryArchSuffix
#	lib:libQt6TextToSpeech$secondaryArchSuffix
#	lib:libQt6WebChannelQuick$secondaryArchSuffix
#	lib:libQt6WebSockets$secondaryArchSuffix
#	lib:libQt6Xml$secondaryArchSuffix
	"
REPLACES="
	shiboken6$secondaryArchSuffix
	"

PROVIDES_devel="
	pyside6${secondaryArchSuffix}_devel = $portVersion
	devel:libpyside6.abi3$secondaryArchSuffix = $libVersionCompat
	devel:libpyside6qml.abi3$secondaryArchSuffix = $libVersionCompat
#	devel:libpyside6remoteobjects$secondaryArchSuffix
	devel:libshiboken6.abi3$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	pyside6$secondaryArchSuffix == $portVersion base
	"
REPLACES_devel="
	shiboken6${secondaryArchSuffix}_devel
	"

PROVIDES_tools="
	pyside6${secondaryArchSuffix}_tools = $portVersion
	cmd:android_deploy.py
	cmd:deploy.py
	cmd:metaobjectdump.py
	cmd:project.py
	cmd:pyside_tool.py
	cmd:qml.py
	cmd:qtpy2cpp.py
	cmd:requirements_android.txt
	cmd:shiboken6
	cmd:shiboken_tool.py
	"
REQUIRES_tools="
	haiku$secondaryArchSuffix
	pyside6$secondaryArchSuffix == $portVersion base
	pyside6_python$defaultPythonVersion
	cmd:python3
	lib:libclang$secondaryArchSuffix
	lib:libQt6Core$secondaryArchSuffix
	lib:libxml2$secondaryArchSuffix
	lib:libxslt$secondaryArchSuffix
	"
fi

PYTHON_VERSIONS=(3.10 3.14)

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	# Allows using dot in sub-package names (eg: "_python3.14" vs "_python314"):
	eval "PACKAGE_NAME_$pythonPackage=${portName}_python$pythonVersion"

	eval "PROVIDES_$pythonPackage=\"
		${portName}_python$pythonVersion = $portVersion
		${portName}_$pythonPackage = $portVersion
		\""

	if $setuptoolsBuild; then
	eval "PROVIDES_$pythonPackage+=\"
		cmd:pyside6_deploy_$pythonVersion = $portVersion
		cmd:pyside6_genpyi_$pythonVersion = $portVersion
		cmd:pyside6_metaobjectdump_$pythonVersion = $portVersion
		cmd:pyside6_project_$pythonVersion = $portVersion
		cmd:pyside6_qml_$pythonVersion = $portVersion
		cmd:pyside6_qtpy2cpp_$pythonVersion = $portVersion
		cmd:shiboken6_$pythonVersion = $portVersion
		cmd:shiboken6_genpyi_$pythonVersion = $portVersion
		\""

	if [ $pythonVersion = $defaultPythonVersion ]; then
		eval "PROVIDES_$pythonPackage+=\"
			cmd:pyside6_deploy = $portVersion
			cmd:pyside6_genpyi = $portVersion
			cmd:pyside6_metaobjectdump = $portVersion
			cmd:pyside6_project = $portVersion
			cmd:pyside6_qml = $portVersion
			cmd:pyside6_qtpy2cpp = $portVersion
			cmd:shiboken6 = $portVersion
			cmd:shiboken6_genpyi = $portVersion
			\""
	fi
	fi

	if [ -n "$secondaryArchSuffix" ]; then
		eval "PROVIDES_$pythonPackage+=\"
			${portBaseName}_python$pythonVersion = $portVersion
			${portBaseName}_$pythonPackage = $portVersion
			\""
	fi

	eval "REQUIRES_$pythonPackage=\"
		haiku$secondaryArchSuffix
		cmd:python$pythonVersion
		\""

	if $setuptoolsBuild; then
	eval "REQUIRES_$pythonPackage+=\"
		lib:libclang$secondaryArchSuffix
		lib:libGL$secondaryArchSuffix
		lib:libopenal$secondaryArchSuffix
		lib:libxml2$secondaryArchSuffix
		lib:libxslt$secondaryArchSuffix
		# Qt6
		lib:libQt6Core$secondaryArchSuffix
		lib:libQt6Qml$secondaryArchSuffix
		# optional -- not including these causes policy warnings
#		lib:libQt63DCore$secondaryArchSuffix
#		lib:libQt6Charts$secondaryArchSuffix
#		lib:libQt6DataVisualization$secondaryArchSuffix
#		lib:libQt6Help$secondaryArchSuffix
#		lib:libQt6Location$secondaryArchSuffix
#		lib:libQt6Multimedia$secondaryArchSuffix
#		lib:libQt6Network$secondaryArchSuffix
#		lib:libQt6Positioning$secondaryArchSuffix
#		lib:libQt6Quick$secondaryArchSuffix
#		lib:libQt6Quick3D$secondaryArchSuffix
#		lib:libQt6Scxml$secondaryArchSuffix
#		lib:libQt6Sensors$secondaryArchSuffix
#		lib:libQt6SerialPort$secondaryArchSuffix
#		lib:libQt6SpatialAudio$secondaryArchSuffix
#		lib:libQt6StateMachine$secondaryArchSuffix
#		lib:libQt6Svg$secondaryArchSuffix
#		lib:libQt6TextToSpeech$secondaryArchSuffix
#		lib:libQt6WebChannelQuick$secondaryArchSuffix
#		lib:libQt6WebSockets$secondaryArchSuffix
#		lib:libQt6Xml$secondaryArchSuffix
		\""
	BUILD_REQUIRES+="
		installer_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
	else
	eval "REQUIRES_$pythonPackage+=\"
		pyside6$secondaryArchSuffix == $portVersion base
		\""
	fi
done

BUILD_REQUIRES+="
	haiku${secondaryArchSuffix}_devel
	gcc${secondaryArchSuffix}_syslibs_devel
	devel:libclang$secondaryArchSuffix >= $clangVer
	devel:libclang_cpp$secondaryArchSuffix >= $clangVer
	devel:libLLVM_$clangVer$secondaryArchSuffix
	devel:libomp$secondaryArchSuffix # tests
	devel:libxml2$secondaryArchSuffix
	devel:libxslt$secondaryArchSuffix
	# Qt6
	devel:libQt6Core$secondaryArchSuffix
	# optional
	qt6_tools${secondaryArchSuffix}_devel
	devel:libQt63DCore$secondaryArchSuffix
	devel:libQt6Charts$secondaryArchSuffix
	devel:libQt6Concurrent$secondaryArchSuffix
	devel:libQt6Bluetooth$secondaryArchSuffix
	devel:libQt6DataVisualization$secondaryArchSuffix
	devel:libQt6DBus$secondaryArchSuffix
	devel:libQt6Graphs$secondaryArchSuffix
	devel:libQt6Gui$secondaryArchSuffix
#	devel:libQt6HttpServer$secondaryArchSuffix # not released
	devel:libQt6Location$secondaryArchSuffix
	devel:libQt6Multimedia$secondaryArchSuffix
	devel:libQt6Network$secondaryArchSuffix
	devel:libQt6NetworkAuth$secondaryArchSuffix
	devel:libQt6OpenGL$secondaryArchSuffix
	devel:libQt6OpenGLWidgets$secondaryArchSuffix
	devel:libQt6Positioning$secondaryArchSuffix
	devel:libQt6PrintSupport$secondaryArchSuffix
	devel:libQt6Qml$secondaryArchSuffix
	devel:libQt6Quick$secondaryArchSuffix
	devel:libQt6QuickControls2$secondaryArchSuffix
	devel:libQt6QuickWidgets$secondaryArchSuffix
	devel:libQt6Quick3D$secondaryArchSuffix
#	devel:libQt6RemoteObjects$secondaryArchSuffix # not released
	devel:libQt6Scxml$secondaryArchSuffix
	devel:libQt6Sensors$secondaryArchSuffix
#	devel:libQt6SerialBus$secondaryArchSuffix # not released
	devel:libQt6SerialPort$secondaryArchSuffix
	devel:libQt6ShaderTools$secondaryArchSuffix
	devel:libQt6Sql$secondaryArchSuffix
	devel:libQt6Svg$secondaryArchSuffix
	devel:libQt6Test$secondaryArchSuffix
	devel:libQt6TextToSpeech$secondaryArchSuffix
	devel:libQt6WebChannel$secondaryArchSuffix
	devel:libQt6WebSockets$secondaryArchSuffix
	devel:libQt6Widgets$secondaryArchSuffix
	devel:libQt6Xml$secondaryArchSuffix
	numpy_python$defaultPythonVersion
	"
BUILD_PREREQUIRES+="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:llvm_config >= $clangVer
	cmd:pkg_config$secondaryArchSuffix
	"
if $setuptoolsBuild; then
BUILD_REQUIRES+="
	build_python$defaultPythonVersion
	packaging_python$defaultPythonVersion
	setuptools_python$defaultPythonVersion
	wheel_python$defaultPythonVersion
	"
BUILD_PREREQUIRES+="
	cmd:ninja
	"
else
BUILD_PREREQUIRES+="
	cmd:make
	cmd:python$defaultPythonVersion
	"
fi

BUILD()
{
	if $setuptoolsBuild; then
	unset HAIKU_USE_VENDOR_DIRECTORIES
		# The build systems assumes installation in site-packages.
		# For BUILD() this doesn't matter yet, so let's do that.

	python$defaultPythonVersion setup.py build \
		--qtpaths=/boot/system/$relativeLibDir/Qt6/qtpaths6 \
		--qt-tools-path=/boot/system/$relativeLibDir/Qt6 \
		--no-qt-tools --reuse-build $jobArgs

	python$defaultPythonVersion create_wheels.py --no-examples
	else
	cmake -B build -S . -DCMAKE_BUILD_TYPE=Release \
		$cmakeDirArgs \
		-DLIB_INSTALL_DIR=$libDir \
		-DPYTHON_SITE_PACKAGES=$libDir/python$defaultPythonVersion/vendor-packages \
		-DNUMPY_INCLUDE_DIR=`finddir B_SYSTEM_LIB_DIRECTORY`/python$defaultPythonVersion/vendor-packages/numpy/_core/include/ \
		-DQDOC_EXECUTABLE=`finddir B_SYSTEM_LIB_DIRECTORY`${secondaryArchSubDir}/Qt6 \
		-DQHELPGENERATOR_EXECUTABLE=`finddir B_SYSTEM_LIB_DIRECTORY`${secondaryArchSubDir}/Qt6 \
		-DBUILD_SHARED_LIBS=ON \
		-DSHIBOKEN_BUILD_LIBS=ON \
		-DSHIBOKEN_BUILD_TOOLS=ON \
		-DNO_QT_TOOLS=yes \
		-DMINIMAL_TESTS=ON \
		-DBUILD_TESTS=OFF

	make -C build $jobArgs
	fi
}

INSTALL()
{
	if ! $setuptoolsBuild; then
	make -C build install

	prepareInstalledDevelLibs \
		libpyside6.abi3 \
		libpyside6qml.abi3 \
		libshiboken6.abi3
	fixPkgconfig

	packageEntries tools \
		$prefix/bin

	packageEntries devel \
		$developDir \
		$libDir/cmake

	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		python=python$pythonVersion

		if [ $pythonVersion != $defaultPythonVersion ]; then
			mkdir -p $prefix/lib/$python
			cp -r $prefix/lib/python$defaultPythonVersion/* $prefix/lib/$python
		fi
	done
	fi

	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}
		python=python$pythonVersion

		if $setuptoolsBuild; then
		$python -m installer -p $prefix --overwrite-existing dist/*.whl
			# overwrite-existing is necessary because some *.pyi files appear in multiple wheels

		# Version suffix all the scripts
		for f in $prefix/bin/*; do
			mv $f $f-$pythonVersion
		done

		# And provide suffix-less symlinks for the default version
		if [ $pythonVersion = $defaultPythonVersion ]; then
			for f in $prefix/bin/*; do
				ln -sr $f ${f%-$pythonVersion}
			done
		fi
		fi

		packageEntries $pythonPackage \
			$prefix/lib/$python \
			$prefix/bin
	done
}

TEST()
{
	ctest --test-dir build --output-on-failure
}
