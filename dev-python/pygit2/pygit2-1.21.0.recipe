SUMMARY="Python bindings for libgit2"
DESCRIPTION="pygit2 implements Python bindings for libgit2."
HOMEPAGE="https://www.pygit2.org/"
COPYRIGHT="The pygit2 contributors"
LICENSE="GNU GPL v2"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/source/p/$portName/$portName-$portVersion.tar.gz"
CHECKSUM_SHA256="1e987fbef899d1bf12aecc10b33acc917d60266ca114428dfc260df4451a555f"
SOURCE_DIR="pygit2-$portVersion"

ARCHITECTURES="all !x86_gcc2"

REQUIRES="
	haiku
	libgit2_1.9
	libffi
	"

BUILD_REQUIRES="
	cmd:gcc$secondaryArchSuffix
	haiku_devel
	libgit2_1.9_devel
	libffi_devel
	"

PYTHON_VERSIONS=(3.10 3.14)

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	packageVar=python${pythonVersion//.}

	# Only using "dotted" name suffices on newly introduced packages.
	if [ $pythonVersion != 3.10 ]; then
		pythonPackage=python$pythonVersion

		# Allows using dot in sub-package names (eg: "_python3.14" vs "_python314"):
		eval "PACKAGE_NAME_$packageVar=${portBaseName}_$pythonPackage"
	else
		pythonPackage=python${pythonVersion//.}
	fi

	eval "PROVIDES_$packageVar=\"
		${portName}_$pythonPackage = $portVersion
		\""
	eval "REQUIRES_$packageVar=\"$REQUIRES
		cmd:python$pythonVersion
		cffi_$pythonPackage
		\""
	BUILD_REQUIRES+="
		build_$pythonPackage
		installer_$pythonPackage
		setuptools_$pythonPackage
		cffi_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done


INSTALL()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion

		$python -m build --wheel --no-isolation
		$python -m installer --overwrite-existing --prefix $prefix dist/*.whl

		packageEntries $pythonPackage \
			$prefix/lib/python*
	done
}
