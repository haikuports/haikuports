SUMMARY="Python bindings for libgit2"
DESCRIPTION="pygit2 implements Python bindings for libgit2."
HOMEPAGE="https://www.pygit2.org/"
COPYRIGHT="The pygit2 contributors"
LICENSE="GNU GPL v2"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/source/p/$portName/$portName-$portVersion.tar.gz"
CHECKSUM_SHA256="36dff84d237f2b8f18b0b146d6e7c3f99a7bce2da98cc4103a14387f53319f95"
SOURCE_DIR="pygit2-$portVersion"

ARCHITECTURES="all !x86_gcc2"

REQUIRES="
	haiku
	libgit2_1.9
	libffi
	"

BUILD_REQUIRES="
	cmd:gcc$secondaryArchSuffix
	haiku_devel
	libgit2_1.9_devel
	libffi_devel
	"

PYTHON_VERSIONS=(3.10)

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	eval "PROVIDES_$pythonPackage=\"
		${portName}_$pythonPackage = $portVersion
		\""
	eval "REQUIRES_$pythonPackage=\"$REQUIRES
		cmd:python$pythonVersion
		cffi_$pythonVersion
		\""
	BUILD_REQUIRES+="
		build_$pythonPackage
		installer_$pythonPackage
		setuptools_$pythonPackage
		cffi_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done


INSTALL()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion

		$python -m build --wheel --no-isolation
		$python -m installer --p $prefix dist/*.whl

		packageEntries $pythonPackage \
			$prefix/lib/python*
	done
}
