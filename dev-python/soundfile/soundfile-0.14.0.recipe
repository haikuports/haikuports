SUMMARY="Read and write sound files through libsndfile"
DESCRIPTION="Reads and writes sound files in the many formats libsndfile supports, \
returning and accepting audio as NumPy arrays, with support for seeking and \
block-wise processing."
HOMEPAGE="https://github.com/bastibe/python-soundfile"
COPYRIGHT="2013 Bastian Bechtold"
LICENSE="BSD (3-clause)"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/py2.py3/s/soundfile/soundfile-$portVersion-py2.py3-none-any.whl#noarchive"
CHECKSUM_SHA256="8ba81ae3a89fd5ab3bef8a8eb481fbbe794e806309675a89b4df48b8d31908a8"

ARCHITECTURES="any"

BUILD_REQUIRES="
	haiku_devel
	"

PYTHON_VERSIONS=(3.14)

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	# Allows using dot in sub-package names (eg: "_python3.14" vs "_python314"):
	eval "PACKAGE_NAME_$pythonPackage=${portName}_python$pythonVersion"

	eval "PROVIDES_$pythonPackage=\"
		${portName}_python$pythonVersion = $portVersion
		${portName}_$pythonPackage = $portVersion
		\""
	eval "REQUIRES_$pythonPackage=\"
		haiku
		cffi_$pythonPackage
		numpy_$pythonPackage
		typing_extensions_$pythonPackage
		lib:libsndfile
		cmd:python$pythonVersion
		\""
	BUILD_REQUIRES+="
		installer_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

INSTALL()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion

		$python -m installer -p $prefix soundfile-$portVersion-py2.py3-none-any.whl

		packageEntries $pythonPackage \
			$prefix/lib/python*
	done
}
