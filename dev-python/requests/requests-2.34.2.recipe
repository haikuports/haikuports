SUMMARY="A HTTP library for Python"
DESCRIPTION="Requests is a HTTP library, written in Python, made for humans."
HOMEPAGE="http://python-requests.org/
	http://pypi.python.org/pypi/requests"
COPYRIGHT="Kenneth Reitz"
LICENSE="Apache v2"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/source/${portName:0:1}/$portName/$portName-$portVersion.tar.gz"
CHECKSUM_SHA256="f288924cae4e29463698d6d60bc6a4da69c89185ad1e0bcc4104f584e960b9ed"
SOURCE_FILENAME="requests-$portVersion.tar.gz"

ARCHITECTURES="any"

PYTHON_VERSIONS=(3.10 3.14)

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	# Not renaming 3.10 packages to avoid needing massive packages rebuilds.
	# No need for REPLACES then. ToDo: remove the conditional after dropping 3.10.
	if [ $pythonVersion != 3.10 ]; then
		# Allows using dot in sub-package names (eg: "_python3.14" vs "_python314"):
		eval "PACKAGE_NAME_$pythonPackage=${portName}_python$pythonVersion"

		eval "PROVIDES_$pythonPackage=\"
			${portName}_python$pythonVersion = $portVersion
			\""
	fi

	eval "PROVIDES_$pythonPackage+=\"
		${portName}_$pythonPackage = $portVersion
		\""

	eval "REQUIRES_$pythonPackage=\"
		haiku
		ca_root_certificates
		charset_normalizer_$pythonPackage
		idna_$pythonPackage
		urllib3_$pythonPackage
		cmd:python$pythonVersion
		\""

	BUILD_REQUIRES+="
		build_$pythonPackage
		installer_$pythonPackage
		setuptools_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

INSTALL()
{
	cp src/requests/certs.py certs.py.in

	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}

		if [ $pythonVersion == 3.10 ]; then
			pythonPackageName=${portName}_$pythonPackage-$portFullVersion
		else
			# i.e.: '_python3.14', not _python310
			pythonPackageName=${portName}_python$pythonVersion-$portFullVersion
		fi

		pythonLinksDir=$(dirname $portPackageLinksDir)/$pythonPackageName
		certificatePath=$pythonLinksDir/ca_root_certificates/$relativeDataRootDir/ssl/CARootCertificates.pem
		whereDef="def where(): return \"$certificatePath\""

		sed -e 's|from certifi import where|'"$whereDef"'|' \
			certs.py.in > src/requests/certs.py

		python=python$pythonVersion

		$python -m build --wheel --no-isolation
		$python -m installer -p $prefix dist/*.whl

		packageEntries $pythonPackage \
			$prefix/lib/$python
	done
}
