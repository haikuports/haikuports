SUMMARY="An XML processing library combining libxml2/libxslt with the ElementTree API"
DESCRIPTION="lxml is a Pythonic, mature binding for the libxml2 and libxslt libraries. \
It provides safe and convenient access to these libraries using the ElementTree API."
HOMEPAGE="
	https://lxml.de/
	https://github.com/lxml/lxml
	https://pypi.org/project/lxml/
	"
COPYRIGHT="2003-2010 Gustavo Niemeyer
	2003 Shuttleworth Foundation
	2004 Infrae"
LICENSE="BSD (3-clause)
	ElementTree
	GNU GPL v2
	PSF-2"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/source/${portBaseName:0:1}/$portBaseName/$portBaseName-$portVersion.tar.gz"
CHECKSUM_SHA256="45222d94ddd511536f3b2f7d9deae3b2339b4ce0f075f1ca25703b07cad9dd21"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

REQUIRES="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libxml2$secondaryArchSuffix
	devel:libxslt$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	"

PYTHON_VERSIONS=(3.10 3.14)

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	# Only using "dotted" name suffixes on newly introduced packages.
	if [ $pythonVersion != 3.10 ]; then
		# Allows using dot in sub-package names (eg: "_python3.14" vs "_python314"):
		eval "PACKAGE_NAME_$pythonPackage=${portName}_python$pythonVersion"

		eval "PROVIDES_$pythonPackage=\"
			${portName}_python$pythonVersion = $portVersion
			\""
		if [ "$targetArchitecture" = x86_gcc2 ]; then
			eval "PROVIDES_${pythonPackage}+=\"
				${portBaseName}_python$pythonVersion = $portVersion
				\""
		fi
	fi

	# We need to provide the "dotless" package name too for now (to avoid having
	# to change $pythonPackage in each BUILD_REQUIRES/REQUIRES of all recipes).
	eval "PROVIDES_$pythonPackage+=\"
		${portName}_$pythonPackage = $portVersion
		\""

	if [ "$targetArchitecture" = x86_gcc2 ]; then
		eval "PROVIDES_${pythonPackage}+=\"
			${portBaseName}_$pythonPackage = $portVersion
			\""
	fi

	eval "REQUIRES_$pythonPackage=\"
		haiku$secondaryArchSuffix
		cmd:python$pythonVersion
		lib:libxml2$secondaryArchSuffix
		lib:libxslt$secondaryArchSuffix
		lib:libz$secondaryArchSuffix
		\""

	BUILD_REQUIRES+="
		build_$pythonPackage
		installer_$pythonPackage
		setuptools_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

TEST_REQUIRES="
	cmd:make
	cmd:python3
	"

BUILD()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		python=python$pythonVersion

		# We build without cmd:cython, as the release tarball already includes the generated
		# .c files. In case the build still complains, add "-C--build-option=--without-cython"
		# to the following command:
		$python -m build --wheel --skip-dependency-check --no-isolation
	done
}

INSTALL()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}
		python=python$pythonVersion

		$python -m installer --p $prefix dist/$portBaseName-$portVersion-cp${pythonVersion//.}-*.whl

		packageEntries $pythonPackage \
			$prefix/lib/$python
	done
}


# For reference, on beta6, 32 bits, with Python 3.14:
# Ran 2006 tests in 8.417s
# with no errors.
TEST()
{
	make test
}
