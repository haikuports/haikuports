SUMMARY="A parser for Coffeescript Object Notation (CSON)"
DESCRIPTION="A python parser for the Coffeescript Object Notation (CSON)."
HOMEPAGE="https://github.com/avakar/pycson"
COPYRIGHT="2015-2019, Martin Vejnár"
LICENSE="MIT"
REVISION="2"
SOURCE_URI="https://files.pythonhosted.org/packages/3.7/c/cson/cson-$portVersion-py2.py3-none-any.whl#noarchive"
CHECKSUM_SHA256="163a18fccbb5bd0911d20f0ef5876ce5a08057b05ba212571579578f292ed100"

ARCHITECTURES="any"

BUILD_REQUIRES="
	haiku_devel
	"

PYTHON_VERSIONS=(3.10 3.14)

for pythonVersion in "${PYTHON_VERSIONS[@]}"; do
	pythonPackage=python${pythonVersion//.}

	# Not renaming 3.10 packages to avoid needing massive packages rebuilds.
	# No need for REPLACES then. ToDo: remove the conditional after dropping 3.10.
	if [ $pythonVersion != 3.10 ]; then
		# Allows using dot in sub-package names (eg: "_python3.14" vs "_python314"):
		eval "PACKAGE_NAME_$pythonPackage=cson_python$pythonVersion"

		eval "PROVIDES_$pythonPackage=\"
			cson_python$pythonVersion = $portVersion
			\""
	fi

	eval "PROVIDES_$pythonPackage+=\"
		cson_$pythonPackage = $portVersion
		\""
	eval "REQUIRES_$pythonPackage=\"
		haiku
		cmd:python$pythonVersion
		speg_$pythonPackage
		\""

	BUILD_REQUIRES+="
		installer_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

INSTALL()
{
	for pythonVersion in "${PYTHON_VERSIONS[@]}"; do
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion

		$python -m installer -p $prefix cson-$portVersion-py2.py3-none-any.whl

		packageEntries $pythonPackage \
			$prefix/lib/$python
	done
}
