SUMMARY="Library of file utilities for use in Mozilla testing"
DESCRIPTION="see https://firefox-source-docs.mozilla.org/mozbase/index.html"
HOMEPAGE="https://firefox-source-docs.mozilla.org/mozbase/index.html"
COPYRIGHT="2012-2022 Mozilla"
LICENSE="MPL v2.0"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/25/f8/a1f0076490d50dbe8bdcf15df97856a4734f459aaf0a4d42c64a11ab7231/mozfile-3.0.0.tar.gz"
SOURCE_DIR="$portVersionedName"
CHECKSUM_SHA256="92ca1a786abbdf5e6a7aada62d3a4e28f441ef069c7623223add45268e53c789"

ARCHITECTURES="any"

PROVIDES="
	$portName = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	"

# add python versions if needed: eg (3.10 3.13)
PYTHON_VERSIONS=(3.14)

for i in "${!PYTHON_VERSIONS[@]}"; do
	pythonVersion=${PYTHON_VERSIONS[$i]}
	pythonPackage=python${pythonVersion//.}

	eval "PROVIDES_$pythonPackage=\"
		${portName}_$pythonPackage = $portVersion
		\""

	eval "REQUIRES_$pythonPackage=\"
		$REQUIRES
		cmd:python$pythonVersion
		\""

	BUILD_REQUIRES+="
		setuptools_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

INSTALL()
{
	for i in "${!PYTHON_VERSIONS[@]}"; do
		pythonVersion=${PYTHON_VERSIONS[$i]}
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion

		installLocation=$prefix/lib/$python/vendor-packages/
		export PYTHONPATH=$installLocation:$PYTHONPATH

		mkdir -p $installLocation
		rm -rf build

		$python setup.py build install \
			--root=/ --prefix=$prefix

		packageEntries $pythonPackage \
			$prefix/lib/python*
	done
}
