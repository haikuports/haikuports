SUMMARY="Library of file utilities for use in Mozilla testing"
DESCRIPTION="see https://firefox-source-docs.mozilla.org/mozbase/index.html"
HOMEPAGE="https://firefox-source-docs.mozilla.org/mozbase/index.html"
COPYRIGHT="2012-2022 Mozilla"
LICENSE="MPL v2.0"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/py2.py3/${portName:0:1}/$portName/$portName-$portVersion-py2.py3-none-any.whl#noarchive"
CHECKSUM_SHA256="3b0afcda2fa8b802ef657df80a56f21619008f61fcc14b756124028d7b7adf5c"

ARCHITECTURES="any"

BUILD_REQUIRES="
	haiku_devel
	"

PYTHON_VERSIONS=(3.14)

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	eval "PACKAGE_NAME_$pythonPackage=${portBaseName}_python$pythonVersion"

	eval "PROVIDES_$pythonPackage=\"
		${portName}_python$pythonVersion = $portVersion
		\""

	eval "REQUIRES_$pythonPackage=\"
		haiku
		cmd:python$pythonVersion
		\""

	BUILD_REQUIRES+="
		installer_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

INSTALL()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion
		$python -m installer -p $prefix $portName-$portVersion-*-none-any.whl

		packageEntries $pythonPackage \
			$prefix/lib/python*
	done
}
