From 360de547b03def1c2216988e068b2afda362c838 Mon Sep 17 00:00:00 2001
From: Begasus <begasus@gmail.com>
Date: Mon, 3 Feb 2025 13:55:59 +0100
Subject: Fix tests


diff --git a/testing/cffi0/test_ownlib.py b/testing/cffi0/test_ownlib.py
index d185681..d864a2c 100644
--- a/testing/cffi0/test_ownlib.py
+++ b/testing/cffi0/test_ownlib.py
@@ -389,7 +389,7 @@ class TestOwnLib:
     def test_dlopen_handle(self):
         if self.module is None:
             pytest.skip("fix the auto-generation of the tiny test lib")
-        if sys.platform == 'win32' or is_musl or sys.platform.startswith('freebsd'):
+        if sys.platform == 'win32' or sys.platform[:5] == 'haiku' or is_musl or sys.platform.startswith('freebsd'):
             pytest.skip("uses 'dl' explicitly")
         if self.__class__.Backend is CTypesBackend:
             pytest.skip("not for the ctypes backend")
diff --git a/testing/cffi0/test_parsing.py b/testing/cffi0/test_parsing.py
index 3e47bcd..dd35dc5 100644
--- a/testing/cffi0/test_parsing.py
+++ b/testing/cffi0/test_parsing.py
@@ -17,7 +17,7 @@ class FakeBackend:
         if sys.platform == 'win32':
             assert name is None or "msvcr" in name
         else:
-            assert name is None or "libc" in name or "libm" in name
+            assert name is None or "libc" in name or "libm" in name or "libroot" in name
         return FakeLibrary()
 
     def new_function_type(self, args, result, has_varargs):
diff --git a/testing/cffi1/test_re_python.py b/testing/cffi1/test_re_python.py
index fbca325..c832837 100644
--- a/testing/cffi1/test_re_python.py
+++ b/testing/cffi1/test_re_python.py
@@ -287,7 +287,7 @@ def test_selfref():
 def test_dlopen_handle():
     import _cffi_backend
     from re_python_pysrc import ffi
-    if sys.platform == 'win32' or is_musl or sys.platform.startswith('freebsd'):
+    if sys.platform == 'win32' or sys.platform[:5] == 'haiku' or is_musl or sys.platform.startswith('freebsd'):
         pytest.skip("uses 'dl' explicitly")
     ffi1 = FFI()
     ffi1.cdef("""void *dlopen(const char *filename, int flags);
