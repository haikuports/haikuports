SUMMARY="Open, modern and actively maintained alternative to Chardet"
DESCRIPTION="A library that helps you read text from an unknown charset encoding.

Motivated by chardet, I'm trying to resolve the issue by taking a new approach.
All IANA character set names for which the Python core library provides codecs are supported."
HOMEPAGE="https://pypi.org/project/charset-normalizer/"
COPYRIGHT="2025 TAHRI Ahmed R."
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://files.pythonhosted.org/packages/py3/${portName:0:1}/$portName/$portName-$portVersion-py3-none-any.whl#noarchive"
CHECKSUM_SHA256="6df0ec430f9a831772c23ca5a224cba36517a58a84bb32c32bb59a9fa67c47f6"

ARCHITECTURES="any"

PYTHON_VERSIONS=(3.10 3.14)
defaultVersion=3.14

for pythonVersion in ${PYTHON_VERSIONS[@]}; do
	pythonPackage=python${pythonVersion//.}

	# Not renaming 3.10 packages to avoid needing massive packages rebuilds.
	# No need for REPLACES then. ToDo: remove the conditional after dropping 3.10.
	if [ $pythonVersion != 3.10 ]; then
		# Allows using dot in sub-package names (eg: "_python3.14" vs "_python314"):
		eval "PACKAGE_NAME_$pythonPackage=${portName}_python$pythonVersion"

		eval "PROVIDES_$pythonPackage=\"
			${portName}_python$pythonVersion = $portVersion
			\""
	fi

	eval "PROVIDES_$pythonPackage+=\"
		${portName}_$pythonPackage = $portVersion
		cmd:normalizer_$pythonVersion = $portVersion
		\""

	if [ $pythonVersion = $defaultVersion ]; then
		eval "PROVIDES_$pythonPackage+=\"
			cmd:normalizer = $portVersion
			\""
	fi

	eval "REQUIRES_$pythonPackage=\"
		haiku
		cmd:python$pythonVersion
		\""

	BUILD_REQUIRES+="
		installer_$pythonPackage
		"
	BUILD_PREREQUIRES+="
		cmd:python$pythonVersion
		"
done

INSTALL()
{
	for pythonVersion in ${PYTHON_VERSIONS[@]}; do
		pythonPackage=python${pythonVersion//.}

		python=python$pythonVersion
		$python -m installer -p $prefix $portName-$portVersion-*-none-any.whl

		# Version suffix all the scripts
		for f in $binDir/*; do
			mv $f $f-$pythonVersion
		done

		# And provide suffix-less symlinks for the default version
		if [ $pythonVersion = $defaultVersion ]; then
			for f in $binDir/*; do
				ln -sr $f ${f%-$pythonVersion}
			done
		fi

		packageEntries $pythonPackage \
			$prefix/lib/$python \
			$binDir
	done
}
