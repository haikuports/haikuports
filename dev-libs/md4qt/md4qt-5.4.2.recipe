SUMMARY="C++ library for parsing Markdown"
DESCRIPTION="md4qt is a static C++ library for parsing Markdown.

md4qt supports CommonMark 0.31.2 Spec, and some GitHub extensions, such as tables, footnotes, \
tasks lists, strikethroughs, LaTeX Maths injections, GitHub's auto-links."
HOMEPAGE="https://invent.kde.org/libraries/md4qt"
COPYRIGHT="2026 Igor Mironchik"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://invent.kde.org/libraries/md4qt/-/archive/v$portVersion/md4qt-v$portVersion.tar.bz2"
CHECKSUM_SHA256="8f6bbe30d578e22a29d1501117fa1640cd0fee4327424f473c7dd4c6d572b56a"
SOURCE_DIR="md4qt-v$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	md4qt$secondaryArchSuffix = $portVersion
	devel:libmd4qt$secondaryArchSuffix
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	extra_cmake_modules$secondaryArchSuffix
	devel:libQt6Core$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	cmake -B build -S . -DCMAKE_BUILD_TYPE=Release \
		$cmakeDirArgs \
		-D BUILD_MD4QT_TESTS=OFF

	make -C build $jobArgs
}

INSTALL()
{
	make -C build install

	prepareInstalledDevelLib \
		libmd4qt
}

TEST()
{
	ctest --test-dir build --output-on-failure
}
