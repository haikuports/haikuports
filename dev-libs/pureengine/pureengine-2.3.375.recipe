SUMMARY="Document engine of PureWriter and PureMail (static library)"
DESCRIPTION="PureEngine (HTML Component Library) is the document engine \
shared by PureWriter and PureMail: layout and rendering of HTML, ODF, Office \
Open XML, RTF, Markdown and LyX documents, editing, PDF and e-book export, \
spreadsheets, charts, formulas and document signing. This package holds the \
static library libhcl.a and its headers for building applications on the \
engine; PureWriter and PureMail compile the engine sources themselves and do \
not need it."
HOMEPAGE="https://codeberg.org/pmandalian/PureMail"
COPYRIGHT="2021-2026 Pawel Mandalian"
LICENSE="MIT"
REVISION="1"
srcGitRev="f1328fb10db6499b4b08da7aaf1b32960e204e76"
SOURCE_URI="$HOMEPAGE/archive/$srcGitRev.tar.gz"
CHECKSUM_SHA256="b12c6faa2252a72e7ce0ebd907f99e284fa356daa9ad457d61211a79007e82b7"
SOURCE_DIR="puremail"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	pureengine$secondaryArchSuffix = $portVersion
	devel:libhcl$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libcrypto$secondaryArchSuffix
	devel:libfreetype$secondaryArchSuffix
	devel:libhpdf$secondaryArchSuffix
	devel:libicui18n$secondaryArchSuffix
	devel:libicuuc$secondaryArchSuffix
	devel:libjpeg$secondaryArchSuffix
	devel:libopenjp2$secondaryArchSuffix
	devel:libpng16$secondaryArchSuffix
	devel:libssl$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libcrypto$secondaryArchSuffix
	devel:libfreetype$secondaryArchSuffix
	devel:libhpdf$secondaryArchSuffix
	devel:libicui18n$secondaryArchSuffix
	devel:libicuuc$secondaryArchSuffix
	devel:libjpeg$secondaryArchSuffix
	devel:libopenjp2$secondaryArchSuffix
	devel:libpng16$secondaryArchSuffix
	devel:libssl$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:ar$secondaryArchSuffix
	cmd:g++$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	make -C PureEngine $jobArgs OBJ_DIR=obj LIB_DIR=lib
}

INSTALL()
{
	mkdir -p $developLibDir $includeDir/pureengine/src
	cp PureEngine/lib/libhcl.a $developLibDir/
	cp PureEngine/*.h $includeDir/pureengine/
	cp PureEngine/src/*.h $includeDir/pureengine/src/
}
