From 7eaaee4f0130b2726b0ef072b29d8d9d7bfbf026 Mon Sep 17 00:00:00 2001
From: David Karoly <david.karoly@outlook.com>
Date: Sun, 20 Nov 2022 10:35:55 +0100
Subject: fix includes on Haiku


diff --git a/lib/local_filesys.cpp b/lib/local_filesys.cpp
index 215f94c..f03f186 100644
--- a/lib/local_filesys.cpp
+++ b/lib/local_filesys.cpp
@@ -11,7 +11,11 @@
 #else
 #include <errno.h>
 #include <limits.h>
+#ifdef __HAIKU__
+#include <posix/fcntl.h>
+#else
 #include <sys/fcntl.h>
+#endif
 #include <sys/stat.h>
 #include <sys/types.h>
 #include <unistd.h>
diff --git a/lib/process.cpp b/lib/process.cpp
index 17504aa..2f10ae6 100644
--- a/lib/process.cpp
+++ b/lib/process.cpp
@@ -426,7 +426,9 @@ private:
 #include <errno.h>
 #include <fcntl.h>
 #include <signal.h>
+#ifndef __HAIKU__
 #include <sys/syscall.h>
+#endif
 #include <sys/wait.h>
 #include <string.h>
 #include <unistd.h>
-- 
2.56.0


From 5734d557ea6abb1bb0cce6a2d1fbdca48a730087 Mon Sep 17 00:00:00 2001
From: David Karoly <david.karoly@outlook.com>
Date: Sun, 20 Nov 2022 10:35:55 +0100
Subject: Haiku: use crypt() instead of crypt_r()


diff --git a/lib/impersonation.cpp b/lib/impersonation.cpp
index 75bbbd3..6977d6b 100644
--- a/lib/impersonation.cpp
+++ b/lib/impersonation.cpp
@@ -268,8 +268,13 @@ bool check_auth(native_string const& username, native_string const& password)
 #if FZ_UNIX
 	auto shadow = get_shadow(username);
 	if (shadow.shadow_) {
+#ifdef __HAIKU__
+		//FIXME
+		char* encrypted = crypt(password.c_str(), shadow.shadow_->sp_pwdp);
+#else
 		struct crypt_data data{};
 		char* encrypted = crypt_r(password.c_str(), shadow.shadow_->sp_pwdp, &data);
+#endif
 		if (encrypted && !strcmp(encrypted, shadow.shadow_->sp_pwdp)) {
 			return true;
 		}
-- 
2.56.0


From cd335d0a4bdfac5e6e52bf0543759bc039855661 Mon Sep 17 00:00:00 2001
From: David Karoly <david.karoly@outlook.com>
Date: Sun, 20 Nov 2022 10:35:55 +0100
Subject: configure: detect crypt.h and -lcrypt


diff --git a/configure.ac b/configure.ac
index 9cb2bbc..8391ee8 100644
--- a/configure.ac
+++ b/configure.ac
@@ -124,6 +124,11 @@ CHECK_STRUCT_STAT_ST_MTIM
 
 AC_CHECK_DECLS([pthread_condattr_setclock], [], [], [[#include <pthread.h>]])
 
+if test "$unix" = "1"; then
+  AC_CHECK_HEADERS([crypt.h])
+  AC_SEARCH_LIBS([crypt], [crypt])
+fi
+
 if test "$windows" = "1"; then
   libdeps="-lws2_32 -liphlpapi"
 else
diff --git a/lib/Makefile.am b/lib/Makefile.am
index 5c65d8c..d5bca29 100644
--- a/lib/Makefile.am
+++ b/lib/Makefile.am
@@ -179,10 +179,6 @@ if FZ_MAC
 libfilezilla_la_LDFLAGS += -framework CoreServices
 endif
 
-if FZ_UNIX
-libfilezilla_la_LDFLAGS += -lcrypt
-endif
-
 libfilezilla_la_CPPFLAGS = $(AM_CPPFLAGS)
 libfilezilla_la_CPPFLAGS += -I$(top_builddir)/config
 libfilezilla_la_CPPFLAGS += -DBUILDING_LIBFILEZILLA
diff --git a/lib/impersonation.cpp b/lib/impersonation.cpp
index 6977d6b..b1f5636 100644
--- a/lib/impersonation.cpp
+++ b/lib/impersonation.cpp
@@ -82,7 +82,9 @@ impersonation_token::impersonation_token(fz::user const& user, impersonation_opt
 #include "libfilezilla/buffer.hpp"
 
 #if FZ_UNIX
+#ifdef HAVE_CRYPT_H
 #include <crypt.h>
+#endif
 #include <shadow.h>
 #endif
 #if defined(__linux__)
-- 
2.56.0


From 887b146d247c7b023efdf0dfedc98f174b591dc1 Mon Sep 17 00:00:00 2001
From: David Karoly <david.karoly@outlook.com>
Date: Sun, 20 Nov 2022 10:35:55 +0100
Subject: configure: detect -lnetwork


diff --git a/configure.ac b/configure.ac
index 8391ee8..2b3320b 100644
--- a/configure.ac
+++ b/configure.ac
@@ -129,6 +129,8 @@ if test "$unix" = "1"; then
   AC_SEARCH_LIBS([crypt], [crypt])
 fi
 
+AC_SEARCH_LIBS([socket], [network])
+
 if test "$windows" = "1"; then
   libdeps="-lws2_32 -liphlpapi"
 else
-- 
2.56.0


From 6a210d7614d5adb5dbe85e119ceaef38012a4051 Mon Sep 17 00:00:00 2001
From: Luc Schrijvers <begasus@gmail.com>
Date: Fri, 31 Oct 2025 10:36:50 +0100
Subject: Haiku (beta5) doesn't have ESOCKTNOSUPPORT


diff --git a/lib/socket_errors.cpp b/lib/socket_errors.cpp
index 3c1f090..53f165b 100644
--- a/lib/socket_errors.cpp
+++ b/lib/socket_errors.cpp
@@ -107,7 +107,9 @@ std::unordered_map<int, Error> const& get_errors()
 	#ifdef EADDRNOTAVAIL
 		insert(EADDRNOTAVAIL, fztranslate_mark("Cannot assign requested address"));
 	#endif
+#ifndef __HAIKU__
 		insert(ESOCKTNOSUPPORT, fztranslate_mark("Socket type not supported"));
+#endif
 
 	// Codes that have no POSIX equivalence
 	#ifdef FZ_WINDOWS
-- 
2.56.0


