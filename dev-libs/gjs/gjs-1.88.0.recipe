SUMMARY="Javascript bindings for GNOME"
DESCRIPTION="GJS is a JavaScript runtime built on Firefox's SpiderMonkey JavaScript engine and \
the GNOME platform libraries.
Use the GNOME platform libraries in your JavaScript programs. GJS powers GNOME Shell, Maps, \
Characters, Sound Recorder and many other apps."
HOMEPAGE="https://gitlab.gnome.org/GNOME/gjs"
COPYRIGHT="2026 GNOME developers"
LICENSE="MIT
	GNU LGPL v2.1"
REVISION="1"
SOURCE_URI="https://gitlab.gnome.org/GNOME/gjs/-/archive/$portVersion/gjs-$portVersion.tar.bz2"
CHECKSUM_SHA256="f314939c68953104620eedc1f54434e2e113f2401894ea67fa64e05fc3b57b55"
srcGitRev_2="bafffd954c045a66f85646fafd5674ac6d0b26ae"
SOURCE_URI_2="https://gitlab.gnome.org/GNOME/gobject-introspection-tests/-/archive/$srcGitRev_2.tar.gz"
CHECKSUM_SHA256_2="a440211612a87a09ab92669fc3c3c00ef9e8b698d5ba1fc79b9de6fd0b7430c7"
SOURCE_DIR_2="gobject-introspection-tests-$srcGitRev_2"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="?x86"

libVersion="0.0.0"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

PROVIDES="
	gjs$secondaryArchSuffix = $portVersion
	cmd:gjs = $portVersion
	cmd:gjs_console = $portVersion
	lib:libgjs$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libcairo$secondaryArchSuffix
	lib:libcairo_gobject$secondaryArchSuffix
	lib:libffi$secondaryArchSuffix
	lib:libgio_2.0$secondaryArchSuffix
	lib:libgirepository_2.0$secondaryArchSuffix
	lib:libglib_2.0$secondaryArchSuffix
	lib:libgobject_2.0$secondaryArchSuffix
	lib:libintl$secondaryArchSuffix
	lib:libmozjs_140$secondaryArchSuffix
	lib:libreadline$secondaryArchSuffix
	"

PROVIDES_devel="
	gjs${secondaryArchSuffix}_devel = $portVersion
	devel:libgjs$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	gjs$secondaryArchSuffix == $portVersion base
	devel:libcairo$secondaryArchSuffix
	devel:libglib_2.0$secondaryArchSuffix
	devel:libmozjs_140$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libcairo$secondaryArchSuffix
	devel:libgirepository_2.0$secondaryArchSuffix
	devel:libglib_2.0$secondaryArchSuffix
	devel:libgtk_4$secondaryArchSuffix
	devel:libmozjs_140$secondaryArchSuffix
	devel:libreadline$secondaryArchSuffix >= 8
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:dbus_run_session
	cmd:gcc$secondaryArchSuffix
	cmd:meson
	cmd:msgfmt$secondaryArchSuffix
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	cmd:vapigen
	"

TEST_REQUIRES="
	cmd:diff
	gtk3$secondaryArchSuffix
	"

BUILD()
{
	cp -r $sourceDir2/* subprojects/gobject-introspection-tests

	meson \
		--buildtype=release \
		--prefix=$prefix \
		--bindir=$prefix/bin \
		--libdir=$libDir \
		--libexecdir=$libDir \
		--datadir=$dataDir \
		--localedir=$dataDir/locale \
		--includedir=$includeDir \
		--sysconfdir=$settingsDir \
		-D skip_dbus_tests=true \
		-D skip_gtk_tests=false \
		-D installed_tests=false \
		build --reconfigure

	ninja -C build
}

INSTALL()
{
	ninja -C build install

	prepareInstalledDevelLib \
		libgjs
	fixPkgconfig

	packageEntries devel \
		"$developDir"
}

TEST()
{
#	Ok:                69
#	Fail:              9
	export LIBRARY_PATH=$LIBRARY_PATH:$PWD/build/subprojects/gobject-introspection-tests/
	export LIBRARY_PATH=$LIBRARY_PATH:$PWD/build/installed-tests/js/libgjstesttools/
	meson test -C build --print-errorlogs
}
