From 45284c0c96db96cc91c45c558d6deaca2801d977 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Joachim=20Mairb=C3=B6ck?= <j.mairboeck@gmail.com>
Date: Sat, 7 Nov 2026 15:58:06 +0100
Subject: add Haiku native implementation of find_executable


diff --git a/srclib/progreloc.c b/srclib/progreloc.c
index 3596043..e6bfd6f 100644
--- a/srclib/progreloc.c
+++ b/srclib/progreloc.c
@@ -49,6 +49,10 @@
 # include <os2.h>
 #endif
 
+#ifdef __HAIKU__
+# include <image.h>
+#endif
+
 #include "relocatable.h"
 
 #ifdef NO_XMALLOC
@@ -334,6 +338,15 @@ find_executable (const char *argv0)
       && location[0] == '/')
     return canonicalize_file_name (location);
 # endif
+# ifdef __HAIKU__
+  {
+    image_info info;
+    int32 cookie = 0;
+    while (get_next_image_info (B_CURRENT_TEAM, &cookie, &info) == B_OK)
+      if (info.type == B_APP_IMAGE)
+        return xstrdup (info.name);
+  }
+# else /* disable the fallback code to avoid unnecessary gcc2 changes */
   /* Guess the executable's full path.  We assume the executable has been
      called via execlp() or execvp() with properly set up argv[0].  The
      login(1) convention to add a '-' prefix to argv[0] is not supported.  */
@@ -397,6 +410,7 @@ find_executable (const char *argv0)
     if (maybe_executable (argv0))
       return canonicalize_file_name (argv0);
   }
+# endif
   /* No way to find the executable.  */
   return NULL;
 #endif
-- 
2.56.0


From 23916a8ad8cf94eabea942b6123704252a3da773 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Joachim=20Mairb=C3=B6ck?= <j.mairboeck@gmail.com>
Date: Sat, 7 Nov 2026 15:59:41 +0100
Subject: gcc2 fixes part 3


diff --git a/srclib/basename-lgpl.c b/srclib/basename-lgpl.c
index 53f3bae..528186a 100644
--- a/srclib/basename-lgpl.c
+++ b/srclib/basename-lgpl.c
@@ -29,11 +29,12 @@ char *
 last_component (char const *name)
 {
   char const *base = name + FILE_SYSTEM_PREFIX_LEN (name);
+  bool last_was_slash = false;
+  char const *p;
   while (ISSLASH (*base))
     base++;
 
-  bool last_was_slash = false;
-  for (char const *p = base; *p; p++)
+  for (p = base; *p; p++)
     {
       if (ISSLASH (*p))
         last_was_slash = true;
@@ -51,6 +52,7 @@ size_t
 base_len (char const *name)
 {
   size_t len;
+  size_t prefix_len = FILE_SYSTEM_PREFIX_LEN (name);
   for (len = strlen (name);  1 < len && ISSLASH (name[len - 1]);  len--)
     continue;
 
@@ -58,7 +60,6 @@ base_len (char const *name)
       && ISSLASH (name[0]) && ISSLASH (name[1]) && ! name[2])
     return 2;
 
-  size_t prefix_len = FILE_SYSTEM_PREFIX_LEN (name);
   if (FILE_SYSTEM_DRIVE_PREFIX_CAN_BE_RELATIVE && prefix_len
       && len == prefix_len && ISSLASH (name[prefix_len]))
     return prefix_len + 1;
diff --git a/srclib/dup2.c b/srclib/dup2.c
index b9a5526..bdc4b10 100644
--- a/srclib/dup2.c
+++ b/srclib/dup2.c
@@ -176,6 +176,7 @@ klibc_dup2 (int fd, int desired_fd)
 int
 rpl_dup2 (int fd, int desired_fd)
 {
+  int result;
 #ifdef F_GETFL
   /* On Linux kernels 2.6.26-2.6.29, dup2 (fd, fd) returns -EBADF.
      On Cygwin 1.5.x, dup2 (1, 1) returns 0.
@@ -191,7 +192,7 @@ rpl_dup2 (int fd, int desired_fd)
     return fcntl (fd, F_GETFL) == -1 ? -1 : fd;
 #endif
 
-  int result = dup2 (fd, desired_fd);
+  result = dup2 (fd, desired_fd);
 
   /* Correct an errno value on FreeBSD 6.1 and Cygwin 1.5.x.  */
   if (result < 0 && errno == EMFILE)
diff --git a/srclib/gettext.h b/srclib/gettext.h
index 2f4b1c9..8e5293f 100644
--- a/srclib/gettext.h
+++ b/srclib/gettext.h
@@ -478,11 +478,12 @@ dcpgettext_expr (const char *domain,
   if (msg_ctxt_id != NULL)
 #endif
     {
+      int found_translation;
       memcpy (msg_ctxt_id, msgctxt, msgctxt_len - 1);
       msg_ctxt_id[msgctxt_len - 1] = '\004';
       memcpy (msg_ctxt_id + msgctxt_len, msgid, msgid_len);
       translation = dcgettext (domain, msg_ctxt_id, category);
-      int found_translation = (translation != msg_ctxt_id);
+      found_translation = (translation != msg_ctxt_id);
 #if !_LIBGETTEXT_HAVE_VARIABLE_SIZE_ARRAYS
       if (msg_ctxt_id != buf)
         free (msg_ctxt_id);
@@ -523,11 +524,12 @@ dcnpgettext_expr (const char *domain,
   if (msg_ctxt_id != NULL)
 #endif
     {
+      int found_translation;
       memcpy (msg_ctxt_id, msgctxt, msgctxt_len - 1);
       msg_ctxt_id[msgctxt_len - 1] = '\004';
       memcpy (msg_ctxt_id + msgctxt_len, msgid, msgid_len);
       translation = dcngettext (domain, msg_ctxt_id, msgid_plural, n, category);
-      int found_translation = !(translation == msg_ctxt_id || translation == msgid_plural);
+      found_translation = !(translation == msg_ctxt_id || translation == msgid_plural);
 #if !_LIBGETTEXT_HAVE_VARIABLE_SIZE_ARRAYS
       if (msg_ctxt_id != buf)
         free (msg_ctxt_id);
diff --git a/srclib/open.c b/srclib/open.c
index c3b5648..7b3ec03 100644
--- a/srclib/open.c
+++ b/srclib/open.c
@@ -71,6 +71,16 @@ int
 open (const char *filename, int flags, ...)
 {
   mode_t mode = 0;
+  bool check_for_slash_bug;
+  bool check_directory;
+
+  /* 0 = unknown, 1 = yes, -1 = no.  */
+#if GNULIB_defined_O_CLOEXEC
+  int have_cloexec = -1;
+#else
+  static int have_cloexec;
+#endif
+  int fd;
 
   if (flags & O_CREAT)
     {
@@ -116,7 +126,6 @@ open (const char *filename, int flags, ...)
          directories,
        - if O_WRONLY or O_RDWR is specified, open() must fail because the
          file does not contain a '.' directory.  */
-  bool check_for_slash_bug;
   if (OPEN_TRAILING_SLASH_BUG)
     {
       size_t len = strlen (filename);
@@ -138,7 +147,7 @@ open (const char *filename, int flags, ...)
      stat first lest we hang trying to open a fifo.  Although there is
      a race between this and opening the file, we can do no better.
      After opening the file we will check again with fstat.  */
-  bool check_directory =
+  check_directory =
     (check_for_slash_bug
      || (!HAVE_WORKING_O_DIRECTORY && flags & O_DIRECTORY));
   if (check_directory)
@@ -156,14 +165,7 @@ open (const char *filename, int flags, ...)
         }
     }
 
-  /* 0 = unknown, 1 = yes, -1 = no.  */
-#if GNULIB_defined_O_CLOEXEC
-  int have_cloexec = -1;
-#else
-  static int have_cloexec;
-#endif
-
-  int fd = orig_open (filename,
+  fd = orig_open (filename,
                       flags & ~(have_cloexec < 0 ? O_CLOEXEC : 0), mode);
 
   if (flags & O_CLOEXEC)
diff --git a/srclib/progreloc.c b/srclib/progreloc.c
index e6bfd6f..09c7c4b 100644
--- a/srclib/progreloc.c
