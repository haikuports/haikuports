       curr_prefix_len = strlen (curr_prefix_arg);
-      char *memory = (char *) xmalloc (orig_prefix_len + 1 + curr_prefix_len + 1);
+      memory = (char *) xmalloc (orig_prefix_len + 1 + curr_prefix_len + 1);
 #ifdef NO_XMALLOC
       if (memory != NULL)
 #endif
@@ -198,6 +199,9 @@ compute_curr_prefix (const char *orig_installprefix,
                      const char *orig_installdir,
                      const char *curr_pathname)
 {
+  const char *rel_installdir;
+  char *curr_installdir;
+
   if (curr_pathname == NULL)
     return NULL;
 
@@ -208,10 +212,9 @@ compute_curr_prefix (const char *orig_installprefix,
       != 0)
     /* Shouldn't happen - nothing should be installed outside $(prefix).  */
     return NULL;
-  const char *rel_installdir = orig_installdir + strlen (orig_installprefix);
+  rel_installdir = orig_installdir + strlen (orig_installprefix);
 
   /* Determine the current installation directory.  */
-  char *curr_installdir;
   {
     const char *p_base = curr_pathname + FILE_SYSTEM_PREFIX_LEN (curr_pathname);
     const char *p = curr_pathname + strlen (curr_pathname);
diff --git a/srclib/strerror.c b/srclib/strerror.c
index f92a739..4b7876a 100644
--- a/srclib/strerror.c
+++ b/srclib/strerror.c
@@ -46,6 +46,7 @@ strerror (int n)
   /* Cast away const, due to the historical signature of strerror;
      callers should not be modifying the string.  */
   const char *msg = strerror_override (n);
+  size_t len;
   if (msg)
     return (char *) msg;
 
@@ -66,7 +67,7 @@ strerror (int n)
     }
 
   /* Fix STACKBUF_LEN if this ever aborts.  */
-  size_t len = strlen (msg);
+  len = strlen (msg);
   if (sizeof buf <= len)
     abort ();
 
