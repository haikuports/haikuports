From a69a70394454622036af258168fa342ee090b8f0 Mon Sep 17 00:00:00 2001
From: Gerasim Troeglazov <3dEyes@gmail.com>
Date: Mon, 10 Aug 2026 11:46:13 +1000
Subject: Use find_paths as XDG_DATA_DIRS fallback on Haiku


diff --git a/gio/xdgmime/xdgmime.c b/gio/xdgmime/xdgmime.c
index 66f8f39..b94f589 100644
--- a/gio/xdgmime/xdgmime.c
+++ b/gio/xdgmime/xdgmime.c
@@ -29,6 +29,11 @@
 #include <unistd.h>
 #include <assert.h>
 
+#if defined(__HAIKU__)
+#include <FindDirectory.h>
+#include <fs_info.h>
+#endif
+
 #ifndef S_ISREG
 #define S_ISREG(m) (((m) & _S_IFMT) == _S_IFREG)
 #endif
@@ -217,6 +222,9 @@ static void
 xdg_init_dirs (void)
 {
   const char *xdg_data_home, *home, *xdg_data_dirs;
+#ifdef __HAIKU__
+  char *haiku_dirs_str = NULL;
+#endif
   const char *ptr;
   size_t n_dirs = 0;
   size_t i, current_dir;
@@ -228,7 +236,36 @@ xdg_init_dirs (void)
   xdg_data_dirs = getenv ("XDG_DATA_DIRS");
 
   if (xdg_data_dirs == NULL)
-    xdg_data_dirs = "/usr/local/share/:/usr/share/";
+    {
+#ifdef __HAIKU__
+      char **paths = NULL;
+      size_t pathCount = 0;
+
+      if (find_paths (B_FIND_PATH_DATA_DIRECTORY, NULL, &paths, &pathCount) == B_OK && pathCount > 0)
+        {
+          size_t total_len = 0;
+          for (i = 0; i < pathCount; i++)
+            total_len += strlen (paths[i]) + 1;
+
+          haiku_dirs_str = malloc (total_len);
+          haiku_dirs_str[0] = '\0';
+          for (i = 0; i < pathCount; i++)
+            {
+              strcat (haiku_dirs_str, paths[i]);
+              if (i < pathCount - 1)
+                strcat (haiku_dirs_str, ":");
+            }
+          free (paths);
+          xdg_data_dirs = haiku_dirs_str;
+        }
+      else
+        {
+          xdg_data_dirs = "/boot/system/non-packaged/data:/boot/system/data";
+        }
+#else
+      xdg_data_dirs = "/usr/local/share/:/usr/share/";
+#endif
+    }
 
   /* Work out how many dirs we’re dealing with. */
   if (xdg_data_home != NULL || home != NULL)
@@ -299,6 +336,10 @@ xdg_init_dirs (void)
   /* NULL terminator */
   xdg_dirs[current_dir] = NULL;
 
+#ifdef __HAIKU__
+  free (haiku_dirs_str);
+#endif
+
   need_reread = TRUE;
 }
 
-- 
2.54.0

