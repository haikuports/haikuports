SUMMARY="Building blocks for modern GNOME applications"
DESCRIPTION="Libadwaita is a GTK 4 library that provides widgets and APIs from the Adwaita \
design language, complementing GTK itself."
HOMEPAGE="https://gitlab.gnome.org/GNOME/libadwaita"
COPYRIGHT="GNOME Project"
LICENSE="GNU LGPL v2.1"
REVISION="1"
SOURCE_URI="https://gitlab.gnome.org/GNOME/libadwaita/-/archive/$portVersion/libadwaita-$portVersion.tar.bz2"
CHECKSUM_SHA256="889a88d203a2425330d837c735c364f17d64d29c7b672650a614de879ef14978"
SOURCE_DIR="libadwaita-$portVersion"
PATCHES="libadwaita-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="?x86"

apiVer="1"

PROVIDES="
	libadwaita$secondaryArchSuffix = $portVersion
	cmd:adwaita_1_demo
	lib:libadwaita_$apiVer$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	adwaita_icon_theme
	lib:libfribidi$secondaryArchSuffix
	lib:libgio_2.0$secondaryArchSuffix
	lib:libglib_2.0$secondaryArchSuffix
	lib:libgobject_2.0$secondaryArchSuffix
	lib:libgraphene_1.0$secondaryArchSuffix
	lib:libgtk_4$secondaryArchSuffix
	lib:libintl$secondaryArchSuffix
	lib:libministream$secondaryArchSuffix
	lib:libpango_1.0$secondaryArchSuffix
	"

PROVIDES_devel="
	libadwaita${secondaryArchSuffix}_devel = $portVersion
	devel:libadwaita_$apiVer$secondaryArchSuffix = $portVersion
	"
REQUIRES_devel="
	libadwaita$secondaryArchSuffix == $portVersion base
	devel:libgtk_4$secondaryArchSuffix
	devel:libappstream$secondaryArchSuffix
	devel:libministream$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libglib_2.0$secondaryArchSuffix
	devel:libgirepository_1.0$secondaryArchSuffix
	devel:libgtk_4$secondaryArchSuffix
	devel:libministream$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	setuptools_python3.14
	cmd:appstreamcli
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:meson
	cmd:msgfmt$secondaryArchSuffix
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	cmd:python3
	cmd:sassc$secondaryArchSuffix
	cmd:vapigen
	"

BUILD()
{
	meson setup Build \
		--buildtype=release \
		--prefix="$prefix" \
		--libdir="$libDir" \
		--datadir="$dataDir" \
		--localedir="$dataDir/locale" \
		-Dintrospection=enabled \
		-Dtests=false \
		-Dexamples=true \
		-Dvapi=true

	ninja -C Build $jobArgs
}

INSTALL()
{
	ninja install -C Build

	# cleanup
	rm -rf $dataDir/{applications,metainfo}

	prepareInstalledDevelLib \
		libadwaita-$apiVer
	fixPkgconfig

	packageEntries devel \
		$developDir \
		$dataDir/gir-1.0 \
		$dataDir/vala
}
