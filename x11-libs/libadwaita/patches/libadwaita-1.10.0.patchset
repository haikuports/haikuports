From 824c4e04bed564a7b9eaf5f11a08902fa341252a Mon Sep 17 00:00:00 2001
From: Luc Schrijvers <begasus@gmail.com>
Date: Tue, 13 Oct 2026 15:15:23 +0200
Subject: Use native 'open' command on Haiku


diff --git a/src/adw-link-row.c b/src/adw-link-row.c
index 4e9344d..b8de7d4 100644
--- a/src/adw-link-row.c
+++ b/src/adw-link-row.c
@@ -163,11 +163,19 @@ activate_link_default_cb (AdwLinkRow *self)
     g_object_unref (launcher);
     g_object_unref (file);
   } else {
+#ifdef __HAIKU__
+  if (self->uri && strlen (self->uri) > 0) {
+    char *command = g_strdup_printf ("open \"%s\"", self->uri);
+    g_spawn_command_line_async (command, NULL);
+    g_free (command);
+  }
+#else
     GtkUriLauncher *launcher = gtk_uri_launcher_new (self->uri);
 
     gtk_uri_launcher_launch (launcher, GTK_WINDOW (root), NULL, launch_done, NULL);
 
     g_object_unref (launcher);
+#endif
   }
 
   adw_link_row_set_visited (self, TRUE);
-- 
2.56.0

