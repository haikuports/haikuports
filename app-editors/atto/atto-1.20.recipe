SUMMARY="Atto is a simple screen-based text editor in the style of Emacs"
DESCRIPTION="
Atto is a simple screen-based text editor in the style of Emacs, written in C (an alternative to vi). It is based on Anthony's Editor. It was this version (by Hugh Barney) that was added to the NetBSD base system in late 2026.
"
HOMEPAGE="GitHub - hughbarney/atto: Atto Emacs is a minimal functional Emacs in less than 2000 lines of C code.  It is derived from Anthony's Editor and uses a buffer-gap to represent the file in memory. (https://github.com/hughbarney/atto)"
COPYRIGHT="1991, 1993 Anthony Howe
2015-2016 Hugh Barney"
LICENSE="Public Domain"
REVISION="1"
SOURCE_URI="https://github.com/hughbarney/atto/archive/refs/heads/master.tar.gz"
CHECKSUM_SHA256="0a609d28814bd06520257fbb1e3a40026c26bf493a38dde069d7569671c249fb"
SOURCE_FILENAME="atto-$portVersion.tar.gz"
SOURCE_DIR="atto-master"

ARCHITECTURES="all"

PROVIDES="
 cmd:atto = $portVersion
 "

REQUIRES="
 haiku
 lib:libncurses
 "

BUILD_REQUIRES="
 haiku_devel
 devel:libncurses
 "

BUILD_PREREQUIRES="
 cmd:gcc
 cmd:make
 cmd:sed
 "

BUILD() {
 sed -i 's/-lncursesw/-lncurses/g' makefile
 make CC=gcc
}

INSTALL() {
 install -d $binDir
 install -m 0755 atto $binDir/
}
