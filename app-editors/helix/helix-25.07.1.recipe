SOURCE_URI_309="https://static.crates.io/crates/zlib-rs/zlib-rs-0.5.0.crate"
CHECKSUM_SHA256_309="868b928d7949e09af2f6086dfc1e01936064cc7a819253bce650d4e2a2d63ba8"
ARCHITECTURES="!all x86_64"

PROVIDES="
	helix = $portVersion
	cmd:hx = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	"
BUILD_PREREQUIRES="
	cmd:cargo
	cmd:gcc
	cmd:git
	"

BUILD()
{
	export CARGO_HOME=$sourceDir/../cargo
	vendor=$CARGO_HOME/haiku
	mkdir -p "$vendor"
	for i in $(seq 2 309); do
		eval "srcDir=\$sourceDir$i"
		eval "sha256sum=\$CHECKSUM_SHA256_$i"
		set -- "$srcDir"/*
		ln -sf "$1" "$vendor"
		cat <<-EOF >"$vendor/${1##*/}/.cargo-checksum.json"
		{
		  "package": "$sha256sum",
		  "files": {}
		}
		EOF
	done

	cat <<-EOF >"$CARGO_HOME"/config.toml
	[source.haiku]
	directory = "$vendor"

	[source.crates-io]
	replace-with = "haiku"
	EOF

	# The source contains the tree-sitter grammar sources as git checkouts at
	# the right versions, but they are owned by a different uid, so this is
	# needed to convince git to read them.
	export GIT_CONFIG_COUNT=1
	export GIT_CONFIG_KEY_0=safe.directory
	export GIT_CONFIG_VALUE_0="*"

	# tree-sitter's portable/endian.h doesn't know about haiku in this release.
	# It's fixed on main, so remove this when helix does it's next release.
	export CFLAGS="$CFLAGS -DHAVE_ENDIAN_H"

	export HELIX_DEFAULT_RUNTIME=/boot/system/data/helix/runtime
	cargo build --profile opt --frozen
}

INSTALL()
{
	install -m 755 -d "$binDir" "$dataDir"/helix "$docDir" \
		"$dataDir"/bash-completion/completions

	install -m 755 target/opt/hx "$binDir"/hx

	# The grammar sources are only needed at build time.
	cp -r runtime "$dataDir"/helix/
	rm -rf "$dataDir"/helix/runtime/grammars/sources

	install -m 644 contrib/completion/hx.bash \
		"$dataDir"/bash-completion/completions/hx

	install -m 644 README.md CHANGELOG.md "$docDir"
}
