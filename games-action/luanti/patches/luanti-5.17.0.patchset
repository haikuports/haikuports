From 4c2bde6facb9373f182b2defe0e0864495634694 Mon Sep 17 00:00:00 2001
From: Alexander Richards <electrodeyt@gmail.com>
Date: Mon, 14 Sep 2026 22:07:33 +0200
Subject: build: add Haiku to exception list


diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0ecd832..9b25074 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -262,7 +262,7 @@ install(FILES "doc/texture_packs.md" DESTINATION "${DOCDIR}" COMPONENT "Docs")
 install(FILES "doc/world_format.md" DESTINATION "${DOCDIR}" COMPONENT "Docs")
 install(FILES "minetest.conf.example" DESTINATION "${EXAMPLE_CONF_DIR}")
 
-if(UNIX AND NOT APPLE)
+if(UNIX AND NOT (APPLE OR HAIKU))
 	install(FILES "doc/luanti.6" "doc/luantiserver.6" DESTINATION "${MANDIR}/man6")
 	install(FILES "misc/org.luanti.luanti.desktop" DESTINATION "${XDG_APPS_DIR}")
 	install(FILES "misc/org.luanti.luanti.metainfo.xml" DESTINATION "${METAINFODIR}")
-- 
2.54.0


From eb4bf048965d02e99f125f2436ef4e632ba988e2 Mon Sep 17 00:00:00 2001
From: Alexander Richards <electrodeyt@gmail.com>
Date: Mon, 14 Sep 2026 23:05:08 +0200
Subject: porting/haiku: add data directory detection


diff --git a/src/porting.cpp b/src/porting.cpp
index 4c24e8c..a7b84a5 100644
--- a/src/porting.cpp
+++ b/src/porting.cpp
@@ -618,6 +618,24 @@ bool setSystemPaths()
 	return true;
 }
 
+//// Haiku
+#elif defined(__HAIKU__)
+
+bool setSystemPaths()
+{
+	path_share = STATIC_SHAREDIR;
+	static char dir[PATH_MAX] = "";
+	if (find_directory(B_USER_SETTINGS_DIRECTORY, -1, false, dir, sizeof(dir)) != B_OK)
+		sprintf(dir, "/boot/home/config/settings");
+	dir[sizeof(dir) - 1] = 0;
+
+	auto user_path_env = getUserPathEnvVar();
+	if (user_path_env)
+		path_user = std::move(user_path_env.value());
+	else
+		path_user = std::string(dir) + "/" + lowercase(PROJECT_NAME);
+	return true;
+}
 
 #else
 
-- 
2.54.0

