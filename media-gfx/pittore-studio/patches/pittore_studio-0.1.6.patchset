From 1fbc8f2703d2ea71dd7e68954be2e2f5105f688b Mon Sep 17 00:00:00 2001
From: Luc Schrijvers <begasus@gmail.com>
Date: Wed, 28 Oct 2026 18:14:36 +0100
Subject: Build for Haiku


diff --git a/meson.build b/meson.build
old mode 100755
new mode 100644
index fdd5d45..12ffcb5
--- a/meson.build
+++ b/meson.build
@@ -13,7 +13,7 @@ project('pittore-studio', 'cpp',
     'prefix=/usr',
   ])
 
-if host_machine.system() != 'linux'
+if host_machine.system() != 'haiku'
   error('Pittore Studio is Linux-only. Refusing to build elsewhere.')
 endif
 
@@ -26,4 +26,4 @@ endif
 
 subdir('src')
 subdir('tests')
-subdir('tools')
\ No newline at end of file
+subdir('tools')
-- 
2.56.0


From de0b2c9d6b9738bc205fab1e528ba863388580f4 Mon Sep 17 00:00:00 2001
From: Luc Schrijvers <begasus@gmail.com>
Date: Wed, 28 Oct 2026 18:51:57 +0100
Subject: Fix undefined references to backtrace*


diff --git a/src/ui/tools/log/tool_log.cpp b/src/ui/tools/log/tool_log.cpp
old mode 100755
new mode 100644
index 8bb41e8..8d9568e
--- a/src/ui/tools/log/tool_log.cpp
+++ b/src/ui/tools/log/tool_log.cpp
@@ -218,7 +218,7 @@ void writeCrash(const char* header) {
 }
 
 void writeBacktrace() {
-#ifndef _WIN32
+#if !defined(_WIN32) && !defined(__HAIKU__)
     void* frames[64];
     const int n = ::backtrace(frames, 64);
     if (n <= 0) return;
diff --git a/tests/test_tool_log.cpp b/tests/test_tool_log.cpp
old mode 100755
new mode 100644
index 2f013ae..c688c5c
--- a/tests/test_tool_log.cpp
+++ b/tests/test_tool_log.cpp
@@ -100,7 +100,7 @@ int main(int argc, char** argv) {
 
     // 6. The crash path, for real: a forked child dies on its own signal and
     //    the handler must have named the tool, the stage and the log to open.
-#ifndef _WIN32
+#if !defined(_WIN32) && !defined(__HAIKU__)
     install_tool_crash_logging();
     const QString crashPath = log_dir() + QStringLiteral("/Pittore-Crash.log");
     CHECK(QFile::exists(crashPath));  // opened (and created) by the installer
-- 
2.56.0

