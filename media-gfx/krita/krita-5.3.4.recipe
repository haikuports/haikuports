	lib:libkritamultiarch$secondaryArchSuffix = $libVersionCompat
	lib:libkritapigment$secondaryArchSuffix = $libVersionCompat
	lib:libkritaplugin$secondaryArchSuffix = $libVersionCompat
	lib:libkritapsd$secondaryArchSuffix = $libVersionCompat
	lib:libkritapsdutils$secondaryArchSuffix = $libVersionCompat
	lib:libkritaqmicinterface$secondaryArchSuffix = $libVersionCompat
	lib:libkritaqmlwidgets$secondaryArchSuffix = $libVersionCompat
	lib:libkritaresources$secondaryArchSuffix = $libVersionCompat
