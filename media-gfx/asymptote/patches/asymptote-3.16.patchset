+++ b/LspCpp/third_party/ixwebsocket/ixwebsocket/IXSetThreadName.cpp
@@ -24,6 +24,10 @@
 #include <windows.h>
 #endif
 
+#ifdef __HAIKU__
+#include <OS.h>
+#endif
+
 namespace ix
 {
 #ifdef _WIN32
@@ -80,6 +84,8 @@ namespace ix
         SetThreadName(-1, name.c_str());
 #elif defined(BSD)
         pthread_set_name_np(pthread_self(), name.substr(0, 15).c_str());
+#elif defined(__HAIKU__)
+        rename_thread(find_thread(NULL), name.substr(0, B_OS_NAME_LENGTH).c_str());
 #else
         // ... assert here ?
 #endif
