From e5cd1f1c711d295263eae8ea2068fc47f5f3a7a6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Joachim=20Mairb=C3=B6ck?= <j.mairboeck@gmail.com>
Date: Fri, 18 Apr 2025 20:59:28 +0200
Subject: Haiku build fixes

Use the gnu++17 C++ standard to get non-standard symbols from netdb.h
(and fix a bug in the Makefile when using that). Patching configure
instead of configure.ac avoids the need for autoconf.

Define __BSD_VISIBLE for feenableexcept and fedisableexcept.

Change a hard-coded -fPIE to -fPIC.

diff --git a/LspCpp/CMakeLists.txt b/LspCpp/CMakeLists.txt
index 8876135..0da6b76 100644
--- a/LspCpp/CMakeLists.txt
+++ b/LspCpp/CMakeLists.txt
@@ -176,7 +176,7 @@ function(lspcpp_set_target_options target)
         set_property(TARGET ${target} PROPERTY CXX_STANDARD 14)
     endif()
 
-    set_property(TARGET ${target} PROPERTY CXX_EXTENSIONS OFF)
+    set_property(TARGET ${target} PROPERTY CXX_EXTENSIONS ON)
 
     if (CMAKE_GENERATOR MATCHES "Visual Studio.*")
         lspcpp_set_target_options_with_nuget_pkg(${target} boost 1.76.0.0)
diff --git a/Makefile.in b/Makefile.in
index 11caddc..83b1717 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -308,7 +308,7 @@ asymptote.so: $(COREFILES:=.pic.o) glew.o
 
 $(LSP_ROOT)/liblspcpp.a: $(GCLIB)
 	$(CMAKE) -B$(LSP_ROOT)/build -S$(LSP_ROOT) -DCMAKE_CXX_FLAGS=\
-	"-fPIE @OPTIONS@ @LSP_CXX_BUILD_FLAGS@" \
+	"-fPIC @OPTIONS@ @LSP_CXX_BUILD_FLAGS@" \
 	@LSP_CMAKE_OPTIONS@
 	$(MAKE) -C $(LSP_ROOT)/build
 
@@ -356,7 +356,7 @@ GEN_PREPROCESSED_DEPFILE_BASE_ARGS = \
     $(PYTHON) gen_preprocessed_depfile.py \
 	--cxx-compiler="$(CXX)" \
 	--additional-raw-arguments="$(PREPROC_OPTS)" \
-	--cxx-standard=$(subst gnu,,$(subst c++,,$(CXX_STANDARD)))
+	--cxx-standard=$(subst gnu++,,$(subst c++,,$(CXX_STANDARD)))
 
 $(SYMBOL_FILES:=.raw.i): %.raw.i: %.cc gen_preprocessed_depfile.py
 	@echo Generating $@ from $<
diff --git a/configure b/configure
index a1eb4c4..c066d30 100755
--- a/configure
+++ b/configure
@@ -3387,7 +3387,7 @@ then :
   enableval=$enable_lsp;
 fi
 
-cxxstd="c++17"
+cxxstd="gnu++17"
 
 CXXFLAGS=$CXXFLAGS" -std=$cxxstd"
 
diff --git a/fpu.h b/fpu.h
index 4da5396..94c494f 100644
--- a/fpu.h
+++ b/fpu.h
@@ -6,6 +6,8 @@
 #define __GNU_VISIBLE 1
 #endif
 
+#define __BSD_VISIBLE 1
+
 #include "common.h"
 
 #ifdef HAVE_FEENABLEEXCEPT
-- 
2.56.0


From 3e2d82bf404a07b8a7fb085073ebff8a64815d7e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Joachim=20Mairb=C3=B6ck?= <j.mairboeck@gmail.com>
Date: Sun, 20 Apr 2025 20:05:42 +0200
Subject: Settings fixes

Put settings into ~/config/settings/asy instead of ~/.asy.

Use `open` by default to open external files.

diff --git a/GUI/xasyOptions.py b/GUI/xasyOptions.py
index 132aba5..7846c35 100644
--- a/GUI/xasyOptions.py
+++ b/GUI/xasyOptions.py
@@ -26,13 +26,13 @@ except ModuleNotFoundError:
     def user_config_dir(appname: str, *args, **kwargs):
         path = os.environ.get("XDG_CONFIG_HOME", "")
         if not path.strip():
-            path = os.path.expanduser("~/.local/share")
+            path = os.path.expanduser("~/config/settings")
         return os.path.join(path, appname)
 
     def user_state_dir(appname: str, *args, **kwargs):
         path = os.environ.get("XDG_STATE_HOME", "")
         if not path.strip():
-            path = os.path.expanduser("~/.local/state")
+            path = os.path.expanduser("~/config/var")
         return os.path.join(path, appname)
 
 
@@ -59,7 +59,7 @@ class xasyOptions:
             self.options[key] = self.options[settingsName][key]
 
     def settingsFileLocation(self):
-        folders = [Path(user_config_dir("asymptote")), Path.home() / ".asy"]
+        folders = [Path(user_config_dir("asymptote")), Path.home() / "config" / "settings" / "asy"]
         searchOrder = [".cson", ""]
 
         for folder in folders:
@@ -146,7 +146,7 @@ def setAsyPathFromWindowsRegistry():
 
 class xasyOpenRecent:
     def settingsFileLocation(self, ensure_exists: bool = True):
-        folders = [Path(user_state_dir("asymptote")), Path.home() / ".asy"]
+        folders = [Path(user_state_dir("asymptote")), Path.home() / "config" / "settings" / "asy"]
         file = "xasyrecents.txt"
 
         for folder in folders:
diff --git a/doc/asy.1 b/doc/asy.1
index e17ed71..87042fe 100644
--- a/doc/asy.1
+++ b/doc/asy.1
@@ -22,8 +22,8 @@ can be negated by prepending
 to the option name. 
 Default values for most options may also be entered in the 
 file 
-.B .asy/config.asy
-in the user's home directory using the long form:
+.B asy/config.asy
+in the user's settings directory using the long form:
 .PP
      import settings;
      batchView=true;
diff --git a/doc/asy.1.begin b/doc/asy.1.begin
index 1a22329..e8a662b 100644
--- a/doc/asy.1.begin
+++ b/doc/asy.1.begin
@@ -22,8 +22,8 @@ can be negated by prepending
 to the option name. 
 Default values for most options may also be entered in the 
 file 
-.B .asy/config.asy
-in the user's home directory using the long form:
+.B asy/config.asy
+in the user's settings directory using the long form:
 .PP
      import settings;
      batchView=true;
diff --git a/settings.cc b/settings.cc
index 0e5d753..942ff0a 100644
--- a/settings.cc
+++ b/settings.cc
@@ -24,6 +24,11 @@
 #include <unistd.h>
 #endif
 
+#ifdef __HAIKU__
+#include <FindDirectory.h>
+#include <Path.h>
+#endif
+
 #include "common.h"
 #include "rendererloader.h"
 #ifdef HAVE_RENDERER
@@ -130,7 +135,7 @@ bool msdos=false;
 string HOME="HOME";
 string docdir=ASYMPTOTE_DOCDIR;
 const char pathSeparator=':';
-#ifdef __APPLE__
+#if defined(__APPLE__) || defined(__HAIKU__)
 string defaultPSViewer="open";
 string defaultPDFViewer="open";
 string defaultHTMLViewer="open";
@@ -2056,7 +2061,16 @@ void initDir() {
     initdir=Getenv("ASYMPTOTE_HOME",msdos);
 
   if(initdir.empty())
+#ifdef __HAIKU__
+  {
+    BPath path;
+    status_t status=find_directory(B_USER_SETTINGS_DIRECTORY, &path);
+    if(status == B_OK)
+      initdir=path.Path()+dirsep+suffix;
+  }
+#else
     initdir=Getenv(HOME.c_str(),msdos)+dirsep+"."+suffix;
+#endif
 
 #if defined(_WIN32)
   DWORD dirAttrib = GetFileAttributesA(initdir.c_str());
-- 
2.56.0


From c5edf291642c0c0d6823ea2becc7483fc6828d9d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Joachim=20Mairb=C3=B6ck?= <j.mairboeck@gmail.com>
Date: Sun, 10 May 2026 20:18:48 +0200
Subject: fix build on 32 bit systems

This fixes an ambiguity when reading and writing size_t values in streams
by using the appropriate available type directly instead.

diff --git a/fileio.h b/fileio.h
index 19ec59d..5f2ce23 100644
--- a/fileio.h
+++ b/fileio.h
@@ -649,7 +649,11 @@ public:
   }
 
   void Read(string& val) override {
-    size_t n=0;
+#if SIZE_MAX == UINT32_MAX
+    uint32_t n=0;
+#else
+    uint64_t n=0;
+#endif
     if(wordmode)
       *fstream >> n;
     else
@@ -739,8 +743,12 @@ public:
 
   void write(const string& val) override {
     size_t n=val.size();
-    if(wordmode)
-      *ioxfstreamRef << n;
+    if(wordmode) {
+      if constexpr(sizeof(size_t) == 4)
+        *ioxfstreamRef << (uint32_t) n;
+      else
+        *ioxfstreamRef << (uint64_t) n;
+    }
     for(size_t i=0; i < n; ++i)
       *ioxfstreamRef << (xdr::xbyte) val[i];
   }
@@ -820,8 +828,12 @@ public:
 
   void write(const string& val) override {
     size_t n=val.size();
-    if(wordmode)
-      *fstream << n;
+    if(wordmode) {
+      if constexpr(sizeof(size_t) == 4)
+        *fstream << (uint32_t) n;
+      else
+        *fstream << (uint64_t) n;
+    }
     for(size_t i=0; i < n; ++i)
       *fstream << (xdr::xbyte) val[i];
   }
-- 
2.56.0


From fce3d2d2745e106a3f6eebd2e4a5134d84bcbfa9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Joachim=20Mairb=C3=B6ck?= <j.mairboeck@gmail.com>
Date: Sat, 31 Oct 2026 19:46:25 +0100
Subject: don't use GLX on Haiku


diff --git a/glew.c b/glew.c
index acf3879..41a633c 100644
--- a/glew.c
+++ b/glew.c
@@ -7,7 +7,7 @@
 #ifdef HAVE_LIBGL
 
 #include "backports/glew/include/GL/glew.h"
-#ifndef __APPLE__
+#if !defined(__APPLE__) && !defined(__HAIKU__)
 #include "backports/glew/include/GL/glxew.h"
 #endif
 
-- 
2.56.0


From aa2c9cbda4e68ea0f1d5bb9f63ded6209d080834 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Joachim=20Mairb=C3=B6ck?= <j.mairboeck@gmail.com>
Date: Sat, 31 Oct 2026 20:34:41 +0100
Subject: fix build on 32 bit systems part 2


diff --git a/v3dfile.h b/v3dfile.h
index 5dbc77f..e73b748 100644
--- a/v3dfile.h
+++ b/v3dfile.h
@@ -86,7 +86,10 @@ protected:
   void writeContent(xdr::oxstream& ox) const override
   {
     size_t n=str.size();
-    ox << n;
+    if constexpr(sizeof(size_t) == 4)
+      ox << (uint32_t) n;
+    else
+      ox << (uint64_t) n;
     for(size_t i=0; i < n; ++i)
       ox << (xdr::xbyte) str[i];
 
-- 
2.56.0

