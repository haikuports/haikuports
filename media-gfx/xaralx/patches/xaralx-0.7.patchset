Subject: fix files to build XaraLX for Haiku


diff --git a/Kernel/ccfile.cpp b/Kernel/ccfile.cpp
index dac9fb0..d169899 100644
--- a/Kernel/ccfile.cpp
+++ b/Kernel/ccfile.cpp
@@ -446,7 +446,7 @@ BOOL CCFile::SetZipFileErrorMessage(UINT32 ErrorID)
 	UINT32 ZipFileErrorID;
 
 	// Work out which error description string to use...
-	switch (GZipErrorID)
+	switch ((INT32)GZipErrorID)
 	{
 		case Z_ERRNO:
 			// Bad file number
diff --git a/Makefile.am b/Makefile.am
index 5364354..0f4aa16 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -71,8 +71,8 @@ endif
 # 	$(libpng_LIBS) -lz
 
 XaraLX_LDFLAGS = --debug $(CDRAW_DIR_LDFLAGS) \
-	$(LIBXML2_LIBS) $(CDRAW_LIB_LDFLAGS) -lpangoft2-1.0 -lfreetype -lz \
-	-llzma  $(WX_LIBS) -licuuc
+	$(LIBXML2_LIBS) $(CDRAW_LIB_LDFLAGS) $(LIBS) -latk-1.0 -lfreetype -lgdk_pixbuf-2.0 -lgio-2.0 -ljpeg -lpangoft2-1.0 -lfreetype -lz \
+	-llzma  $(WX_LIBS) -licuuc -lcairo -lpango-1.0 -lfreetype -lfontconfig -lgobject-2.0 -lglib-2.0 -lgtk-3 -lgdk-3 $(libpng_LIBS)
 
 XaraLX_LD ?= $(CXX)
 
diff --git a/Scripts/bin2cpp.pl b/Scripts/bin2cpp.pl
old mode 100644
new mode 100755
