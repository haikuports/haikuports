diff --git a/wxOil/camelot.cpp b/wxOil/camelot.cpp
index 3653a08..2b50851 100644
--- a/wxOil/camelot.cpp
+++ b/wxOil/camelot.cpp
@@ -617,6 +617,9 @@ BOOL CCamApp::OnSecondInstance(wxChar** argv, INT32 argc)
 
 bool CCamApp::OnInit()
 {
+#ifndef _DEBUG
+	wxLog::EnableLogging(false);
+#endif
 	// Don't allow the user to try carrying on working
 	InInitOrDeInit = TRUE;
 	::wxHandleFatalExceptions(TRUE);
@@ -828,7 +831,11 @@ bool CCamApp::OnInit()
 #if !defined(RESOURCE_DIR)
 		// we can't use auto pointers here because they free using
 		// delete but BR allocates using malloc (strdup actually)
+#ifndef __HAIKU__
 		char * pszDataPath = br_find_data_dir( "/usr/share" );
+#else
+		char * pszDataPath = br_find_data_dir( "/boot/system/data" );
+#endif
 		if (pszDataPath)
 		{
 			m_strResourceDirPath = wxString( pszDataPath, wxConvFile );
@@ -912,7 +919,11 @@ bool CCamApp::OnInit()
 #if defined(_DEBUG)
 		// Debug-only fallback
 		if (!wxDir::Exists(strConfigPath))
+#ifndef __HAIKU__
 			strConfigPath = _T("/usr/share/xaralx/Examples");
+#else
+			strConfigPath = _T("/boot/system/data/xaralx/Examples");
+#endif
 #endif
 		if (wxDir::Exists(strConfigPath))
 			BaseFileDialog::DefaultOpenFilePath = strConfigPath;
@@ -2105,7 +2116,7 @@ void CCamApp::OnHelpIndex()
     {
         // Complete failure to find any local help files
         // So go to the web site...
-        strUrl = _T("http://www.xaralx.org");
+        strUrl = _T("http://www.xaraxtreme.org/");
     }
     else
     {
@@ -2178,6 +2189,9 @@ BOOL CCamApp::LaunchWebBrowser(const wxString& strUrl)
 
     ok = LaunchBrowserApp(_T("safari"), strUrl);
     if (ok) return ok;
+    
+    ok = LaunchBrowserApp(_T("WebPositive"), strUrl);
+    if (ok) return ok;
 
     ok = wxLaunchDefaultBrowser(strUrl);
 
@@ -2774,6 +2788,8 @@ static PCTSTR           g_apszApps[] = {_T("mplayer"),
                                         _T("totem"),
                                         _T("xfmedia"),
                                         _T("codeine"),
+                                        _T("MediaPlayer"),
+                                        _T("vlc"),
                                         NULL };
 
 static void FillMediaAppMap( SelMediaDlgParam::CMediaAppList* pMapMediaApp )
