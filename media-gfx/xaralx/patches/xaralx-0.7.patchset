diff --git a/wxOil/cartctl.cpp b/wxOil/cartctl.cpp
index 8738513..508a606 100644
--- a/wxOil/cartctl.cpp
+++ b/wxOil/cartctl.cpp
@@ -366,7 +366,7 @@ void wxCamArtControl::OnTimer(wxTimerEvent & event)
 	// Sadly, what can happen is that the Op can set in place a redraw, and during the redraw
 	// the button will left. But our timer gets her first. So we have to check whether the
 	// button is still down
-	if (!::wxGetMouseState().LeftDown())
+	if (!::wxGetMouseState().LeftIsDown())
 		return;
 
 	if (!m_AREventPending) // don't process if another event was pending
@@ -401,7 +401,7 @@ to redraw between undo etc. Instead we send a deferred message back to ourselves
 void wxCamArtControl::OnInvoke(wxCamArtControlEvent & event)
 {
 	m_AREventPending = FALSE;
-	if (!::wxGetMouseState().LeftDown())
+	if (!::wxGetMouseState().LeftIsDown())
 	{
 		m_Timer.Stop();
 		return;
@@ -532,7 +532,7 @@ wxObject * wxCamArtControlXmlHandler::DoCreateResource()
 bool wxCamArtControlXmlHandler::CanHandle(wxXmlNode *node)
 {
   bool fOurClass =
-    node->GetPropVal(wxT("class"), wxEmptyString) == wxT("wxCamArtControl");
+    node->GetAttribute(wxT("class"), wxEmptyString) == wxT("wxCamArtControl");
   return fOurClass;
 
   // This doesn't work on some compilers (although it is identical to
