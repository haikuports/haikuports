SUMMARY="Xara LX, a vector drawing and manipulation program"
DESCRIPTION="Xara LX is primarily a vector graphics (drawing and illustration) \
program but is one of the new generation of cross-over products that handles photos and drawings with equal ease"
HOMEPAGE="http://www.xaraxtreme.org"
COPYRIGHT="1993-2026 Xara Group Ltd"
LICENSE="GNU GPL v2"
REVISION="1"
srcGitRev="e789d9afde142e0127bba1c77cd07984604dbd7d"
SOURCE_URI="https://github.com/earl-kent/xara-lx/archive/$srcGitRev.zip"
CHECKSUM_SHA256="bd8711f1b2bc0c497d9b971178cd116804b35013673c55cc2ecb31a992b4715d"
SOURCE_DIR="xara-lx-$srcGitRev"
PATCHES="xaralx-0.7.patchset"
ADDITIONAL_FILES="xaralx.rdef.in"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	xaralx$secondaryArchSuffix = $portVersion
	app:XaraLX = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libatk_1.0$secondaryArchSuffix
	lib:libcairo$secondaryArchSuffix
	lib:libfontconfig$secondaryArchSuffix
	lib:libfreetype$secondaryArchSuffix
	lib:libgdk_pixbuf_2.0$secondaryArchSuffix
	lib:libglib_2.0$secondaryArchSuffix
	lib:libgtk_3$secondaryArchSuffix
	lib:libicuuc$secondaryArchSuffix
	lib:libiconv$secondaryArchSuffix
	lib:libjpeg$secondaryArchSuffix
	lib:libpango_1.0$secondaryArchSuffix
	lib:libpng16$secondaryArchSuffix
	lib:libwx_gtk3u_core_3.2$secondaryArchSuffix
	lib:libwx_gtk3u_xrc_3.2$secondaryArchSuffix
	lib:libwx_gtk3u_qa_3.2$secondaryArchSuffix
	lib:libwx_baseu_net_3.2$secondaryArchSuffix
	lib:libwx_gtk3u_html_3.2$secondaryArchSuffix
	lib:libwx_gtk3u_core_3.2$secondaryArchSuffix
	lib:libwx_baseu_3.2$secondaryArchSuffix
	lib:libwx_gtk3u_aui_3.2$secondaryArchSuffix
	lib:libwx_baseu_xml_3.2$secondaryArchSuffix
	lib:libxml2$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	lib:liblzma$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libatk_1.0$secondaryArchSuffix
	devel:libcairo$secondaryArchSuffix
	devel:libfontconfig$secondaryArchSuffix
	devel:libfreetype$secondaryArchSuffix
	devel:libgdk_pixbuf_2.0$secondaryArchSuffix
	devel:libglib_2.0$secondaryArchSuffix
	devel:libgtk_3$secondaryArchSuffix
	devel:libharfbuzz$secondaryArchSuffix
	devel:libicuuc$secondaryArchSuffix
	devel:libiconv$secondaryArchSuffix
	devel:libintl$secondaryArchSuffix
	devel:libjpeg$secondaryArchSuffix
	devel:libpango_1.0$secondaryArchSuffix
	devel:libpng16$secondaryArchSuffix
	devel:libwx_gtk3u_core_3.2$secondaryArchSuffix
	devel:libxml2$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	devel:liblzma$secondaryArchSuffix
	"

BUILD_PREREQUIRES="
	cmd:autoconf
	cmd:zip
	cmd:automake
	cmd:cp
	cmd:gettext
	cmd:ld
	cmd:gcc$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	autoreconf -i
	runConfigure ./configure --with-freetype-config=pkg-config \
					--enable-static --disable-shared CFLAGS="-fPIC" CXXFLAGS="-fPIC" \
					--with-cairo --with-wx-config=wx-config
	make $jobArgs
}

INSTALL()
{
	mkdir -p $appsDir
	cp XaraLX $appsDir

	mkdir -p $dataDir/xaralx/Examples
	cp Designs/* $dataDir/xaralx/Examples

	mkdir -p $dataDir/xaralx/Testfiles
	cp testfiles/* $dataDir/xaralx/Testfiles

	mkdir -p $dataDir/xaralx/TextDesigns
	cp TextDesigns/* $dataDir/xaralx/TextDesigns

	mkdir -p $dataDir/xaralx/Templates
	cp Templates/* $dataDir/xaralx/Templates

	mkdir -p $dataDir/xaralx/doc/en
	cp doc/en/LICENSE $dataDir/xaralx/doc/
	tar -xf doc/en/xaralxHelp.tar.gz -C $dataDir/xaralx/doc/en/

	local APP_SIGNATURE="application/x-vnd.xaralx"
	local MAJOR="`echo "$portVersion" | cut -d. -f1`"
	local MIDDLE="`echo "$portVersion" | cut -d. -f2 | cut -d~ -f1`"
	local MINOR="0"
	local LONG_INFO="$SUMMARY"
	sed \
		-e "s|@APP_SIGNATURE@|$APP_SIGNATURE|" \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/xaralx.rdef.in > xaralx.rdef

	addResourcesToBinaries xaralx.rdef $appsDir/XaraLX
	addAppDeskbarSymlink $appsDir/XaraLX
}
