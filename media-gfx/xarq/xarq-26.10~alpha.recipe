SUMMARY="Vector illustration and page layout, descended from Xara"
DESCRIPTION="XarQ is a vector illustration and page layout application with the \
complete classic Xara tool set. It reads and writes native XAR documents and \
imports a wide range of vector and raster formats, including SVG, CorelDRAW, \
Affinity, Photoshop, Visio and Adobe XD. Use it to draw illustrations, logos and \
page designs, edit bezier paths, or convert graphics between formats."
HOMEPAGE="https://github.com/jonata/xarq"
COPYRIGHT="1993-2006 Xara Group Ltd
	2026 Jonatã Bolzan Loss"
LICENSE="GNU GPL v2
	SIL Open Font License v1.1
	Ubuntu Font License 1.0"
REVISION="1"
srcGitRev="cda1dcc6e6bb4d10709fd90a01daade91c899885"
SOURCE_URI="$HOMEPAGE/archive/$srcGitRev.tar.gz"
CHECKSUM_SHA256="b36326dc43754e31f3c181b89d03581ae58114dfbd74baa9357bd09a12023f03"
SOURCE_FILENAME="xarq-$portVersion-$srcGitRev.tar.gz"
SOURCE_DIR="xarq-$srcGitRev"

ARCHITECTURES="!x86_gcc2 x86_64"

PROVIDES="
	xarq = $portVersion
	app:XarQ = $portVersion
	"
REQUIRES="
	haiku
	dejavu
	djvu
	graphviz
	hunspell
	hyphen
	jbig2dec
	lcms
	libraw
	myspell
	openjpeg
	qrencode
	qt6_imageformats
	qt6_svg
	lib:libcdr_0.1
	lib:libcdt
	lib:libcgraph
	lib:libetonyek_0.1
	lib:libexpat
	lib:libfreehand_0.1
	lib:libfreetype
	lib:libgdal
	lib:libGL
	lib:libgvc
	lib:libharfbuzz
	lib:libjpeg
	lib:libmspub_0.1
	lib:libmwaw_0.3
	lib:libpagemaker_0.0
	lib:libpng16
	lib:libQt6Core
	lib:libQt6Gui
	lib:libQt6PrintSupport
	lib:libQt6Svg
	lib:libQt6Widgets
	lib:libqxp_0.0
	lib:librevenge_0.0
	lib:librevenge_generators_0.0
	lib:librevenge_stream_0.0
	lib:libstaroffice_0.0
	lib:libvisio_0.1
	lib:libwmf_0.2
	lib:libwmflite_0.2
	lib:libwpg_0.3
	lib:libz
	lib:libzmf_0.0
	lib:libzstd
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libcdr_0.1
	devel:libetonyek_0.1
	devel:libexpat
	devel:libfreehand_0.1
	devel:libfreetype
	devel:libgdal
	devel:libgvc
	devel:libharfbuzz
	devel:libjpeg
	devel:liblangtag
	devel:libmspub_0.1
	devel:libmwaw_0.3
	devel:libpagemaker_0.0
	devel:libpng16
	devel:libQt6Core
	devel:libQt6Gui
	devel:libQt6PrintSupport
	devel:libQt6Svg
	devel:libQt6Widgets
	devel:libqxp_0.0
	devel:librevenge_0.0
	devel:libstaroffice_0.0
	devel:libvisio_0.1
	devel:libwmf_0.2
	devel:libwpd_0.10
	devel:libwpg_0.3
	devel:libz
	devel:libzmf_0.0
	devel:libzstd
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:g++
	cmd:moc
	cmd:ninja
	cmd:pkg_config
	cmd:rcc
	"

BUILD()
{
	cmake -S src -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=$prefix
	ninja -C build $jobArgs
}

INSTALL()
{
	mkdir -p $appsDir
	cp build/xarq $appsDir/XarQ
	addAppDeskbarSymlink $appsDir/XarQ

	# Xara documents get their own file type: the stock database reads .xar as an archive format.
	mkdir -p $dataDir/mime_db/application
	rc -o xar-type.rsrc src/haiku/x-vnd.xara-xar.rdef
	resattr -O -o $dataDir/mime_db/application/x-vnd.xara-xar xar-type.rsrc
}
