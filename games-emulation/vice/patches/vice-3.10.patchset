From 5a3c8ff2f8b4d78b7a2c95a1c58c4316f372b888 Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Sat, 25 Jul 2026 10:42:34 +0200
Subject: Haiku is mostly UNIX, so try to reuse UNIX code


diff --git a/configure.ac b/configure.ac
index 11f1863..a024686 100755
--- a/configure.ac
+++ b/configure.ac
@@ -2312,6 +2312,15 @@ elif test x"$is_beos" = "xyes"; then
     AC_CHECK_FUNCS(socket send bind listen gethostbyname connect recv accept,,
                    [BEOS_NETWORK_FUNCS_PRESENT=no],)
 
+    AC_MSG_CHECKING([for in_addr_t])
+    AC_TRY_COMPILE([#include <sys/types.h>
+                    #include <stdlib.h>
+                    #include <stddef.h>
+                    #include <netinet/in.h>], [in_addr_t foo;],
+                    [AC_DEFINE(HAVE_IN_ADDR_T,,[Define if the in_addr_t type is present.])
+                     AC_MSG_RESULT(yes)],
+                    [AC_MSG_RESULT(no)])
+
     if test x"$BEOS_NETWORK_FUNCS_PRESENT" = "xyes"; then
       AC_DEFINE(HAVE_NETWORK,,[Enable netplay support])
       HAVE_NETWORK_SUPPORT="yes"
@@ -2801,7 +2810,7 @@ AC_SUBST(SOUND_DRIVERS)
 AC_SUBST(SOUND_LIBS)
 
 dnl Check for ParSID/USBSID/HardSID/CW support
-if test x"$is_unix" = "xyes"; then
+if test x"$is_unix" = "xyes" -o x"$is_beos" = "xyes"; then
 
   dnl Check cpu first
   case "$host_cpu" in
@@ -3367,11 +3376,12 @@ elif test x"$is_win32" = "xyes"; then
   AM_CONDITIONAL(MAKE_INSTALL, false)
   AM_CONDITIONAL(MAKE_BINDIST, true)
 elif test x"$is_beos" = "xyes"; then
-  AM_CONDITIONAL(UNIX_COMPILE, false)
+  AC_DEFINE(UNIX_COMPILE,,[Are we compiling for unix?])
+  AM_CONDITIONAL(UNIX_COMPILE, true)
   AM_CONDITIONAL(WINDOWS_COMPILE, false)
   AM_CONDITIONAL(MACOS_COMPILE, false)
-  AM_CONDITIONAL(MAKE_INSTALL, false)
-  AM_CONDITIONAL(MAKE_BINDIST, true)
+  AM_CONDITIONAL(MAKE_INSTALL, true)
+  AM_CONDITIONAL(MAKE_BINDIST, false)
 else
   AC_MSG_WARN([No architecture defined!])
 fi
diff --git a/src/arch/shared/archdep_socketpeek.c b/src/arch/shared/archdep_socketpeek.c
index 49f116e..f96d111 100644
--- a/src/arch/shared/archdep_socketpeek.c
+++ b/src/arch/shared/archdep_socketpeek.c
@@ -38,6 +38,10 @@
 #include <winsock.h>
 #endif
 
+#ifdef __HAIKU__
+#include <unistd.h>
+#endif
+
 #if defined(HAVE_WINSOCK_H) && defined(FIONREAD)
 
 int archdep_socketpeek(int fd, int *bytes_available)
-- 
2.54.0

