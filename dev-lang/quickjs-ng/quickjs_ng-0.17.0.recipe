SUMMARY="Small and embeddable Javascript engine"
DESCRIPTION="QuickJS is a small and embeddable JavaScript engine. It aims to support the latest \
ECMAScript specification.

This project (QuickJS-NG) is a fork of the original QuickJS project by Fabrice Bellard and Charlie Gordon, \
after it went dormant, with the intent of reigniting its development."
HOMEPAGE="https://quickjs-ng.github.io/quickjs"
COPYRIGHT="2017-2026 Fabrice Bellard
	2017-2024 Charlie Gordon
	2023-2026 Ben Noordhuis
	2023-2026 Saúl Ibarra Corretgé"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://github.com/quickjs-ng/quickjs/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256="559bc4c420475e55c7ab4510adbc562f55d7524d75e8e89d79ce4bb02f5687d9"
SOURCE_DIR="quickjs-$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

libVersion="$portVersion"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

PROVIDES="
	$portName = $portVersion
	cmd:qjs = $portVersion
	cmd:qjsc = $portVersion
	lib:libqjs$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"
REPLACES="quickjs$secondaryArchSuffix"

PROVIDES_devel="
	${portName}_devel = $portVersion
	devel:libqjs$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	$portName == $portVersion base
	"
REPLACES_devel="quickjs${secondaryArchSuffix}_devel"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	cmake -Bbuild -S. $cmakeDirArgs -W no-dev \
		-DCMAKE_BUILD_TYPE=Release -DQJS_BUILD_LIBC=ON -DBUILD_SHARED_LIBS=ON
	cmake --build build $jobArgs
}

INSTALL()
{
	cmake --install build

	prepareInstalledDevelLib libqjs

	# devel package
	packageEntries devel \
		$developDir \
		$libDir/cmake \
		$docDir
	rm -rf $(dirname $docDir)
}
