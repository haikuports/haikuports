From c277744f2646fcd0618c2c7edd71531a8a396c45 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?J=C3=A9r=C3=B4me=20Duval?= <jerome.duval@gmail.com>
Date: Mon, 5 Oct 2026 21:49:42 +0200
Subject: Haiku: no gtk LAF


diff --git a/src/java.desktop/share/classes/javax/swing/UIManager.java b/src/java.desktop/share/classes/javax/swing/UIManager.java
index 752b37a52..b985ebbc0 100644
--- a/src/java.desktop/share/classes/javax/swing/UIManager.java
+++ b/src/java.desktop/share/classes/javax/swing/UIManager.java
@@ -388,7 +388,7 @@ public String toString() {
         else if (osType == OSInfo.OSType.MACOSX) {
             iLAFs.add(new LookAndFeelInfo("Mac OS X", "com.apple.laf.AquaLookAndFeel"));
         }
-        else {
+        else if (osType != OSInfo.OSType.HAIKU) {
             // GTK is not shipped on Windows.
             iLAFs.add(new LookAndFeelInfo("GTK+",
                   "com.sun.java.swing.plaf.gtk.GTKLookAndFeel"));
diff --git a/src/java.desktop/share/classes/sun/awt/OSInfo.java b/src/java.desktop/share/classes/sun/awt/OSInfo.java
index decd3e354..0dc753334 100644
--- a/src/java.desktop/share/classes/sun/awt/OSInfo.java
+++ b/src/java.desktop/share/classes/sun/awt/OSInfo.java
@@ -41,6 +41,7 @@ public static enum OSType {
         LINUX,
         MACOSX,
         AIX,
+        HAIKU,
         UNKNOWN
     }
 
@@ -97,6 +98,7 @@ private static OSType getOSTypeImpl() {
             case LINUX -> LINUX;
             case MACOS -> MACOSX;
             case AIX -> AIX;
+            case HAIKU -> HAIKU;
             default -> UNKNOWN;
         };
     }
diff --git a/src/java.desktop/share/classes/sun/font/SunFontManager.java b/src/java.desktop/share/classes/sun/font/SunFontManager.java
index 2831cae25..0f26fc7e6 100644
--- a/src/java.desktop/share/classes/sun/font/SunFontManager.java
+++ b/src/java.desktop/share/classes/sun/font/SunFontManager.java
@@ -328,7 +328,7 @@ protected SunFontManager() {
          * registerFonts method as on-screen these JRE fonts
          * always go through the JDK rasteriser.
          */
-        if (FontUtilities.isLinux) {
+        if (FontUtilities.isLinux || FontUtilities.isHaiku) {
             /* Linux font configuration uses these fonts */
             registerFontDir(jreFontDirName);
         }
-- 
2.54.0

