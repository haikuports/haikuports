From 212a71106f9819e38a95a89054f9cb7f1b961ec3 Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Sat, 1 Aug 2026 10:53:00 +0200
Subject: applying patch FixPython3_14.diff


diff --git a/python/mach/mach/command_util.py b/python/mach/mach/command_util.py
index 44e13f18d..8539bf37b 100644
--- a/python/mach/mach/command_util.py
+++ b/python/mach/mach/command_util.py
@@ -292,7 +292,7 @@ class DecoratorVisitor(ast.NodeVisitor):
             kwarg_dict = {}
 
             for name, arg in zip(["command", "subcommand"], decorator.args):
-                kwarg_dict[name] = arg.s
+                kwarg_dict[name] = arg.value
 
             for keyword in decorator.keywords:
                 if keyword.arg not in relevant_kwargs:
diff --git a/python/mozbuild/mozbuild/frontend/reader.py b/python/mozbuild/mozbuild/frontend/reader.py
index 9f6292cb9..f0bcc8c77 100644
--- a/python/mozbuild/mozbuild/frontend/reader.py
+++ b/python/mozbuild/mozbuild/frontend/reader.py
@@ -470,7 +470,7 @@ class TemplateFunction:
             return c(
                 ast.Subscript(
                     value=c(ast.Name(id=self._global_name, ctx=ast.Load())),
-                    slice=c(ast.Index(value=c(ast.Str(s=node.id)))),
+                    slice=c(ast.Index(value=c(ast.Constant(value=node.id)))),
                     ctx=node.ctx,
                 )
             )
-- 
2.54.0


From 3b6fe5cf6057bcb1c6b8e69474114ac7489f64c9 Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Fri, 31 Jul 2026 18:47:26 +0200
Subject: Let the buildsystem know about Haiku


diff --git a/build/moz.configure/init.configure b/build/moz.configure/init.configure
index 6162d6869..ed9b742de 100644
--- a/build/moz.configure/init.configure
+++ b/build/moz.configure/init.configure
@@ -507,6 +507,8 @@ def split_triplet(triplet, allow_wasi=False):
         canonical_os = canonical_kernel = "DragonFly"
     elif os.startswith("freebsd"):
         canonical_os = canonical_kernel = "FreeBSD"
+    elif os.startswith("haiku"):
+        canonical_os = canonical_kernel = "Haiku"
     elif os.startswith("netbsd"):
         canonical_os = canonical_kernel = "NetBSD"
     elif os.startswith("openbsd"):
diff --git a/python/mozbuild/mozbuild/configure/constants.py b/python/mozbuild/mozbuild/configure/constants.py
index 25f43bb9f..887af93bd 100644
--- a/python/mozbuild/mozbuild/configure/constants.py
+++ b/python/mozbuild/mozbuild/configure/constants.py
@@ -36,6 +36,7 @@ class OS(EnumString):
         "DragonFly",
         "FreeBSD",
         "GNU",
+        "Haiku",
         "iOS",
         "NetBSD",
         "OpenBSD",
@@ -51,6 +52,7 @@ class Kernel(EnumString):
         "Darwin",
         "DragonFly",
         "FreeBSD",
+        "Haiku",
         "kFreeBSD",
         "Linux",
         "NetBSD",
@@ -143,6 +145,7 @@ kernel_preprocessor_checks = {
     "DragonFly": "__DragonFly__",
     "FreeBSD": "__FreeBSD__",
     "kFreeBSD": "__FreeBSD_kernel__",
+    "Haiku": "__HAIKU__",
     "Linux": "__linux__",
     "NetBSD": "__NetBSD__",
     "OpenBSD": "__OpenBSD__",
-- 
2.54.0


From baa5c015b50c8ca70e96104166ef234028ef3c16 Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Sat, 1 Aug 2026 10:48:57 +0200
Subject: Disable failing assert for Haiku


diff --git a/mozglue/misc/PlatformMutex.h b/mozglue/misc/PlatformMutex.h
index ac5459cf1..4bc6c2f88 100644
--- a/mozglue/misc/PlatformMutex.h
+++ b/mozglue/misc/PlatformMutex.h
@@ -48,7 +48,7 @@ class MutexImpl {
 
   PlatformData* platformData();
 
-#if !defined(XP_WIN) && !defined(__wasi__)
+#if !defined(XP_WIN) && !defined(__wasi__) && !defined(__HAIKU__)
   void* platformData_[sizeof(pthread_mutex_t) / sizeof(void*)];
   static_assert(sizeof(pthread_mutex_t) / sizeof(void*) != 0 &&
                     sizeof(pthread_mutex_t) % sizeof(void*) == 0,
-- 
2.54.0


From e3aef0e1b675b568a134ce99d83f6298c3e6a83e Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Sat, 1 Aug 2026 10:49:10 +0200
Subject: Let another buildfile know about Haiku


diff --git a/testing/mozbase/mozinfo/mozinfo/mozinfo.py b/testing/mozbase/mozinfo/mozinfo/mozinfo.py
index ee7f8a6e4..2b2927a07 100755
--- a/testing/mozbase/mozinfo/mozinfo/mozinfo.py
+++ b/testing/mozbase/mozinfo/mozinfo/mozinfo.py
@@ -116,6 +116,9 @@ elif system == "Darwin":
 elif sys.platform in ("solaris", "sunos5"):
     info["os"] = "unix"  # community builds
     os_version = version = sys.platform
+elif system == "Haiku":
+    info["os"] = "haiku"
+    os_version = version = "R1"
 else:
     os_version = version = unknown
 
-- 
2.54.0


From 90a7d2d01d540e89ba32b62b4f9c986fbbd61987 Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Sat, 1 Aug 2026 11:10:24 +0200
Subject: Haiku: define macros to access registers from mcontext


diff --git a/js/src/wasm/WasmSignalHandlers.cpp b/js/src/wasm/WasmSignalHandlers.cpp
index 06954b3dd..2786047d6 100644
--- a/js/src/wasm/WasmSignalHandlers.cpp
+++ b/js/src/wasm/WasmSignalHandlers.cpp
@@ -247,6 +247,26 @@ using namespace js::wasm;
 #    define RFP_sig(p) ((p)->thread.__fp)
 #    define R31_sig(p) ((p)->thread.__sp)
 #    define RLR_sig(p) ((p)->thread.__lr)
+#  elif defined(__HAIKU__)
+#    define EIP_sig(p) ((p)->uc_mcontext.eip)
+#    define RIP_sig(p) ((p)->uc_mcontext.rip)
+#    define RAX_sig(p) ((p)->uc_mcontext.rax)
+#    define RCX_sig(p) ((p)->uc_mcontext.rcx)
+#    define RDX_sig(p) ((p)->uc_mcontext.rdx)
+#    define RBX_sig(p) ((p)->uc_mcontext.rbx)
+#    define RSP_sig(p) ((p)->uc_mcontext.rsp)
+#    define RBP_sig(p) ((p)->uc_mcontext.rbp)
+#    define RSI_sig(p) ((p)->uc_mcontext.rsi)
+#    define RDI_sig(p) ((p)->uc_mcontext.rdi)
+#    define R8_sig(p) ((p)->uc_mcontext.r8)
+#    define R9_sig(p) ((p)->uc_mcontext.r9)
+#    define R10_sig(p) ((p)->uc_mcontext.r10)
+#    define R11_sig(p) ((p)->uc_mcontext.r11)
+#    define R12_sig(p) ((p)->uc_mcontext.r12)
+#    define R13_sig(p) ((p)->uc_mcontext.r13)
+#    define R14_sig(p) ((p)->uc_mcontext.r14)
+#    define R15_sig(p) ((p)->uc_mcontext.r15)
+#    define XMM_sig(p,i) ((p)->uc_mcontext.fpu.fp_fxsave.xmm[i])
 #  else
 #    error \
         "Don't know how to read/write to the thread state via the mcontext_t."
-- 
2.54.0


From 9961f2a9b9066111187d3519d42f43e0efd590d6 Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Sat, 1 Aug 2026 11:45:18 +0200
Subject: There is no sys/syscalls.h in Haiku


diff --git a/mozglue/misc/TimeStamp_posix.cpp b/mozglue/misc/TimeStamp_posix.cpp
index 6f87118a1..dd73cdcfa 100644
--- a/mozglue/misc/TimeStamp_posix.cpp
+++ b/mozglue/misc/TimeStamp_posix.cpp
@@ -13,7 +13,10 @@
 // obtained with this API; see TimeDuration::Resolution;
 //
 
+#if !defined(__HAIKU__)
 #include <sys/syscall.h>
+#endif
+
 #include <time.h>
 #include <unistd.h>
 #include <string.h>
-- 
2.54.0


From 692e7f3d002b0304c55f5254a1122cddbd983a51 Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Sat, 1 Aug 2026 11:45:33 +0200
Subject: Link to libnetwork and libbsd


diff --git a/build/moz.configure/libraries.configure b/build/moz.configure/libraries.configure
index 26ca886f6..55b322b6c 100644
--- a/build/moz.configure/libraries.configure
+++ b/build/moz.configure/libraries.configure
@@ -82,9 +82,9 @@ set_config(
 )
 set_config(
     "SOCKET_LIBS",
-    ["-lsocket"],
+    ["-lnetwork"],
     when=check_symbol_in_lib(
-        "socket", symbol="socket", when=building_with_gnu_compatible_cc
+        "network", symbol="socket", when=building_with_gnu_compatible_cc
     ),
 )
 
diff --git a/js/src/rust/moz.build b/js/src/rust/moz.build
index 3b18ee083..895f8662c 100644
--- a/js/src/rust/moz.build
+++ b/js/src/rust/moz.build
@@ -34,6 +34,8 @@ elif CONFIG["OS_ARCH"] == "WINNT":
         "userenv",
         "ws2_32",
     ]
+elif CONFIG["OS_ARCH"] == "Haiku":
+    OS_LIBS += ["-lnetwork", "-lbsd"]
 
 COMPILE_FLAGS["BASE_INCLUDES"] = []
 HOST_COMPILE_FLAGS["BASE_INCLUDES"] = []
-- 
2.54.0


From 25a0e473e9860da67f479b212c33b25292eae7ba Mon Sep 17 00:00:00 2001
From: Luc Schrijvers <begasus@gmail.com>
Date: Sat, 8 Aug 2026 10:30:44 +0200
Subject: Add support to handle : typedef int FileHandleType;


diff --git a/mfbt/UniquePtrExtensions.h b/mfbt/UniquePtrExtensions.h
index 565d4bf1f..eafd73da0 100644
--- a/mfbt/UniquePtrExtensions.h
+++ b/mfbt/UniquePtrExtensions.h
@@ -98,7 +98,7 @@ struct FreePolicy {
 // Can't include <windows.h> to get the actual definition of HANDLE
 // because of namespace pollution.
 typedef void* FileHandleType;
-#  elif defined(XP_UNIX)
+#  elif defined(XP_UNIX) || defined(__HAIKU__)
 typedef int FileHandleType;
 #  else
 #    error "Unsupported OS?"
@@ -106,7 +106,7 @@ typedef int FileHandleType;
 
 struct FileHandleHelper {
   MOZ_IMPLICIT FileHandleHelper(FileHandleType aHandle) : mHandle(aHandle) {
-#  if defined(XP_UNIX) && (defined(DEBUG) || defined(FUZZING))
+#  if defined(XP_UNIX) || defined(__HAIKU__) && (defined(DEBUG) || defined(FUZZING))
     MOZ_RELEASE_ASSERT(aHandle == kInvalidHandle || aHandle > 2);
 #  endif
   }
-- 
2.54.0

