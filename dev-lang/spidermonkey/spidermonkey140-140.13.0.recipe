SUMMARY="A Javascript engine written in C/C++"
DESCRIPTION="Spidermonkey is a Javascript engine written in C/C++ used in \
various products from Mozilla."
HOMEPAGE="https://developer.mozilla.org/en-US/docs/Mozilla/Projects/SpiderMonkey"
COPYRIGHT="1998-1999 Netscape Communications Corporation
2000-2026 Mozilla Fundation"
LICENSE="NPL v1.1"
SOURCE_URI="https://releases.wildfiregames.com/libs/mozjs-$portVersion.tar.xz"
SOURCE_DIR="mozjs-$portVersion"
CHECKSUM_SHA256="04f9a92c7126e5d8036d526c72b957ff7eb253eee2383dd2dc60623229a01549"
REVISION="1"
PATCHES="spidermonkey-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="?x86"

pythonVersion=3.14
pythonPackage=python$pythonVersion

PROVIDES="
	spidermonkey140$secondaryArchSuffix = $portVersion compat >= 140
	lib:libmozjs_140$secondaryArchSuffix
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

PROVIDES_devel="
	spidermonkey140${secondaryArchSuffix}_devel = $portVersion
	devel:libmozjs_140$secondaryArchSuffix
	"
REQUIRES_devel="
	spidermonkey140$secondaryArchSuffix == $portVersion base
	"
CONFLICTS_devel="
	spidermonkey${secondaryArchSuffix}_devel
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	mozfile_$pythonPackage
	cmd:gcc$secondaryArchSuffix
	devel:libgcc$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	llvm21$secondaryArchSuffix
	cmd:awk
	cmd:cbindgen
	cmd:cmp
	cmd:m4
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	cmd:rustc$secondaryArchSuffix
	cmd:python$pythonVersion
	"

BUILD()
{
	rm -rf /boot/home/.mozbuild
	echo -e "ac_add_options --enable-optimize
ac_add_options --enable-release
mk_add_options MOZ_OBJDIR=obj-release" > mozconfig
	MOZ_NOSPAM=1 MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=none \
		MOZCONFIG_OPTIONS="--with-system-zlib" \
		python$pythonVersion mach build $jobArgs
}

INSTALL()
{
	mkdir -p $libDir
	cp obj-release/dist/bin/libmozjs-140.so $libDir

	mkdir -p $includeDir
	cp -Lpr obj-release/dist/include/* $includeDir

	mkdir -p $developLibDir/pkgconfig
	cat > $developLibDir/pkgconfig/mozjs-140.pc << EOF
prefix=$prefix
exec_prefix=$prefix
bindir=$prefix/bin
libdir=$libDir
includedir=$includeDir

Name: SpiderMonkey 140.13.0
Description: The Mozilla library for JavaScript
Version: $portVersion
Libs: -L$developLibDir -lmozjs-140
Cflags: -I$includeDir
EOF

	prepareInstalledDevelLib \
		libmozjs-140

		packageEntries devel \
		$developDir
}
