# "monolite" bootstrap corlib snapshot. mcs/class/Makefile's own
# get-monolite-latest target would otherwise reach out to this same URL
# *during* BUILD() to solve the chicken-and-egg problem of compiling
# mscorlib.dll for the first time -- but haikuporter's build chroot has no
# network access at that point, so we fetch it up front like every other
# source and place it ourselves (see BUILD() below).
# NOTE: unlike every other numbered source above, this upstream URL is a
# mutable "-latest" pointer, not a commit-pinned archive. If WineHQ ever
# republishes a new snapshot at this same URL, CHECKSUM_SHA256_25 below will
# simply stop matching and the build will fail loudly rather than silently
# use different bits -- but there is no commit-pinned alternative upstream
# offers for this particular artifact.
SOURCE_URI_25="https://dl.winehq.org/mono/monolite/monolite-unix-1A5E0066-58DC-428A-B21C-0AD6CDAE2789-latest.tar.gz"
CHECKSUM_SHA256_25="7b2143aa1aa8ef988b925deb63f114ebfcfa6b2a6aef7bd9c1dc1efbc18a81a8"
SOURCE_DIR_25="monolite-unix-1A5E0066-58DC-428A-B21C-0AD6CDAE2789-latest"

PATCHES="mono-$portVersion.patchset"
ARCHITECTURES="x86_64"

# The whole settings/mono tree (etc/mono/config with all its <dllmap> entries,
# plus the per-profile machine.config/web.config/settings.map/browscap.ini/
# mconfig files) has to be declared writable, or packagefs never actually
# copies it into the live settings tree -- it just sits inert inside the
# package. Without this, mono can't find its own config file at runtime at
# all, so none of its <dllmap> redirects (including the one that points
# System.Native at our own libmono-native.so) ever get applied, and the
# runtime falls back to guessing library names that don't exist on Haiku.
GLOBAL_WRITABLE_FILES="
	settings/mono directory keep-old
	"

# Every executable and shared library the package ships, so other ports can
# depend on specific mono commands/libraries per HandlingRequirements.md's
# "be explicit" rule. cmd: entries cover the core, most-likely-to-be-depended
# on commands rather than all ~90 installed binaries. lib: versions/compat
# match the real .so version and soname from the dry-run install's lib/ dir.
PROVIDES="
	mono = $portVersion
	cmd:csc = $portVersion
	cmd:dmcs = $portVersion
	cmd:gacutil = $portVersion
	cmd:ilasm = $portVersion
	cmd:mcs = $portVersion
	cmd:mkbundle = $portVersion
	cmd:mono = $portVersion
	cmd:mono_sgen = $portVersion
	cmd:monodis = $portVersion
	cmd:pdb2mdb = $portVersion
	cmd:sn = $portVersion
	cmd:vbc = $portVersion
	cmd:xbuild = $portVersion
	lib:libmono_2.0 = 1.0.0 compat >= 1
	lib:libmono_native = 0.0.0 compat >= 0
	lib:libmono_profiler_aot = 0.0.0 compat >= 0
	lib:libmono_profiler_coverage = 0.0.0 compat >= 0
	lib:libmono_profiler_log = 0.0.0 compat >= 0
	lib:libmonoboehm_2.0 = 1.0.0 compat >= 1
	lib:libmonosgen_2.0 = 1.0.0 compat >= 1
	"

# Derived from readelf -d NEEDED entries on every mono binary/library built
# by a full dry-run install (bin/mono, bin/mono-sgen, and all lib/libmono*).
# libnetwork.so, libtextencoding.so and libroot.so are core Haiku OS
# libraries shipped with the base "haiku" package, not separate ports.
REQUIRES="
	haiku
	lib:libexecinfo
	lib:libz
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libexecinfo
	devel:libz
	"
BUILD_PREREQUIRES="
	cmd:autoconf
	cmd:automake
	cmd:gcc
	cmd:git
	cmd:libtool
	cmd:make
	cmd:pkg_config
	cmd:python3
	cmd:which
	"

BUILD()
{
	rm -rf external/api-doc-tools external/bdwgc external/boringssl external/corefx \
		external/roslyn-binaries external/binary-reference-assemblies external/cecil \
		external/corert external/ikvm external/linker external/aspnetwebstack \
		external/ikdasm external/xunit-binaries external/cecil-legacy external/rx \
		external/nuget-buildtasks external/bockbuild external/nunit-lite \
		external/illinker-test-assets external/Newtonsoft.Json external/api-snapshot
	cp -a $sourceDir2 external/api-doc-tools
	cp -a $sourceDir3 external/bdwgc
	cp -a $sourceDir4 external/boringssl
	cp -a $sourceDir5 external/corefx
	cp -a $sourceDir6 external/roslyn-binaries
	cp -a $sourceDir7 external/binary-reference-assemblies
	cp -a $sourceDir8 external/cecil
	cp -a $sourceDir9 external/corert
	cp -a $sourceDir10 external/ikvm
	cp -a $sourceDir11 external/linker
	cp -a $sourceDir12 external/aspnetwebstack
	cp -a $sourceDir13 external/ikdasm
	cp -a $sourceDir14 external/xunit-binaries
	cp -a $sourceDir15 external/cecil-legacy
	cp -a $sourceDir16 external/rx
	cp -a $sourceDir17 external/nuget-buildtasks
	cp -a $sourceDir18 external/bockbuild
	cp -a $sourceDir19 external/nunit-lite
	cp -a $sourceDir20 external/illinker-test-assets
	cp -a $sourceDir21 external/Newtonsoft.Json
	cp -a $sourceDir22 external/api-snapshot

	# api-doc-tools has its own submodules that its archive export doesn't
	# include either; nest them in place after it's copied.
	rm -rf external/api-doc-tools/external/Lucene.Net.Light external/api-doc-tools/external/SharpZipLib
	cp -a $sourceDir23 external/api-doc-tools/external/Lucene.Net.Light
	cp -a $sourceDir24 external/api-doc-tools/external/SharpZipLib

	# Pre-place the "monolite" bootstrap corlib snapshot exactly where
	# mcs/class/Makefile's get-monolite-latest target would have put it
	# after downloading + renaming, so its own "already have it" check
	# (test -s $(MONOLITE_MSCORLIB)) is satisfied and it never attempts the
	# network fetch that isn't possible inside the build chroot.
	mkdir -p mcs/class/lib/monolite-unix
	rm -rf mcs/class/lib/monolite-unix/1A5E0066-58DC-428A-B21C-0AD6CDAE2789
	cp -a $sourceDir25 mcs/class/lib/monolite-unix/1A5E0066-58DC-428A-B21C-0AD6CDAE2789

	# PATH fix for the self-hosting bootstrap gap: mono-wrapper (the freshly
	# built native runtime) is a real prerequisite of all-mcs, but the
	# upstream build never puts it on PATH itself. Exporting it once up
	# front is enough since make resolves it lazily.
	export PATH="$PWD/runtime/_tmpinst/bin:$PATH"

	runConfigure ./autogen.sh --with-mcs-docs=no --enable-nls=no \
		--disable-static
	make $jobArgs
}
INSTALL()
{
	make install

	# Every invocation of the just-built runtime during the build (gacutil,
	# mkbundle, etc.) goes through runtime/mono-wrapper, a libtool "execute"
	# wrapper that ends up exec'ing mono/mini/.libs/lt-mono-sgen directly --
	# there are well over a hundred of these over the course of a full
	# build, and almost all of them exit within a second or two, same as on
	# any other platform. But on Haiku, at least one of them (confirmed via
	# a live process-table watch across a full build: a single instance
	# stayed alive continuously for 18+ minutes, fully initialized -- SGen
	# worker/Finalizer/Timer-Scheduler/thread-pool all present -- but every
	# thread sitting blocked in "wait" state, not consuming CPU) never gets
	# told to exit and is simply never reaped by anything. Haikuporter's own
	# chroot teardown only retries unmounting "dev" for about 15 seconds
	# before giving up, force-unmounting it, and unconditionally exiting 1 --
	# reporting the whole build as failed even though packaging already
	# succeeded. That forced-unmount-then-exit-1 path runs identically
	# whether or not anyone is watching a terminal, so this isn't just a
	# local annoyance: the same bad luck would fail an unattended CI build
	# too and block a pull request on it.
	#
	# Track down and kill any such straggler ourselves before handing
	# control back to haikuporter, using the exact same mechanism its own
	# cleanupChroot script uses to detect this in the first place --
	# "fdinfo -d /dev" lists every team still holding a file descriptor
	# open under the mount haikuporter is about to try to unmount, which is
	# the literal condition that makes its unmount fail. Cross-check each
	# candidate's own listed executable path for "mono-sgen"/"mono-boehm"
	# before killing it, so this can never touch bash, make, or anything
	# else that happens to have e.g. /dev/null open as stdin.
	local pid
	for pid in $(fdinfo -d /dev 2>/dev/null | grep -iE 'mono-sgen|mono-boehm' \
			| awk '{print $1}' | sort -u); do
		echo "mono-6.14.1: killing team $pid still holding /dev open after install"
		kill -9 "$pid" 2>/dev/null
	done

	# We don't ship a "-devel" subpackage (no PROVIDES_devel/REQUIRES_devel,
	# no packageEntries devel split), so there's no develop/lib consumer for
	# any of these anyway -- --disable-static above should stop most of them
	# from being built in the first place, but Mono's own Makefiles build a
	# few "-static" profiler variants (libmono-profiler-{aot,coverage,log}
	# -static) as explicit targets independent of the global libtool static/
	# shared toggle, and libtool still drops an empty .la stub next to some
	# shared libs regardless. Matching how net-misc/curl's recipe handles its
	# own leftover libcurl.la: just remove them rather than relocating them
	# to develop/lib, since nothing in this package's PROVIDES declares a
	# devel: entry that would need them there.
	rm -f $libDir/*.a $libDir/*.la
}
