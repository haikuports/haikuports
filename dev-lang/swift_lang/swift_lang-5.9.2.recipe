PATCHES="swift_llvm-$portVersion.patchset"
PATCHES_2="swift_lang-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2 !x86"
SECONDARY_ARCHITECTURES="!x86"

PROVIDES="
	swift_lang$secondaryArchSuffix = $portVersion
	cmd:swift$secondaryArchSuffix = $portVersion
	cmd:swift_api_digester$secondaryArchSuffix = $portVersion
	cmd:swift_api_dump.py$secondaryArchSuffix = $portVersion
	cmd:swift_api_extract$secondaryArchSuffix = $portVersion
	cmd:swift_ast_script$secondaryArchSuffix = $portVersion
	cmd:swift_autolink_extract$secondaryArchSuffix = $portVersion
	cmd:swift_compatibility_symbols$secondaryArchSuffix = $portVersion
	cmd:swift_def_to_strings_converter$secondaryArchSuffix = $portVersion
	cmd:swift_demangle$secondaryArchSuffix = $portVersion
	cmd:swift_demangle_yamldump$secondaryArchSuffix = $portVersion
	cmd:swift_dependency_tool$secondaryArchSuffix = $portVersion
	cmd:swift_frontend$secondaryArchSuffix = $portVersion
	cmd:swift_indent$secondaryArchSuffix = $portVersion
	cmd:swift_llvm_opt$secondaryArchSuffix = $portVersion
	cmd:swift_refactor$secondaryArchSuffix = $portVersion
	cmd:swift_reflection_dump$secondaryArchSuffix = $portVersion
	cmd:swift_serialize_diagnostics$secondaryArchSuffix = $portVersion
	cmd:swift_symbolgraph_extract$secondaryArchSuffix = $portVersion
	cmd:swiftc$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	llvm17$secondaryArchSuffix
	lib:libatomic$secondaryArchSuffix
	lib:libexecinfo$secondaryArchSuffix
	lib:libncurses$secondaryArchSuffix
	lib:libuuid$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	gcc${secondaryArchSuffix}_syslibs_devel
	devel:libcharset$secondaryArchSuffix
	devel:libedit$secondaryArchSuffix
	devel:libexecinfo$secondaryArchSuffix
	devel:libgcc$secondaryArchSuffix
	devel:libiconv$secondaryArchSuffix
	devel:libicudata$secondaryArchSuffix >= 74
	devel:libicui18n$secondaryArchSuffix >= 74
	devel:libicuuc$secondaryArchSuffix >= 74
	devel:libncurses$secondaryArchSuffix
	devel:libsqlite3$secondaryArchSuffix
	devel:libuuid$secondaryArchSuffix >= 1.3
	devel:libxml2$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	llvm17_clang$secondaryArchSuffix
	cmd:cmake
	cmd:diff
	cmd:find
	cmd:gcc$secondaryArchSuffix
	cmd:grep
	cmd:groff
	llvm17_lld$secondaryArchSuffix
	cmd:libtool$secondaryArchSuffix
	cmd:make
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	cmd:python3.12
	cmd:sed
	cmd:swig
	cmd:which
	"

BUILD()
{
	cd ..

	# Prepare source directories
	mkdir -p llvm-project swift cmark llbuild \
	         swift-tools-support-core swiftpm swift-argument-parser swift-collections \
	         swift-crypto swift-certificates swift-asn1 swift-driver \
	         swift-syntax swift-system swift-stress-tester swift-corelibs-xctest \
	         swift-corelibs-foundation swift-corelibs-libdispatch yams indexstore-db \
	         sourcekit-lsp swift-format swift-docc swift-lmdb \
	         swift-docc-symbolkit swift-markdown swift-nio swift-experimental-string-processing \

	# Place source files to required layout
	cp -rd $sourceDir/* llvm-project
	cp -rd $sourceDir2/* swift
	cp -rd $sourceDir3/* cmark
	cp -rd $sourceDir4/* llbuild
	cp -rd $sourceDir5/* swift-tools-support-core
	cp -rd $sourceDir6/* swiftpm
	cp -rd $sourceDir7/* swift-argument-parser
	cp -rd $sourceDir8/* swift-collections
	cp -rd $sourceDir9/* swift-crypto
	cp -rd $sourceDir10/* swift-certificates
	cp -rd $sourceDir11/* swift-asn1
	cp -rd $sourceDir12/* swift-driver
	cp -rd $sourceDir13/* swift-syntax
	cp -rd $sourceDir14/* swift-system
	cp -rd $sourceDir15/* swift-stress-tester
	cp -rd $sourceDir16/* swift-corelibs-xctest
	cp -rd $sourceDir17/* swift-corelibs-foundation
	cp -rd $sourceDir18/* swift-corelibs-libdispatch
	cp -rd $sourceDir19/* yams
	cp -rd $sourceDir20/* indexstore-db
	cp -rd $sourceDir21/* sourcekit-lsp
	cp -rd $sourceDir22/* swift-format
	cp -rd $sourceDir23/* swift-docc
	cp -rd $sourceDir24/* swift-lmdb
	cp -rd $sourceDir25/* swift-docc-symbolkit
	cp -rd $sourceDir26/* swift-markdown
	cp -rd $sourceDir27/* swift-nio
	cp -rd $sourceDir28/* swift-experimental-string-processing

	# Fix permisssions for build-script.
	chmod +x ./swift/utils/build-script ./swift/utils/build-script-impl
	chmod -R 755 ./swift/utils

	export HOST_CC="/bin/clang"
	export HOST_CXX="/bin/clang++"

	# Notes:
	# - `bootstrapping=off` means we use C++ for Swift build.
	#   This is supported yet, but it'll change to use Swift to build Swift itself,
	#   we'll build using Swift from HaikuDepot or will build bootstrap-Swift in the
	#   build process in future.
	#   see: https://forums.swift.org/t/unable-to-build-with-bootstrapping-enabled/68493/3
	#
	# - `-j2` is a workaround for linker crash probably caused by too many files opened.
	#   `-j1`, `-j2` worked but `-j4` reliably failed to build on my env.
	python3.12 ./swift/utils/build-script \
	    -R \
	    --bootstrapping=off \
	    --llvm-targets-to-build=X86 \
	    --skip-build-clang-tools-extra \
	    --skip-build-compiler-rt \
	    --llvm-cmake-options="\
	        -DLLVM_ENABLE_ASSERTIONS=TRUE,\
	        -DCMAKE_SKIP_RPATH=FALSE,\
	        -DLLVM_ENABLE_RTTI=ON,\
	        -DLLVM_ENABLE_THREADS=ON,\
	        -DCMAKE_C_FLAGS=-fPIC,\
	        -DCMAKE_CXX_FLAGS=-fPIC,\
	        -DCMAKE_SHARED_LINKER_FLAGS='-lnetwork',\
	        -DCMAKE_EXE_LINKER_FLAGS='-lnetwork',\
	        -Wno-author" \
	    --extra-cmake-options="\
	        -DSWIFT_ENABLE_DISPATCH=OFF,\
	        -DSWIFT_BUILD_SOURCEKIT=OFF,\
	        -DSWIFT_ENABLE_EXPERIMENTAL_CONCURRENCY=OFF,\
	        -DSWIFT_ENABLE_EXPERIMENTAL_CXX_INTEROP=ON,\
	        -DSWIFT_IMPLICIT_CONCURRENCY_IMPORT=OFF,\
	        -DSWIFT_ENABLE_EXPERIMENTAL_DISTRIBUTED=OFF,\
	        -DSWIFT_ENABLE_EXPERIMENTAL_DIFFERENTIABLE_PROGRAMMING=OFF,\
	        -DSWIFT_ENABLE_EXPERIMENTAL_OBSERVATION=OFF,\
	        -DSWIFT_USE_LINKER=lld,\
	        -DLLVM_USE_LINKER=lld,\
	        -Wno-author" \
	    --stdlib-deployment-targets=haiku-x86_64 $jobArgs -j2
}

INSTALL()
{
	mkdir -p $binDir $libDir/swift $libDir/swift/shims \
		$libDir/swift/haiku/x86_64 $libDir/swift/clang/include

	cd ../build/Ninja-ReleaseAssert/swift-haiku-x86_64

	# Copy the executables into the binDir.
	cp -P ./bin/swift* $binDir
	rm $binDir/swift-ide-test \
	   $binDir/swift-reflection-test-HAIKU \
	   $binDir/swift-reflection-test-haiku-x86_64 \
	   $binDir/swift-remoteast-test
	cd ./lib/swift/

	# Symlink and copy the clang headers.
	ln -sfn ../../../llvm-haiku-x86_64/lib/clang/13.0.0/include/ clang
	cp -R ./clang/* $libDir/swift/clang/include
	cp -R ./shims/* $libDir/swift/shims

	# Copy the specific library files.
	cp ./haiku/libswiftCore.so $libDir/swift/haiku
	cp ./haiku/libswiftGlibc.so $libDir/swift/haiku
	cp ./haiku/libswiftRemoteMirror.so $libDir/swift/haiku
	cp ./haiku/libswiftSwiftOnoneSupport.so $libDir/swift/haiku
	cp ./haiku/libswift_RegexParser.so $libDir/swift/haiku
	cp ./haiku/libswift_StringProcessing.so $libDir/swift/haiku

	# Copy the essential swiftmodule files.
	cp -R ./haiku/SwiftOnoneSupport.swiftmodule $libDir/swift/haiku/x86_64
	cp -R ./haiku/Glibc.swiftmodule $libDir/swift/haiku/x86_64
	cp -R ./haiku/Swift.swiftmodule $libDir/swift/haiku/x86_64
	cp -R ./haiku/_StringProcessing.swiftmodule $libDir/swift/haiku/x86_64

	# CxxInterop for swift 5.10 build
	cp -R ./haiku/Cxx.swiftmodule       $libDir/swift/haiku/x86_64
	cp -R ./haiku/CxxStdlib.swiftmodule	$libDir/swift/haiku/x86_64
	cp ./haiku/x86_64/libswiftCxx.a     $libDir/swift/haiku/x86_64

	# Glibc for swift 5.10 build
	cp ./haiku/x86_64/SwiftGlibc.h      $libDir/swift/haiku/x86_64
	cp ./haiku/x86_64/glibc.modulemap   $libDir/swift/haiku/x86_64

	# Copy the essential swiftdoc files.
	cp ./haiku/x86_64/swiftrt.o         $libDir/swift/haiku/x86_64
}

TEST()
{
	python3.12 utils/build-script -R -t
}
