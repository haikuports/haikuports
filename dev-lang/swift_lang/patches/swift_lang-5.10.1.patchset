From a9e50117d9d05d5c2574e3be0ccff90ac67a8376 Mon Sep 17 00:00:00 2001
From: KENZ <KENZ.gelsoft@gmail.com>
Date: Thu, 26 Nov 2026 06:46:24 +0900
Subject: [PATCH 2/3] Fix ClangImporter to use libstdc++ for Haiku and make it
 to build CxxStdlib.swiftmodule

---
 lib/ClangImporter/ClangIncludePaths.cpp | 2 +-
 stdlib/public/Cxx/std/CMakeLists.txt    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/lib/ClangImporter/ClangIncludePaths.cpp b/lib/ClangImporter/ClangIncludePaths.cpp
index 0e9c42a4c44..4e5365475ab 100644
--- a/lib/ClangImporter/ClangIncludePaths.cpp
+++ b/lib/ClangImporter/ClangIncludePaths.cpp
@@ -263,7 +263,7 @@ static void getLibStdCxxFileMapping(
 
   const llvm::Triple &triple = ctx.LangOpts.Target;
   // We currently only need this when building for Linux.
-  if (!triple.isOSLinux())
+  if (!triple.isOSLinux() && !triple.isOSHaiku())
     return;
   // Android uses libc++.
   if (triple.isAndroid())
diff --git a/stdlib/public/Cxx/std/CMakeLists.txt b/stdlib/public/Cxx/std/CMakeLists.txt
index 3ed04729d4e..0543a546904 100644
--- a/stdlib/public/Cxx/std/CMakeLists.txt
+++ b/stdlib/public/Cxx/std/CMakeLists.txt
@@ -52,7 +52,7 @@ add_swift_target_library(swiftCxxStdlib STATIC NO_LINK_NAME IS_STDLIB IS_SWIFT_O
     DEPLOYMENT_VERSION_OSX ${COMPATIBILITY_MINIMUM_DEPLOYMENT_VERSION_OSX}
 
     LINK_FLAGS "${SWIFT_RUNTIME_SWIFT_LINK_FLAGS}"
-    TARGET_SDKS ALL_APPLE_PLATFORMS LINUX WINDOWS
+    TARGET_SDKS ALL_APPLE_PLATFORMS LINUX WINDOWS HAIKU
     INSTALL_IN_COMPONENT compiler
     INSTALL_WITH_SHARED
     DEPENDS libstdcxx-modulemap libcxxshim_modulemap CxxStdlib-apinotes)
-- 
2.56.0


From 5e2471db2a569b9c391de68a0df96ccd08fe3a98 Mon Sep 17 00:00:00 2001
From: KENZ <KENZ.gelsoft@gmail.com>
Date: Thu, 26 Nov 2026 06:50:56 +0900
Subject: [PATCH 3/3] Add patch to compile Swift 5.10 with 5.9.2 haikuport
 swiftc

- Handle swiftc path relative path resolution
- Don't strip some required symbols by adding `nostart-stop-gc` option to linker
---
 CMakeLists.txt                      |  5 ++++-
 SwiftCompilerSources/CMakeLists.txt |  6 +++++-
 cmake/modules/AddPureSwift.cmake    |  8 ++++++++
 cmake/modules/AddSwift.cmake        | 15 +++++++++++++--
 cmake/modules/SwiftUtils.cmake      |  4 +++-
 5 files changed, 33 insertions(+), 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 172e5d4f365..d33f9e35828 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1336,8 +1336,11 @@ if(SWIFT_INCLUDE_TOOLS)
     # All libraries in 'swift-syntax' goes to 'lib/swift/host'.
     set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${SWIFT_HOST_LIBRARIES_DEST_DIR}")
     set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${SWIFT_HOST_LIBRARIES_DEST_DIR}")
-    if(SWIFT_HOST_VARIANT_SDK MATCHES "LINUX|ANDROID|OPENBSD|FREEBSD")
+    if(SWIFT_HOST_VARIANT_SDK MATCHES "LINUX|ANDROID|OPENBSD|FREEBSD|HAIKU")
       set(SWIFT_HOST_LIBRARIES_RPATH "$ORIGIN;$ORIGIN/../${SWIFT_SDK_${SWIFT_HOST_VARIANT_SDK}_LIB_SUBDIR}")
+      if(SWIFT_HOST_VARIANT_SDK MATCHES "HAIKU")
+        list(APPEND SWIFT_HOST_LIBRARIES_RPATH "/boot/system/lib/swift/haiku")
+      endif()
     endif()
     # Add unique ABI prefix to swift-syntax libraries so that compiler libraries (e.g. sourcekitdInProc)
     # can be used from tools that has its own swift-syntax libraries as SwiftPM dependencies.
diff --git a/SwiftCompilerSources/CMakeLists.txt b/SwiftCompilerSources/CMakeLists.txt
index 1899b9f43a5..04e70e7b77b 100644
--- a/SwiftCompilerSources/CMakeLists.txt
+++ b/SwiftCompilerSources/CMakeLists.txt
@@ -133,7 +133,11 @@ function(add_swift_compiler_modules_library name)
   # Let Swift discover SwiftShims headers which are included by some headers
   # under `include/swift`. These are either located next to the compiler (in case of open source toolchains) or
   # in the SDK (in case a Swift compiler from Xcode)
-  get_filename_component(swift_exec_bin_dir ${ALS_SWIFT_EXEC} DIRECTORY)
+  if (SWIFT_HOST_VARIANT_SDK STREQUAL "HAIKU")
+    set(swift_exec_bin_dir "/boot/system/bin")
+  else()
+    get_filename_component(swift_exec_bin_dir ${ALS_SWIFT_EXEC} DIRECTORY)
+  endif()
   set(sdk_option ${sdk_option} "-I" "${swift_exec_bin_dir}/../lib" "-I" "${sdk_path}/usr/lib")
 
   set(all_obj_files)
diff --git a/cmake/modules/AddPureSwift.cmake b/cmake/modules/AddPureSwift.cmake
index 03c18eca00f..3be42c54b93 100644
--- a/cmake/modules/AddPureSwift.cmake
+++ b/cmake/modules/AddPureSwift.cmake
@@ -61,6 +61,14 @@ function(_set_pure_swift_link_flags name relpath_to_lib_dir)
         # NOTE: This relies on the ABI being the same as the builder.
         "$ORIGIN/${relpath_to_lib_dir}swift/${SWIFT_SDK_${SWIFT_HOST_VARIANT_SDK}_LIB_SUBDIR}"
     )
+    if(SWIFT_HOST_VARIANT_SDK STREQUAL "HAIKU")
+      set_property(TARGET ${name}
+        APPEND PROPERTY INSTALL_RPATH
+          "/boot/system/lib/swift/${SWIFT_SDK_HAIKU_LIB_SUBDIR}"
+          "/boot/system/lib/swift/${SWIFT_SDK_HAIKU_LIB_SUBDIR}/${SWIFT_HOST_VARIANT_ARCH}"
+          "/boot/system/lib"
+      )
+    endif()
     # NOTE: At this point we don't have any pure swift executables/shared
     # libraries required for building runtime/stdlib. So we don't need to add
     # RPATH to the builder's runtime.
diff --git a/cmake/modules/AddSwift.cmake b/cmake/modules/AddSwift.cmake
index c626b9c0f20..4aedeae81b6 100644
--- a/cmake/modules/AddSwift.cmake
+++ b/cmake/modules/AddSwift.cmake
@@ -389,7 +389,8 @@ function(_add_host_variant_link_flags target)
     target_link_libraries(${target} PRIVATE
       bsd)
     target_link_options(${target} PRIVATE
-      "SHELL:-Xlinker -Bsymbolic")
+      "SHELL:-Xlinker -Bsymbolic"
+      "LINKER:-z,nostart-stop-gc")
   elseif(SWIFT_HOST_VARIANT_SDK STREQUAL "ANDROID")
     target_link_libraries(${target} PRIVATE
       dl
@@ -561,6 +562,8 @@ function(_add_swift_runtime_link_flags target relpath_to_lib_dir bootstrapping)
       # installed host toolchain.
       if(SWIFT_PATH_TO_SWIFT_SDK)
         set(swift_dir "${SWIFT_PATH_TO_SWIFT_SDK}/usr")
+      elseif(SWIFT_HOST_VARIANT_SDK STREQUAL "HAIKU")
+        set(swift_dir "/boot/system")
       else()
         get_filename_component(swift_bin_dir ${SWIFT_EXEC_FOR_SWIFT_MODULES} DIRECTORY)
         get_filename_component(swift_dir ${swift_bin_dir} DIRECTORY)
@@ -578,7 +581,15 @@ function(_add_swift_runtime_link_flags target relpath_to_lib_dir bootstrapping)
       # At runtime, use swiftCore in the current toolchain.
       # For building stdlib, LD_LIBRARY_PATH will be set to builder's stdlib
       # FIXME: This assumes the ABI hasn't changed since the builder.
-      set(swift_runtime_rpath "$ORIGIN/${relpath_to_lib_dir}/swift/${SWIFT_SDK_${SWIFT_HOST_VARIANT_SDK}_LIB_SUBDIR}")
+      if(SWIFT_HOST_VARIANT_SDK STREQUAL "HAIKU")
+        list(APPEND swift_runtime_rpath
+          "$ORIGIN/${relpath_to_lib_dir}/swift/${SWIFT_SDK_${SWIFT_HOST_VARIANT_SDK}_LIB_SUBDIR}"
+          "/boot/system/lib/swift/${SWIFT_SDK_${SWIFT_HOST_VARIANT_SDK}_LIB_SUBDIR}"
+          "/boot/system/lib/swift/${SWIFT_SDK_${SWIFT_HOST_VARIANT_SDK}_LIB_SUBDIR}/${SWIFT_HOST_VARIANT_ARCH}"
+          "/boot/system/lib")
+      else()
+        set(swift_runtime_rpath "$ORIGIN/${relpath_to_lib_dir}/swift/${SWIFT_SDK_${SWIFT_HOST_VARIANT_SDK}_LIB_SUBDIR}")
+      endif()
 
     elseif(ASRLF_BOOTSTRAPPING_MODE STREQUAL "BOOTSTRAPPING")
       # At build time link against the built swift libraries from the
diff --git a/cmake/modules/SwiftUtils.cmake b/cmake/modules/SwiftUtils.cmake
index 738ddb4795e..1eb13d142b9 100644
--- a/cmake/modules/SwiftUtils.cmake
+++ b/cmake/modules/SwiftUtils.cmake
@@ -108,7 +108,7 @@ function(get_bootstrapping_swift_lib_dir bs_lib_dir bootstrapping)
       get_bootstrapping_path(bs_lib_dir ${lib_dir} "1")
     endif()
   elseif(BOOTSTRAPPING_MODE STREQUAL "HOSTTOOLS")
-    if(SWIFT_HOST_VARIANT_SDK MATCHES "LINUX|ANDROID|OPENBSD|FREEBSD|HAIKU")
+    if(SWIFT_HOST_VARIANT_SDK MATCHES "LINUX|ANDROID|OPENBSD|FREEBSD")
       # Compiler's INSTALL_RPATH is set to libs in the build directory
       # For building stdlib, use stdlib in the builder's resource directory
       # because the runtime may not be built yet.
@@ -116,6 +116,8 @@ function(get_bootstrapping_swift_lib_dir bs_lib_dir bootstrapping)
       get_filename_component(swift_bin_dir ${CMAKE_Swift_COMPILER} DIRECTORY)
       get_filename_component(swift_dir ${swift_bin_dir} DIRECTORY)
       set(bs_lib_dir "${swift_dir}/lib/swift/${SWIFT_SDK_${SWIFT_HOST_VARIANT_SDK}_LIB_SUBDIR}")
+    elseif(SWIFT_HOST_VARIANT_SDK MATCHES "HAIKU")
+      set(bs_lib_dir "/boot/system/lib/swift/${SWIFT_SDK_${SWIFT_HOST_VARIANT_SDK}_LIB_SUBDIR}")
     endif()
   endif()
   set(bs_lib_dir ${bs_lib_dir} PARENT_SCOPE)
-- 
2.56.0

