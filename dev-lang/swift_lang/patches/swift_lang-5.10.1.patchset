@@ -80,6 +80,7 @@ public typealias CLongDouble = Double
 // On Windows, long double is always Double.
 public typealias CLongDouble = Double
 #elseif os(Linux)
+#elseif os(Haiku)
 // On Linux/x86, long double is Float80.
