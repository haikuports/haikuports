From 7d5403631f8199947c736e029898141fabead7d6 Mon Sep 17 00:00:00 2001
From: Pascal Abresch <nep-git@packageloss.eu>
Date: Wed, 28 Oct 2026 09:15:43 +0100
Subject: Find Openssl and expat


diff --git a/acx_nlnetlabs.m4 b/acx_nlnetlabs.m4
index 5a71c7c..489b086 100644
--- a/acx_nlnetlabs.m4
+++ b/acx_nlnetlabs.m4
@@ -731,18 +731,28 @@ AC_DEFUN([ACX_SSL_CHECKS], [
 		fi
 	fi
         if test x_$withval = x_ -o x_$withval = x_yes; then
-            withval="/usr/local/ssl /usr/lib/ssl /usr/ssl /usr/pkg /usr/local /opt/local /usr/sfw /usr"
+            withval="/usr/local/ssl /usr/lib/ssl /usr/ssl /usr/pkg /usr/local /opt/local /usr/sfw /usr /system/develop"
         fi
         for dir in $withval; do
             ssldir="$dir"
             if test -f "$dir/include/openssl/ssl.h"; then
                 found_ssl="yes"
-		ssldir_include="$ssldir/include"
-		if test ! -d "$ssldir/lib" -a -d "$ssldir/lib64"; then
-			ssldir_lib="$ssldir/lib64"
-		else
-			ssldir_lib="$ssldir/lib"
-		fi
+				ssldir_include="$ssldir/include"
+				if test ! -d "$ssldir/lib" -a -d "$ssldir/lib64"; then
+					ssldir_lib="$ssldir/lib64"
+				else
+					ssldir_lib="$ssldir/lib"
+				fi
+                break;
+            fi
+			if test -f "$dir/headers/openssl/ssl.h"; then
+			    found_ssl="yes"
+				ssldir_include="$ssldir/headers"
+				if test ! -d "$ssldir/lib" -a -d "$ssldir/lib64"; then
+					ssldir_lib="$ssldir/lib64"
+				else
+					ssldir_lib="$ssldir/lib"
+				fi
                 break;
             fi
         done
diff --git a/configure.ac b/configure.ac
index 788202e..a223f8a 100644
--- a/configure.ac
+++ b/configure.ac
@@ -12,14 +12,14 @@ sinclude(dnscrypt/dnscrypt.m4)
 # must be numbers. ac_defun because of later processing
 m4_define([VERSION_MAJOR],[1])
 m4_define([VERSION_MINOR],[26])
-m4_define([VERSION_MICRO],[2])
+m4_define([VERSION_MICRO],[3])
 AC_INIT([unbound],m4_defn([VERSION_MAJOR]).m4_defn([VERSION_MINOR]).m4_defn([VERSION_MICRO]),[unbound-bugs@nlnetlabs.nl or https://github.com/NLnetLabs/unbound/issues],[unbound])
 AC_SUBST(UNBOUND_VERSION_MAJOR, [VERSION_MAJOR])
 AC_SUBST(UNBOUND_VERSION_MINOR, [VERSION_MINOR])
 AC_SUBST(UNBOUND_VERSION_MICRO, [VERSION_MICRO])
 
 LIBUNBOUND_CURRENT=9
-LIBUNBOUND_REVISION=41
+LIBUNBOUND_REVISION=42
 LIBUNBOUND_AGE=1
 # 1.0.0 had 0:12:0
 # 1.0.1 had 0:13:0
@@ -128,6 +128,7 @@ LIBUNBOUND_AGE=1
 # 1.26.0 had 9:39:1
 # 1.26.1 had 9:40:1
 # 1.26.2 had 9:41:1
+# 1.26.3 had 9:42:1
 
 #   Current  -- the number of the binary API that we're implementing
 #   Revision -- which iteration of the implementation of the binary
@@ -1591,17 +1592,27 @@ fi
 
 # check for libexpat
 AC_ARG_WITH(libexpat, AS_HELP_STRING([--with-libexpat=path],[specify explicit path for libexpat.]),
-    [ ],[ withval="/usr/local /opt/local /usr/lib /usr/pkg /usr/sfw /usr" ])
+    [ ],[ withval="/usr/local /opt/local /usr/lib /usr/pkg /usr/sfw /usr /system/develop" ])
 AC_MSG_CHECKING(for libexpat)
 found_libexpat="no"
 for dir in $withval ; do
             if test -f "$dir/include/expat.h"; then
-		found_libexpat="yes"
-		dnl assume /usr is in default path.
-		if test "$dir" != "/usr"; then
-                    CPPFLAGS="$CPPFLAGS -I$dir/include"
-		    LDFLAGS="$LDFLAGS -L$dir/lib"
-		fi
+				found_libexpat="yes"
+				dnl assume /usr is in default path.
+				if test "$dir" != "/usr"; then
+					CPPFLAGS="$CPPFLAGS -I$dir/include"
+					LDFLAGS="$LDFLAGS -L$dir/lib"
+				fi
+				AC_MSG_RESULT(found in $dir)
+                break;
+			fi
+			if test -f "$dir/headers/expat.h"; then
+				found_libexpat="yes"
+				dnl assume /usr is in default path.
+				if test "$dir" != "/usr"; then
+					CPPFLAGS="$CPPFLAGS -I$dir/headers"
+					LDFLAGS="$LDFLAGS -L$dir/lib"
+				fi
             	AC_MSG_RESULT(found in $dir)
                 break;
             fi
-- 
2.56.0

