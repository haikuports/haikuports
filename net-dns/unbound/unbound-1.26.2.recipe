SUMMARY="Validating, recursive, caching DNS resolver"
DESCRIPTION="Unbound is a validating, recursive, caching DNS resolver. It is designed to be \
fast and lean and incorporates modern features based on open standards."
HOMEPAGE="https://github.com/NLnetLabs/unbound/"
COPYRIGHT="2007 NLnet Labs."
LICENSE="BSD (3-clause)"
REVISION="1"
SOURCE_URI="https://github.com/NLnetLabs/unbound/archive/release-$portVersion.tar.gz"
CHECKSUM_SHA256="4ec94f911afb4347600d6b1044264fe8e9b07d73c6fcba668ace5a0cf45803d5"
SOURCE_DIR="unbound-release-$portVersion"
PATCHES="unbound-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

libVersion="8.1.42"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

GLOBAL_WRITABLE_FILES="
	settings/unbound/unbound.conf keep-old
	"

PACKAGE_USERS="
	unbound real-name \"unbound\" home \"/var/empty\" shell \"/bin/true\" groups \"unbound\"
	"

PACKAGE_GROUPS="
	unbound
	"

PROVIDES="
	unbound$secondaryArchSuffix = $portVersion
	cmd:unbound
	cmd:unbound_anchor
	cmd:unbound_checkconf
	cmd:unbound_control
	cmd:unbound_control_setup
	cmd:unbound_host
	lib:libunbound$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libcrypto$secondaryArchSuffix
	lib:libexpat$secondaryArchSuffix
	lib:libssl$secondaryArchSuffix
	"

PROVIDES_devel="
	unbound${secondaryArchSuffix}_devel = $portVersion
	devel:libunbound$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	unbound$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libcrypto$secondaryArchSuffix >= 3
	devel:libexpat$secondaryArchSuffix
	devel:libssl$secondaryArchSuffix >= 3
	"
BUILD_PREREQUIRES="
	cmd:aclocal
	cmd:autoreconf
	cmd:bison$secondaryArchSuffix
	cmd:flex
	cmd:gcc$secondaryArchSuffix
	cmd:make
	cmd:libtool$secondaryArchSuffix
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	autoreconf -vfi
	runConfigure ./configure LIBS="-lnetwork" \
		--disable-static

	make $jobArgs
}

INSTALL()
{
	make install

	# remove libtool file
	rm -rf $libDir/*.la

	prepareInstalledDevelLib \
		libunbound
	fixPkgconfig

	packageEntries devel \
		$developDir \
		$manDir/man3
}

TEST()
{
	# assertion failure testcode/unitmain.c:311
	make check
}
