From 9b3cb24d4a252dc3b0bbe3a26f4fa67274b1c9e8 Mon Sep 17 00:00:00 2001
From: Markus Himmel <markus@himmel-villmar.de>
Date: Sat, 3 Oct 2015 10:24:07 +0000
Subject: [PATCH 1/2] Fix signature for non-debug stubs and fix unicode literals

---
 src/frontend/debug.cc  | 4 ++--
 src/frontend/output.cc | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/frontend/debug.cc b/src/frontend/debug.cc
index f7df145..541de85 100644
--- a/src/frontend/debug.cc
+++ b/src/frontend/debug.cc
@@ -94,8 +94,8 @@ int dbg_printf(const char *fmt, ...)
 
 #else /* !DEBUG */
 
-int dbg_open(const char *name __attribute__((unused)) ) { return 0; }
-int dbg_printf(const char *fmt __attribute__((unused)), ...) { return 0; }
+int dbg_open(const char *name) { return 0; }
+int dbg_printf(const char *fmt, ...) { return 0; }
 int dbg_close(void) { return 0; }
 
 #endif /* DEBUG */
diff --git a/src/frontend/output.cc b/src/frontend/output.cc
index 21698cb..fda1ea8 100644
--- a/src/frontend/output.cc
+++ b/src/frontend/output.cc
@@ -32,8 +32,8 @@
 
 #define MAX_BOARD_RANGE 65
 #define PIECE_SIZE 7
-const char w_pieces[6][PIECE_SIZE] = {"\u2654 ", "\u2655 ", "\u2656 ", "\u2657 ", "\u2658 ", "\u2659 "};
-const char b_pieces[6][PIECE_SIZE] = {"\u265A ", "\u265B ", "\u265C ", "\u265D ", "\u265E ", "\u265F "};
+const char w_pieces[6][PIECE_SIZE] = {"\\u2654 ", "\\u2655 ", "\\u2656 ", "\\u2657 ", "\\u2658 ", "\\u2659 "};
+const char b_pieces[6][PIECE_SIZE] = {"\\u265A ", "\\u265B ", "\\u265C ", "\\u265D ", "\\u265E ", "\\u265F "};
 const unsigned ui_king = 0;
 const unsigned ui_queen = 1;
 const unsigned ui_rook = 2;
-- 
2.2.2


From 562f88ee9d115bdabb22173596fdcaa3e939dd9c Mon Sep 17 00:00:00 2001
From: caqqxd <caqqmc.contact@gmail.com>
Date: Mon, 31 Aug 2026 17:55:00 +0200
Subject: [PATCH 2/2] Search PKGDATADIR for gnuchess.ini and fix NULL file open

---
 src/adapter/main.cpp   | 4 ++--
 src/adapter/option.cpp | 3 +++
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/adapter/main.cpp b/src/adapter/main.cpp
index b1ebe13..2f07dc0 100644
--- a/src/adapter/main.cpp
+++ b/src/adapter/main.cpp
@@ -167,8 +167,8 @@ static void parse_option() {
 
    file_name = option_get_string("OptionFile");
 
-   file = fopen(file_name,"r");
-   if (file == NULL) my_fatal( "Can't open file \"%s\": %s - using defaults\n",file_name,strerror(errno));
+   file = file_name ? fopen(file_name, "r") : NULL;
+   if (file_name != NULL && file == NULL) my_fatal( "Can't open file \"%s\": %s - using defaults\n",file_name,strerror(errno));
 
    // PolyGlot options (assumed first)
 
diff --git a/src/adapter/option.cpp b/src/adapter/option.cpp
index 46e0921..80053b4 100644
--- a/src/adapter/option.cpp
+++ b/src/adapter/option.cpp
@@ -128,6 +128,9 @@ void option_init() {
 
    // options
 
+   if (!file_found) {
+      file_found = option_file_find(PKGDATADIR, "/", optionName, optionFile);
+   }
    if (file_found) {
       option_set("OptionFile",optionFile);
    }
-- 
2.55.0
