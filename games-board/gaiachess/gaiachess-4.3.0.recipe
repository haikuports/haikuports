# --- end crates ---

ARCHITECTURES="x86_64"

PROVIDES="
	gaiachess = $portVersion
	app:GaiaChess = $portVersion
	"
REQUIRES="
	haiku
	lib:libzstd
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libzstd
	"
# rc, xres and mimeset ship with the base system in the build chroot and are
# never declared (no package provides them as cmd:).
BUILD_PREREQUIRES="
	cmd:cargo
	cmd:clang
	cmd:gcc
	cmd:pkg_config
	cmd:rustc
	"

# Cargo's release profile emits no DWARF, so this mostly ships the symbol table.
defineDebugInfoPackage gaiachess \
	"$appsDir"/GaiaChess

BUILD()
{
	# The buildmasters build offline: every crate arrived as a numbered source
	# (the extracted .crate directory), linked here into a cargo directory
	# registry — the ripgrep recipe's pattern.
	export CARGO_HOME=$sourceDir/../cargo
	vendor=$CARGO_HOME/haiku
	mkdir -p "$vendor"
	set -- $CRATE_RANGE
	for i in $(seq "$1" "$2"); do
		eval "srcDir=\$sourceDir$i"
		eval "sha256sum=\$CHECKSUM_SHA256_$i"
		set -- "$srcDir"/*
		ln -sf "$1" "$vendor"
		cat <<-EOF >"$vendor/${1##*/}/.cargo-checksum.json"
		{
		  "package": "$sha256sum",
		  "files": {}
		}
		EOF
	done

	cat <<-EOF >"$CARGO_HOME"/config.toml
	[source.haiku]
	directory = "$vendor"

	[source.crates-io]
	replace-with = "haiku"
	EOF

	# The two flat sources, exactly as build.rs will embed them. A wrong path
	# here means dead tables at run time, so say loudly what went in.
	echo "flat sources as embedded:"
	sha256sum "$sourceDir2/$NNUE_NET" "$sourceDir3/tb34.gtpk"

	# x86-64-v2 (SSE4.2/POPCNT) is the floor the published binaries accept on
	# every platform; AVX2 is given up for the sake of running everywhere.
	# Fat LTO miscompiles the GaiaTB parser with Haiku's rustc (thin ICEs);
	# see tools/pgo/build-haiku.sh.
	MODEL="$sourceDir2/$NNUE_NET" \
	GAIATB_BLOB="$sourceDir3/tb34.gtpk" \
	ZSTD_SYS_USE_PKG_CONFIG=1 \
	CARGO_PROFILE_RELEASE_LTO=false \
	RUSTFLAGS="-C target-cpu=x86-64-v2" \
		cargo build --release --frozen --no-default-features \
		--features "nnue,gui,syzygy,gaiatb,online-tb,nalimov,progress"

	rc -o gaiachess.rsrc tools/pgo/gaiachess.rdef tools/pgo/gaiachess-icons.rdef
	xres -o target/release/gaiachess gaiachess.rsrc
	mimeset -f target/release/gaiachess

	# The binary must answer from its embedded tables before it may ship: a
	# mate-in-8 found at depth 1 can only come out of them, and a corrupted
	# embed (seen once under emulation) is silent otherwise.
	printf 'uci\nisready\nposition fen 7k/8/8/8/8/8/8/KQ6 w - - 0 1\ngo depth 1\nquit\n' \
		| ./target/release/gaiachess --no-gui > probe.out 2>&1 || true
	grep -q 'score mate 7' probe.out || {
		echo 'the embedded endgame tables answered no probe'
		exit 1
	}
}

INSTALL()
{
	mkdir -p $appsDir
	cp target/release/gaiachess $appsDir/GaiaChess
	addAppDeskbarSymlink $appsDir/GaiaChess "GaiaChess"
}

TEST()
{
	# Same registry, flags and features as BUILD(), so the unit tests exercise
	# the shipped configuration and cargo reuses its artifacts. Serial: the
	# ponder liveness tests starve under a parallel cargo test on a small VM.
	# Full suite (not --lib): gaiatb_sanity no longer needs the repo's Syzygy
	# fixtures, and the remaining cross-checks are #[ignore].
	export CARGO_HOME=$sourceDir/../cargo
	MODEL="$sourceDir2/$NNUE_NET" \
	GAIATB_BLOB="$sourceDir3/tb34.gtpk" \
	ZSTD_SYS_USE_PKG_CONFIG=1 \
	CARGO_PROFILE_RELEASE_LTO=false \
	RUSTFLAGS="-C target-cpu=x86-64-v2" \
		cargo test --release --frozen --no-default-features \
		--features "nnue,gui,syzygy,gaiatb,online-tb,nalimov,progress" \
		-- --test-threads=1
}
