# HaikuPorts recipe for GaiaChess, master copy — PRed to
# github.com/haikuports/haikuports as games-board/gaiachess/gaiachess-4.3.0.recipe.
# Buildmasters build offline, which is why the network and the tablebase blob
# arrive as sources rather than through build.rs's curl fallback. Network and
# GaiaTB checksums verified against the published files (2026-09-05). Tarball
# sha256 taken from github.com/jromang/gaiachess/archive/refs/tags/v4.3.0.tar.gz.

SUMMARY="Chess engine with a pixel-art board"
DESCRIPTION="GaiaChess is a UCI chess engine with NNUE evaluation and a built-in \
pixel-art interface. Launched from the desktop it opens the board, with twenty \
skill levels from beginner to full strength; launched by a chess interface or \
match manager it speaks UCI, as an engine always has. The board plays in six \
languages with optional clocks, and the engine probes Syzygy and Nalimov endgame \
tablebases, with its own three- and four-piece tables built in."
HOMEPAGE="https://github.com/jromang/gaiachess"
COPYRIGHT="2025-2026 Jean-Francois Romang
	2021 DrSmey (chess pieces pixel art, used with the artist's permission)"
LICENSE="GNU GPL v3"
REVISION="1"

SOURCE_URI="https://github.com/jromang/gaiachess/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256="e294cc2eb1c3f7a2a2097dd289ac18d85482f77d88d421133f9b5fc70fe536bf"
SOURCE_FILENAME="gaiachess-$portVersion.tar.gz"
SOURCE_DIR="gaiachess-$portVersion"

# The NNUE network, published append-only under immutable names.
NNUE_NET="gaianet-t2b-e013.bin"
SOURCE_URI_2="https://huggingface.co/jromanghf/gaiachess-networks/resolve/main/$NNUE_NET#noarchive"
CHECKSUM_SHA256_2="c2ed7c57a921315e4bf1169a640907b1825c90a8748d122c3d45f2190ce8824c"
SOURCE_FILENAME_2="$NNUE_NET"

# The GaiaTB blob (DTM tablebases, 3+4 pieces), embedded by build.rs. Handed over
# as a source so the build never reaches for the network itself.
SOURCE_URI_3="https://huggingface.co/datasets/jromanghf/gaiatb-tb34/resolve/main/tb34-v3.gtpk#noarchive"
CHECKSUM_SHA256_3="f2f19d2ef3024ab96d9c28090f33b81b7866620f97749d866b91bd58d2fbb24e"
SOURCE_FILENAME_3="tb34.gtpk"

