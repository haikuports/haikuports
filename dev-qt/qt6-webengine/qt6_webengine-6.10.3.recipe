SUMMARY="Chromium-based web engine for the Qt6 framework"
DESCRIPTION="QtWebEngine provides a web browser engine that integrates \
Chromium's web capabilities into Qt applications.

This build has the Widgets module only, renders in software (no GPU \
rasterisation) and runs without Chromium's sandbox. WebRTC, PDF, printing, \
spellchecking, extensions and proprietary codecs are left out."
HOMEPAGE="https://www.qt.io/"
COPYRIGHT="2015-2026 The Qt Company Ltd.
	2006-2025 The Chromium Authors"
LICENSE="BSD (3-clause)
	GNU LGPL v3
	GNU GPL v2
	GNU GPL v3"
REVISION="1"
QT_MIRROR_URI="https://ftp.fau.de/qtproject/archive"
SOURCE_URI="$QT_MIRROR_URI/qt/${portVersion%.*}/$portVersion/submodules/qtwebengine-everywhere-src-$portVersion.tar.xz"
CHECKSUM_SHA256="07c95f81d64391b3dd5b0edce7fc7eb2e8d39844e4904f82ae53f5533f4cf043"
SOURCE_DIR="qtwebengine-everywhere-src-$portVersion"
# The first patchset is FreeBSD ports' www/qt6-webengine patches (freebsd-ports
# commit fbb8b4880d68, for Qt 6.10.2) applied to 6.10.3; Haiku builds as a BSD
# in Chromium, so they carry most of the port. The second holds the Haiku changes.
PATCHES="qt6_webengine-$portVersion-freebsd.patchset
	qt6_webengine-$portVersion.patchset"

# Too large for the builders: built by hand, packaged by qt6_webengine_bin.
ARCHITECTURES="!x86_gcc2 ?x86_64"

libVersion="$portVersion"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

PROVIDES="
	qt6_webengine$secondaryArchSuffix = $portVersion compat >= 6
	lib:libQt6WebEngineCore$secondaryArchSuffix = $libVersionCompat
	lib:libQt6WebEngineWidgets$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libavcodec$secondaryArchSuffix >= 60
	lib:libavformat$secondaryArchSuffix >= 60
	lib:libavutil$secondaryArchSuffix >= 58
	lib:libdbus_1$secondaryArchSuffix
	lib:libexecinfo$secondaryArchSuffix
	lib:libexpat$secondaryArchSuffix
	lib:libfontconfig$secondaryArchSuffix
	lib:libfreetype$secondaryArchSuffix
	lib:libGL$secondaryArchSuffix
	lib:libharfbuzz$secondaryArchSuffix
	lib:libharfbuzz_subset$secondaryArchSuffix
	lib:libjpeg$secondaryArchSuffix
	lib:libminizip$secondaryArchSuffix
	lib:libnspr4$secondaryArchSuffix
	lib:libnss3$secondaryArchSuffix
	lib:libnssutil3$secondaryArchSuffix
	lib:libopus$secondaryArchSuffix
	lib:libplc4$secondaryArchSuffix
	lib:libplds4$secondaryArchSuffix
	lib:libpng16$secondaryArchSuffix
	lib:libQt6Core$secondaryArchSuffix == $libVersion
	lib:libQt6Gui$secondaryArchSuffix == $libVersion
	lib:libQt6Network$secondaryArchSuffix == $libVersion
	lib:libQt6OpenGL$secondaryArchSuffix == $libVersion
	lib:libQt6Qml$secondaryArchSuffix == $libVersion
	lib:libQt6QmlMeta$secondaryArchSuffix == $libVersion
	lib:libQt6QmlModels$secondaryArchSuffix == $libVersion
	lib:libQt6QmlWorkerScript$secondaryArchSuffix == $libVersion
	lib:libQt6Quick$secondaryArchSuffix == $libVersion
	lib:libQt6QuickWidgets$secondaryArchSuffix == $libVersion
	lib:libQt6WebChannel$secondaryArchSuffix == $libVersion
	lib:libQt6Widgets$secondaryArchSuffix == $libVersion
	lib:libsmime3$secondaryArchSuffix
	lib:libsnappy$secondaryArchSuffix
	lib:libwebp$secondaryArchSuffix
	lib:libwebpdemux$secondaryArchSuffix
	lib:libwebpmux$secondaryArchSuffix
	lib:libxml2$secondaryArchSuffix
	lib:libxslt$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

PROVIDES_devel="
	qt6_webengine${secondaryArchSuffix}_devel = $portVersion compat >= 6
	devel:libQt6WebEngineCore$secondaryArchSuffix = $libVersionCompat
	devel:libQt6WebEngineWidgets$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	qt6_webengine$secondaryArchSuffix == $portVersion base
	haiku$secondaryArchSuffix
	devel:libQt6Core$secondaryArchSuffix == $libVersion
	devel:libQt6WebChannel$secondaryArchSuffix == $libVersion
	lib:libGL$secondaryArchSuffix
	lib:libQt6Core$secondaryArchSuffix == $libVersion
	lib:libQt6Designer$secondaryArchSuffix == $libVersion
	lib:libQt6Gui$secondaryArchSuffix == $libVersion
	lib:libQt6Network$secondaryArchSuffix == $libVersion
	lib:libQt6OpenGL$secondaryArchSuffix == $libVersion
	lib:libQt6OpenGLWidgets$secondaryArchSuffix == $libVersion
	lib:libQt6Qml$secondaryArchSuffix == $libVersion
	lib:libQt6Quick$secondaryArchSuffix == $libVersion
	lib:libQt6WebChannel$secondaryArchSuffix == $libVersion
	lib:libQt6Widgets$secondaryArchSuffix == $libVersion
	lib:libQt6Xml$secondaryArchSuffix == $libVersion
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libavcodec$secondaryArchSuffix >= 60
	devel:libavformat$secondaryArchSuffix >= 60
	devel:libavutil$secondaryArchSuffix >= 58
	devel:libdbus_1$secondaryArchSuffix
	devel:libexecinfo$secondaryArchSuffix
	devel:libexpat$secondaryArchSuffix
	devel:libfontconfig$secondaryArchSuffix
	devel:libfreetype$secondaryArchSuffix
	devel:libharfbuzz$secondaryArchSuffix
	devel:libicuuc$secondaryArchSuffix >= 74
	devel:libjpeg$secondaryArchSuffix
	devel:liblcms2$secondaryArchSuffix
	devel:libminizip$secondaryArchSuffix
	devel:libnss3$secondaryArchSuffix
	devel:libopus$secondaryArchSuffix
	devel:libpng16$secondaryArchSuffix
	devel:libQt6Core$secondaryArchSuffix == $libVersion
	devel:libQt6Designer$secondaryArchSuffix == $libVersion
	devel:libQt6Gui$secondaryArchSuffix == $libVersion
	devel:libQt6Network$secondaryArchSuffix == $libVersion
	devel:libQt6OpenGL$secondaryArchSuffix == $libVersion
	devel:libQt6Positioning$secondaryArchSuffix == $libVersion
	devel:libQt6Qml$secondaryArchSuffix == $libVersion
	devel:libQt6Quick$secondaryArchSuffix == $libVersion
	devel:libQt6QuickWidgets$secondaryArchSuffix == $libVersion
	devel:libQt6ShaderTools$secondaryArchSuffix == $libVersion
	devel:libQt6Svg$secondaryArchSuffix == $libVersion
	devel:libQt6WebChannel$secondaryArchSuffix == $libVersion
	devel:libQt6Widgets$secondaryArchSuffix == $libVersion
	devel:libre2$secondaryArchSuffix
	devel:libsnappy$secondaryArchSuffix
	devel:libwebp$secondaryArchSuffix >= 7
	devel:libxml2$secondaryArchSuffix
	devel:libxslt$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:awk
	cmd:bison
	cmd:cmake
	cmd:find
	cmd:flex
	cmd:g++$secondaryArchSuffix
	cmd:gperf
	cmd:ld$secondaryArchSuffix
	cmd:ninja
	cmd:node >= 24
	cmd:perl
	cmd:pkg_config$secondaryArchSuffix
	cmd:python3.10
	html5lib_python310
	cmd:sed
	cmd:xargs
	"

BUILD()
{
	export DISABLE_ASLR=1
	# The jobs of the Chromium part, which Qt builds with its own ninja run.
	export NINJAFLAGS="-j$jobs"

	cmake -B build -S $sourceDir -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DPython3_EXECUTABLE=/bin/python3.10 \
		-DQT_GENERATE_SBOM=ON \
		-DQT_FEATURE_qtpdf_build=OFF \
		-DQT_FEATURE_qtwebengine_quick_build=OFF \
		-DQT_FEATURE_webengine_extensions=OFF \
		-DQT_FEATURE_webengine_geolocation=OFF \
		-DQT_FEATURE_webengine_jumbo_build=OFF \
		-DQT_FEATURE_webengine_kerberos=OFF \
		-DQT_FEATURE_webengine_ozone_x11=OFF \
		-DQT_FEATURE_webengine_pepper_plugins=OFF \
		-DQT_FEATURE_webengine_printing_and_pdf=OFF \
		-DQT_FEATURE_webengine_proprietary_codecs=OFF \
		-DQT_FEATURE_webengine_spellchecker=OFF \
		-DQT_FEATURE_webengine_system_alsa=OFF \
		-DQT_FEATURE_webengine_system_ffmpeg=ON \
		-DQT_FEATURE_webengine_system_gbm=OFF \
		-DQT_FEATURE_webengine_system_pulseaudio=OFF \
		-DQT_FEATURE_webengine_system_sndio=OFF \
		-DQT_FEATURE_webengine_vaapi=OFF \
		-DQT_FEATURE_webengine_vulkan=OFF \
		-DQT_FEATURE_webengine_webrtc=OFF \
		-DQT_FEATURE_webenginedriver=OFF \
		-Wno-dev

	find -name cmake_install.cmake -exec sed -i "s|set(CMAKE_INSTALL_PREFIX.*|set(CMAKE_INSTALL_PREFIX \"$prefix\")|" {} \;

	ninja -v -C build -j$jobs
}

INSTALL()
{
	ninja -C build install

	prepareInstalledDevelLibs \
		libQt6WebEngineCore \
		libQt6WebEngineWidgets

	# fix pkgconfig files
	fixPkgconfig
	sed -i "s|includedir=.*|includedir=$includeDir/Qt6|" \
		$developLibDir/pkgconfig/*.pc

	cd $libDir
	for i in lib*.so.6.*;do
		ln -fs $i $(echo $i | cut -f1,2 -d.)
	done

	packageEntries devel \
		$developDir \
		$libDir/cmake \
		$dataDir/Qt6/mkspecs \
		$addOnsDir/Qt6/designer
}
