diff --git a/src/3rdparty/chromium/base/message_loop/epoll_haiku.h b/src/3rdparty/chromium/base/message_loop/epoll_haiku.h
new file mode 100644
index 0000000..f622de9
--- /dev/null
+++ b/src/3rdparty/chromium/base/message_loop/epoll_haiku.h
@@ -0,0 +1,56 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_MESSAGE_LOOP_EPOLL_HAIKU_H_
+#define BASE_MESSAGE_LOOP_EPOLL_HAIKU_H_
+
+// Haiku has no epoll. MessagePumpEpoll keeps a poll() list next to its epoll
+// interest list and always waits with poll() on Haiku, so the epoll calls it
+// still makes only need to succeed; nothing waits on them.
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <unistd.h>
+
+typedef union epoll_data {
+  void* ptr;
+  int fd;
+  uint32_t u32;
+  uint64_t u64;
+} epoll_data_t;
+
+struct epoll_event {
+  uint32_t events;
+  epoll_data_t data;
+};
+
+#define EPOLLIN 0x001
+#define EPOLLPRI 0x002
+#define EPOLLOUT 0x004
+#define EPOLLERR 0x008
+#define EPOLLHUP 0x010
+#define EPOLLONESHOT (1u << 30)
+
+#define EPOLL_CTL_ADD 1
+#define EPOLL_CTL_DEL 2
+#define EPOLL_CTL_MOD 3
+
+// A real descriptor, so that ScopedFD owns and closes something.
+inline int epoll_create1(int /*flags*/) {
+  return open("/dev/null", O_RDONLY | O_CLOEXEC);
+}
+
+inline int epoll_ctl(int /*epfd*/, int /*op*/, int /*fd*/,
+                     struct epoll_event* /*event*/) {
+  return 0;
+}
+
+inline int epoll_wait(int /*epfd*/, struct epoll_event* /*events*/,
+                      int /*maxevents*/, int /*timeout*/) {
+  errno = ENOSYS;
+  return -1;
+}
+
+#endif  // BASE_MESSAGE_LOOP_EPOLL_HAIKU_H_
diff --git a/src/3rdparty/chromium/base/message_loop/message_pump_epoll.cc b/src/3rdparty/chromium/base/message_loop/message_pump_epoll.cc
index 0bb5eff..81a31ca 100644
--- a/src/3rdparty/chromium/base/message_loop/message_pump_epoll.cc
+++ b/src/3rdparty/chromium/base/message_loop/message_pump_epoll.cc
@@ -9,7 +9,13 @@
 
 #include "base/message_loop/message_pump_epoll.h"
 
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_HAIKU)
+#include <fcntl.h>
+#else
 #include <sys/eventfd.h>
+#endif
 
 #include <algorithm>
 #include <cstddef>
@@ -144,7 +150,18 @@ MessagePumpEpoll::MessagePumpEpoll() {
   epoll_.reset(epoll_create1(/*flags=*/0));
   PCHECK(epoll_.is_valid());
 
+#if BUILDFLAG(IS_HAIKU)
+  int wake_pipe[2];
+  PCHECK(pipe(wake_pipe) == 0);
+  for (int fd : wake_pipe) {
+    PCHECK(fcntl(fd, F_SETFL, O_NONBLOCK) == 0);
+    PCHECK(fcntl(fd, F_SETFD, FD_CLOEXEC) == 0);
+  }
+  wake_event_.reset(wake_pipe[0]);
+  wake_write_.reset(wake_pipe[1]);
+#else
   wake_event_.reset(eventfd(0, EFD_NONBLOCK));
+#endif
   PCHECK(wake_event_.is_valid());
 
   epoll_event wake{.events = EPOLLIN, .data = {.ptr = &wake_event_}};
@@ -306,7 +323,12 @@ void MessagePumpEpoll::Quit() {
 
 void MessagePumpEpoll::ScheduleWork() {
   const uint64_t value = 1;
+#if BUILDFLAG(IS_HAIKU)
+  // A full pipe (EAGAIN) is as good as a write: the reader will wake up.
+  ssize_t n = HANDLE_EINTR(write(wake_write_.get(), &value, sizeof(value)));
+#else
   ssize_t n = HANDLE_EINTR(write(wake_event_.get(), &value, sizeof(value)));
+#endif
 
   // EAGAIN here implies that the write() would overflow of the event counter,
   // which is a condition we can safely ignore. It implies that the event
@@ -459,8 +481,10 @@ bool MessagePumpEpoll::WaitForEpollEvents(TimeDelta timeout) {
   // to iterate through the list of watched fds. This value is pretty arbitrary,
   // the internet suggests that under 1000 fds that epoll isn't noticeably
   // faster than poll but this isn't easy to empirically measure.
+  // Haiku has no epoll: poll() is the only way to wait there.
   bool use_poll =
-      g_use_poll.load(std::memory_order_relaxed) && entries_.size() < 500;
+      BUILDFLAG(IS_HAIKU) ||
+      (g_use_poll.load(std::memory_order_relaxed) && entries_.size() < 500);
 
   if (use_poll) {
     if (!GetEventsPoll(epoll_timeout, &poll_events)) {
@@ -676,9 +700,17 @@ void MessagePumpEpoll::HandleEvent(int fd,
 void MessagePumpEpoll::HandleWakeUp() {
   DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
   BeginNativeWorkBatch();
+#if BUILDFLAG(IS_HAIKU)
+  // Unlike an eventfd, the pipe holds one word per wake-up: drain them all.
+  uint64_t values[64];
+  while (HANDLE_EINTR(read(wake_event_.get(), values, sizeof(values))) ==
+         static_cast<ssize_t>(sizeof(values))) {
+  }
+#else
   uint64_t value;
   ssize_t n = HANDLE_EINTR(read(wake_event_.get(), &value, sizeof(value)));
   DPCHECK(n == sizeof(value));
+#endif
 }
 
 void MessagePumpEpoll::BeginNativeWorkBatch() {
