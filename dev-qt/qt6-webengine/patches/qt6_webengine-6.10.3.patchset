From 9821f012ff27c8e2c4e3a1ed164ccca658cb64c7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonat=C3=A3=20Bolzan=20Loss?= <jonata@jonata.org>
Date: Thu, 12 Nov 2026 00:15:50 -0300
Subject: Haiku: message pump on poll(), base/ OS calls, WebRTC, net

MessagePumpEpoll already keeps a poll() list beside its epoll set; Haiku,
which has no epoll or eventfd, always waits with poll() (epoll_haiku.h
gives the types and inert calls) and wakes through a pipe. base/:
random bytes from arc4random_buf (libbsd), stack bases and the debugger
check from get_thread_info/get_team_info, FILE_EXE from the app image,
no setproctitle, no sysctl, no syscall.h. WebRTC and the DNS address
sorter skip BSD headers Haiku lacks (sys/endian.h, in6_var.h).
---
 src/3rdparty/chromium/base/BUILD.gn           |  8 ++-
 .../chromium/base/base_paths_posix.cc         | 16 +++++-
 .../chromium/base/debug/debugger_posix.cc     | 18 +++++-
 src/3rdparty/chromium/base/linux_util.cc      |  1 +
 .../chromium/base/message_loop/epoll_haiku.h  | 56 +++++++++++++++++++
 .../base/message_loop/message_pump_epoll.cc   | 34 ++++++++++-
 .../base/message_loop/message_pump_epoll.h    | 13 +++++
 .../chromium/base/process/launch_posix.cc     |  2 +
 .../base/process/set_process_title.cc         |  4 +-
 .../base/profiler/stack_base_address_posix.cc | 15 ++++-
 src/3rdparty/chromium/base/rand_util_posix.cc |  2 +
 .../chromium/net/dns/address_sorter_posix.cc  |  6 +-
 .../third_party/webrtc/rtc_base/byte_order.h  |  2 +-
 .../webrtc/rtc_base/platform_thread_types.cc  |  2 +
 14 files changed, 169 insertions(+), 10 deletions(-)
 create mode 100644 src/3rdparty/chromium/base/message_loop/epoll_haiku.h

diff --git a/src/3rdparty/chromium/base/BUILD.gn b/src/3rdparty/chromium/base/BUILD.gn
index c6578dc..4875f3b 100644
--- a/src/3rdparty/chromium/base/BUILD.gn
+++ b/src/3rdparty/chromium/base/BUILD.gn
@@ -2182,7 +2182,10 @@ jumbo_component("base") {
       "process/process_metrics_haiku.cc",
       "system/sys_info_haiku.cc",
     ]
-    libs += [ "execinfo" ]
+    libs += [
+      "bsd",
+      "execinfo",
+    ]
   } else if (is_freebsd) {
     sources += [
       "process/process_handle_freebsd.cc",
@@ -2378,6 +2381,9 @@ jumbo_component("base") {
       "message_loop/message_pump_epoll.cc",
       "message_loop/message_pump_epoll.h",
     ]
+    if (is_haiku) {
+      sources += [ "message_loop/epoll_haiku.h" ]
+    }
   }
 
   # Android and MacOS have their own custom shared memory handle
