diff --git a/src/3rdparty/chromium/third_party/libsync/src/sync.c b/src/3rdparty/chromium/third_party/libsync/src/sync.c
index cd943d0..dd612f4 100644
--- a/src/3rdparty/chromium/third_party/libsync/src/sync.c
+++ b/src/3rdparty/chromium/third_party/libsync/src/sync.c
@@ -29,7 +29,16 @@
 
 #include <sync/sync.h>
 
-#if defined(__OpenBSD__) || defined(__FreeBSD__)
+#if defined(__HAIKU__)
+/* No sync files on Haiku: every ioctl below fails at run time. */
+#include <sys/ioccom.h>
+typedef uint8_t __u8;
+typedef uint32_t __u32;
+typedef int32_t __s32;
+#ifndef ETIME
+#define ETIME ETIMEDOUT
+#endif
+#elif defined(__OpenBSD__) || defined(__FreeBSD__)
 typedef __uint8_t __u8;
 typedef __uint32_t __u32;
 typedef __int32_t __s32;
diff --git a/src/3rdparty/chromium/tools/licenses/licenses.py b/src/3rdparty/chromium/tools/licenses/licenses.py
index ee340b9..efb314c 100755
--- a/src/3rdparty/chromium/tools/licenses/licenses.py
+++ b/src/3rdparty/chromium/tools/licenses/licenses.py
@@ -808,7 +808,7 @@ def _GnBinary():
   exe = 'gn'
   if sys.platform.startswith('linux'):
     subdir = 'linux64'
-  elif sys.platform.startswith('freebsd'):
+  elif sys.platform.startswith(('freebsd', 'haiku')):
     subdir = '../../../../.build/install/bin'
   elif sys.platform == 'darwin':
     subdir = 'mac'
diff --git a/src/3rdparty/chromium/v8/BUILD.gn b/src/3rdparty/chromium/v8/BUILD.gn
index c87cd55..d400d8f 100644
--- a/src/3rdparty/chromium/v8/BUILD.gn
+++ b/src/3rdparty/chromium/v8/BUILD.gn
@@ -6652,7 +6652,13 @@ v8_component("v8_libbase") {
     }
   }
 
-  if ((is_linux || is_chromeos) && !is_bsd) {
+  if (is_haiku) {
+    sources += [
+      "src/base/debug/stack_trace_posix.cc",
+      "src/base/platform/platform-haiku.cc",
+    ]
+    libs = [ "execinfo" ]
+  } else if ((is_linux || is_chromeos) && !is_bsd) {
     sources += [
       "src/base/debug/stack_trace_posix.cc",
       "src/base/platform/platform-linux.cc",
diff --git a/src/3rdparty/chromium/v8/include/v8config.h b/src/3rdparty/chromium/v8/include/v8config.h
index 406a02b..1aecceb 100644
--- a/src/3rdparty/chromium/v8/include/v8config.h
+++ b/src/3rdparty/chromium/v8/include/v8config.h
@@ -171,6 +171,11 @@ path. Add it with -I<path> to the command line
 # define V8_OS_QNX 1
 # define V8_OS_STRING "qnx"
 
+#elif defined(__HAIKU__)
+# define V8_OS_HAIKU 1
+# define V8_OS_POSIX 1
+# define V8_OS_STRING "haiku"
+
 #elif defined(_WIN32)
 # define V8_OS_WIN 1
 # define V8_OS_STRING "windows"
diff --git a/src/3rdparty/chromium/v8/src/base/platform/platform-haiku.cc b/src/3rdparty/chromium/v8/src/base/platform/platform-haiku.cc
new file mode 100644
index 0000000..b10e777
--- /dev/null
+++ b/src/3rdparty/chromium/v8/src/base/platform/platform-haiku.cc
@@ -0,0 +1,62 @@
+// Copyright 2012 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Platform-specific code for Haiku goes here. For the POSIX-compatible
+// parts, the implementation is in platform-posix.cc.
+
+#include <OS.h>
+#include <image.h>
+#include <pthread.h>
+#include <string.h>
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "src/base/macros.h"
+#include "src/base/platform/platform-posix-time.h"
+#include "src/base/platform/platform-posix.h"
+#include "src/base/platform/platform.h"
+
+namespace v8 {
+namespace base {
+
+TimezoneCache* OS::CreateTimezoneCache() {
+  return new PosixDefaultTimezoneCache();
+}
+
+std::vector<OS::SharedLibraryAddress> OS::GetSharedLibraryAddresses() {
+  std::vector<SharedLibraryAddress> result;
+  image_info info;
+  int32 cookie = 0;
+  while (get_next_image_info(B_CURRENT_TEAM, &cookie, &info) == B_OK) {
+    const char* sep = strrchr(info.name, '/');
+    std::string lib_name(sep != nullptr ? sep + 1 : info.name);
+    uintptr_t start = reinterpret_cast<uintptr_t>(info.text);
+    result.push_back(
+        SharedLibraryAddress(lib_name, start, start + info.text_size));
+  }
+  return result;
+}
+
+void OS::SignalCodeMovingGC() {}
+
+void OS::AdjustSchedulingParams() {}
+
+std::optional<OS::MemoryRange> OS::GetFirstFreeMemoryRangeWithin(
+    OS::Address boundary_start, OS::Address boundary_end, size_t minimum_size,
+    size_t alignment) {
+  return std::nullopt;
+}
+
+// static
+Stack::StackSlot Stack::ObtainCurrentThreadStackStart() {
+  thread_info info;
+  if (get_thread_info(find_thread(nullptr), &info) != B_OK) return nullptr;
+  // Stacks grow down: the start is the highest address.
+  return info.stack_end;
+}
+
+}  // namespace base
+}  // namespace v8
diff --git a/src/3rdparty/chromium/v8/src/base/platform/platform-posix.cc b/src/3rdparty/chromium/v8/src/base/platform/platform-posix.cc
index 0e7e140..078c817 100644
--- a/src/3rdparty/chromium/v8/src/base/platform/platform-posix.cc
+++ b/src/3rdparty/chromium/v8/src/base/platform/platform-posix.cc
@@ -71,10 +71,14 @@
 #include <sys/resource.h>
 #endif
 
-#if !defined(_AIX) && !defined(V8_OS_FUCHSIA) && !V8_OS_ZOS
+#if !defined(_AIX) && !defined(V8_OS_FUCHSIA) && !V8_OS_ZOS && !V8_OS_HAIKU
 #include <sys/syscall.h>
 #endif
 
+#if V8_OS_HAIKU
+#include <OS.h>
+#endif
+
 #if V8_OS_FREEBSD || V8_OS_DARWIN || V8_OS_BSD || V8_OS_SOLARIS
 #define MAP_ANONYMOUS MAP_ANON
 #endif
@@ -867,6 +871,8 @@ int OS::GetCurrentThreadId() {
   return static_cast<int>(pthread_self());
 #elif V8_OS_ZOS
   return gettid();
+#elif V8_OS_HAIKU
+  return static_cast<int>(find_thread(nullptr));
 #else
   return static_cast<int>(reinterpret_cast<intptr_t>(pthread_self()));
 #endif
@@ -1175,7 +1181,9 @@ Thread::~Thread() {
 
 
 static void SetThreadName(const char* name) {
-#if V8_OS_DRAGONFLYBSD || V8_OS_FREEBSD || V8_OS_OPENBSD
+#if V8_OS_HAIKU
+  rename_thread(find_thread(nullptr), name);
+#elif V8_OS_DRAGONFLYBSD || V8_OS_FREEBSD || V8_OS_OPENBSD
   pthread_set_name_np(pthread_self(), name);
 #elif V8_OS_NETBSD
   static_assert(Thread::kMaxThreadNameLength <= PTHREAD_MAX_NAMELEN_NP);
@@ -1354,7 +1362,7 @@ void Thread::SetThreadLocal(LocalStorageKey key, void* value) {
 // keep this version in POSIX as most Linux-compatible derivatives will
 // support it. MacOS and FreeBSD are different here.
 #if !defined(V8_OS_FREEBSD) && !defined(V8_OS_DARWIN) && !defined(_AIX) && \
-    !defined(V8_OS_SOLARIS) && !defined(V8_OS_OPENBSD)
+    !defined(V8_OS_SOLARIS) && !defined(V8_OS_OPENBSD) && !defined(V8_OS_HAIKU)
 
 namespace {
 #if DEBUG
diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
index 143ba52..dbbe94f 100644
--- a/src/core/CMakeLists.txt
+++ b/src/core/CMakeLists.txt
@@ -463,8 +463,14 @@ foreach(arch ${archs})
         )
 
         if(LINUX OR FREEBSD OR HAIKU)
+            # Haiku has neither an EGL nor a GLX display for ANGLE's GL
+            # backend: it renders in software.
+            if(HAIKU)
+                list(APPEND gnArgArg angle_enable_gl=false angle_enable_vulkan=false)
+            else()
+                list(APPEND gnArgArg angle_enable_gl=true)
+            endif()
             list(APPEND gnArgArg
-                angle_enable_gl=true
                 use_gtk=false # GTK toolkit bindings
                 use_qt5=false # Qt5 toolkit bindings
                 use_gio=false
-- 
2.53.0


From 182c35e69884bf988a4cca8abda5579ef602742c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonat=C3=A3=20Bolzan=20Loss?= <jonata@jonata.org>
Date: Wed, 11 Nov 2026 23:41:07 -0300
Subject: Haiku: base/ process and system info, PartitionAlloc threads

base/ gets Haiku versions of the four per-OS files the BSDs have (process
handle, iterator, metrics, sys_info), built on team_info, area_info,
team_usage_info and system_info; libkvm/epoll-shim are not linked.
PartitionAlloc: thread ids from find_thread, stack top from
get_thread_info, no sys/syscall.h. The export-template self-tests skip
__declspec on Haiku (its GCC maps __declspec to __attribute__). ANGLE
gets its null backend, its only one on Haiku.
---
 src/3rdparty/chromium/base/BUILD.gn           |  10 +-
 .../page_allocator_internals_posix.h          |   2 +
 .../partition_alloc_base/export_template.h    |   6 +-
 .../partition_alloc_base/rand_util_posix.cc   |   2 +
 .../threading/platform_thread_posix.cc        |   6 +-
 .../src/partition_alloc/stack/stack.cc        |  14 +-
 src/3rdparty/chromium/base/export_template.h  |   4 +
 .../base/process/process_handle_haiku.cc      |  33 ++++
 .../chromium/base/process/process_iterator.h  |   4 +
 .../base/process/process_iterator_haiku.cc    |  54 ++++++
 .../base/process/process_metrics_haiku.cc     | 159 ++++++++++++++++++
 .../chromium/base/system/sys_info_haiku.cc    |  94 +++++++++++
 .../chromium/v8/src/base/export-template.h    |   4 +
 src/core/CMakeLists.txt                       |   6 +-
 14 files changed, 392 insertions(+), 6 deletions(-)
 create mode 100644 src/3rdparty/chromium/base/process/process_handle_haiku.cc
 create mode 100644 src/3rdparty/chromium/base/process/process_iterator_haiku.cc
 create mode 100644 src/3rdparty/chromium/base/process/process_metrics_haiku.cc
 create mode 100644 src/3rdparty/chromium/base/system/sys_info_haiku.cc

diff --git a/src/3rdparty/chromium/base/BUILD.gn b/src/3rdparty/chromium/base/BUILD.gn
index 536958f..c6578dc 100644
