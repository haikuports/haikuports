diff --git a/src/3rdparty/chromium/base/process/process_handle_haiku.cc b/src/3rdparty/chromium/base/process/process_handle_haiku.cc
new file mode 100644
index 0000000..0b4777d
--- /dev/null
+++ b/src/3rdparty/chromium/base/process/process_handle_haiku.cc
@@ -0,0 +1,33 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/process/process_handle.h"
+
+#include <OS.h>
+#include <image.h>
+
+#include "base/files/file_path.h"
+
+namespace base {
+
+ProcessId GetParentProcessId(ProcessHandle process) {
+  team_info info;
+  if (get_team_info(process, &info) != B_OK) {
+    return -1;
+  }
+  return info.parent;
+}
+
+FilePath GetProcessExecutablePath(ProcessHandle process) {
+  image_info info;
+  int32 cookie = 0;
+  while (get_next_image_info(process, &cookie, &info) == B_OK) {
+    if (info.type == B_APP_IMAGE) {
+      return FilePath(info.name);
+    }
+  }
+  return FilePath();
+}
+
+}  // namespace base
diff --git a/src/3rdparty/chromium/base/process/process_iterator.h b/src/3rdparty/chromium/base/process/process_iterator.h
index 3d0734a..057b3f3 100644
--- a/src/3rdparty/chromium/base/process/process_iterator.h
+++ b/src/3rdparty/chromium/base/process/process_iterator.h
@@ -25,6 +25,8 @@
 #include <windows.h>
 
 #include <tlhelp32.h>
+#elif BUILDFLAG(IS_HAIKU)
+#include <OS.h>
 #elif BUILDFLAG(IS_APPLE) || BUILDFLAG(IS_OPENBSD)
 #include <sys/sysctl.h>
 #elif BUILDFLAG(IS_FREEBSD)
@@ -116,6 +118,8 @@ class BASE_EXPORT ProcessIterator {
 #if BUILDFLAG(IS_WIN)
   HANDLE snapshot_;
   bool started_iteration_ = false;
+#elif BUILDFLAG(IS_HAIKU)
+  int32 team_cookie_ = 0;
 #elif BUILDFLAG(IS_APPLE) || BUILDFLAG(IS_BSD)
   std::vector<kinfo_proc> kinfo_procs_;
   size_t index_of_kinfo_proc_ = 0;
diff --git a/src/3rdparty/chromium/base/process/process_iterator_haiku.cc b/src/3rdparty/chromium/base/process/process_iterator_haiku.cc
new file mode 100644
index 0000000..4376b85
--- /dev/null
+++ b/src/3rdparty/chromium/base/process/process_iterator_haiku.cc
@@ -0,0 +1,54 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/process/process_iterator.h"
+
+#include <OS.h>
+#include <unistd.h>
+
+#include <string>
+
+#include "base/process/process_handle.h"
+#include "base/strings/string_split.h"
+
+namespace base {
+
+// Haiku lists teams through a cookie, not a table to copy, so the iterator
+// keeps that cookie in place of the process list.
+ProcessIterator::ProcessIterator(const ProcessFilter* filter)
+    : filter_(filter) {}
+
+ProcessIterator::~ProcessIterator() = default;
+
+bool ProcessIterator::CheckForNextProcess() {
+  team_info info;
+  while (get_next_team_info(&team_cookie_, &info) == B_OK) {
+    if (info.uid != getuid()) {
+      continue;
+    }
+
+    // args holds the command line, space-separated and cut at 64 bytes.
+    std::string args(info.args, strnlen(info.args, sizeof(info.args)));
+    entry_.cmd_line_args_ =
+        SplitString(args, " ", KEEP_WHITESPACE, SPLIT_WANT_NONEMPTY);
+    entry_.pid_ = info.team;
+    entry_.ppid_ = info.parent;
+    entry_.gid_ = info.group_id;
+
+    FilePath exe = GetProcessExecutablePath(info.team);
+    entry_.exe_file_ = exe.empty() ? std::string(info.name)
+                                   : exe.BaseName().value();
+    return true;
+  }
+  return false;
+}
+
+bool NamedProcessIterator::IncludeEntry() {
+  if (executable_name_ != entry().exe_file()) {
+    return false;
+  }
+  return ProcessIterator::IncludeEntry();
+}
+
+}  // namespace base
diff --git a/src/3rdparty/chromium/base/process/process_metrics_haiku.cc b/src/3rdparty/chromium/base/process/process_metrics_haiku.cc
new file mode 100644
index 0000000..9211ff1
--- /dev/null
+++ b/src/3rdparty/chromium/base/process/process_metrics_haiku.cc
@@ -0,0 +1,159 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/process/process_metrics.h"
+
+#include <OS.h>
+#include <sys/resource.h>
+#include <unistd.h>
+
+#include "base/memory/ptr_util.h"
+#include "base/notreached.h"
+#include "base/values.h"
+
+namespace base {
+
+ProcessMetrics::ProcessMetrics(ProcessHandle process) : process_(process) {}
+
+std::unique_ptr<ProcessMetrics> ProcessMetrics::CreateProcessMetrics(
+    ProcessHandle process) {
+  return WrapUnique(new ProcessMetrics(process));
+}
+
+base::expected<ProcessMemoryInfo, ProcessUsageError>
+ProcessMetrics::GetMemoryInfo() const {
+  team_info team;
+  if (get_team_info(process_, &team) != B_OK) {
+    return base::unexpected(ProcessUsageError::kProcessNotFound);
+  }
+  // The resident set is the RAM behind the team's areas.
+  ProcessMemoryInfo memory_info;
+  area_info area;
+  ssize_t cookie = 0;
+  while (get_next_area_info(process_, &cookie, &area) == B_OK) {
+    memory_info.resident_set_bytes += area.ram_size;
+  }
+  return memory_info;
+}
+
+base::expected<TimeDelta, ProcessCPUUsageError>
+ProcessMetrics::GetCumulativeCPUUsage() {
+  team_usage_info usage;
+  if (get_team_usage_info(process_, B_TEAM_USAGE_SELF, &usage) != B_OK) {
+    return base::unexpected(ProcessCPUUsageError::kProcessNotFound);
+  }
+  return base::ok(Microseconds(usage.user_time + usage.kernel_time));
+}
+
+size_t GetSystemCommitCharge() {
+  system_info info;
+  if (get_system_info(&info) != B_OK) {
+    return 0;
+  }
+  return static_cast<size_t>(info.used_pages * B_PAGE_SIZE / 1024);
+}
+
+int64_t GetNumberOfThreads(ProcessHandle process) {
+  team_info info;
+  if (get_team_info(process, &info) != B_OK) {
+    return 0;
+  }
+  return info.thread_count;
+}
+
+bool GetSystemMemoryInfo(SystemMemoryInfoKB* meminfo) {
+  system_info info;
+  if (get_system_info(&info) != B_OK) {
+    return false;
+  }
+  meminfo->total = static_cast<int>(info.max_pages * B_PAGE_SIZE / 1024);
+  meminfo->free = static_cast<int>(info.free_memory / 1024);
+  meminfo->available = meminfo->free;
+  meminfo->cached = static_cast<int>(info.cached_pages * B_PAGE_SIZE / 1024);
+  meminfo->swap_total =
+      static_cast<int>(info.max_swap_pages * B_PAGE_SIZE / 1024);
+  meminfo->swap_free =
+      static_cast<int>(info.free_swap_pages * B_PAGE_SIZE / 1024);
+  return true;
+}
+
+int ProcessMetrics::GetOpenFdCount() const {
+  // Haiku does not list another team's descriptors.
+  return -1;
+}
+
+int ProcessMetrics::GetOpenFdSoftLimit() const {
+  struct rlimit limit;
+  if (getrlimit(RLIMIT_NOFILE, &limit) != 0) {
+    return -1;
+  }
+  return static_cast<int>(limit.rlim_cur);
+}
+
+int ProcessMetrics::GetIdleWakeupsPerSecond() {
+  NOTIMPLEMENTED();
+  return 0;
+}
+
+bool GetSystemDiskInfo(SystemDiskInfo* diskinfo) {
+  NOTIMPLEMENTED();
+  return false;
+}
+
+bool GetVmStatInfo(VmStatInfo* vmstat) {
+  NOTIMPLEMENTED();
+  return false;
+}
+
+SystemDiskInfo::SystemDiskInfo() = default;
+
+SystemDiskInfo::SystemDiskInfo(const SystemDiskInfo& other) = default;
+
+SystemDiskInfo& SystemDiskInfo::operator=(const SystemDiskInfo&) = default;
+
+Value::Dict SystemDiskInfo::ToDict() const {
+  Value::Dict res;
+  // Write out uint64_t variables as doubles: JS has no other option.
+  res.Set("reads", static_cast<double>(reads));
+  res.Set("reads_merged", static_cast<double>(reads_merged));
+  res.Set("sectors_read", static_cast<double>(sectors_read));
+  res.Set("read_time", static_cast<double>(read_time));
+  res.Set("writes", static_cast<double>(writes));
+  res.Set("writes_merged", static_cast<double>(writes_merged));
+  res.Set("sectors_written", static_cast<double>(sectors_written));
+  res.Set("write_time", static_cast<double>(write_time));
+  res.Set("io", static_cast<double>(io));
+  res.Set("io_time", static_cast<double>(io_time));
+  res.Set("weighted_io_time", static_cast<double>(weighted_io_time));
+  return res;
+}
+
+Value::Dict SystemMemoryInfoKB::ToDict() const {
+  Value::Dict res;
+  res.Set("total", total);
+  res.Set("free", free);
+  res.Set("available", available);
+  res.Set("buffers", buffers);
+  res.Set("cached", cached);
+  res.Set("active_anon", active_anon);
+  res.Set("inactive_anon", inactive_anon);
+  res.Set("active_file", active_file);
+  res.Set("inactive_file", inactive_file);
+  res.Set("swap_total", swap_total);
+  res.Set("swap_free", swap_free);
+  res.Set("swap_used", swap_total - swap_free);
+  res.Set("dirty", dirty);
+  res.Set("reclaimable", reclaimable);
+  return res;
+}
+
+Value::Dict VmStatInfo::ToDict() const {
+  Value::Dict res;
+  res.Set("pswpin", static_cast<int>(pswpin));
+  res.Set("pswpout", static_cast<int>(pswpout));
+  res.Set("pgmajfault", static_cast<int>(pgmajfault));
+  return res;
+}
+
+}  // namespace base
diff --git a/src/3rdparty/chromium/base/system/sys_info_haiku.cc b/src/3rdparty/chromium/base/system/sys_info_haiku.cc
new file mode 100644
index 0000000..d76feb7
--- /dev/null
+++ b/src/3rdparty/chromium/base/system/sys_info_haiku.cc
@@ -0,0 +1,94 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/system/sys_info.h"
+
+#include <OS.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <string>
+
+#include "base/check.h"
+#include "base/process/process_metrics.h"
+#include "base/strings/string_util.h"
+
+namespace base {
+
+namespace {
+
+bool GetSystemInfo(system_info* info) {
+  return get_system_info(info) == B_OK;
+}
+
+}  // namespace
+
+int SysInfo::NumberOfProcessors() {
+  system_info info;
+  if (!GetSystemInfo(&info) || info.cpu_count == 0) {
+    return 1;
+  }
+  return static_cast<int>(info.cpu_count);
+}
+
+uint64_t SysInfo::AmountOfPhysicalMemoryImpl() {
+  system_info info;
+  if (!GetSystemInfo(&info)) {
+    return 0;
+  }
+  return info.max_pages * B_PAGE_SIZE;
+}
+
+uint64_t SysInfo::AmountOfAvailablePhysicalMemoryImpl() {
+  system_info info;
+  if (!GetSystemInfo(&info)) {
+    return 0;
+  }
+  return info.free_memory;
+}
+
+uint64_t SysInfo::AmountOfAvailablePhysicalMemory(
+    const SystemMemoryInfoKB& info) {
+  uint64_t res_kb = info.available != 0
+                        ? info.available - info.active_file
+                        : info.free + info.reclaimable + info.inactive_file;
+  return res_kb * 1024;
+}
+
+std::string SysInfo::CPUModelName() {
+  cpu_topology_node_info nodes[64];
+  uint32 count = std::size(nodes);
+  if (get_cpu_topology_info(nodes, &count) != B_OK) {
+    return std::string();
+  }
+  for (uint32 i = 0; i < count; i++) {
+    if (nodes[i].type == B_TOPOLOGY_PACKAGE) {
+      switch (nodes[i].data.package.vendor) {
+        case B_CPU_VENDOR_INTEL:
+          return "Intel";
+        case B_CPU_VENDOR_AMD:
+          return "AMD";
+        default:
+          break;
+      }
+    }
+  }
+  return std::string();
+}
+
+uint64_t SysInfo::MaxSharedMemorySize() {
+  // Haiku shares memory through areas, with no fixed upper size.
+  return 0;
+}
+
+SysInfo::HardwareInfo SysInfo::GetHardwareInfoSync() {
+  HardwareInfo info;
+  info.manufacturer = "Haiku";
+  info.model = HardwareModelName();
+  DCHECK(IsStringUTF8(info.manufacturer));
+  DCHECK(IsStringUTF8(info.model));
+  return info;
+}
+
+}  // namespace base
diff --git a/src/3rdparty/chromium/v8/src/base/export-template.h b/src/3rdparty/chromium/v8/src/base/export-template.h
index 861cfe4..c980721 100644
