From a8873dc18d58f3d21229da1af5ccf4f1d8f39ebb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonat=C3=A3=20Bolzan=20Loss?= <jonata@jonata.org>
Date: Wed, 11 Nov 2026 23:21:22 -0300
Subject: Haiku: V8 platform, Dawn, ANGLE, libsync, pkg-config

V8 gets V8_OS_HAIKU (POSIX, no target OS define, so none of the Linux
signal/trap-handler code) and platform-haiku.cc, carried forward from
the Qt 5 port: image list from get_next_image_info, stack start from
get_thread_info, thread ids and names via find_thread/rename_thread.
Dawn counts Haiku with the BSDs. ANGLE builds no GL or Vulkan backend on
Haiku (no EGL/GLX display; it renders in software). libsync compiles to
ioctls that fail. Chromium's pkg-config wrapper returned nothing on any
platform it did not know, so no system library had flags: Haiku added
there and to the other build scripts that look at sys.platform.
---
 .../chromium/build/config/linux/pkg-config.py |  2 +-
 src/3rdparty/chromium/build/landmine_utils.py |  2 +-
 .../bindings/scripts/bind_gen/style_format.py |  2 +-
 .../dawn/src/dawn/common/Platform.h           |  2 +-
 .../libsync/src/include/sync/sync.h           |  2 +-
 .../chromium/third_party/libsync/src/sync.c   | 11 +++-
 .../chromium/tools/licenses/licenses.py       |  2 +-
 src/3rdparty/chromium/v8/BUILD.gn             |  8 ++-
 src/3rdparty/chromium/v8/include/v8config.h   |  5 ++
 .../v8/src/base/platform/platform-haiku.cc    | 62 +++++++++++++++++++
 .../v8/src/base/platform/platform-posix.cc    | 14 ++++-
 src/core/CMakeLists.txt                       |  8 ++-
 12 files changed, 108 insertions(+), 12 deletions(-)
 create mode 100644 src/3rdparty/chromium/v8/src/base/platform/platform-haiku.cc

diff --git a/src/3rdparty/chromium/build/config/linux/pkg-config.py b/src/3rdparty/chromium/build/config/linux/pkg-config.py
index 92bfc0a..60dd6b9 100755
--- a/src/3rdparty/chromium/build/config/linux/pkg-config.py
+++ b/src/3rdparty/chromium/build/config/linux/pkg-config.py
@@ -113,7 +113,7 @@ def main():
   # If this is run on non-Linux platforms, just return nothing and indicate
   # success. This allows us to "kind of emulate" a Linux build from other
   # platforms.
-  if not sys.platform.startswith(tuple(['linux', 'darwin', 'freebsd', 'openbsd'])):
+  if not sys.platform.startswith(tuple(['linux', 'darwin', 'freebsd', 'openbsd', 'haiku'])):
     print("[[],[],[],[],[]]")
     return 0
 
diff --git a/src/3rdparty/chromium/build/landmine_utils.py b/src/3rdparty/chromium/build/landmine_utils.py
index b126f4f..eefdf8b 100644
--- a/src/3rdparty/chromium/build/landmine_utils.py
+++ b/src/3rdparty/chromium/build/landmine_utils.py
@@ -11,7 +11,7 @@ def IsWindows():
 
 
 def IsLinux():
-  return sys.platform.startswith(('linux', 'freebsd', 'netbsd', 'openbsd'))
+  return sys.platform.startswith(('linux', 'freebsd', 'netbsd', 'openbsd', 'haiku'))
 
 
 def IsMac():
diff --git a/src/3rdparty/chromium/third_party/blink/renderer/bindings/scripts/bind_gen/style_format.py b/src/3rdparty/chromium/third_party/blink/renderer/bindings/scripts/bind_gen/style_format.py
index cdbf6cb..042d05a 100644
