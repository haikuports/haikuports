+++ b/src/3rdparty/chromium/v8/src/base/export-template.h
@@ -153,8 +153,12 @@
 
 EXPORT_TEMPLATE_TEST(DEFAULT, );
 EXPORT_TEMPLATE_TEST(DEFAULT, __attribute__((visibility("default"))));
+// Haiku's GCC turns __declspec(x) into __attribute__((x)), which these
+// token-pasting checks cannot take apart.
+#if !defined(__HAIKU__)
 EXPORT_TEMPLATE_TEST(MSVC_HACK, __declspec(dllexport));
 EXPORT_TEMPLATE_TEST(DEFAULT, __declspec(dllimport));
+#endif
 
 #undef EXPORT_TEMPLATE_TEST
 #undef EXPORT_TEMPLATE_TEST_DEFAULT_DEFAULT
diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
index dbbe94f..b35b1fa 100644
--- a/src/core/CMakeLists.txt
+++ b/src/core/CMakeLists.txt
@@ -464,9 +464,11 @@ foreach(arch ${archs})
 
         if(LINUX OR FREEBSD OR HAIKU)
             # Haiku has neither an EGL nor a GLX display for ANGLE's GL
-            # backend: it renders in software.
+            # backend: it renders in software, and ANGLE gets its null
+            # backend so it still has one.
             if(HAIKU)
-                list(APPEND gnArgArg angle_enable_gl=false angle_enable_vulkan=false)
+                list(APPEND gnArgArg angle_enable_gl=false angle_enable_vulkan=false
+                    angle_enable_null=true)
             else()
                 list(APPEND gnArgArg angle_enable_gl=true)
             endif()
