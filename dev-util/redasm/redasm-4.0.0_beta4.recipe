SUMMARY="The Open Source Disassembler"
DESCRIPTION="A cross platform, free and open source disassembler that supports multiple \
architectures, legacy formats and plugins."
HOMEPAGE="https://redasm.dev"
COPYRIGHT="2016-2026 Antonio Davide Trogu (Dax)"
LICENSE="GNU GPL v3"
REVISION="1"
_pkgver="${portVersion/_/-}"
_miniz_ver="3.1.1"
_tomlc17_ver="R20260501"
_qhexview_ver="5.1.4"
_capstone_ver="6.0.0-Alpha10"
_yyjson_ver="0.13.0"
SOURCE_URI="https://github.com/redasm-dev/workspace/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256="686a94ee31feeb4dee71e1d9841d2b9bb5e3d003cae67245f497c7f3cb63c79c"
SOURCE_DIR="workspace-${_pkgver}"
