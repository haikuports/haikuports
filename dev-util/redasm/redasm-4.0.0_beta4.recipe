SOURCE_FILENAME_2="core-${_pkgver}"
SOURCE_DIR_2="core-${_pkgver}"
SOURCE_URI_3="https://github.com/redasm-dev/redasm/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_3="ba5d206ff0dbb56690d94fc943369c55fdd7520751230f8a0324202685a59f7a"
SOURCE_FILENAME_3="redasm-${_pkgver}"
SOURCE_DIR_3="redasm-${_pkgver}"
SOURCE_URI_4="https://github.com/redasm-dev/loaders/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_4="ff916b22374cf12f8afd4ca210566fd85106770ea30fa7019b77421e3ec08a21"
SOURCE_FILENAME_4="loaders-${_pkgver}"
SOURCE_DIR_4="loaders-${_pkgver}"
SOURCE_URI_5="https://github.com/redasm-dev/processors/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_5="4c488cf4dc13c896541d7d8dcf6b14c09cf391a220235c831097270df914345a"
SOURCE_FILENAME_5="processors-${_pkgver}"
SOURCE_DIR_5="processors-${_pkgver}"
SOURCE_URI_6="https://github.com/redasm-dev/analyzers/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_6="444e11c885c8206da397c8adc72d9e6cf21421e11d28f66bb600ec0528a843c1"
SOURCE_FILENAME_6="analyzers-${_pkgver}"
SOURCE_DIR_6="analyzers-${_pkgver}"
SOURCE_URI_7="https://github.com/redasm-dev/commands/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_7="88a16c0058ea043a626c8f6a718a8f166ab4ebf943b8d4e0efc2f66d60a97f7d"
SOURCE_FILENAME_7="commands-${_pkgver}"
SOURCE_DIR_7="commands-${_pkgver}"
SOURCE_URI_8="https://github.com/redasm-dev/mcp/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_8="5726a7582a5b231fca83aac6d9cd00e87ca00dd3b3edc2e4bbbbc38ed535098d"
SOURCE_FILENAME_8="mcp-${_pkgver}"
SOURCE_DIR_8="mcp-${_pkgver}"
SOURCE_URI_9="https://github.com/redasm-dev/kb/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_9="408af6ba8607b61ca740cde2bd53c7ca3a2374207d2cf6d6406c6a356ffc4cd6"
SOURCE_FILENAME_9="kb-${_pkgver}"
SOURCE_DIR_9="kb-${_pkgver}"
SOURCE_URI_10="https://github.com/richgel999/miniz/releases/download/${_miniz_ver}/miniz-${_miniz_ver}.zip"
CHECKSUM_SHA256_10="cb28402bb2af93bdc331b60d16807e89727d1712a2d0a7ba0cac79a3e406fe40"
SOURCE_DIR_10=""
SOURCE_URI_11="https://github.com/cktan/tomlc17/archive/${_tomlc17_ver}.tar.gz"
CHECKSUM_SHA256_11="85a61daa8ca69c8036ce37529645769bf58ee4c8b0734283228c854cecf55cda"
SOURCE_DIR_11="tomlc17-${_tomlc17_ver}"
SOURCE_URI_12="https://github.com/Dax89/QHexView/archive/v${_qhexview_ver}.tar.gz"
CHECKSUM_SHA256_12="a35d26468c3ed08f30676013e28004cca3c6182b6ee63950b7d59c1a1051112d"
SOURCE_FILENAME_12="QHexView-${_qhexview_ver}"
SOURCE_DIR_12="QHexView-${_qhexview_ver}"
SOURCE_URI_13="https://github.com/capstone-engine/capstone/archive/${_capstone_ver}.tar.gz"
CHECKSUM_SHA256_13="af09851f76656d97f12e44f7224bd1066ea441da6efa91dd9c8d53837e8e15d5"
SOURCE_FILENAME_13="capstone-${_capstone_ver}"
SOURCE_DIR_13="capstone-${_capstone_ver}"
SOURCE_URI_14="https://github.com/ibireme/yyjson/archive/${_yyjson_ver}.tar.gz"
CHECKSUM_SHA256_14="34e0f62a2bc11ab20d601e8ca1cc2b2079503aa45119a19133d89d19b94a0fae"
SOURCE_FILENAME_14="yyjson-${_yyjson_ver}"
SOURCE_DIR_14="yyjson-${_yyjson_ver}"
ADDITIONAL_FILES="redasm.rdef.in"

ARCHITECTURES="all !x86_gcc2"

PROVIDES="
	redasm = $portVersion
	app:REDasm = $portVersion
	cmd:redasm_gui = $portVersion
	cmd:redasm_mcp = $portVersion
	lib:libredasm = $portVersion
	"
REQUIRES="
	haiku
	lib:libcurl
	lib:libGL
	lib:libQt6Core
	lib:libQt6Gui
	lib:libQt6Widgets
	lib:libsqlite3
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libcurl
	devel:libQt6Core
	devel:libQt6Gui
	devel:libQt6Widgets
	devel:libsqlite3
	devel:libZydis
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc
	cmd:make
	"

BUILD()
{
	depot="$sourceDir/../depot"

	ln -sfn "$sourceDir2" core
	ln -sfn "$sourceDir3" redasm
	ln -sfn "$sourceDir4" loaders
	ln -sfn "$sourceDir5" processors
	ln -sfn "$sourceDir6" analyzers
	ln -sfn "$sourceDir7" commands
	ln -sfn "$sourceDir8" mcp

	mkdir -p kb
	cp -r "$sourceDir9/." kb/

	mkdir -p "$depot"
	ln -sfn "$sourceDir10" "$depot/miniz"
	ln -sfn "$sourceDir11" "$depot/tomlc17"
	ln -sfn "$sourceDir12" "$depot/QHexView"
	ln -sfn "$sourceDir13" "$depot/capstone"
	ln -sfn "$sourceDir14" "$depot/yyjson"

	cmake -B build -S . $cmakeDirArgs \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=$appsDir/REDasm \
		-DCMAKE_SKIP_RPATH=ON \
		-DREDASM_RELEASE_TAG="v${_pkgver}" \
		-DREDASM_OFFLINE=ON \
		-DREDASM_DEPOT_DIR="$depot"

	make -C build $jobArgs
}

INSTALL()
{
	make -C build install

	app="$appsDir/REDasm"

	mv "$app/bin/redasm-gui" "$app/REDasm"
	mv "$app/bin/redasm-mcp" "$app/redasm-mcp"
	mv "$app/lib/redasm/plugins" "$app/plugins"
	mv "$app/data/redasm/kb" "$app/kb"

	mkdir -p "$libDir" "$binDir"
	mv "$app/lib/libredasm.so" "$libDir/"
	ln -sfn "$app/REDasm" "$binDir/redasm-gui"
	ln -sfn "$app/redasm-mcp" "$binDir/redasm-mcp"

	rm -rf "$app/bin" "$app/lib" "$app/include" "$app/develop" "$app/share" "$app/data"

	local ver="${portVersion%%_*}" pre="${portVersion#*_}"
	local major middle minor
	IFS=. read -r major middle minor <<< "$ver"

	local variety="B_APPV_FINAL" internal=0
	case "$pre" in
		beta*) variety="B_APPV_BETA"; internal="${pre#beta}" ;;
		rc*) variety="B_APPV_GAMMA"; internal="${pre#rc}" ;;
	esac

	sed -e "s|@MAJOR@|$major|" -e "s|@MIDDLE@|$middle|" -e "s|@MINOR@|$minor|" \
		-e "s|@VARIETY@|$variety|" -e "s|@INTERNAL@|$internal|" \
		-e "s|@APP_SIGNATURE@|application/x-vnd.redasm|" \
		-e "s|@LONG_INFO@|$SUMMARY|" \
		"$portDir/additional-files/redasm.rdef.in" > redasm.rdef

	addResourcesToBinaries redasm.rdef "$app/REDasm"
	addAppDeskbarSymlink "$app/REDasm" "REDasm"
}
