SOURCE_URI_9="https://github.com/redasm-dev/kb/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_9="408af6ba8607b61ca740cde2bd53c7ca3a2374207d2cf6d6406c6a356ffc4cd6"
SOURCE_FILENAME_9="kb-${_pkgver}"


# --- Dependency depot ------------------
# - Zydis (4.1.1) comes from the system, so it has no depot entry.
# - The system capstone is 5.x and core needs >= 6, so it is always bundled

# miniz - redasm-dev/core
SOURCE_URI_10="https://github.com/richgel999/miniz/releases/download/${_miniz_ver}/miniz-${_miniz_ver}.zip"
CHECKSUM_SHA256_10="cb28402bb2af93bdc331b60d16807e89727d1712a2d0a7ba0cac79a3e406fe40"

# tomlc17 - redasm-dev/core
SOURCE_URI_11="https://github.com/cktan/tomlc17/archive/${_tomlc17_ver}.tar.gz"
CHECKSUM_SHA256_11="85a61daa8ca69c8036ce37529645769bf58ee4c8b0734283228c854cecf55cda"

# QHexView - redasm-dev/redasm (GUI)
SOURCE_URI_12="https://github.com/Dax89/QHexView/archive/v${_qhexview_ver}.tar.gz"
CHECKSUM_SHA256_12="a35d26468c3ed08f30676013e28004cca3c6182b6ee63950b7d59c1a1051112d"
SOURCE_FILENAME_12="QHexView-${_qhexview_ver}"

# Capstone - redasm-dev/processors (capstonebundle)
SOURCE_URI_13="https://github.com/capstone-engine/capstone/archive/${_capstone_ver}.tar.gz"
CHECKSUM_SHA256_13="af09851f76656d97f12e44f7224bd1066ea441da6efa91dd9c8d53837e8e15d5"
SOURCE_FILENAME_13="capstone-${_capstone_ver}"

# yyjson - redasm-dev/mcp
SOURCE_URI_14="https://github.com/ibireme/yyjson/archive/${_yyjson_ver}.tar.gz"
CHECKSUM_SHA256_14="34e0f62a2bc11ab20d601e8ca1cc2b2079503aa45119a19133d89d19b94a0fae"
SOURCE_FILENAME_14="yyjson-${_yyjson_ver}"

ADDITIONAL_FILES="
	redasm.rdef.in
	"

ARCHITECTURES="all !x86_gcc2"

PROVIDES="
	redasm$secondaryArchSuffix = $portVersion
	app:REDasm = $portVersion
	cmd:redasm_gui$secondaryArchSuffix = $portVersion
	cmd:redasm_mcp$secondaryArchSuffix = $portVersion
	lib:libredasm$secondaryArchSuffix = $portVersion
	"

# Core accepts the system SQLite only if it is >= 3.35
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libGL$secondaryArchSuffix
	lib:libQt6Core$secondaryArchSuffix
	lib:libQt6Gui$secondaryArchSuffix
	lib:libQt6Widgets$secondaryArchSuffix
	lib:libsqlite3$secondaryArchSuffix
	lib:libcurl$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libQt6Core$secondaryArchSuffix
	devel:libQt6Gui$secondaryArchSuffix
	devel:libQt6Widgets$secondaryArchSuffix
	devel:libsqlite3$secondaryArchSuffix
	devel:libZydis$secondaryArchSuffix
	devel:libcurl$secondaryArchSuffix
	"

BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	sources="$sourceDir/../.."
	depot="$sourceDir/../depot"

	# workspace layout
	ln -sfn "$sources/sources-2/core-${_pkgver}" core
	ln -sfn "$sources/sources-3/redasm-${_pkgver}" redasm
	ln -sfn "$sources/sources-4/loaders-${_pkgver}" loaders
	ln -sfn "$sources/sources-5/processors-${_pkgver}" processors
	ln -sfn "$sources/sources-6/analyzers-${_pkgver}" analyzers
	ln -sfn "$sources/sources-7/commands-${_pkgver}" commands
	ln -sfn "$sources/sources-8/mcp-${_pkgver}" mcp

	# prepare KB files
	mkdir -p kb
	cp -r "$sources/sources-9/kb-${_pkgver}/." kb/

	# dependency depot: one directory per package, named like the CMake package
	mkdir -p "$depot"
	ln -sfn "$sources/sources-10" "$depot/miniz"
	ln -sfn "$sources/sources-11/tomlc17-${_tomlc17_ver}" "$depot/tomlc17"
	ln -sfn "$sources/sources-12/QHexView-${_qhexview_ver}" "$depot/QHexView"
	ln -sfn "$sources/sources-13/capstone-${_capstone_ver}" "$depot/capstone"
	ln -sfn "$sources/sources-14/yyjson-${_yyjson_ver}" "$depot/yyjson"

	cmake -B build -S . $cmakeDirArgs \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=$appsDir/REDasm \
		-DCMAKE_SKIP_RPATH=ON \
		-DREDASM_RELEASE_TAG="v${_pkgver}" \
		-DREDASM_OFFLINE=ON \
		-DREDASM_DEPOT_DIR="$depot"

	make -C build $jobArgs
}

INSTALL()
{
	make -C build install

	app="$appsDir/REDasm"

	mv "$app/bin/redasm-gui" "$app/REDasm"
	mv "$app/bin/redasm-mcp" "$app/redasm-mcp"
	mv "$app/lib/redasm/plugins" "$app/plugins"
	mv "$app/data/redasm/kb" "$app/kb"

	mkdir -p "$libDir"
	mv "$app/lib/libredasm.so" "$libDir/"

	mkdir -p "$binDir"
	ln -sfn "$appsDir/REDasm/REDasm" "$binDir/redasm-gui"
	ln -sfn "$appsDir/REDasm/redasm-mcp" "$binDir/redasm-mcp"

	rm -rf "$app/bin" "$app/lib" "$app/include" "$app/develop" "$app/share" "$app/data"

	# resources: icon, signature, version (4.0.0_beta4 -> 4.0.0, beta 4)
	local ver="${portVersion%%_*}" pre="${portVersion#*_}"
	local major middle minor
	IFS=. read -r major middle minor <<< "$ver"

	local variety="B_APPV_FINAL" internal=0
	case "$pre" in
		beta*) variety="B_APPV_BETA";  internal="${pre#beta}" ;;
		rc*)   variety="B_APPV_GAMMA"; internal="${pre#rc}" ;;
	esac

	sed -e "s|@MAJOR@|$major|" -e "s|@MIDDLE@|$middle|" -e "s|@MINOR@|$minor|" \
		-e "s|@VARIETY@|$variety|" -e "s|@INTERNAL@|$internal|" \
		-e "s|@APP_SIGNATURE@|application/x-vnd.redasm|" \
		-e "s|@LONG_INFO@|$SUMMARY|" \
		"$portDir/additional-files/redasm.rdef.in" > redasm.rdef

	addResourcesToBinaries redasm.rdef "$app/REDasm"

	addAppDeskbarSymlink "$app/REDasm" "REDasm"
}
