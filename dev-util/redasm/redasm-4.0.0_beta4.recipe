SOURCE_URI_2="https://github.com/redasm-dev/core/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_2="3f7cc3e73e4200e3410cbfa46e3f4641b0d697a8ecf75f7cfbe0bb5acdd417f2"
SOURCE_FILENAME_2="core-${_pkgver}"

SOURCE_URI_3="https://github.com/redasm-dev/redasm/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_3="ba5d206ff0dbb56690d94fc943369c55fdd7520751230f8a0324202685a59f7a"
SOURCE_FILENAME_3="redasm-${_pkgver}"

SOURCE_URI_4="https://github.com/redasm-dev/loaders/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_4="ff916b22374cf12f8afd4ca210566fd85106770ea30fa7019b77421e3ec08a21"
