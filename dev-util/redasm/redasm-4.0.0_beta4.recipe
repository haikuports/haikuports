SOURCE_URI_6="https://github.com/redasm-dev/analyzers/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_6="444e11c885c8206da397c8adc72d9e6cf21421e11d28f66bb600ec0528a843c1"
