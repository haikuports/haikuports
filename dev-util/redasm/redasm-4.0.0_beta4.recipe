SOURCE_URI_7="https://github.com/redasm-dev/commands/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_7="88a16c0058ea043a626c8f6a718a8f166ab4ebf943b8d4e0efc2f66d60a97f7d"
SOURCE_FILENAME_7="commands-${_pkgver}"

SOURCE_URI_8="https://github.com/redasm-dev/mcp/archive/v${_pkgver}.tar.gz"
CHECKSUM_SHA256_8="5726a7582a5b231fca83aac6d9cd00e87ca00dd3b3edc2e4bbbbc38ed535098d"
