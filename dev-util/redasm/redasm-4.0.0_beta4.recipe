SUMMARY="The Open Source Disassembler"
DESCRIPTION="A cross platform, free and open source disassembler that supports multiple architectures, legacy formats and plugins"
HOMEPAGE="https://redasm.dev"
COPYRIGHT="2016-2026 Antonio Davide Trogu (Dax)"
LICENSE="GNU GPL v3"
REVISION="1"

_pkgver="${portVersion/_/-}"

# Depots versions
_miniz_ver="3.1.1"
_tomlc17_ver="R20260501"
_qhexview_ver="5.1.4"
_capstone_ver="6.0.0-Alpha10"
_yyjson_ver="0.13.0"

# --- REDasm components -------------------------------------------------------
