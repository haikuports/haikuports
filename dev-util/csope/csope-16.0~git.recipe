SUMMARY="C and C++ source code browser"
DESCRIPTION="
Csope is a fork of Cscope version 15.9, with various improvements.

Allows searching code for:

* symbol
* global definition
* assignments to specified symbol
* functions called by specified function
* functions calling specified function
* text string
* egrep pattern
* file
* files (including specified file)

...and open with your '$EDITOR'.
"
HOMEPAGE="https://github.com/agvxov/csope/"
COPYRIGHT="1998-2001 The Santa Cruz Operation
2023 Ognjen Milan Robovic"
LICENSE="BSD (4-clause)"
REVISION="1"
srcGitRev="7a51cba7e0574562b7a74983fbec56d7bd412b8a"
SOURCE_URI="https://github.com/agvxov/csope/archive/$srcGitRev.tar.gz"
CHECKSUM_SHA256="70fdc190f7a7b24d9a0b594990f173b6bd6ff508896368b018c0c2422eb3e6f0"
SOURCE_DIR="$portBaseName-$srcGitRev"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	$portName = $portVersion
	cmd:csope = $portVersion compat >= 15
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libncurses$secondaryArchSuffix
	lib:libreadline$secondaryArchSuffix
	"

BUILD_REQUIRES="
	devel:libncurses$secondaryArchSuffix
	devel:libreadline$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	haiku${secondaryArchSuffix}_devel
	cmd:gcc$secondaryArchSuffix
	cmd:flex
	cmd:yacc
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	make $jobArgs
}

INSTALL()
{
	PREFIX=$prefix make install

	# Manually install older man page (from cscope), better than nothing:
	mkdir -p $manDir/man1
	bunzip2 -k documentation/cscope.1.bz2 -c > $manDir/man1/csope.1
}
