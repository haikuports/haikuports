From 42b2478948080b3707001fbf8e63c6ad6f1d4235 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Joachim=20Mairb=C3=B6ck?= <j.mairboeck@gmail.com>
Date: Mon, 26 Oct 2026 18:31:36 +0100
Subject: fix cmake installation path


diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3e5e8c1..57d9a77 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -111,15 +111,15 @@ if (VULKAN_HEADERS_ENABLE_INSTALL)
             FILE_SET CXX_MODULES DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
         install(EXPORT VulkanHeadersConfig
             NAMESPACE "Vulkan::"
-            DESTINATION "share/cmake/VulkanHeaders"
+            DESTINATION "${CMAKE_INSTALL_DATADIR}/cmake/VulkanHeaders"
             CXX_MODULES_DIRECTORY "")
     else()
         install(EXPORT VulkanHeadersConfig
             NAMESPACE "Vulkan::"
-            DESTINATION "share/cmake/VulkanHeaders")
+            DESTINATION "${CMAKE_INSTALL_DATADIR}/cmake/VulkanHeaders")
     endif()
 
     set(version_config "${CMAKE_CURRENT_BINARY_DIR}/generated/VulkanHeadersConfigVersion.cmake")
     write_basic_package_version_file("${version_config}" COMPATIBILITY SameMajorVersion ARCH_INDEPENDENT)
-    install(FILES "${version_config}" DESTINATION "share/cmake/VulkanHeaders")
+    install(FILES "${version_config}" DESTINATION "${CMAKE_INSTALL_DATADIR}/cmake/VulkanHeaders")
 endif()
-- 
2.56.0


From 274e0bd176d662ea76def17187308915a9618235 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Joachim=20Mairb=C3=B6ck?= <j.mairboeck@gmail.com>
Date: Mon, 26 Oct 2026 18:51:35 +0100
Subject: fix dynamic loading on Haiku


diff --git a/include/vulkan/vulkan.hpp b/include/vulkan/vulkan.hpp
index 0911b4c..d9d02b8 100644
--- a/include/vulkan/vulkan.hpp
+++ b/include/vulkan/vulkan.hpp
@@ -26085,7 +26085,7 @@ VULKAN_HPP_EXPORT namespace VULKAN_HPP_NAMESPACE
         {
 #  if defined( _WIN32 )
           m_library = ::LoadLibraryA( vulkanLibraryName.c_str() );
-#  elif defined( __unix__ ) || defined( __APPLE__ ) || defined( __QNX__ ) || defined( __Fuchsia__ )
+#  elif defined( __unix__ ) || defined( __APPLE__ ) || defined( __QNX__ ) || defined( __Fuchsia__ ) || defined( __HAIKU__ )
           m_library = dlopen( vulkanLibraryName.c_str(), RTLD_NOW | RTLD_LOCAL );
 #  else
 #    error unsupported platform
@@ -26126,7 +26126,7 @@ VULKAN_HPP_EXPORT namespace VULKAN_HPP_NAMESPACE
           {
             m_library = dlopen( "MoltenVK.framework/MoltenVK", RTLD_NOW | RTLD_LOCAL );
           }
-#  elif defined( __unix__ ) || defined( __QNX__ ) || defined( __Fuchsia__ )
+#  elif defined( __unix__ ) || defined( __QNX__ ) || defined( __Fuchsia__ ) || defined( __HAIKU__ )
           m_library = dlopen( "libvulkan.so", RTLD_NOW | RTLD_LOCAL );
           if ( !m_library )
           {
@@ -26165,7 +26165,7 @@ VULKAN_HPP_EXPORT namespace VULKAN_HPP_NAMESPACE
       {
         if ( m_library )
         {
-#  if defined( __unix__ ) || defined( __APPLE__ ) || defined( __QNX__ ) || defined( __Fuchsia__ )
+#  if defined( __unix__ ) || defined( __APPLE__ ) || defined( __QNX__ ) || defined( __Fuchsia__ ) || defined( __HAIKU__ )
           dlclose( m_library );
 #  elif defined( _WIN32 )
           ::FreeLibrary( m_library );
@@ -26178,7 +26178,7 @@ VULKAN_HPP_EXPORT namespace VULKAN_HPP_NAMESPACE
       template <typename T>
       T getProcAddress( char const * function ) const VULKAN_HPP_NOEXCEPT
       {
-#  if defined( __unix__ ) || defined( __APPLE__ ) || defined( __QNX__ ) || defined( __Fuchsia__ )
+#  if defined( __unix__ ) || defined( __APPLE__ ) || defined( __QNX__ ) || defined( __Fuchsia__ ) || defined( __HAIKU__ )
         return (T)(void *)dlsym( m_library, function );
 #  elif defined( _WIN32 )
         return (T)(void *)::GetProcAddress( m_library, function );
@@ -26193,7 +26193,7 @@ VULKAN_HPP_EXPORT namespace VULKAN_HPP_NAMESPACE
       }
 
     private:
-#  if defined( __unix__ ) || defined( __APPLE__ ) || defined( __QNX__ ) || defined( __Fuchsia__ )
+#  if defined( __unix__ ) || defined( __APPLE__ ) || defined( __QNX__ ) || defined( __Fuchsia__ ) || defined( __HAIKU__ )
       void * m_library;
 #  elif defined( _WIN32 )
       ::HINSTANCE m_library;
diff --git a/include/vulkan/vulkan_hpp_macros.hpp b/include/vulkan/vulkan_hpp_macros.hpp
index 8c92b30..0dfd2c8 100644
--- a/include/vulkan/vulkan_hpp_macros.hpp
+++ b/include/vulkan/vulkan_hpp_macros.hpp
@@ -87,7 +87,7 @@
 #endif
 
 #if VULKAN_HPP_ENABLE_DYNAMIC_LOADER_TOOL == 1
-#  if defined( __unix__ ) || defined( __APPLE__ ) || defined( __QNX__ ) || defined( __Fuchsia__ )
+#  if defined( __unix__ ) || defined( __APPLE__ ) || defined( __QNX__ ) || defined( __Fuchsia__ ) || defined( __HAIKU__ )
 #    include <dlfcn.h>
 #  elif defined( _WIN32 ) && !defined( VULKAN_HPP_NO_WIN32_PROTOTYPES )
 using HINSTANCE = struct HINSTANCE__ *;
-- 
2.56.0

