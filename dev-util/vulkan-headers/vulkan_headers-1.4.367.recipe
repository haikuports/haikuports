SUMMARY="Vulkan header files and API registry"
DESCRIPTION="This package contains Vulkan header files, include files for C and C++, and related \
scripts."
HOMEPAGE="https://www.vulkan.org/"
COPYRIGHT="2015-2026 The Khronos Group Inc."
LICENSE="Apache v2
	MIT"
REVISION="1"
SOURCE_URI="https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/v$portVersion.tar.gz"
SOURCE_FILENAME="Vulkan-Headers-$portVersion.tar.gz"
CHECKSUM_SHA256="0df7d58b5df617e0a6a17dec521af459206719f9c7cb12d05d09275597c16f70"
SOURCE_DIR="Vulkan-Headers-$portVersion"
PATCHES="vulkan_headers-$portVersion.patchset"

ARCHITECTURES="any"

PROVIDES="
	vulkan_headers = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc
	cmd:ninja
	"

BUILD()
{
	cmake -S . -B build $cmakeDirArgs \
		-DCMAKE_BUILD_TYPE=Release \
		-G Ninja
}

INSTALL()
{
	ninja -C build install
}

TEST()
{
	ninja -C build test
}
