From c756db8ec527574ef72597b8e248c2a55ccd66e5 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Joachim=20Mairb=C3=B6ck?= <j.mairboeck@gmail.com>
Date: Sun, 13 Sep 2026 13:41:25 +0200
Subject: fix test and samples build on Haiku


diff --git a/samples/Demo/CMakeLists.txt b/samples/Demo/CMakeLists.txt
index 14e817f..fc4373d 100644
--- a/samples/Demo/CMakeLists.txt
+++ b/samples/Demo/CMakeLists.txt
@@ -16,7 +16,7 @@ if(NOT WIN32)
     set_target_properties(DemoWchar PROPERTIES COMPILE_FLAGS "-DPLOG_ENABLE_WCHAR_INPUT=1")
     set_target_properties(DemoWchar PROPERTIES FOLDER Samples)
 
-    if(APPLE)
+    if(APPLE OR HAIKU)
         target_link_libraries(DemoWchar -liconv)
     endif()
 endif()
diff --git a/test/CMakeLists.txt b/test/CMakeLists.txt
index e988660..0f5d053 100644
--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -70,7 +70,7 @@ function(plog_add_test_wchar _target)
         plog_add_test(${_target})
         target_compile_definitions(${_target} PRIVATE PLOG_ENABLE_WCHAR_INPUT=1)
 
-        if(APPLE)
+        if(APPLE OR HAIKU)
             target_link_libraries(${_target} -liconv)
         endif()
     endif()
-- 
2.54.0

