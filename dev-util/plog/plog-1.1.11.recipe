SUMMARY="Portable, simple and extensible C++ logging library"
DESCRIPTION="Plog is a C++ logging library that is designed to be as simple, small and flexible \
as possible. It is created as an alternative to existing large libraries and provides some unique \
features as CSV log format and wide string support."
HOMEPAGE="https://github.com/SergiusTheBest/plog"
COPYRIGHT="2022 Sergey Podobry"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://github.com/SergiusTheBest/plog/archive/refs/tags/$portVersion.tar.gz"
CHECKSUM_SHA256="d60b8b35f56c7c852b7f00f58cbe9c1c2e9e59566c5b200512d0cdbb6309a7c2"
PATCHES="plog-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	plog$secondaryArchSuffix = $portVersion
	devel:plog$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	#devel:libiconv$secondaryArchSuffix # needed to build samples and tests
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	cmake -B build -S . -DCMAKE_BUILD_TYPE=Release $cmakeDirArgs \
		-DPLOG_BUILD_SAMPLES=OFF -DPLOG_BUILD_TESTS=OFF

	make -C build $jobArgs
}

INSTALL()
{
	make -C build install
}

TEST()
{
	# to run the tests, they must be enabled in BUILD
	ctest --test-dir build --output-on-failure
}
