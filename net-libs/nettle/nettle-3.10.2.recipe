SUMMARY="Low-level cryptographic library"
DESCRIPTION="Nettle is a cryptographic library that is designed to fit easily \
in more or less any context: In crypto toolkits for object-oriented languages \
(C++, Python, Pike, ...), in applications like LSH or GNUPG, or even in kernel \
space."
HOMEPAGE="https://www.lysator.liu.se/~nisse/nettle/"
COPYRIGHT="2001-2025 Niels Möller"
LICENSE="GNU GPL v2
	GNU GPL v3
	GNU LGPL v3"
REVISION="1"
SOURCE_URI="https://ftp.gnu.org/gnu/nettle/nettle-$portVersion.tar.gz"
CHECKSUM_SHA256="fe9ff51cb1f2abb5e65a6b8c10a92da0ab5ab6eaf26e7fc2b675c45f1fb519b5"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

# On x86_gcc2 we don't want to install the commands in bin/<arch>/, but in bin/.
commandBinDir=$binDir
commandSuffix=$secondaryArchSuffix
if [ "$targetArchitecture" = x86_gcc2 ]; then
	commandSuffix=
	commandBinDir=$prefix/bin
fi

PROVIDES="
	nettle$secondaryArchSuffix = $portVersion
	lib:libnettle$secondaryArchSuffix = 8.11 compat >= 8
	lib:libhogweed$secondaryArchSuffix = 6.11 compat >= 6
	"

REQUIRES="
	haiku$secondaryArchSuffix
	lib:libgmp$secondaryArchSuffix
	"

PROVIDES_devel="
	nettle${secondaryArchSuffix}_devel = $portVersion
	devel:libnettle$secondaryArchSuffix = 8.11 compat >= 8
	devel:libhogweed$secondaryArchSuffix = 6.11 compat >= 6
	"
REQUIRES_devel="
	nettle$secondaryArchSuffix == $portVersion base
	"

PROVIDES_tools="
	nettle${secondaryArchSuffix}_tools = $portVersion
	cmd:nettle_hash$commandSuffix
	cmd:nettle_lfib_stream$commandSuffix
	cmd:nettle_pbkdf2$commandSuffix
	cmd:pkcs1_conv$commandSuffix
	cmd:sexp_conv$commandSuffix
	"
REQUIRES_tools="
	nettle$secondaryArchSuffix == $portVersion base
	$REQUIRES
	"


BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libgmp$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:awk
	cmd:gcc$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	cmd:m4
	cmd:make
	"

TEST_REQUIRES="
	cmd:cmp
	cmd:diff
	"

BUILD()
{
	runConfigure --omit-dirs binDir ./configure \
		--bindir=$commandBinDir \
		--disable-static
	make desdata
	make $jobArgs
}

INSTALL()
{
	make install

	prepareInstalledDevelLibs \
		libnettle \
		libhogweed
	fixPkgconfig

	packageEntries devel \
		$developDir

	packageEntries tools \
		$commandBinDir
}

TEST()
{
	LIBRARY_PATH="$sourceDir/.lib:$LIBRARY_PATH" make check
}
