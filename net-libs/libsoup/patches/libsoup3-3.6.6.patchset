From b6b72143c95d9ba75c0d3a12f39402b0c6a09450 Mon Sep 17 00:00:00 2001
From: Gerasim Troeglazov <3dEyes@gmail.com>
Date: Wed, 25 Nov 2015 01:25:58 +0000
Subject: libsoup, fix build


diff --git a/libsoup/auth/soup-auth-digest.c b/libsoup/auth/soup-auth-digest.c
index 292f204..4cb17ea 100644
--- a/libsoup/auth/soup-auth-digest.c
+++ b/libsoup/auth/soup-auth-digest.c
@@ -9,6 +9,10 @@
 #include <config.h>
 #endif
 
+#ifdef __HAIKU__
+#include <unistd.h>
+#endif
+
 #include <string.h>
 
 #include "auth/soup-auth-digest-private.h"
diff --git a/libsoup/auth/soup-auth-ntlm.c b/libsoup/auth/soup-auth-ntlm.c
index af416fd..3693ec2 100644
--- a/libsoup/auth/soup-auth-ntlm.c
+++ b/libsoup/auth/soup-auth-ntlm.c
@@ -16,6 +16,10 @@
 
 #include <glib.h>
 
+#ifdef __HAIKU__
+#include <unistd.h>
+#endif
+
 #include "soup-auth-ntlm.h"
 #include "soup.h"
 #include "soup-message-private.h"
-- 
2.54.0


From 303fc26ccf2cd0c6f7f74f7b8e87c3d53d593aa6 Mon Sep 17 00:00:00 2001
From: Gerasim Troeglazov <3dEyes@gmail.com>
Date: Tue, 29 Nov 2022 12:51:22 +1000
Subject: link with libnetwork


diff --git a/meson.build b/meson.build
index b979b37..8334bff 100644
--- a/meson.build
+++ b/meson.build
@@ -45,6 +45,11 @@ if host_system == 'sunos'
       add_project_link_arguments('-lsocket', language: 'c')
 endif
 
+if host_system == 'haiku'
+      add_project_arguments('-D__EXTENSIONS__', language: 'c')
+      add_project_link_arguments('-lnetwork', language: 'c')
+endif
+
 common_flags = [
   '-DHAVE_CONFIG_H',
 ]
@@ -81,6 +86,8 @@ else
       '-Wno-sign-compare',
       '-Wno-cast-function-type',
       '-Wno-missing-field-initializers',
+      '-Wno-nonull',
+      '-Wno-error=nonnull',
   ]
 
   if get_option('b_sanitize') == 'address' or get_option('b_sanitize') == 'address,undefined' or \
-- 
2.54.0


From 25ac2beeb393cd201e87a2bb9f21359357241f6d Mon Sep 17 00:00:00 2001
From: Luc Schrijvers <begasus@gmail.com>
Date: Tue, 22 Sep 2026 12:29:12 +0200
Subject: Disable test for RLIMIT


diff --git a/tests/server-mem-limit-test.c b/tests/server-mem-limit-test.c
index 65dc875..05eae07 100644
--- a/tests/server-mem-limit-test.c
+++ b/tests/server-mem-limit-test.c
@@ -129,7 +129,7 @@ main (int argc, char **argv)
 	/* a build with an address sanitizer may crash on mmap() with the limit,
 	   thus skip the limit set in such case, even it may not necessarily
 	   trigger the bug if it regresses */
-	#if !defined(G_OS_WIN32) && !defined(B_SANITIZE_OPTION)
+	#if !defined(G_OS_WIN32) && !defined(B_SANITIZE_OPTION) && !defined(G_OS_HAIKU)
 	struct rlimit new_rlimit = { 1024UL * 1024UL * 1024UL * 2UL, 1024UL * 1024UL * 1024UL * 2UL };
 	/* limit memory usage, to trigger too large memory allocation abort */
 	g_assert_cmpint (setrlimit (RLIMIT_DATA, &new_rlimit), ==, 0);
-- 
2.54.0

