From af6d1d5b15e669a32615a6e36eeb209797f65d87 Mon Sep 17 00:00:00 2001
From: Gerasim Troeglazov <3dEyes@gmail.com>
Date: Wed, 25 Nov 2015 01:25:58 +0000
Subject: Fix build


diff --git a/libsoup/soup-auth-digest.c b/libsoup/soup-auth-digest.c
index e8ba990..4215a02 100644
--- a/libsoup/soup-auth-digest.c
+++ b/libsoup/soup-auth-digest.c
@@ -9,6 +9,10 @@
 #include <config.h>
 #endif
 
+#ifdef __HAIKU__
+#include <unistd.h>
+#endif
+
 #include <string.h>
 
 #include "soup-auth-digest.h"
diff --git a/libsoup/soup-auth-ntlm.c b/libsoup/soup-auth-ntlm.c
index 2d07846..fae991e 100644
--- a/libsoup/soup-auth-ntlm.c
+++ b/libsoup/soup-auth-ntlm.c
@@ -16,6 +16,10 @@
 
 #include <glib.h>
 
+#ifdef __HAIKU__
+#include <unistd.h>
+#endif
+
 #include "soup-auth-ntlm.h"
 #include "soup.h"
 #include "soup-message-private.h"
-- 
2.54.0


From 7779fda02beae204ac33e779f0001c9f73f15b45 Mon Sep 17 00:00:00 2001
From: Luc Schrijvers <begasus@gmail.com>
Date: Wed, 30 Sep 2026 19:10:03 +0200
Subject: Add linbnetwork to platform_deps


diff --git a/meson.build b/meson.build
index 130f813..3207267 100644
--- a/meson.build
+++ b/meson.build
@@ -147,6 +147,10 @@ if not is_static_library
   endif
 endif
 
+if host_machine.system() == 'haiku'
+    platform_deps = [cc.find_library('network')]
+endif
+
 libpsl_required_version = '>= 0.20'
 libpsl_dep = dependency('libpsl', version : libpsl_required_version,
   fallback : ['libpsl', 'libpsl_dep'])
-- 
2.54.0

