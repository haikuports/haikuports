From a5cae381f117e6a6aa3a9ce68f9f0b26046fb2e3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Joachim=20Mairb=C3=B6ck?= <j.mairboeck@gmail.com>
Date: Sat, 12 Sep 2026 19:33:37 +0200
Subject: Haiku build fixes


diff --git a/configure.ac b/configure.ac
index 204e7eb..c7e362f 100644
--- a/configure.ac
+++ b/configure.ac
@@ -135,8 +135,9 @@ AM_CONDITIONAL([COND_PROGRAMS], [test "$enable_programs" = yes])
 AC_CHECK_TYPE(size_t)
 AC_CHECK_TYPE(ssize_t)
 
-AC_CHECK_FUNCS(socket, , AC_CHECK_LIB(socket, socket))
+AC_SEARCH_LIBS(socket, [socket network])
 AC_CHECK_FUNCS(inet_addr, , AC_CHECK_LIB(nsl, inet_addr))
+AC_CHECK_FUNCS(arc4random_buf, , AC_CHECK_LIB(bsd, arc4random_buf))
 
 AC_CHECK_HEADERS(stdatomic.h)
 AC_CHECK_HEADERS(sys/queue.h)
diff --git a/usrsctplib/netinet/sctp_os_userspace.h b/usrsctplib/netinet/sctp_os_userspace.h
index 1476660..dd44be2 100755
--- a/usrsctplib/netinet/sctp_os_userspace.h
+++ b/usrsctplib/netinet/sctp_os_userspace.h
@@ -509,7 +509,7 @@ struct sx {int dummy;};
 #if !defined(_WIN32)
 #include <netinet/ip6.h>
 #endif
-#if defined(__APPLE__) || defined(__FreeBSD__) || defined(__linux__) || defined(__NetBSD__) || defined(__OpenBSD__) || defined(_WIN32) || defined(__EMSCRIPTEN__)
+#if defined(__APPLE__) || defined(__FreeBSD__) || defined(__linux__) || defined(__NetBSD__) || defined(__OpenBSD__) || defined(_WIN32) || defined(__EMSCRIPTEN__) || defined(__HAIKU__)
 #include "user_ip6_var.h"
 #else
 #include <netinet6/ip6_var.h>
@@ -1132,7 +1132,7 @@ sctp_get_mbuf_for_msg(unsigned int space_needed, int want_header, int how, int a
 
 #define SCTP_IS_LISTENING(inp) ((inp->sctp_flags & SCTP_PCB_FLAGS_ACCEPTING) != 0)
 
-#if defined(__APPLE__) || defined(__DragonFly__) || defined(__linux__) || defined(__native_client__) || defined(__NetBSD__) || defined(_WIN32) || defined(__Fuchsia__) || defined(__EMSCRIPTEN__)
+#if defined(__APPLE__) || defined(__DragonFly__) || defined(__linux__) || defined(__native_client__) || defined(__NetBSD__) || defined(_WIN32) || defined(__Fuchsia__) || defined(__EMSCRIPTEN__) || defined(__HAIKU__)
 int
 timingsafe_bcmp(const void *, const void *, size_t);
 #endif
diff --git a/usrsctplib/netinet/sctp_userspace.c b/usrsctplib/netinet/sctp_userspace.c
index ba64aaf..2ad0a83 100755
--- a/usrsctplib/netinet/sctp_userspace.c
+++ b/usrsctplib/netinet/sctp_userspace.c
@@ -44,6 +44,11 @@
 #include <sys/prctl.h>
 #endif
 
+#ifdef __HAIKU__
+#include <OS.h>
+#include <sys/sockio.h>
+#endif
+
 #if defined(_WIN32)
 /* Adapter to translate Unix thread start routines to Windows thread start
  * routines.
@@ -92,6 +97,9 @@ sctp_userspace_set_threadname(const char *name)
 #if defined(__FreeBSD__)
 	pthread_set_name_np(pthread_self(), name);
 #endif
+#ifdef __HAIKU__
+	rename_thread(find_thread(NULL), name);
+#endif
 }
 
 #if !defined(_WIN32) && !defined(__native_client__)
@@ -126,7 +134,7 @@ sctp_userspace_get_mtu_from_ifn(uint32_t if_index, int af)
 }
 #endif
 
-#if defined(__APPLE__) || defined(__DragonFly__) || defined(__linux__) || defined(__native_client__) || defined(__NetBSD__) || defined(_WIN32) || defined(__Fuchsia__) || defined(__EMSCRIPTEN__)
+#if defined(__APPLE__) || defined(__DragonFly__) || defined(__linux__) || defined(__native_client__) || defined(__NetBSD__) || defined(_WIN32) || defined(__Fuchsia__) || defined(__EMSCRIPTEN__) || defined(__HAIKU__)
 int
 timingsafe_bcmp(const void *b1, const void *b2, size_t n)
 {
diff --git a/usrsctplib/user_environment.c b/usrsctplib/user_environment.c
index 1887718..5f0bdea 100755
--- a/usrsctplib/user_environment.c
+++ b/usrsctplib/user_environment.c
@@ -120,7 +120,7 @@ finish_random(void)
 {
 	return;
 }
-#elif defined(__FreeBSD__) || defined(__DragonFly__) || defined(__OpenBSD__) || defined(__NetBSD__) || defined(__APPLE__) || defined(__Bitrig__)
+#elif defined(__FreeBSD__) || defined(__DragonFly__) || defined(__OpenBSD__) || defined(__NetBSD__) || defined(__APPLE__) || defined(__Bitrig__) || defined(__HAIKU__)
 #include <stdlib.h>
 
 void
diff --git a/usrsctplib/user_ip6_var.h b/usrsctplib/user_ip6_var.h
index b970fb8..cf35a70 100755
--- a/usrsctplib/user_ip6_var.h
+++ b/usrsctplib/user_ip6_var.h
@@ -87,7 +87,7 @@ struct ip6_hdr {
 #if defined(_WIN32)
 #define s6_addr16 u.Word
 #endif
-#if !defined(_WIN32) && !defined(__linux__) && !defined(__EMSCRIPTEN__)
+#if !defined(_WIN32) && !defined(__linux__) && !defined(__EMSCRIPTEN__) && !defined(__HAIKU__)
 #define s6_addr8  __u6_addr.__u6_addr8
 #define s6_addr16 __u6_addr.__u6_addr16
 #define s6_addr32 __u6_addr.__u6_addr32
diff --git a/usrsctplib/user_socket.c b/usrsctplib/user_socket.c
index 513a5a9..5613604 100755
--- a/usrsctplib/user_socket.c
+++ b/usrsctplib/user_socket.c
@@ -50,6 +50,9 @@
 #if defined(__linux__)
 #define __FAVOR_BSD    /* (on Ubuntu at least) enables UDP header field names like BSD in RFC 768 */
 #endif
+#ifdef __HAIKU__
+#define UIO_MAXIOV IOV_MAX
+#endif
 #if !defined(_WIN32)
 #if defined INET || defined INET6
 #include <netinet/udp.h>
@@ -1035,7 +1038,7 @@ userspace_sctp_recvmsg(struct socket *so,
 	if (error) {
 		if ((auio.uio_resid != ulen) &&
 		    (error == EINTR ||
-#if !defined(__NetBSD__)
+#if !defined(__NetBSD__) && !defined(__HAIKU__)
 		     error == ERESTART ||
 #endif
 		     error == EWOULDBLOCK)) {
@@ -1128,7 +1131,7 @@ usrsctp_recvv(struct socket *so,
 	if (errno) {
 		if ((auio.uio_resid != ulen) &&
 		    (errno == EINTR ||
-#if !defined(__NetBSD__)
+#if !defined(__NetBSD__) && !defined(__HAIKU__)
 		     errno == ERESTART ||
 #endif
 		     errno == EWOULDBLOCK)) {
@@ -1944,7 +1947,7 @@ int user_connect(struct socket *so, struct sockaddr *sa)
 		error = pthread_cond_wait(SOCK_COND(so), SOCK_MTX(so));
 #endif
 		if (error) {
-#if defined(__NetBSD__)
+#if defined(__NetBSD__) || defined(__HAIKU__)
 			if (error == EINTR) {
 #else
 			if (error == EINTR || error == ERESTART) {
@@ -1964,7 +1967,7 @@ bad:
 	if (!interrupted) {
 		so->so_state &= ~SS_ISCONNECTING;
 	}
-#if !defined(__NetBSD__)
+#if !defined(__NetBSD__) && !defined(__HAIKU__)
 	if (error == ERESTART) {
 		error = EINTR;
 	}
-- 
2.54.0

