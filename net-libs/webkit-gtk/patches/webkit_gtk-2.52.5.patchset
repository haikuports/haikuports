 {
     RELEASE_ASSERT(signal == Signal::AccessFault);
-
+#if HAVE(MACHINE_CONTEXT)
     auto instructionPointer = MachineContext::instructionPointer(context);
     if (!instructionPointer)
         return SignalAction::NotHandled;
@@ -128,6 +128,7 @@ static SignalAction trapHandler(Signal signal, SigInfo& sigInfo, PlatformRegiste
             }
         }
     }
+#endif
     return SignalAction::NotHandled;
 }
 
diff --git a/Source/ThirdParty/ANGLE/src/common/SimpleMutex.h b/Source/ThirdParty/ANGLE/src/common/SimpleMutex.h
