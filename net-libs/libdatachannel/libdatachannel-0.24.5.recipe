SUMMARY="C/C++ WebRTC network library"
DESCRIPTION="libdatachannel is an open-source software library implementing WebRTC Data Channels, \
WebRTC Media Transport, and WebSockets. It is written in C++17 and offers C bindings."
HOMEPAGE="https://libdatachannel.org/"
COPYRIGHT="2021 Paul-Louis Ageneau"
LICENSE="MPL v2.0"
REVISION="1"
SOURCE_URI="https://github.com/paullouisageneau/libdatachannel/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256="454537c3cd526bed935d847bb2dff4046f266eef84d43b2a5f2f2f293c0026f4"
PATCHES="libdatachannel-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

libVersion="$portVersion"
libVersionCompat="$libVersion compat >= ${libVersion%.*}"

PROVIDES="
	libdatachannel$secondaryArchSuffix = $portVersion
	lib:libdatachannel$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libcrypto$secondaryArchSuffix
	lib:libglib_2.0$secondaryArchSuffix
	lib:libgobject_2.0$secondaryArchSuffix
	lib:libnice$secondaryArchSuffix
	lib:libsrtp2$secondaryArchSuffix
	lib:libssl$secondaryArchSuffix
	lib:libusrsctp$secondaryArchSuffix
	"

PROVIDES_devel="
	libdatachannel${secondaryArchSuffix}_devel = $portVersion
	devel:libdatachannel$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	libdatachannel$secondaryArchSuffix == $portVersion
	devel:libcrypto$secondaryArchSuffix
	devel:libnice$secondaryArchSuffix
	devel:libsrtp2$secondaryArchSuffix
	devel:libusrsctp$secondaryArchSuffix
	devel:plog$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libcrypto$secondaryArchSuffix >= 3
	devel:libnice$secondaryArchSuffix
	devel:libsrtp2$secondaryArchSuffix
	devel:libusrsctp$secondaryArchSuffix
	devel:nlohmann_json
	devel:plog$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	cmake -B build -S . -DCMAKE_BUILD_TYPE=Release $cmakeDirArgs \
		-DUSE_NICE=ON -DPREFER_SYSTEM_LIB=ON \
		-DNO_EXAMPLES=ON -DNO_TESTS=ON

	make -C build $jobArgs
}

INSTALL()
{
	make -C build install

	prepareInstalledDevelLib \
		libdatachannel

	packageEntries devel \
		$developDir \
		$libDir/cmake
}

TEST()
{
	# tests need to be enabled in BUILD

	build/tests || true # requires network and crashes
	build/benchmark || true # this one fails
}
