SUMMARY="A SSH/SFTP library based on libfilezilla"
DESCRIPTION="This library is free software, it is distributed under the terms and conditions of \
the GNU Affero General Public License v3+ with attribution, see the library's README file for \
details.

fzssh is a cross-platform library for all major operating systems, including but not limited to \
Linux, *BSD, macOS and Windows."
HOMEPAGE="https://fzssh.filezilla-project.org/"
COPYRIGHT="2025-2026 Tim Kosse"
LICENSE="GNU AGPL v3"
REVISION="1"
# Upstream download link became (purposely) unstable
# See https://trac.filezilla-project.org/ticket/13186
SOURCE_URI="https://sources.archlinux.org/other/packages/fzssh/fzssh-$portVersion.tar.xz"
CHECKSUM_SHA256="0c53178298364404e1fe4ce3d50267cf1238e52b414a6a53356bc43b37811338"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

libVersion="14.0.0"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

PROVIDES="
	fzssh$secondaryArchSuffix = $portVersion
	lib:libfzssh$secondaryArchSuffix = $libVersionCompat
	lib:libfzssh_client$secondaryArchSuffix = $libVersionCompat
	lib:libfzssh_crypt$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libargon2$secondaryArchSuffix
	lib:libfilezilla$secondaryArchSuffix
	lib:libgmp$secondaryArchSuffix
	lib:libhogweed$secondaryArchSuffix
	lib:libnettle$secondaryArchSuffix
	"

PROVIDES_devel="
	fzssh${secondaryArchSuffix}_devel = $portVersion
	devel:libfzssh$secondaryArchSuffix = $libVersionCompat
	devel:libfzssh_client$secondaryArchSuffix = $libVersionCompat
	devel:libfzssh_crypt$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	fzssh$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libargon2$secondaryArchSuffix
	devel:libfilezilla$secondaryArchSuffix
	devel:libgmp$secondaryArchSuffix
	devel:libiconv$secondaryArchSuffix
	devel:libnettle$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	cmd:meson
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	meson --buildtype=release build \
		--prefix=$prefix \
		--bindir=$commandBinDir \
		--datadir=$dataDir \
		--localedir=$dataDir/locale \
		--includedir=$includeDir \
		--libdir=$libDir

	ninja -C build $jobArgs
}

INSTALL()
{
	ninja -C build install

	mv $prefix/include/fzssh/version.hpp $includeDir/fzssh
	rm -rf $prefix/include

	prepareInstalledDevelLibs \
		libfzssh \
		libfzssh-client \
		libfzssh-crypt
	fixPkgconfig

	packageEntries devel \
		$developDir
}
