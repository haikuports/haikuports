From 97a869b2c04d7eb3260be27927b52734eebbc0f3 Mon Sep 17 00:00:00 2001
From: Jerome Duval <jerome.duval@gmail.com>
Date: Sat, 27 Mar 2021 14:01:44 +0100
Subject: Haiku v8 patches

Rebased onto V8 12.4 (Node v22.23.3): libbase sources, the toolchain clang
guard and the v8_fuzzers guard close moved to new anchors; the POSIX
ObtainCurrentThreadStackStart() exclusion moved with its #if.

platform-haiku.cc: ObtainCurrentThreadStackStart() now returns
thread_info.stack_end instead of stack_base. V8 expects the high address
of the stack, and the stack grows down on Haiku. The function also returns
nullptr when get_thread_info() fails.

diff --git a/deps/v8/BUILD.gn b/deps/v8/BUILD.gn
index 3929a9f9..bdb2fb94 100644
--- a/deps/v8/BUILD.gn
+++ b/deps/v8/BUILD.gn
@@ -477,7 +477,7 @@ if (v8_enable_snapshot_native_code_counters == "") {
 }
 if (v8_enable_pointer_compression == "") {
   v8_enable_pointer_compression =
-      v8_current_cpu == "arm64" || v8_current_cpu == "x64"
+      (v8_current_cpu == "arm64" || v8_current_cpu == "x64") && !is_haiku
 }
 
 # Toggle pointer compression for correctness fuzzing when building the
@@ -1500,7 +1500,7 @@ config("toolchain") {
     }
   }
 
-  if (is_clang) {
+  if (is_clang && !is_haiku) {
     cflags += [
       "-Wunreachable-code",
 
@@ -6520,6 +6520,11 @@ v8_component("v8_libbase") {
       "//third_party/fuchsia-sdk/sdk/pkg/component_incoming_cpp",
       "//third_party/fuchsia-sdk/sdk/pkg/zx",
     ]
+  } else if (is_haiku) {
+    sources += [
+      "src/base/debug/stack_trace_posix.cc",
+      "src/base/platform/platform-haiku.cc",
+    ]
   } else if (is_mac) {
     sources += [
       "src/base/debug/stack_trace_posix.cc",
@@ -7359,6 +7364,13 @@ if (is_fuchsia && !build_with_chromium) {
 
 group("v8_fuzzers") {
   testonly = true
+
+  if(host_os == "haiku"){
+    data_deps = []
+  }
+
+  if (host_os != "haiku") {
+
   data_deps = [
     ":v8_simple_inspector_fuzzer",
     ":v8_simple_json_fuzzer",
@@ -7378,6 +7390,7 @@ group("v8_fuzzers") {
       ":v8_simple_wasm_streaming_fuzzer",
     ]
   }
+  }
 }
 
 if (is_component_build) {
diff --git a/deps/v8/include/v8config.h b/deps/v8/include/v8config.h
