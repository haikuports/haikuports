From 79501dadd41444cf1b150fdeca4a479d5a3b7449 Mon Sep 17 00:00:00 2001
From: Augustin Cavalier <waddlesplash@gmail.com>
Date: Tue, 28 Jul 2026 18:01:16 -0400
Subject: Hacks to fix the build on Haiku with Clang.


diff --git a/Source/WTF/wtf/simdutf/simdutf_impl.cpp.h b/Source/WTF/wtf/simdutf/simdutf_impl.cpp.h
index 52fcda76..c798fffa 100644
--- a/Source/WTF/wtf/simdutf/simdutf_impl.cpp.h
+++ b/Source/WTF/wtf/simdutf/simdutf_impl.cpp.h
@@ -67190,7 +67190,7 @@ simdutf_warn_unused size_t implementation::binary_length_from_base64(
 
 #ifdef __has_include
   #if __has_include(<uchar.h>)
-    #include <uchar.h>
+    //#include <uchar.h>
   #else // __has_include(<uchar.h>)
     #define char16_t uint16_t
     #define char32_t uint32_t
diff --git a/Source/WebCore/CMakeLists.txt b/Source/WebCore/CMakeLists.txt
index 47d95f9c..3cf2eacc 100644
--- a/Source/WebCore/CMakeLists.txt
+++ b/Source/WebCore/CMakeLists.txt
@@ -3194,6 +3194,7 @@ WEBKIT_DEFINE_SUBTARGET_WITH_PREFIX(WebCore WebCoreJSBindings
     PREFIX WebCoreJSBindingsPrefix.h
     PREFIX_LANGUAGES CXX
     DIRS JSBindings bindings)
+if(FALSE) # Disabled for Haiku 32-bit, OOMs
 # WebCoreStyle takes precedence but only has a C++ prefix header. So, when a
 # folder appears in both WebCoreStyle and WebCoreDOMAndRendering, WebCoreStyle
 # claims its .cpp files and WebCoreDOMAndRendering claims its .mm files.
@@ -3208,6 +3209,7 @@ WEBKIT_DEFINE_SUBTARGET_WITH_PREFIX(WebCore WebCoreDOMAndRendering
     DIRS accessibility animation css cssjit dom domjit editing history html
          layout loader page plugins rendering storage style svg workers
          worklets xml)
+endif()
 WEBKIT_DEFINE_SUBTARGET_WITH_PREFIX(WebCore WebCoreInspector
     PREFIX WebCoreInspectorPrefix.h
     PREFIX_LANGUAGES CXX
diff --git a/Source/WebCore/Sources.txt b/Source/WebCore/Sources.txt
index 027cba6c..20421c4c 100644
--- a/Source/WebCore/Sources.txt
+++ b/Source/WebCore/Sources.txt
@@ -1299,7 +1299,7 @@ dom/DeviceOrientationAndMotionAccessController.cpp
 dom/DeviceOrientationController.cpp
 dom/DeviceOrientationData.cpp
 dom/DeviceOrientationEvent.cpp
-dom/Document.cpp @header:RenderStyleGetters @cost:22
+dom/Document.cpp @header:RenderStyleGetters @cost:22 @no-unify
 dom/DocumentFontLoader.cpp
 dom/DocumentFragment.cpp
 dom/DocumentFullscreen.cpp
diff --git a/Source/WebCore/platform/graphics/PlatformDisplay.cpp b/Source/WebCore/platform/graphics/PlatformDisplay.cpp
index 64150da3..7dec1359 100644
--- a/Source/WebCore/platform/graphics/PlatformDisplay.cpp
+++ b/Source/WebCore/platform/graphics/PlatformDisplay.cpp
@@ -40,6 +40,9 @@
 #if USE(LIBEPOXY)
 #include <epoxy/egl.h>
 #else
+#if PLATFORM(HAIKU)
+#define EGL_NO_X11
+#endif
 #include <EGL/egl.h>
 #include <EGL/eglext.h>
 #endif
diff --git a/Source/WebCore/platform/graphics/egl/GLContext.h b/Source/WebCore/platform/graphics/egl/GLContext.h
index 28829bd1..3073c41b 100644
--- a/Source/WebCore/platform/graphics/egl/GLContext.h
+++ b/Source/WebCore/platform/graphics/egl/GLContext.h
@@ -26,6 +26,9 @@
 #include <wtf/ThreadSafeWeakPtr.h>
 
 #if !PLATFORM(GTK) && !PLATFORM(WPE)
+#if PLATFORM(HAIKU)
+#define EGL_NO_X11
+#endif
 #include <EGL/eglplatform.h>
 typedef EGLNativeWindowType GLNativeWindowType;
 #else
diff --git a/Source/WebCore/rendering/haiku/RenderThemeHaiku.cpp b/Source/WebCore/rendering/haiku/RenderThemeHaiku.cpp
index 31bc2f41..436fb158 100644
--- a/Source/WebCore/rendering/haiku/RenderThemeHaiku.cpp
+++ b/Source/WebCore/rendering/haiku/RenderThemeHaiku.cpp
@@ -202,7 +202,7 @@ void RenderThemeHaiku::adjustMenuListButtonStyle(Style::ComputedStyle& style, co
     int labelSpacing = be_control_look ? static_cast<int>(be_control_look->DefaultLabelSpacing()) : 3;
     // Position the text correctly within the select box and make the box wide enough to fit the dropdown button
     style.setPaddingTop(WebCore::Style::PaddingEdge::Fixed { 3 } );
-    style.setPaddingLeft(WebCore::Style::PaddingEdge::Fixed { 3 + labelSpacing });
+    style.setPaddingLeft(WebCore::Style::PaddingEdge::Fixed { float(3 + labelSpacing) });
     style.setPaddingRight(WebCore::Style::PaddingEdge::Fixed { 22 });
     style.setPaddingBottom(WebCore::Style::PaddingEdge::Fixed {3 });
 
@@ -214,7 +214,7 @@ void RenderThemeHaiku::adjustMenuListButtonStyle(Style::ComputedStyle& style, co
     int minHeight = style.computedFontSize();
     minHeight = std::max(minHeight, menuListButtonMinHeight);
 
-    style.setMinHeight(WebCore::Style::MinimumSize::Fixed { minHeight });
+    style.setMinHeight(WebCore::Style::MinimumSize::Fixed { float(minHeight) });
 }
 
 void RenderThemeHaiku::paintMenuListButtonDecorations(const RenderBox& object, const PaintInfo& info, const FloatRect& floatRect)
diff --git a/Source/cmake/WebKitCompilerFlags.cmake b/Source/cmake/WebKitCompilerFlags.cmake
index 0793c789..65b9bf4b 100644
--- a/Source/cmake/WebKitCompilerFlags.cmake
+++ b/Source/cmake/WebKitCompilerFlags.cmake
@@ -370,7 +370,8 @@ endif ()
 
 if (COMPILER_IS_CLANG)
     foreach (_lang C CXX OBJC OBJCXX)
-        set(CMAKE_${_lang}_COMPILE_OPTIONS_INSTANTIATE_TEMPLATES_PCH -fpch-instantiate-templates)
+        # hack: disabled for Haiku, OOMs on 32-bit
+        set(CMAKE_${_lang}_COMPILE_OPTIONS_INSTANTIATE_TEMPLATES_PCH)
     endforeach ()
 endif ()
 
-- 
2.54.0

