SUMMARY="Set of clapper enhancers"
DESCRIPTION="Plugins enhancing Clapper library capabilities"
HOMEPAGE="https://github.com/Rafostar/clapper-enhancers/"
COPYRIGHT="2026 Rafał Dzięgiel"
LICENSE="GNU LGPL v2.1"
REVISION="1"
SOURCE_URI="https://github.com/Rafostar/clapper-enhancers/archive/refs/tags/$portVersion.tar.gz"
CHECKSUM_SHA256="54061d27e32b4529dba62f7dc81c72405388ad09a5b3d8d6860d69c7206bfd97"
SOURCE_DIR="clapper-enhancers-$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="?x86"

pythonVersion=3.14
pythonPackage=python${pythonVersion//.}

PROVIDES="
	clapper_enhancers$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libclapper_0.0$secondaryArchSuffix
	lib:libgio_2.0$secondaryArchSuffix
	lib:libglib_2.0$secondaryArchSuffix
	lib:libgobject_2.0$secondaryArchSuffix
	lib:libgstreamer_1.0$secondaryArchSuffix
	lib:libjson_glib_1.0$secondaryArchSuffix
	lib:libpeas_2$secondaryArchSuffix
	lib:libsoup_3.0$secondaryArchSuffix
	lib:libsqlite3$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libclapper_0.0$secondaryArchSuffix
	devel:libglib_2.0$secondaryArchSuffix
	devel:libgstreamer_1.0$secondaryArchSuffix
	devel:libgsttag_1.0$secondaryArchSuffix
	devel:libjson_glib_1.0$secondaryArchSuffix
	devel:libpeas_2$secondaryArchSuffix
	devel:libsoup_3.0$secondaryArchSuffix
	devel:libsqlite3$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	pygobject_$pythonPackage
	cmd:gcc$secondaryArchSuffix
	cmd:meson
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	cmd:python$pythonVersion
	"

BUILD()
{
	meson --buildtype=release build \
		--prefix=$prefix \
		--bindir=$commandBinDir \
		--includedir=$includeDir \
		--libdir=$libDir \
		-D enhancersdir=$libDir/clapper-0.0/enhancers

	ninja -C build
}

INSTALL()
{
	ninja -C build install
}
