@@ -593,7 +595,7 @@ static void GetTls(uptr *addr, uptr *size) {
   const uptr pre_tcb_size = TlsPreTcbSize();
   *addr = tp - pre_tcb_size;
   *size = g_tls_size + pre_tcb_size;
-#    elif SANITIZER_FREEBSD || SANITIZER_LINUX || SANITIZER_SOLARIS
