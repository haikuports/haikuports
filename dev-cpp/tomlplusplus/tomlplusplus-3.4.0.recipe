SUMMARY="Header-only TOML config file parser and serializer for C++17"
DESCRIPTION="toml++ Header-only TOML config file parser and serializer for C++17.
Features:
* Header-only (optional!)
* Module support
* Supports the latest TOML release (v1.0.0), plus optional support for some unreleased TOML \
features
* Passes all tests in the toml-test suite
* Supports serializing to JSON and YAML
* Proper UTF-8 handling (incl. BOM)
* C++17 (plus some C++20 features where available, e.g. experimental support for char8_t strings)
* Doesn't require RTTI
* Works with or without exceptions
* Tested on Clang (8+), GCC (8+) and MSVC (VS2019)
* Tested on x64, x86 and ARM"
HOMEPAGE="https://marzer.github.io/tomlplusplus/"
COPYRIGHT="2020-2023 Mark Gillard"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://github.com/marzer/tomlplusplus/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256="8517f65938a4faae9ccf8ebb36631a38c1cadfb5efa85d9a72e15b9e97d25155"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	tomlplusplus$secondaryArchSuffix = $portVersion
	devel:tomlplusplus$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	cmake -B build -S . -DCMAKE_BUILD_TYPE=Release \
		$cmakeDirArgs

	make -C build $jobArgs
}

INSTALL()
{
	make -C build install
}
