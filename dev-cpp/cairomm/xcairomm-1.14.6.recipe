SUMMARY="C++ interface for Cairo"
DESCRIPTION="a C++ wrapper for the cairo graphics library. It offers all the \
power of cairo with an interface familiar to C++ developers, including use of \
the Standard Template Library where it makes sense."
HOMEPAGE="https://www.cairographics.org/cairomm/"
COPYRIGHT="2006-2016 cairomm authors"
LICENSE="GNU LGPL v2"
REVISION="1"
SOURCE_URI="https://www.cairographics.org/releases/cairomm-$portVersion.tar.xz"
CHECKSUM_SHA256="7e0d5c7f29175d573a03ab5c45aef63f48dd91a5caf335a404cd763e4b7cea4a"
SOURCE_DIR="cairomm-$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

# This recipe MUST be kept in sync with cairomm!

libVersion="1.4.0"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"
apiVersion="1.0"

PROVIDES="
	xcairomm$secondaryArchSuffix = $portVersion
	lib:libcairomm_$apiVersion$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	xcairo$secondaryArchSuffix
	lib:libsigc_2.0$secondaryArchSuffix
	"
CONFLICTS="
	cairomm$secondaryArchSuffix
	"

PROVIDES_devel="
	xcairomm${secondaryArchSuffix}_devel = $portVersion
	devel:libcairomm_$apiVersion$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	xcairomm$secondaryArchSuffix == $portVersion base
	xcairo${secondaryArchSuffix}_devel
	devel:libsigc_2.0$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	xcairo${secondaryArchSuffix}_devel
#	devel:libboost_filesystem$secondaryArchSuffix >= 1.90.0 # tests
	devel:libsigc_2.0$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	cmd:meson
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	"

defineDebugInfoPackage xcairomm$secondaryArchSuffix \
	"$libDir"/libcairomm-$apiVersion.so.$libVersion

BUILD()
{
	meson build \
		--buildtype=debugoptimized \
		--prefix=$prefix \
		--bindir=$binDir \
		--datadir=$dataDir \
		--includedir=$includeDir \
		--libdir=$libDir \
		-D maintainer-mode=false \
		-D build-tests=false

	ninja $jobArgs -C build
}

INSTALL()
{
	ninja -C build install

	# remove libtool file
	rm -rf $libDir/*.la

	mv $libDir/cairomm-$apiVersion/include/*.h $includeDir/cairomm-$apiVersion
	rm -rf $libDir/cairomm-$apiVersion

	prepareInstalledDevelLib \
		libcairomm-$apiVersion
	fixPkgconfig

	sed -i -e 's| -I${libdir}/cairomm-'${apiVersion}'/include||' \
		$developLibDir/pkgconfig/cairomm-$apiVersion.pc

	packageEntries devel \
		$developDir
}

TEST()
{
	ninja -C build test
}
