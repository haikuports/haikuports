From 59849b329b9e7e98d187cc35878df81f197abe13 Mon Sep 17 00:00:00 2001
From: Chris Roberts <cpr420@gmail.com>
Date: Thu, 29 Oct 2026 20:30:13 -0600
Subject: link against libnetwork for socketpair() on Haiku


diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index ac211d3..18cd1dc 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -189,6 +189,10 @@ add_custom_target(confclean
 set(QT_LIBRARIES Qt6::Widgets Qt6::Help Qt6::Network Qt6::Core)
 target_link_libraries(${APPLICATION_NAME} PRIVATE ${QT_LIBRARIES})
 
+if(HAIKU)
+    target_link_libraries(${APPLICATION_NAME} PRIVATE network)
+endif()
+
 if(BUILD_TESTING)
     enable_testing()
 
