SUMMARY="Control the ThinkPad ThinkLight from the command line"
DESCRIPTION="thinklight turns the ThinkLight (the small lamp above the display \
of many ThinkPad laptops) on and off, and can blink it with a simple pattern \
such as -64_12-8_1: light on for 64 ticks, off for 12, on for 8, off for 1, \
where one tick is 1/16 of a second.

It talks to the ACPI firmware through the /dev/acpi/call device of Haiku, so \
no driver is needed. It has been tested on a ThinkPad T60 only."
HOMEPAGE="https://github.com/discotag/thinklight"
COPYRIGHT="2026 discotag"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://github.com/discotag/thinklight/archive/refs/tags/v$portVersion.tar.gz"
SOURCE_FILENAME="thinklight-$portVersion.tar.gz"
CHECKSUM_SHA256="a56a9a08ce658b5dff6338a6021613533f498d04653edc3a1d1b24c1c549eaa3"
SOURCE_DIR="thinklight-$portVersion"

ARCHITECTURES="x86_64 !x86_gcc2"
SECONDARY_ARCHITECTURE="x86"
PROVIDES="
	thinklight = $portVersion
	cmd:thinklight = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku_devel
	"
BUILD_PREREQUIRES="
	cmd:g++
	cmd:gcc
	"

BUILD()
{
	g++ -Wno-multichar -O2 -o thinklight thinklight.cpp
}

INSTALL()
{
	mkdir -p $binDir
	cp thinklight $binDir
}
