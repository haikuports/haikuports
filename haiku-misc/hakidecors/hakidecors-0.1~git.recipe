SUMMARY="Haki Decorators Pack for Haiku"
DESCRIPTION="A pack of window decoratos for Haiku"
HOMEPAGE="https://github.com/s40in/HakiDecors"
COPYRIGHT="2019, Sergei Sorokin (s40in)"
LICENSE="MIT"
REVISION="1"
srcGitRev="4a939d5047d052856d8e6a2b38d07c299b2d2f46"
SOURCE_URI="https://github.com/s40in/HakiDecors/archive/$srcGitRev.tar.gz"
CHECKSUM_SHA256="ec41d6d5774b6b3308dd4c2ccc6c312c8b795801ccb650a6fb1e13dc6fc4fdaf"
SOURCE_FILENAME="HakiDecors-$srcGitRev.tar.gz"
SOURCE_DIR="HakiDecors-$srcGitRev"
PATCHES="$portBaseName-$portVersion.patchset"

# Marking this recipe as "untested/disabled" because it relies on having a 'haiku_source' which
# cannot be obtained via pkgman (and thus not usable from the HaikuPorts builders).
#
# Still buildable, locally. One needs to:
#
# - Create a haiku_source package ("jam haiku_source.hpkg" from the # Haiku's git repo)
# - Manually copy it under your HaikuPorts $PACKAGES_PATH (eg; "/Data/haikuports/packages/")
# - Use "ALLOW_UNTESTED=yes" on one's haikuports.conf file.
ARCHITECTURES="?all"

PROVIDES="
	hakidecors = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	haiku_source
	devel:libfreetype
	"
BUILD_PREREQUIRES="
	makefile_engine
	cmd:find
	cmd:gcc
	cmd:make
	"

BUILD()
{
	make $jobArgs OBJ_DIR=objects
}

INSTALL()
{
	mkdir -p $addOnsDir/decorators
	find Haki* -executable -type f -exec cp {} $addOnsDir/decorators \;
}
