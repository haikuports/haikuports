SUMMARY="A virtual layer that helps you improve privacy and anonymity"
DESCRIPTION="Tor is a network of virtual tunnels that allows people and groups to improve \
their privacy and security on the Internet. It can be used as a client, or run as a relay \
to help the Tor network."
HOMEPAGE="https://www.torproject.org/"
COPYRIGHT="2007-2026 The Tor Project, Inc.
	2004-2006 Nick Mathewson
	2001-2006 Roger Dingledine"
LICENSE="Tor"
REVISION="2"
SOURCE_URI="https://dist.torproject.org/tor-$portVersion.tar.gz"
CHECKSUM_SHA256="ff372c41ee7013557fe5b7acd96c909950b27a7959c59fcb87c02591682fabe2"
PATCHES="
	tor-$portVersion.patchset
	"

ARCHITECTURES="all !x86_gcc2"
if [ "$targetArchitecture" = x86_gcc2 ]; then
	SECONDARY_ARCHITECTURES="x86"
fi

commandBinDir=$binDir
if [ "$targetArchitecture" = x86_gcc2 ]; then
	commandBinDir=$prefix/bin
fi

GLOBAL_WRITABLE_FILES="
	settings/tor/torrc.sample auto-merge
	"
USER_SETTINGS_FILES="
	settings/tor directory
	"

PROVIDES="
	tor$secondaryArchSuffix = $portVersion
	cmd:tor
	cmd:tor_gencert
	cmd:tor_print_ed_signing_cert
	cmd:tor_resolve
	cmd:torify
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libcrypto$secondaryArchSuffix
	lib:libexecinfo$secondaryArchSuffix
	lib:libevent_2.1$secondaryArchSuffix
	lib:liblzma$secondaryArchSuffix
	lib:libssl$secondaryArchSuffix
	lib:libssp$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	lib:libzstd$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libexecinfo$secondaryArchSuffix
	devel:libevent_2.1$secondaryArchSuffix
	devel:liblzma$secondaryArchSuffix
	devel:libssl$secondaryArchSuffix >= 3
	devel:libssp$secondaryArchSuffix
	devel:libssp_nonshared$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	devel:libzstd$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:aclocal
	cmd:autoreconf
	cmd:automake
	cmd:gcc$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

TEST_REQUIRES="
	cmd:perl
	cmd:python3
	"

defineDebugInfoPackage tor$secondaryArchSuffix \
	"$commandBinDir"/tor \
	"$commandBinDir"/tor-gencert \
	"$commandBinDir"/tor-resolve

BUILD()
{
	export CPPFLAGS="-D_BSD_SOURCE -DB_USE_POSITIVE_POSIX_ERRORS"
	export LDFLAGS="-lbsd"
	export LIBS="-lssp -lposix_error_mapper"

	autoreconf -vfi

	runConfigure --omit-dirs "binDir" ./configure \
			--bindir="$commandBinDir" \
			--disable-asciidoc \
			--disable-dependency-tracking \
			--enable-lzma \
			--enable-zstd

	make $jobArgs
}

INSTALL()
{
	make install
}

# For reference, results on hrev59866+101 64 bits:
# TOTAL: 34 - PASS: 28 - SKIP: 3 - FAIL: 3
TEST()
{
	make $jobArgs check
}
