SUMMARY="A virtual layer that helps you improve privacy and anonymity"
DESCRIPTION="Tor is a network of virtual tunnels that allows people and groups to improve \
their privacy and security on the Internet. It also enables software \
developers to create new communication tools with built-in privacy features. \
Tor provides the foundation for a range of applications that allow \
organizations and individuals to share information over public networks \
without compromising their privacy.

Using tor as a client:

By default, tor runs as a client and provides a SOCKS proxy on 127.0.0.1, port 9050. \
To start it at boot, create a file named \"~/config/settings/tor_proxy_autostart\".

For web browsing on 64-bit Haiku, install the tor_browser package. Tor Browser runs its \
own copy of tor from this package, and is designed to make all its users look the same.

Other browsers can be set to use the SOCKS proxy as shown below, but they do not get Tor \
Browser's protections: they can leak your real IP address (for example through DNS or \
WebRTC), and can be fingerprinted. The Tor Project strongly recommends against using \
other browsers with Tor, see https://support.torproject.org/tbb/tbb-9/

- WebPositive: You'll need to call it from Terminal (or a script) like this:
  all_proxy=socks5h://127.0.0.1:9050 WebPositive

- Firefox based browsers: in 'Proxy settings' switch to 'Manual proxy configuration', and set as:
  SOCKS server: 127.0.0.1, port 9050, SOCKS v5.
  And make sure to also check 'Proxy DNS when using SOCKS v5'."
HOMEPAGE="https://www.torproject.org/"
COPYRIGHT="2007-2026 The Tor Project, Inc.
	2004-2006 Nick Mathewson
	2001-2006 Roger Dingledine"
LICENSE="Tor"
REVISION="2"
SOURCE_URI="https://dist.torproject.org/tor-$portVersion.tar.gz"
CHECKSUM_SHA256="ff372c41ee7013557fe5b7acd96c909950b27a7959c59fcb87c02591682fabe2"
PATCHES="
	tor-$portVersion.patchset
	"

ARCHITECTURES="all !x86_gcc2"
if [ "$targetArchitecture" = x86_gcc2 ]; then
	SECONDARY_ARCHITECTURES="x86"
fi

commandBinDir=$binDir
if [ "$targetArchitecture" = x86_gcc2 ]; then
	commandBinDir=$prefix/bin
fi

GLOBAL_WRITABLE_FILES="
	settings/tor/torrc.sample auto-merge
	"
USER_SETTINGS_FILES="
	settings/tor directory
	"

PROVIDES="
	tor$secondaryArchSuffix = $portVersion
	cmd:tor
	cmd:tor_gencert
	cmd:tor_print_ed_signing_cert
	cmd:tor_resolve
	cmd:torify
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libcrypto$secondaryArchSuffix
	lib:libexecinfo$secondaryArchSuffix
	lib:libevent_2.1$secondaryArchSuffix
	lib:liblzma$secondaryArchSuffix
	lib:libssl$secondaryArchSuffix
	lib:libssp$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	lib:libzstd$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libexecinfo$secondaryArchSuffix
	devel:libevent_2.1$secondaryArchSuffix
	devel:liblzma$secondaryArchSuffix
	devel:libssl$secondaryArchSuffix >= 3
	devel:libssp$secondaryArchSuffix
	devel:libssp_nonshared$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	devel:libzstd$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:aclocal
	cmd:autoreconf
	cmd:automake
	cmd:gcc$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

TEST_REQUIRES="
	cmd:perl
	cmd:python3
	"

defineDebugInfoPackage tor$secondaryArchSuffix \
	"$commandBinDir"/tor \
	"$commandBinDir"/tor-gencert \
	"$commandBinDir"/tor-resolve

BUILD()
{
	export CPPFLAGS="-D_BSD_SOURCE -DB_USE_POSITIVE_POSIX_ERRORS"
	export LDFLAGS="-lbsd"
	export LIBS="-lssp -lposix_error_mapper"

	autoreconf -vfi

	runConfigure --omit-dirs "binDir" ./configure \
			--bindir="$commandBinDir" \
			--disable-asciidoc \
			--disable-dependency-tracking \
			--enable-lzma \
			--enable-zstd

	make $jobArgs
}

INSTALL()
{
	make install

	# Install a "tor proxy service". It will only autostart at boot if the user creates a
	# "~/config/settings/tor_proxy_autostart" file.

	mkdir -p $dataDir/user_launch

	echo "target desktop {
	service tor_proxy {
		launch /bin/tor
		if file_exists ~/config/settings/tor_proxy_autostart
		no_safemode
		legacy
		initial_volumes_mounted
	}
}
" > $dataDir/user_launch/tor_proxy
}

# For reference, results on hrev59866+101 64 bits:
# TOTAL: 34 - PASS: 28 - SKIP: 3 - FAIL: 3
TEST()
{
	make $jobArgs check
}
