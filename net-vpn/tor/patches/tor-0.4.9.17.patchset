From 5a11b083a6818bbd488123b1076532c6fb0d5015 Mon Sep 17 00:00:00 2001
From: Ali Raheem <ClaireNET@shoryuken.me>
Date: Fri, 20 Nov 2026 13:06:51 +0000
Subject: [PATCH 1/3] Haiku: define IFF_RUNNING as IFF_LINK

---
 src/lib/net/address.c   | 4 ++++
 src/test/test_address.c | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/src/lib/net/address.c b/src/lib/net/address.c
index a5452dc..c99d759 100644
--- a/src/lib/net/address.c
+++ b/src/lib/net/address.c
@@ -93,6 +93,10 @@
 #include <stdlib.h>
 #include <string.h>
 
+#ifndef IFF_RUNNING
+#define IFF_RUNNING IFF_LINK
+#endif
+
 /* tor_addr_is_null() and maybe other functions rely on AF_UNSPEC being 0 to
  * work correctly. Bail out here if we've found a platform where AF_UNSPEC
  * isn't 0. */
diff --git a/src/test/test_address.c b/src/test/test_address.c
index 2a0e41d..ccd3f06 100644
--- a/src/test/test_address.c
+++ b/src/test/test_address.c
@@ -33,6 +33,10 @@
 #include "test/test.h"
 #include "test/log_test_helpers.h"
 
+#ifndef IFF_RUNNING
+#define IFF_RUNNING IFF_LINK
+#endif
+
 /** Return 1 iff <b>sockaddr1</b> and <b>sockaddr2</b> represent
  * the same IP address and port combination. Otherwise, return 0.
  */
-- 
2.56.0


From 70ad4a2d69f4371eda9c48f5ecee5cf39bcb66db Mon Sep 17 00:00:00 2001
From: Ali Raheem <ClaireNET@shoryuken.me>
Date: Fri, 20 Nov 2026 13:11:25 +0000
Subject: [PATCH 2/3] Haiku: only trap SIGIO where it exists

---
 src/lib/err/backtrace.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/lib/err/backtrace.c b/src/lib/err/backtrace.c
index 9987a51..b78947e 100644
--- a/src/lib/err/backtrace.c
+++ b/src/lib/err/backtrace.c
@@ -227,7 +227,10 @@ dump_stack_symbols_to_error_fds(void)
 
 /* The signals that we want our backtrace handler to trap */
 static int trap_signals[] = { SIGSEGV, SIGILL, SIGFPE, SIGBUS, SIGSYS,
-  SIGIO, -1 };
+#ifdef SIGIO
+  SIGIO,
+#endif
+  -1 };
 
 /** Install signal handlers as needed so that when we crash, we produce a
  * useful stack trace. Return 0 on success, -errno on failure. */
-- 
2.56.0


From d3f4d99f22c6ab89596dc403de390e710b88734b Mon Sep 17 00:00:00 2001
From: Ali Raheem <ClaireNET@shoryuken.me>
Date: Fri, 20 Nov 2026 22:28:11 +0000
Subject: [PATCH 3/3] Haiku: skip crashing backtrace tests

abort() hands the team to debug_server, which waits for the user, so
test-bt-cl assert and crash never exit and make check hangs.
---
 src/test/test_bt.sh | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/test/test_bt.sh b/src/test/test_bt.sh
index 312905a..5280db2 100755
--- a/src/test/test_bt.sh
+++ b/src/test/test_bt.sh
@@ -5,6 +5,15 @@ exitcode=0
 
 export ASAN_OPTIONS="handle_segv=0:allow_user_segv_handler=1"
 "${builddir:-.}/src/test/test-bt-cl" backtraces || exit $?
+
+# On Haiku, abort() hands the team to debug_server, which waits for the
+# user instead of letting it exit, so the assert and crash cases hang.
+if [ "$(uname -s)" = "Haiku" ]; then
+  echo "Skipping assert and crash backtrace tests on Haiku"
+  "${builddir:-.}/src/test/test-bt-cl" none || exitcode="$?"
+  exit ${exitcode}
+fi
+
 "${builddir:-.}/src/test/test-bt-cl" assert 2>&1 | "${PYTHON:-python}" "${abs_top_srcdir:-.}/src/test/bt_test.py" || exitcode="$?"
 "${builddir:-.}/src/test/test-bt-cl" crash  2>&1 | "${PYTHON:-python}" "${abs_top_srcdir:-.}/src/test/bt_test.py" || exitcode="$?"
 
-- 
2.56.0

