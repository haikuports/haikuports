SUMMARY="Makes it easy to build C++ projects, everywhere"
DESCRIPTION="You name your executables and libraries and list their sources. \
Boost.Build takes care about compiling your sources with right options, \
creating static and shared libraries, making executables, and other chores — \
whether you're using gcc, msvc, or a dozen more supported C++ compilers — on \
Windows, OSX, Linux and commercial UNIX systems."
HOMEPAGE="https://www.boost.org/build/index.html"
COPYRIGHT="2006, 2014 Vladimir Prus
	2018-2025 René Ferdinand Rivera Morell"
LICENSE="Boost v1.0"
REVISION="1"
SOURCE_URI="https://github.com/bfgroup/b2/releases/download/$portVersion/b2-$portVersion.tar.bz2"
CHECKSUM_SHA256="d3b914917f8ccf615ee7ec78e59b96c7b49c39f551d5b73525871b2f44cf70d5"
PATCHES="b2-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	b2$secondaryArchSuffix
	cmd:b2
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

REPLACES="
	boost_build$secondaryArchSuffix
	"
if [ "$targetArchitecture" == x86_gcc2 ]; then
	REPLACES+="
		boost_build
		"
fi

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	"

TEST_REQUIRES="
	cmd:python3
	"

BUILD()
{
	export LIBS=-lbsd
	sh bootstrap.sh
}

INSTALL()
{
	runConfigure --omit-dirs "binDir" ./b2 install
}

TEST()
{
	python3 test/test_all.py
}
