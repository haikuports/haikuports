SUMMARY="A software construction tool"
DESCRIPTION="SCons is an open-source software construction tool - that is, a \
next-generation build tool. Think of SCons as an improved, cross-platform \
substitute for the classic Make utility with integrated functionality similar \
to autoconf/automake and compiler caches such as ccache. In short, SCons is an \
easier, more reliable and faster way to build software."
HOMEPAGE="https://www.scons.org/"
COPYRIGHT="2001-2026 The SCons Foundation"
LICENSE="MIT"
REVISION="1"
# If the patchset ever gets upstreamed, we could just switch to repackaging
# the scons .whl from pypy.org.
SOURCE_URI="https://github.com/scons/scons/archive/$portVersion.tar.gz"
CHECKSUM_SHA256="9087b5068572e9e4d9347c987e3fa5ab0edf3fa84935f7ac5c0508792bb7a776"
SOURCE_FILENAME="scons-$portVersion.tar.gz"
PATCHES="scons-$portVersion.patchset"

pythonVersion=3.14
python=python$pythonVersion
pythonPackage=python$pythonVersion

ARCHITECTURES="any"

PROVIDES="
	scons = $portVersion compat >= 3
	cmd:scons = $portVersion compat >= 3
	cmd:scons_configure_cache = $portVersion compat >= 3
	cmd:sconsign = $portVersion compat >= 3
	"
REQUIRES="
	haiku
	cmd:$python
	"

BUILD_REQUIRES="
	haiku_devel
	build_$pythonPackage
	installer_$pythonPackage
	setuptools_$pythonPackage
	"
BUILD_PREREQUIRES="
	cmd:python$pythonVersion
	"

TEST_REQUIRES="
	cmd:gcc
	cmd:$python
	"

BUILD()
{
	$python -m build --wheel --skip-dependency-check --no-isolation
}

INSTALL()
{
	$python -m installer --p $prefix dist/$portName-$portVersion-py3-none-any.whl
}


# For reference, test results on hrev59866+79 (beta6) x86-32:
# Summary: 1305 selected, 18 failed, 319 no result, total execution time 384.6 seconds
#
# Failed the following 18 tests:
#
# test/CC/SHCCFLAGS-live.py
# test/CC/SHCFLAGS-live.py
# test/CXX/CXXFLAGS-live.py
# test/CXX/SHCCFLAGS-live.py
# test/CXX/SHCXXFLAGS-live.py
# test/Errors/permission-denied.py
# test/KeyboardInterrupt.py
# test/LINK/VersionedLib-VariantDir.py
# test/LINK/VersionedLib-j2.py
# test/LINK/VersionedLib-subdir.py
# test/Libs/SharedLibrary.py
# test/NodeOps.py
# test/Repository/SharedLibrary.py
# test/option/debug-json.py
# test/option/option--duplicate.py
# test/option/stack-size.py
# test/scons-time/run/option/verbose.py
# test/sconsign/script/bad.py

# On hrev59866+79 (beta6) x86-64:
# Summary: 1305 selected, 17 failed, 319 no result, total execution time 412.3 seconds
# same list of faied as on 32 bits, but "test/option/stack-size.py" passed.
TEST()
{
	# for testing purposes, specially since the recipe is "any" but calls compilers
	if [ $targetArchitecture == x86_gcc2 ]; then
		# Helps "fix" tests:
		# test/CPPPATH/match-dir.py
		# test/CPPPATH/subdir-as-include.py
		# test/Libs/LIBLITERALPREFIX.py
		export HAIKU_SECONDARY_ARCH=x86
	fi

	# On repeated test-runs, just run the test that failed in the previous one.
	if [ -e failed_tests.log ]; then
		echo "HaikuPorter: running --test in 'retry' mode (runs only failed tests)."
		$python ./runtest.py $jobArgs -t --retry --output hp-test.log
	else
		$python ./runtest.py $jobArgs -a -t --output hp-test.log
	fi
}
