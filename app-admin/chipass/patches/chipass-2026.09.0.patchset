From e5359fa55219295803b4fa55fb34aaf2c7e9ce7f Mon Sep 17 00:00:00 2001
From: pandora <pandora@soulpheonix.org>
Date: Tue, 9 Jun 2026 08:25:50 +0200
Subject: cmake: fix build for Haiku OS


diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 8352072..cce49bd 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -108,6 +108,13 @@ elseif (FREEDESKTOP)
     $<$<BOOL:${CHIPASS_ENABLE_DESKTOP_X11}>:X11::X11>
     $<$<BOOL:${CHIPASS_ENABLE_DESKTOP_X11}>:X11::Xtst>
   )
+
+  if (HAIKU)
+    target_link_libraries(ChiPass_common INTERFACE
+      # Haiku implements the symbols in `socket.h` in libnetwork, not libc
+      network
+    )
+  endif()
 elseif (WIN32)
   target_link_libraries(ChiPass_common INTERFACE
     Qt6::GuiPrivate
-- 
2.56.0


From 1b36aedaf8d9e21528a109ed52e29a586489b4df Mon Sep 17 00:00:00 2001
From: zeldakatze <mail@zeldakatze.de>
Date: Sun, 25 Oct 2026 17:43:02 +0000
Subject: fix build on 32 bit


diff --git a/src/format/KdbxXmlReader.cpp b/src/format/KdbxXmlReader.cpp
index 82b9e3b..d174359 100644
--- a/src/format/KdbxXmlReader.cpp
+++ b/src/format/KdbxXmlReader.cpp
@@ -119,11 +119,11 @@ void KdbxXmlReader::readDatabase(QIODevice* device, Database* db, KeePass2Random
     }
 
     if (!m_tmpParent->children().isEmpty()) {
-        qWarning("KdbxXmlReader::readDatabase: found %lld invalid group reference(s)", m_tmpParent->children().size());
+        qWarning("KdbxXmlReader::readDatabase: found %" PRIdQSIZETYPE " invalid group reference(s)", m_tmpParent->children().size());
     }
 
     if (!m_tmpParent->entries().isEmpty()) {
-        qWarning("KdbxXmlReader::readDatabase: found %lld invalid entry reference(s)", m_tmpParent->children().size());
+        qWarning("KdbxXmlReader::readDatabase: found %" PRIdQSIZETYPE " invalid entry reference(s)", m_tmpParent->children().size());
     }
 
     const QSet<QString> poolKeys = Tools::asSet(m_binaryPool.keys());
-- 
2.56.0

