From 437447f6ae343ae655f94af274e2e20d4e6ff72c Mon Sep 17 00:00:00 2001
From: pandora <pandora@soulpheonix.org>
Date: Tue, 9 Jun 2026 08:25:50 +0200
Subject: cmake: fix build for Haiku OS


diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 8352072..cce49bd 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -108,6 +108,13 @@ elseif (FREEDESKTOP)
     $<$<BOOL:${CHIPASS_ENABLE_DESKTOP_X11}>:X11::X11>
     $<$<BOOL:${CHIPASS_ENABLE_DESKTOP_X11}>:X11::Xtst>
   )
+
+  if (HAIKU)
+    target_link_libraries(ChiPass_common INTERFACE
+      # Haiku implements the symbols in `socket.h` in libnetwork, not libc
+      network
+    )
+  endif()
 elseif (WIN32)
   target_link_libraries(ChiPass_common INTERFACE
     Qt6::GuiPrivate
-- 
2.56.0


From bd50268732784c23bface684842effa97f603f9f Mon Sep 17 00:00:00 2001
From: zeldakatze <mail@zeldakatze.de>
Date: Sun, 25 Oct 2026 17:43:02 +0000
Subject: fix build on 32 bit


diff --git a/src/format/KdbxXmlReader.cpp b/src/format/KdbxXmlReader.cpp
index 82b9e3b..d174359 100644
--- a/src/format/KdbxXmlReader.cpp
+++ b/src/format/KdbxXmlReader.cpp
@@ -119,11 +119,11 @@ void KdbxXmlReader::readDatabase(QIODevice* device, Database* db, KeePass2Random
     }
 
     if (!m_tmpParent->children().isEmpty()) {
-        qWarning("KdbxXmlReader::readDatabase: found %lld invalid group reference(s)", m_tmpParent->children().size());
+        qWarning("KdbxXmlReader::readDatabase: found %" PRIdQSIZETYPE " invalid group reference(s)", m_tmpParent->children().size());
     }
 
     if (!m_tmpParent->entries().isEmpty()) {
-        qWarning("KdbxXmlReader::readDatabase: found %lld invalid entry reference(s)", m_tmpParent->children().size());
+        qWarning("KdbxXmlReader::readDatabase: found %" PRIdQSIZETYPE " invalid entry reference(s)", m_tmpParent->children().size());
     }
 
     const QSet<QString> poolKeys = Tools::asSet(m_binaryPool.keys());
-- 
2.56.0


From 92a1a83560c236b591136d809f9b8695e380c644 Mon Sep 17 00:00:00 2001
From: zeldakatze <mail@zeldakatze.de>
Date: Wed, 4 Nov 2026 20:11:13 +0000
Subject: fix traybar icon


diff --git a/src/gui/Icons.cpp b/src/gui/Icons.cpp
index 7d92183..9e21be2 100644
--- a/src/gui/Icons.cpp
+++ b/src/gui/Icons.cpp
@@ -56,7 +56,11 @@ Icons::Icons()
 
 QString Icons::applicationIconName()
 {
+	#if defined(Q_OS_WIN) || defined(Q_OS_MACOS) || defined(Q_OS_HAIKU)
+	return QString("chipass");
+	#else
     return QString("org.chipass.ChiPass-chipass");
+    #endif
 }
 
 QIcon Icons::applicationIcon()
-- 
2.56.0


From 00331ea8f854ceac4bd7adf855a5332537b72a32 Mon Sep 17 00:00:00 2001
From: Humdinger <humdinger@mailbox.org>
Date: Tue, 10 Nov 2026 17:00:31 +0100
Subject: Use Haiku's fallback icon theme

as suggested by Begasus.

diff --git a/src/gui/Icons.cpp b/src/gui/Icons.cpp
index 9e21be2..2e82b40 100644
--- a/src/gui/Icons.cpp
+++ b/src/gui/Icons.cpp
@@ -184,11 +184,16 @@ QIcon Icons::icon(const QString& name, bool recolor, const QColor& overrideColor
         return icon;
     }
 
+#ifdef Q_OS_HAIKU
+    QIcon::setFallbackThemeName("haiku");
+    icon = QIcon::fromTheme(name);
+#else
     icon = QIcon::fromTheme(name);
     if (recolor) {
         icon = QIcon(new AdaptiveIconEngine(icon, overrideColor));
         icon.setIsMask(true);
     }
+#endif
 
     m_iconCache.insert(cacheName, icon);
     return icon;
-- 
2.56.0

