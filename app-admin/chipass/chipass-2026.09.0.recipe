	Nokia LGPL Exception
	SIL Open Font License v1.1
	"
REVISION="1"
SOURCE_URI="https://codeberg.org/ChiPass/ChiPass/archive/v2026.09.0.tar.gz"
CHECKSUM_SHA256="d3efc634c2dfdd4389ba74424ef4732a49f0a317ad94f8439bf2edf95f9f3454"
SOURCE_DIR="chipass"
PATCHES="chipass-${portVersion}.patchset"
ADDITIONAL_FILES="chipass.rdef.in"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

#GLOBAL_WRITABLE_FILES
#USER_SETTINGS_FILES

PROVIDES="
	chipass$secondaryArchSuffix = $portVersion
	app:ChiPass = $portVersion
	cmd:chipass_cli$secondaryArchSuffix
	cmd:chipass_proxy$secondaryArchSuffix
	"
REQUIRES="
	haiku$secondaryArchSuffix
	qt6_tools${secondaryArchSuffix}
	qt6_translations$secondaryArchSuffix
	lib:libargon2$secondaryArchSuffix
	lib:libbotan_2$secondaryArchSuffix
	lib:libGL$secondaryArchSuffix
	lib:libminizip$secondaryArchSuffix
	lib:libpcsclite$secondaryArchSuffix
	lib:libqrencode$secondaryArchSuffix
	lib:libQt6Core$secondaryArchSuffix
	lib:libQt6Core5Compat$secondaryArchSuffix
	lib:libQt6Svg$secondaryArchSuffix
	lib:libusb_1.0$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	qt6_tools${secondaryArchSuffix}_devel
	qt6_translations$secondaryArchSuffix
	devel:libappstream$secondaryArchSuffix
	devel:libargon2$secondaryArchSuffix
	devel:libbotan_2$secondaryArchSuffix
	devel:libGL$secondaryArchSuffix
	devel:libminizip$secondaryArchSuffix
	devel:libpcsclite$secondaryArchSuffix
	devel:libqrencode$secondaryArchSuffix
	devel:libQt6Core$secondaryArchSuffix
	devel:libQt6Core5Compat$secondaryArchSuffix
	devel:libQt6Svg$secondaryArchSuffix
	devel:libreadline$secondaryArchSuffix
	devel:libusb_1.0$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:clang_format
	cmd:gcc$secondaryArchSuffix
	cmd:g++$secondaryArchSuffix
	cmd:git
	cmd:linguist6$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

defineDebugInfoPackage chipass$secondaryArchSuffix \
	$appsDir/"ChiPass" \
	$binDir/"ChiPass-cli" \
	$binDir/"ChiPass-proxy"

BUILD()
{
	mkdir -p $binDir
	mkdir -p $dataDir/ChiPass

	cmake -Bbuild \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_BINDIR=$binDir \
		-DCMAKE_INSTALL_DATADIR=$dataDir \
		-DCHIPASS_INSTALL_DATADIR=$dataDir/ChiPass \
		-DCHIPASS_WITH_UPDATE_CHECK=false
	make $jobArgs -C build
}

INSTALL()
{
	mkdir -p $appsDir
	make -C build install

	mv $binDir/ChiPass $appsDir/ChiPass

	local MAJOR="`echo "$portVersion" | cut -d. -f1`"
	local MIDDLE="`echo "$portVersion" | cut -d. -f2`"
	local MINOR="`echo "$portVersion" | cut -d. -f3`"
	local LONG_INFO="$SUMMARY"
	sed \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/chipass.rdef.in > chipass.rdef

	addResourcesToBinaries chipass.rdef $appsDir/ChiPass
	addAppDeskbarSymlink $appsDir/ChiPass
}

TEST()
{
	make -C build test ARGS+="$jobArgs --output-on-failure"
}
