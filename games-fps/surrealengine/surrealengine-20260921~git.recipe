SUMMARY="Unreal Engine 1 reimplementation"
DESCRIPTION="Surreal Engine is a project that aims to reimplement Unreal Engine 1.

It's currently focused on making Unreal (Gold) and Unreal Tournament (UT99) playable. The scope \
of this project might expand to cover more UE1 games in the future."
HOMEPAGE="https://github.com/dpjudas/SurrealEngine"
COPYRIGHT="2021-2026 Magnus Norddahl, Lupert Everett and contributors"
LICENSE="LibPNG
	GNU LGPL v2.1
	BSD (3-clause)
	MIT
	"
REVISION="1"
srcGitRev="42b0d647819593cc4b7ca0821aecafcf7914b2b3"
SOURCE_URI="https://github.com/dpjudas/SurrealEngine/archive/$srcGitRev.tar.gz"
CHECKSUM_SHA256="1ff1c1c806b2acd1976eab21b701e5e18ac665bf20f2f7c79331ca61e885836f"
SOURCE_DIR="SurrealEngine-$srcGitRev"
PATCHES="surrealengine-$portVersion.patchset"
ADDITIONAL_FILES="surrealengine.rdef.in"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	surrealengine$secondaryArchSuffix = $portVersion
	lib:libSurrealCommon$secondaryArchSuffix
	lib:libSurrealVideo$secondaryArchSuffix
	lib:libsurrealgpu$secondaryArchSuffix
	app:Surreal_Engine
	app:Surreal_Debugger
	app:Surreal_Editor
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libexecinfo$secondaryArchSuffix
	lib:libfontconfig$secondaryArchSuffix
	lib:libfreetype$secondaryArchSuffix
	lib:libGL$secondaryArchSuffix
	lib:libglib_2.0$secondaryArchSuffix
	lib:libintl$secondaryArchSuffix
	lib:libopenal$secondaryArchSuffix
	lib:libSDL2_2.0$secondaryArchSuffix
	lib:libvulkan$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libexecinfo$secondaryArchSuffix
	devel:libfontconfig$secondaryArchSuffix
	devel:libfreetype$secondaryArchSuffix
	devel:libGL$secondaryArchSuffix
	devel:libglib_2.0$secondaryArchSuffix
	devel:libintl$secondaryArchSuffix
	devel:libopenal$secondaryArchSuffix
	devel:libSDL2_2.0$secondaryArchSuffix
	devel:libvulkan$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

defineDebugInfoPackage surrealengine$secondaryArchSuffix \
	$appsDir/"Surreal Engine" \
	$appsDir/"Surreal Debugger" \
	$appsDir/"Surreal Editor" \
	$libDir/libSurrealCommon.so \
	$libDir/libSurrealVideo.so \
	$libDir/libsurrealgpu.so

BUILD()
{
	cmake -Bbuild -DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DENABLE_SDL2=ON
	make $jobArgs -C build/
}

INSTALL()
{
	local APP_SIGNATURE="application/x-vnd.surrealengine"
	local MAJOR="`echo "$portVersion" | cut -b1-4`"
	local MIDDLE="`echo "$portVersion" | cut -b5-6`"
	local MINOR="`echo "$portVersion" | cut -b7-8`"
	local LONG_INFO="$SUMMARY"
	sed \
		-e "s|@APP_SIGNATURE@|$APP_SIGNATURE|" \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/surrealengine.rdef.in > surrealengine.rdef
		APP_SIGNATURE="application/x-vnd.surrealdebugger"
	sed \
		-e "s|@APP_SIGNATURE@|$APP_SIGNATURE|" \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/surrealengine.rdef.in > surrealdebugger.rdef
	APP_SIGNATURE="application/x-vnd.surrealeditor"
	sed \
		-e "s|@APP_SIGNATURE@|$APP_SIGNATURE|" \
		-e "s|@MAJOR@|$MAJOR|" \
		-e "s|@MIDDLE@|$MIDDLE|" \
		-e "s|@MINOR@|$MINOR|" \
		-e "s|@LONG_INFO@|$LONG_INFO|" \
		$portDir/additional-files/surrealengine.rdef.in > surrealeditor.rdef

	addResourcesToBinaries surrealengine.rdef $sourceDir/build/SurrealEngine
	addResourcesToBinaries surrealdebugger.rdef $sourceDir/build/SurrealDebugger
	addResourcesToBinaries surrealeditor.rdef $sourceDir/build/SurrealEditor
	mimeset -f $sourceDir/build/SurrealEngine
	mimeset -f $sourceDir/build/SurrealDebugger
	mimeset -f $sourceDir/build/SurrealEditor

	mkdir -p $appsDir
	cp -a $sourceDir/build/SurrealEngine $appsDir/"Surreal Engine"
	cp -a $sourceDir/build/SurrealDebugger $appsDir/"Surreal Debugger"
	cp -a $sourceDir/build/SurrealEditor $appsDir/"Surreal Editor"

	addAppDeskbarSymlink $appsDir/"Surreal Engine"
	addAppDeskbarSymlink $appsDir/"Surreal Debugger"
	addAppDeskbarSymlink $appsDir/"Surreal Editor"

	mkdir -p $libDir
	cp -a $sourceDir/build/libSurrealCommon.so $libDir/
	cp -a $sourceDir/build/libSurrealVideo.so $libDir/
	cp -a $sourceDir/build/SurrealGPU/libsurrealgpu.so $libDir/

	mkdir -p $dataDir/SurrealEngine
	cp -a $sourceDir/build/SurrealEngine.pk3 $dataDir/SurrealEngine
}
