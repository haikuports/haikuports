From b2954a6e6455fea8cfbbeb585c826b12c37559be Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Mon, 27 Jul 2026 20:32:09 +0200
Subject: Use Linux path implementation except for locating settings, data and
 cache directories


diff --git a/components/files/fixedpath.hpp b/components/files/fixedpath.hpp
index 279c5b5..9108d9d 100644
--- a/components/files/fixedpath.hpp
+++ b/components/files/fixedpath.hpp
@@ -5,7 +5,7 @@
 #include <string>
 #include <vector>
 
-#if defined(__linux__) || defined(__FreeBSD__) || defined(__FreeBSD_kernel__) || defined(__OpenBSD__)
+#if defined(__linux__) || defined(__FreeBSD__) || defined(__FreeBSD_kernel__) || defined(__OpenBSD__) || defined(__HAIKU__)
 #ifndef ANDROID
 #include <components/files/linuxpath.hpp>
 namespace Files
diff --git a/components/files/linuxpath.cpp b/components/files/linuxpath.cpp
index 8007926..df487c9 100644
--- a/components/files/linuxpath.cpp
+++ b/components/files/linuxpath.cpp
@@ -1,6 +1,6 @@
 #include "linuxpath.hpp"
 
-#if defined(__linux__) || defined(__FreeBSD__) || defined(__FreeBSD_kernel__) || defined(__OpenBSD__)
+#if defined(__linux__) || defined(__FreeBSD__) || defined(__FreeBSD_kernel__) || defined(__OpenBSD__) || defined(__HAIKU__)
 
 #include <array>
 #include <cstring>
@@ -56,17 +56,32 @@ namespace Files
 
     std::filesystem::path LinuxPath::getUserConfigPath() const
     {
+#ifdef __HAIKU__
+        std::filesystem::path path("/boot/home/config/settings");
+        return path / mName;
+#else
         return getEnv("XDG_CONFIG_HOME", getUserHome() / ".config") / mName;
+#endif
     }
 
     std::filesystem::path LinuxPath::getUserDataPath() const
     {
+#ifdef __HAIKU__
+        std::filesystem::path path("/boot/home/config/settings");
+        return path / mName;
+#else
         return getEnv("XDG_DATA_HOME", getUserHome() / ".local/share") / mName;
+#endif
     }
 
     std::filesystem::path LinuxPath::getCachePath() const
     {
+#ifdef __HAIKU__
+        std::filesystem::path path("/boot/home/config/cache");
+        return path / mName;
+#else
         return getEnv("XDG_CACHE_HOME", getUserHome() / ".cache") / mName;
+#endif
     }
 
     std::filesystem::path LinuxPath::getGlobalConfigPath() const
diff --git a/components/files/linuxpath.hpp b/components/files/linuxpath.hpp
index 501a463..0c3dd40 100644
--- a/components/files/linuxpath.hpp
+++ b/components/files/linuxpath.hpp
@@ -1,7 +1,7 @@
 #ifndef COMPONENTS_FILES_LINUXPATH_H
 #define COMPONENTS_FILES_LINUXPATH_H
 
-#if defined(__linux__) || defined(__FreeBSD__) || defined(__FreeBSD_kernel__) || defined(__OpenBSD__)
+#if defined(__linux__) || defined(__FreeBSD__) || defined(__FreeBSD_kernel__) || defined(__OpenBSD__) || defined(__HAIKU__)
 
 #include <filesystem>
 #include <vector>
-- 
2.54.0


From e76b6b71557785c37a5c239425bfa14292197faf Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Mon, 27 Jul 2026 21:56:53 +0200
Subject: Disable CrashCatcher on Haiku

Needs ptrace which we don't have.

diff --git a/components/crashcatcher/crashcatcher.cpp b/components/crashcatcher/crashcatcher.cpp
index e460f04..5cd6983 100644
--- a/components/crashcatcher/crashcatcher.cpp
+++ b/components/crashcatcher/crashcatcher.cpp
@@ -13,7 +13,9 @@
 #include <stdlib.h>
 #include <string.h>
 #include <sys/param.h>
+#ifndef __HAIKU__
 #include <sys/ptrace.h>
+#endif
 #include <sys/stat.h>
 #include <sys/types.h>
 #include <sys/utsname.h>
@@ -581,6 +583,7 @@ static bool isDebuggerPresent()
 #endif
 }
 
+#if USE_CRASH_CATCHER
 void crashCatcherInstall(int argc, char** argv, const std::filesystem::path& crashLogPath)
 {
     if (argc == 2 && strcmp(argv[1], crash_switch) == 0)
@@ -594,3 +597,4 @@ void crashCatcherInstall(int argc, char** argv, const std::filesystem::path& cra
     else
         Log(Debug::Warning) << "Installing crash handler failed";
 }
+#endif
diff --git a/components/crashcatcher/crashcatcher.hpp b/components/crashcatcher/crashcatcher.hpp
index 60f749e..91dac7c 100644
--- a/components/crashcatcher/crashcatcher.hpp
+++ b/components/crashcatcher/crashcatcher.hpp
@@ -4,7 +4,7 @@
 #include <filesystem>
 
 #if (defined(__APPLE__) || (defined(__linux) && !defined(ANDROID)) || (defined(__unix) && !defined(ANDROID))           \
-    || defined(__posix))
+    || (defined(__posix) && !defined(__HAIKU__)))
 void crashCatcherInstall(int argc, char** argv, const std::filesystem::path& crashLogPath);
 #else
 inline void crashCatcherInstall(int /*argc*/, char** /*argv*/, const std::filesystem::path& /*crashLogPath*/) {}
-- 
2.54.0


From 5eaa02d979ab325480a59f22eaee2ef6f60060ca Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Sun, 2 Aug 2026 11:07:01 +0200
Subject: Adjust installation directories for Haiku


diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3fc1b83..a558683 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -233,6 +233,18 @@ endif()
 # Set up common paths
 if (APPLE)
     set(OPENMW_RESOURCE_FILES "../Resources/resources" CACHE PATH "location of OpenMW resources files")
+elseif(HAIKU)
+    # Paths
+    SET(BINDIR "${CMAKE_INSTALL_PREFIX}" CACHE PATH "Where to install binaries")
+    SET(LIBDIR "${CMAKE_INSTALL_PREFIX}/lib${LIB_SUFFIX}" CACHE PATH "Where to install libraries")
+    SET(DATAROOTDIR "${CMAKE_INSTALL_PREFIX}" CACHE PATH "Sets the root of data directories to a non-default location")
+    SET(GLOBAL_DATA_PATH "${DATAROOTDIR}/games/" CACHE PATH "Set data path prefix")
+    SET(DATADIR "${DATAROOTDIR}" CACHE PATH "Sets the openmw data directories to a non-default location")
+    SET(ICONDIR "${DATAROOTDIR}/pixmaps" CACHE PATH "Set icon dir")
+    SET(LICDIR "${DATAROOTDIR}/licenses/openmw" CACHE PATH "Sets the openmw license directory to a non-default location.")
+    SET(GLOBAL_CONFIG_PATH "${CMAKE_INSTALL_PREFIX}/config/" CACHE PATH "Set config dir prefix")
+    SET(SYSCONFDIR "${GLOBAL_CONFIG_PATH}/openmw" CACHE PATH "Set config dir")
+    set(OPENMW_RESOURCE_FILES "${CMAKE_INSTALL_PREFIX}/resources" CACHE PATH "location of OpenMW resources files")
 elseif(UNIX)
     # Paths
     SET(BINDIR "${CMAKE_INSTALL_PREFIX}/bin" CACHE PATH "Where to install binaries")
-- 
2.54.0

