Subject: The Haiku osgViewer


diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4106e0f..262e804 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -115,7 +115,11 @@ ELSEIF(APPLE)
         ENDIF()
     ENDIF()
 ELSE()
+    IF(CMAKE_SYSTEM_NAME STREQUAL "Haiku")
+        SET(OSG_WINDOWING_SYSTEM "Haiku" CACHE STRING "Windowing system type for graphics window creation; options: Haiku or None.")
+    ELSE()
     SET(OSG_WINDOWING_SYSTEM "X11" CACHE STRING "Windowing system type for graphics window creation; options: X11 or None.")
+    ENDIF()
 ENDIF()
 
 
diff --git a/include/osgViewer/api/Haiku/GraphicsWindowHaiku b/include/osgViewer/api/Haiku/GraphicsWindowHaiku
new file mode 100644
index 0000000..826d968
--- /dev/null
+++ b/include/osgViewer/api/Haiku/GraphicsWindowHaiku
@@ -0,0 +1,107 @@
+#ifndef OSGVIEWER_GRAPHICSWINDOWHAIKU
+#define OSGVIEWER_GRAPHICSWINDOWHAIKU 1
+
+#include <osgViewer/GraphicsWindow>
+#include <OpenThreads/Mutex>
+#include <Accelerant.h>
+#include <vector>
+
+#ifdef __HAIKU__
+class BWindow;
+class BGLView;
+#endif
+
+namespace osgViewer {
+
+#ifdef __HAIKU__
+
+class OSGVIEWER_EXPORT GraphicsWindowHaiku : public osgViewer::GraphicsWindow
+{
+public:
+    struct WindowData : public osg::Referenced {
+        WindowData(BWindow* window = 0, BGLView* view = 0,
+            bool ownWindow = true, bool ownView = true)
+            : _window(window), _view(view), _ownWindow(ownWindow), _ownView(ownView) {}
+
+        BWindow* _window;
+        BGLView* _view;
+        bool _ownWindow;
+        bool _ownView;
+    };
+
+    explicit GraphicsWindowHaiku(osg::GraphicsContext::Traits* traits);
+    virtual ~GraphicsWindowHaiku();
+
+    virtual bool isSameKindAs(const osg::Object* object) const {
+        return dynamic_cast<const GraphicsWindowHaiku*>(object) != 0;
+    }
+    virtual const char* libraryName() const { return "osgViewer"; }
+    virtual const char* className() const { return "GraphicsWindowHaiku"; }
+
+    virtual bool valid() const { return _valid; }
+    virtual bool realizeImplementation();
+    virtual bool isRealizedImplementation() const { return _realized; }
+    virtual void closeImplementation();
+    virtual bool makeCurrentImplementation();
+    virtual bool makeContextCurrentImplementation(osg::GraphicsContext* readContext);
+    virtual bool releaseContextImplementation();
+    virtual void bindPBufferToTextureImplementation(GLenum);
+    virtual void swapBuffersImplementation();
+
+    virtual bool checkEvents();
+    virtual bool setWindowRectangleImplementation(int x, int y, int width, int height);
+    virtual bool setWindowDecorationImplementation(bool flag);
+    virtual void grabFocus();
+    virtual void grabFocusIfPointerInWindow();
+    virtual void raiseWindow();
+    virtual void setWindowName(const std::string& name);
+    virtual void useCursor(bool cursorOn);
+    virtual void setCursor(MouseCursor cursor);
+    virtual void setSyncToVBlank(bool on);
+    virtual void requestWarpPointer(float x, float y);
+
+    bool setDisplayMode(const osg::GraphicsContext::ScreenSettings& settings);
+    bool restoreDisplayMode();
+
+    BWindow* getHaikuWindow() const { return _window; }
+    BGLView* getHaikuView() const { return _view; }
+
+protected:
+    void initState();
+    bool createWindow();
+    void destroyWindow();
+    void updateTraitsFromWindow();
+
+    bool _valid;
+    bool _realized;
+    bool _ownsWindow;
+    bool _ownsView;
+    bool _glLocked;
+    bool _pbuffer;
+    bool _modeChanged;
+    display_mode* _originalMode;
+    OpenThreads::Mutex _contextMutex;
+    size_t _contextOwner;
+    BWindow* _window;
+    BGLView* _view;
+};
+
+class HaikuWindowingSystemInterface : public osg::GraphicsContext::WindowingSystemInterface
+{
+public:
+    HaikuWindowingSystemInterface();
+    virtual unsigned int getNumScreens(const osg::GraphicsContext::ScreenIdentifier& si);
+    virtual void getScreenSettings(const osg::GraphicsContext::ScreenIdentifier& si,
+        osg::GraphicsContext::ScreenSettings& resolution);
+    virtual void enumerateScreenSettings(const osg::GraphicsContext::ScreenIdentifier& si,
+        osg::GraphicsContext::ScreenSettingsList& resolutionList);
+    virtual bool setScreenSettings(const osg::GraphicsContext::ScreenIdentifier& si,
+        const osg::GraphicsContext::ScreenSettings& settings);
+    virtual osg::GraphicsContext* createGraphicsContext(osg::GraphicsContext::Traits* traits);
+};
+
+#endif // __HAIKU__
+
+}
+
+#endif
diff --git a/src/osgViewer/CMakeLists.txt b/src/osgViewer/CMakeLists.txt
index b43042f..145f278 100644
--- a/src/osgViewer/CMakeLists.txt
+++ b/src/osgViewer/CMakeLists.txt
@@ -56,8 +56,15 @@ SET(LIB_COMMON_FILES
 
 # Collect all the configuration files
 SET(LIB_EXTRA_LIBS)
-
-IF(${OSG_WINDOWING_SYSTEM} STREQUAL "Win32")
+IF(${OSG_WINDOWING_SYSTEM} STREQUAL "Haiku")
+    SET(TARGET_H_NO_MODULE_INSTALL
+        ${HEADER_PATH}/api/Haiku/GraphicsWindowHaiku
+    )
+    SET(LIB_COMMON_FILES ${LIB_COMMON_FILES}
+        GraphicsWindowHaiku.cpp
+    )
+    SET(LIB_EXTRA_LIBS be GL ${LIB_EXTRA_LIBS})
+ELSEIF(${OSG_WINDOWING_SYSTEM} STREQUAL "Win32")
     #
     # Enable workaround for OpenGL driver issues when used in multithreaded/multiscreen with NVidia drivers on Windows XP
     # For example: osgviewer dumptruck.osg was showing total garbage (screen looked like shattered, splashed hedgehog)
diff --git a/src/osgViewer/GraphicsWindowHaiku.cpp b/src/osgViewer/GraphicsWindowHaiku.cpp
new file mode 100644
index 0000000..9d61af8
--- /dev/null
+++ b/src/osgViewer/GraphicsWindowHaiku.cpp
@@ -0,0 +1,623 @@
+#ifdef __HAIKU__
+
+#include <osgViewer/api/Haiku/GraphicsWindowHaiku>
+#include <osg/Notify>
+#include <osg/Timer>
+#include <osgViewer/GraphicsWindow>
+
+#include <InterfaceDefs.h>
+#include <Screen.h>
+#include <GraphicsDefs.h>
+#include <Accelerant.h>
+#include <Cursor.h>
+#include <Bitmap.h>
+#include <View.h>
+#include <Window.h>
+#include <Application.h>
+#include <GLView.h>
+#include <Message.h>
+#include <String.h>
+
+#include <algorithm>
+#include <climits>
+#include <cmath>
+#include <cstdlib>
+
+using namespace osgViewer;
+
+namespace {
+
+static unsigned int haikuModifiers()
+{
+    const uint32 m = modifiers();
+    unsigned int result = 0;
+    if (m & B_SHIFT_KEY) result |= osgGA::GUIEventAdapter::MODKEY_SHIFT;
+    if (m & B_CONTROL_KEY) result |= osgGA::GUIEventAdapter::MODKEY_CTRL;
+    if (m & B_OPTION_KEY) result |= osgGA::GUIEventAdapter::MODKEY_ALT;
+    if (m & B_COMMAND_KEY) result |= osgGA::GUIEventAdapter::MODKEY_META;
+    if (m & B_CAPS_LOCK) result |= osgGA::GUIEventAdapter::MODKEY_CAPS_LOCK;
+    if (m & B_NUM_LOCK) result |= osgGA::GUIEventAdapter::MODKEY_NUM_LOCK;
+    return result;
+}
+
+static int haikuMouseButton(uint32 buttons)
+{
+    if (buttons & B_SECONDARY_MOUSE_BUTTON) return 3;
+    if (buttons & B_TERTIARY_MOUSE_BUTTON) return 2;
+    return 1;
+}
+
+class HaikuGLView : public BGLView
+{
+public:
+    HaikuGLView(BRect frame, GraphicsWindowHaiku* owner)
+        : BGLView(frame, "osgViewerGL", B_FOLLOW_ALL,
+            B_WILL_DRAW | B_FRAME_EVENTS | B_NAVIGABLE,
+            BGL_RGB | BGL_DOUBLE | BGL_DEPTH),
+          _owner(owner)
+    {
+    }
+
+    virtual void AttachedToWindow()
+    {
+        BGLView::AttachedToWindow();
+        MakeFocus(true);
+        SetEventMask(B_POINTER_EVENTS | B_KEYBOARD_EVENTS, 0);
+    }
+
+    virtual void DetachedFromWindow()
+    {
+        BGLView::DetachedFromWindow();
+    }
+
+    virtual void FrameResized(float width, float height)
+    {
+        if (_owner != 0) {
+            int w = std::max(1, static_cast<int>(width + 1.0f));
+            int h = std::max(1, static_cast<int>(height + 1.0f));
+            _owner->resized(0, 0, w, h);
+            _owner->getEventQueue()->windowResize(0, 0, w, h,
+                _owner->getEventQueue()->getTime());
+            _owner->requestRedraw();
+        }
+        BGLView::FrameResized(width, height);
+    }
+
+    virtual void MouseDown(BPoint point)
+    {
+        if (_owner != 0) {
+            BPoint p = point;
+            uint32 buttons = 0;
+            GetMouse(&p, &buttons, false);
+            osgGA::EventQueue* q = _owner->getEventQueue();
+            q->getCurrentEventState()->setModKeyMask(haikuModifiers());
+            q->mouseButtonPress(p.x, p.y, haikuMouseButton(buttons));
+        }
+        BGLView::MouseDown(point);
+    }
+
+    virtual void MouseUp(BPoint point)
+    {
+        if (_owner != 0) {
+            BPoint p = point;
+            uint32 buttons = 0;
+            GetMouse(&p, &buttons, false);
+            osgGA::EventQueue* q = _owner->getEventQueue();
+            q->getCurrentEventState()->setModKeyMask(haikuModifiers());
+            q->mouseButtonRelease(p.x, p.y, haikuMouseButton(buttons));
+        }
+        BGLView::MouseUp(point);
+    }
+
+    virtual void MouseMoved(BPoint point, uint32 transit, const BMessage* message)
+    {
+        if (_owner != 0) {
+            osgGA::EventQueue* q = _owner->getEventQueue();
+            q->getCurrentEventState()->setModKeyMask(haikuModifiers());
+            q->mouseMotion(point.x, point.y);
+        }
+        BGLView::MouseMoved(point, transit, message);
+    }
+
+    virtual void KeyDown(const char* bytes, int32 numBytes)
+    {
+        if (_owner != 0 && bytes != 0 && numBytes > 0) {
+            osgGA::EventQueue* q = _owner->getEventQueue();
+            q->getCurrentEventState()->setModKeyMask(haikuModifiers());
+            for (int32 i = 0; i < numBytes; ++i)
+                q->keyPress(static_cast<unsigned char>(bytes[i]));
+        }
+        BGLView::KeyDown(bytes, numBytes);
+    }
+
+    virtual void KeyUp(const char* bytes, int32 numBytes)
+    {
+        if (_owner != 0 && bytes != 0 && numBytes > 0) {
+            osgGA::EventQueue* q = _owner->getEventQueue();
+            q->getCurrentEventState()->setModKeyMask(haikuModifiers());
+            for (int32 i = 0; i < numBytes; ++i)
+                q->keyRelease(static_cast<unsigned char>(bytes[i]));
+        }
+        BGLView::KeyUp(bytes, numBytes);
+    }
+
+    virtual void MessageReceived(BMessage* message)
+    {
+        if (_owner != 0 && message != 0 &&
+            message->what == B_MOUSE_WHEEL_CHANGED) {
+            float dx = 0.0f, dy = 0.0f;
+            message->FindFloat("be:wheel_delta_x", &dx);
+            message->FindFloat("be:wheel_delta_y", &dy);
+            osgGA::GUIEventAdapter::ScrollingMotion motion =
+                osgGA::GUIEventAdapter::SCROLL_NONE;
+            if (dy > 0.0f) motion = osgGA::GUIEventAdapter::SCROLL_DOWN;
+            else if (dy < 0.0f) motion = osgGA::GUIEventAdapter::SCROLL_UP;
+            else if (dx > 0.0f) motion = osgGA::GUIEventAdapter::SCROLL_RIGHT;
+            else if (dx < 0.0f) motion = osgGA::GUIEventAdapter::SCROLL_LEFT;
+            if (motion != osgGA::GUIEventAdapter::SCROLL_NONE)
+                _owner->getEventQueue()->mouseScroll(motion);
+            return;
+        }
+        BGLView::MessageReceived(message);
+    }
+
+private:
+    GraphicsWindowHaiku* _owner;
+};
+
+class HaikuOSGWindow : public BWindow
+{
+public:
+    HaikuOSGWindow(BRect frame, const char* title, bool decorated,
+        GraphicsWindowHaiku* owner)
+        : BWindow(frame, title, decorated ? B_TITLED_WINDOW : B_BORDERED_WINDOW,
+            B_ASYNCHRONOUS_CONTROLS | B_AUTO_UPDATE_SIZE_LIMITS),
+          _owner(owner), _view(0)
+    {
+        _view = new HaikuGLView(Bounds(), owner);
+        AddChild(_view);
+    }
+
+    HaikuGLView* view() const { return _view; }
+
+    virtual bool QuitRequested()
+    {
+        if (_owner != 0)
+            _owner->getEventQueue()->closeWindow();
+        return true;
+    }
+
+private:
+    GraphicsWindowHaiku* _owner;
+    HaikuGLView* _view;
+};
+
+} // anonymous namespace
+
+GraphicsWindowHaiku::GraphicsWindowHaiku(
+    osg::GraphicsContext::Traits* traits)
+    : osgViewer::GraphicsWindow(),
+      _contextOwner(nullptr),
+      _view(nullptr),
+      _window(nullptr),
+      _valid(false),
+      _realized(false),
+      _ownsWindow(true),
+      _ownsView(true),
+      _glLocked(false),
+      _pbuffer(false),
+      _modeChanged(false),
+      _originalMode(0)
+{
+    if (traits != nullptr)
+        _traits = traits;
+
+    if (!_traits.valid())
+        _traits = new osg::GraphicsContext::Traits;
+
+    if (_traits->width == 0)
+        _traits->width = 640;
+
+    if (_traits->height == 0)
+        _traits->height = 480;
+
+    if (_traits->windowName.empty())
+        _traits->windowName = "OpenSceneGraph";
+
+    initState();
+
+    _valid = true;
+}
+
+GraphicsWindowHaiku::~GraphicsWindowHaiku()
+{
+    close(true);
+}
+
+void GraphicsWindowHaiku::initState()
+{
+    setState(new osg::State);
+    getState()->setGraphicsContext(this);
+    if (_traits->sharedContext.valid()) {
+        getState()->setContextID(_traits->sharedContext->getState()->getContextID());
+        incrementContextIDUsageCount(getState()->getContextID());
+    } else {
+        getState()->setContextID(osg::GraphicsContext::createNewContextID());
+    }
+}
+
+bool GraphicsWindowHaiku::createWindow()
+{
+    if (_window != 0) return true;
+    if (_traits.valid() && _traits->inheritedWindowData.valid()) {
+        WindowData* data = dynamic_cast<WindowData*>(_traits->inheritedWindowData.get());
+        if (data != 0 && data->_window != 0 && data->_view != 0) {
+            _window = data->_window;
+            _view = data->_view;
+            _ownsWindow = data->_ownWindow;
+            _ownsView = data->_ownView;
+            return true;
+        }
+    }
+    if (be_app == 0) {
+        OSG_NOTICE << "GraphicsWindowHaiku: a BApplication must exist before "
+                      "creating a native graphics window." << std::endl;
+        return false;
+    }
+
+    BRect frame(_traits->x, _traits->y,
+        _traits->x + std::max(1, _traits->width) - 1,
+        _traits->y + std::max(1, _traits->height) - 1);
+    const bool hiddenPbuffer = _traits->pbuffer;
+    HaikuOSGWindow* window = new HaikuOSGWindow(frame,
+        _traits->windowName.c_str(), hiddenPbuffer ? false : _traits->windowDecoration, this);
+    _window = window;
+    _view = window->view();
+    _ownsWindow = true;
+    _ownsView = false;
+    if (!hiddenPbuffer) window->Show();
+    _pbuffer = hiddenPbuffer;
+    return true;
+}
+
+void GraphicsWindowHaiku::updateTraitsFromWindow()
+{
+    if (_window == 0) return;
+    BRect frame = _window->Frame();
+    _traits->x = static_cast<int>(frame.left);
+    _traits->y = static_cast<int>(frame.top);
+    BRect bounds = _window->Bounds();
+    _traits->width = static_cast<int>(bounds.Width()) + 1;
+    _traits->height = static_cast<int>(bounds.Height()) + 1;
+}
+
+bool GraphicsWindowHaiku::realizeImplementation()
+{
+    if (_realized) return true;
+    if (!createWindow()) return false;
+
+    updateTraitsFromWindow();
+    _realized = true;
+    return true;
+}
+
+void GraphicsWindowHaiku::closeImplementation()
+{
+    if (_glLocked && _view != 0) {
+        _view->UnlockGL();
+        _glLocked = false;
+    }
+
+    restoreDisplayMode();
+
+    if (_window != 0 && _ownsWindow) {
+        _window->Lock();
+        _window->Quit();
+        _window = 0;
+        _view = 0;
+    }
+    _realized = false;
+    _valid = false;
+}
+
+bool GraphicsWindowHaiku::makeCurrentImplementation()
+{
+    if (!_realized || _view == 0) return false;
+    const size_t tid = OpenThreads::Thread::CurrentThreadId();
+    if (_glLocked && _contextOwner == tid) return true;
+
+    _contextMutex.lock();
+    if (_glLocked && _contextOwner != tid) {
+        _contextMutex.unlock();
+        return false;
+    }
+    _view->LockGL();
+    _glLocked = true;
+    _contextOwner = tid;
+    return true;
+}
+
+bool GraphicsWindowHaiku::makeContextCurrentImplementation(osg::GraphicsContext* readContext)
+{
+    if (readContext != this && readContext != 0)
+        return false;
+    return makeCurrentImplementation();
+}
+
+bool GraphicsWindowHaiku::releaseContextImplementation()
+{
+    if (!_realized || _view == 0) return false;
+    const size_t tid = OpenThreads::Thread::CurrentThreadId();
+    if (!_glLocked || _contextOwner != tid) return false;
+    _view->UnlockGL();
+    _glLocked = false;
+    _contextOwner = 0;
+    _contextMutex.unlock();
+    return true;
+}
+
+void GraphicsWindowHaiku::bindPBufferToTextureImplementation(GLenum buffer)
+{
+    if (!_pbuffer || !_realized || _view == 0) return;
+    bool acquired = false;
+    if (!_glLocked) {
+        if (!makeCurrentImplementation()) return;
+        acquired = true;
+    }
+    const int width = std::max(1, _traits->width);
+    const int height = std::max(1, _traits->height);
+    glReadBuffer(GL_BACK);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glCopyTexSubImage2D(_traits->target ? _traits->target : GL_TEXTURE_2D, static_cast<GLint>(_traits->level),
+        0, 0, 0, 0, width, height);
+    if (acquired) releaseContextImplementation();
+}
+
+void GraphicsWindowHaiku::swapBuffersImplementation()
+{
+    if (_realized && _view != 0)
+        _view->SwapBuffers(_traits.valid() ? _traits->vsync : true);
+}
+
+bool GraphicsWindowHaiku::checkEvents()
+{
+    return !getEventQueue()->empty();
+}
+
+bool GraphicsWindowHaiku::setWindowRectangleImplementation(int x, int y, int width, int height)
+{
+    if (!_realized || _window == 0) return false;
+    BScreen screen(_window);
+    if (screen.IsValid()) {
+        BRect sf = screen.Frame();
+        const int sw = static_cast<int>(sf.Width()) + 1;
+        const int sh = static_cast<int>(sf.Height()) + 1;
+        if (x == 0 && y == 0 && width == sw && height == sh
+            && !_traits->windowDecoration) {
+            setDisplayMode(osg::GraphicsContext::ScreenSettings(
+                sw, sh, 0.0, 32));
+        }
+    }
+    if (!_window->Lock()) return false;
+    _window->MoveTo(x, y);
+    _window->ResizeTo(std::max(1, width) - 1, std::max(1, height) - 1);
+    _window->Unlock();
+    return true;
+}
+
+bool GraphicsWindowHaiku::setWindowDecorationImplementation(bool flag)
+{
+    if (!_realized || _window == 0) return false;
+    if (!_window->Lock()) return false;
+    _window->SetLook(flag ? B_TITLED_WINDOW_LOOK : B_BORDERED_WINDOW_LOOK);
+    _window->Unlock();
+    return true;
+}
+
+void GraphicsWindowHaiku::grabFocus()
+{
+    if (_window != 0 && _window->Lock()) {
+        _window->Activate(true);
+        if (_view != 0) _view->MakeFocus(true);
+        _window->Unlock();
+    }
+}
+
+void GraphicsWindowHaiku::grabFocusIfPointerInWindow()
+{
+    grabFocus();
+}
+
+void GraphicsWindowHaiku::raiseWindow()
+{
+    grabFocus();
+}
+
+void GraphicsWindowHaiku::setWindowName(const std::string& name)
+{
+    if (_window != 0 && _window->Lock()) {
+        _window->SetTitle(name.c_str());
+        _window->Unlock();
+    }
+    if (_traits.valid()) _traits->windowName = name;
+}
+
+void GraphicsWindowHaiku::useCursor(bool cursorOn)
+{
+    if (be_app == 0) return;
+    if (cursorOn) be_app->ShowCursor();
+    else be_app->HideCursor();
+}
+
+void GraphicsWindowHaiku::setCursor(MouseCursor cursor)
+{
+    if (_view == 0) return;
+    BCursorID id = B_CURSOR_ID_SYSTEM_DEFAULT;
+    switch (cursor) {
+        case InheritCursor: id = B_CURSOR_ID_SYSTEM_DEFAULT; break;
+        case NoCursor: id = B_CURSOR_ID_NO_CURSOR; break;
+        case RightArrowCursor: case LeftArrowCursor: id = B_CURSOR_ID_SYSTEM_DEFAULT; break;
+        case InfoCursor: id = B_CURSOR_ID_MOVE; break;
+        case DestroyCursor: id = B_CURSOR_ID_NOT_ALLOWED; break;
+        case HelpCursor: id = B_CURSOR_ID_HELP; break;
+        case CycleCursor: id = B_CURSOR_ID_NOT_ALLOWED; break;
+        case SprayCursor: id = B_CURSOR_ID_CREATE_LINK; break;
+        case WaitCursor: id = B_CURSOR_ID_PROGRESS; break;
+        case TextCursor: id = B_CURSOR_ID_I_BEAM; break;
+        case CrosshairCursor: id = B_CURSOR_ID_CROSS_HAIR; break;
+        case HandCursor: id = B_CURSOR_ID_GRAB; break;
+        case UpDownCursor: id = B_CURSOR_ID_RESIZE_NORTH_SOUTH; break;
+        case LeftRightCursor: id = B_CURSOR_ID_RESIZE_EAST_WEST; break;
+        case TopSideCursor: id = B_CURSOR_ID_RESIZE_NORTH; break;
+        case BottomSideCursor: id = B_CURSOR_ID_RESIZE_SOUTH; break;
+        case LeftSideCursor: id = B_CURSOR_ID_RESIZE_WEST; break;
+        case RightSideCursor: id = B_CURSOR_ID_RESIZE_EAST; break;
+        case TopLeftCorner: id = B_CURSOR_ID_RESIZE_NORTH_WEST; break;
+        case TopRightCorner: id = B_CURSOR_ID_RESIZE_NORTH_EAST; break;
+        case BottomRightCorner: id = B_CURSOR_ID_RESIZE_SOUTH_EAST; break;
+        case BottomLeftCorner: id = B_CURSOR_ID_RESIZE_SOUTH_WEST; break;
+        default: break;
+    }
+    BCursor cursorObject(id);
+    _view->SetViewCursor(&cursorObject);
+}
+
+void GraphicsWindowHaiku::setSyncToVBlank(bool on)
+{
+    if (_traits.valid()) _traits->vsync = on;
+}
+
+void GraphicsWindowHaiku::requestWarpPointer(float, float)
+{
+    // To the beyond...
+}
+
+bool GraphicsWindowHaiku::setDisplayMode(
+    const osg::GraphicsContext::ScreenSettings& settings)
+{
+    BScreen screen(_window);
+    if (!screen.IsValid()) return false;
+    display_mode current;
+    if (screen.GetMode(&current) != B_OK) return false;
+    display_mode* modes = 0; uint32 count = 0;
+    if (screen.GetModeList(&modes, &count) != B_OK || !modes || !count) return false;
+    display_mode best = current; long bestScore = LONG_MAX;
+    for (uint32 i = 0; i < count; ++i) {
+        const display_mode& m = modes[i];
+        unsigned int depth = (m.space == B_RGB32 || m.space == B_RGBA32) ? 32 :
+            (m.space == B_RGB16 ? 16 : (m.space == B_RGB15 ? 15 : 8));
+        double refresh = (m.timing.pixel_clock && m.timing.h_total && m.timing.v_total)
+            ? (1000.0 * m.timing.pixel_clock) /
+                (static_cast<double>(m.timing.h_total) * m.timing.v_total) : 0.0;
+        long score = std::labs(static_cast<long>(m.timing.h_display) - settings.width) * 1000000L
+            + std::labs(static_cast<long>(m.timing.v_display) - settings.height) * 1000000L
+            + std::labs(static_cast<long>(depth) - static_cast<long>(settings.colorDepth)) * 10000L;
+        if (settings.refreshRate > 0.0)
+            score += static_cast<long>(std::fabs(refresh - settings.refreshRate) * 100.0);
+        if (score < bestScore) { bestScore = score; best = m; }
+    }
+    if (_originalMode == 0) _originalMode = new display_mode(current);
+    if (screen.SetMode(&best) != B_OK) return false;
+    _modeChanged = true;
+    return true;
+}
+
+bool GraphicsWindowHaiku::restoreDisplayMode()
+{
+    if (!_modeChanged || !_originalMode) return true;
+    BScreen screen;
+    if (screen.SetMode(_originalMode) != B_OK) return false;
+    delete _originalMode; _originalMode = 0; _modeChanged = false;
+    return true;
+}
+
+HaikuWindowingSystemInterface::HaikuWindowingSystemInterface()
+{
+    setName("Haiku");
+}
+
+unsigned int HaikuWindowingSystemInterface::getNumScreens(const osg::GraphicsContext::ScreenIdentifier&)
+{
+    return 1;
+}
+
+void HaikuWindowingSystemInterface::getScreenSettings(
+    const osg::GraphicsContext::ScreenIdentifier&, osg::GraphicsContext::ScreenSettings& resolution)
+{
+    BScreen screen;
+    BRect frame = screen.Frame();
+    resolution.width = static_cast<int>(frame.Width()) + 1;
+    resolution.height = static_cast<int>(frame.Height()) + 1;
+    resolution.refreshRate = 0.0;
+    display_mode mode;
+    if (screen.GetMode(&mode) == B_OK && mode.timing.pixel_clock &&
+        mode.timing.h_total && mode.timing.v_total) {
+        resolution.refreshRate = (1000.0 * mode.timing.pixel_clock) /
+            (static_cast<double>(mode.timing.h_total) * mode.timing.v_total);
+        resolution.colorDepth = (mode.space == B_RGB32 || mode.space == B_RGBA32) ? 32 :
+            (mode.space == B_RGB16 ? 16 : (mode.space == B_RGB15 ? 15 : 8));
+    } else {
+        resolution.colorDepth = 32;
+    }
+}
+
+void HaikuWindowingSystemInterface::enumerateScreenSettings(
+    const osg::GraphicsContext::ScreenIdentifier&,
+    osg::GraphicsContext::ScreenSettingsList& resolutionList)
+{
+    resolutionList.clear();
+    BScreen screen;
+    display_mode* modes = 0;
+    uint32 count = 0;
+    if (screen.GetModeList(&modes, &count) != B_OK || modes == 0) return;
+    for (uint32 i = 0; i < count; ++i) {
+        const display_mode& m = modes[i];
+        unsigned int depth = (m.space == B_RGB32 || m.space == B_RGBA32) ? 32 :
+            (m.space == B_RGB16 ? 16 : (m.space == B_RGB15 ? 15 : 8));
+        double refresh = (m.timing.pixel_clock && m.timing.h_total && m.timing.v_total)
+            ? (1000.0 * m.timing.pixel_clock) /
+                (static_cast<double>(m.timing.h_total) * m.timing.v_total) : 0.0;
+        resolutionList.push_back(osg::GraphicsContext::ScreenSettings(
+            m.timing.h_display, m.timing.v_display, refresh, depth));
+    }
+}
+
+bool HaikuWindowingSystemInterface::setScreenSettings(
+    const osg::GraphicsContext::ScreenIdentifier&,
+    const osg::GraphicsContext::ScreenSettings& settings)
+{
+    BScreen screen;
+    if (!screen.IsValid()) return false;
+    display_mode* modes = 0;
+    uint32 count = 0;
+    if (screen.GetModeList(&modes, &count) != B_OK || modes == 0 || count == 0) return false;
+    display_mode* best = 0;
+    long bestScore = LONG_MAX;
+    for (uint32 i = 0; i < count; ++i) {
+        display_mode& m = modes[i];
+        unsigned int depth = (m.space == B_RGB32 || m.space == B_RGBA32) ? 32 :
+            (m.space == B_RGB16 ? 16 : (m.space == B_RGB15 ? 15 : 8));
+        double refresh = (m.timing.pixel_clock && m.timing.h_total && m.timing.v_total)
+            ? (1000.0 * m.timing.pixel_clock) /
+                (static_cast<double>(m.timing.h_total) * m.timing.v_total) : 0.0;
+        long score = std::labs(static_cast<long>(m.timing.h_display) - settings.width) * 1000000L
+            + std::labs(static_cast<long>(m.timing.v_display) - settings.height) * 1000000L
+            + std::labs(static_cast<long>(depth) - static_cast<long>(settings.colorDepth)) * 10000L;
+        if (settings.refreshRate > 0.0)
+            score += static_cast<long>(std::fabs(refresh - settings.refreshRate) * 100.0);
+        if (score < bestScore) { bestScore = score; best = &m; }
+    }
+    return best != 0 && screen.SetMode(best) == B_OK;
+}
+
+osg::GraphicsContext* HaikuWindowingSystemInterface::createGraphicsContext(
+    osg::GraphicsContext::Traits* traits)
+{
+    osg::ref_ptr<GraphicsWindowHaiku> window = new GraphicsWindowHaiku(traits);
+    if (!window->valid()) return 0;
+    return window.release();
+}
+
+REGISTER_WINDOWINGSYSTEMINTERFACE(Haiku, HaikuWindowingSystemInterface)
+
+#endif
