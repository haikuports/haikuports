SUMMARY="A simple and native YouTube video and audio downloader"
DESCRIPTION="HaikuDownloader is a native GUI for yt-dlp written in C++ using \
the BeAPI. It provides a clean and responsive interface to download media \
from the web.

Features:
- Video download in multiple qualities (up to 1080p).
- Audio extraction in MP3, FLAC, and M4A formats.
- Native Drag & Drop support from browsers like WebPositive.
- Real-time progress tracking with a native status bar.
- System notifications upon completion.
- Automatic management of the Downloads folder.
- Integrated Tracker attributes to save source URLs."
HOMEPAGE="https://github.com/Joaquin-Barrera/HaikuDownloader"
COPYRIGHT="2026 Joaquin Barrera"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://github.com/Joaquin-Barrera/HaikuDownloader/archive/refs/tags/v1.0.1.tar.gz"
CHECKSUM_SHA256="cc4da484ba57b2214a235de9823ce1cc3bf87901f0c33aaeba92d6c9e1ba6ea6"
SOURCE_DIR="HaikuDownloader-1.0.1"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	haikudownloader$secondaryArchSuffix = $portVersion
	app:HaikuDownloader = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	cmd:yt_dlp
	cmd:ffmpeg
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	makefile_engine
	cmd:g++$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	make $jobArgs
}

INSTALL()
{
	mkdir -p $appsDir
	# El motor de compilación coloca el binario con el icono dentro de objects.*/
	cp objects.*/HaikuDownloader $appsDir/HaikuDownloader
	addAppDeskbarSymlink $appsDir/HaikuDownloader "HaikuDownloader"
}
