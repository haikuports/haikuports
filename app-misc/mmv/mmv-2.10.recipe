SUMMARY="Move/copy/append/link multiple files according to a set of wildcard patterns"
DESCRIPTION="mmv (and its aliases mcp/mln/mad is a program to move/copy/link/append multiple \
files according to a set of wildcard patterns. This multiple action is performed safely, i.e. \
without any unexpected deletion of files due to collisions of target names with existing \
filenames or with other target names and with use of intermediate files when \
renaming in cycles. Furthermore, before doing anything, mmv attempts to detect any errors that \
would result from the entire set of actions specified and gives the user the choice of either \
aborting before beginning, or proceeding by avoiding the offending parts."
HOMEPAGE="https://github.com/rrthomas/mmv"
COPYRIGHT="Vladimir Lanin
	Michael Meskes
	Bernd Eckenfels
	Hartmut Koptein"
LICENSE="GNU GPL v3"
REVISION="1"
SOURCE_URI="https://github.com/rrthomas/mmv/releases/download/v$portVersion/mmv-$portVersion.tar.gz"
CHECKSUM_SHA256="2bbba14c099b512b4a7e9effacec53caa06998069d108a5669ff424ffc879d03"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

# On x86_gcc2 we don't want to install the commands in bin/<arch>/, but in bin/.
commandBinDir=$binDir
commandSuffix=$secondaryArchSuffix
if [ "$targetArchitecture" = x86_gcc2 ]; then
	commandSuffix=
	commandBinDir=$prefix/bin
fi

PROVIDES="
	mmv$secondaryArchSuffix
	cmd:mad$commandSuffix = $portVersion
	cmd:mcp$commandSuffix = $portVersion
	cmd:mln$commandSuffix = $portVersion
	cmd:mmv$commandSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	cmd:awk
	cmd:gcc$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	runConfigure --omit-dirs binDir ./configure \
			--bindir=$commandBinDir
	make $jobArgs
}

INSTALL()
{
	make install

	# Add the somewhat weird license file.
	mkdir -p $dataDir/licenses
	cp -a COPYING $dataDir/licenses/mmv
}
