SUMMARY="Move/copy/append/link multiple files according to a set of wildcard patterns"
DESCRIPTION="
mmv (and its aliases mcp/mln/mad is a program to move/copy/link/append \
multiple files according to a set of wildcard patterns. This multiple \
action is performed safely, i.e. without any unexpected deletion of \
files due to collisions of target names with existing filenames or \
with other target names and with use of intermediate files when \
renaming in cycles. Furthermore, before doing anything, mmv attempts \
to detect any errors that would result from the entire set of actions \
specified and gives the user the choice of either aborting before \
beginning, or proceeding by avoiding the offending parts. \
"
HOMEPAGE="https://github.com/rrthomas/mmv"
SOURCE_URI="https://github.com/rrthomas/mmv/releases/download/v$portVersion/mmv-$portVersion.tar.gz"
CHECKSUM_SHA256="2bbba14c099b512b4a7e9effacec53caa06998069d108a5669ff424ffc879d03"
LICENSE="GNU GPL v2"
COPYRIGHT="
	Vladimir Lanin
	Michael Meskes
	Bernd Eckenfels
	Hartmut Koptein
"
REVISION="1"
ARCHITECTURES="x86_64 ?x86 ?x86_gcc2"
SECONDARY_ARCHITECTURES="?x86 ?x86_gcc2"

PROVIDES="
	mmv$secondaryArchitectureSuffix
	cmd:mmv$commandSuffix = $portVersion
	cmd:mln$commandSuffix = $portVersion
	cmd:mcp$commandSuffix = $portVersion
	cmd:mad$commandSuffix = $portVersion
"
REQUIRES="
	haiku
"
BUILD_PREREQUIRES="
	haiku_devel$secondaryArchSuffix
	cmd:awk
	cmd:gcc$secondaryArchSuffix
	cmd:make
	# For installation:
	cmd:cp
	cmd:cmp
	cmd:ln
	cmd:mkdir
"

BUILD()
{
	runConfigure ./configure
	make $jobArgs
}

INSTALL()
{
	make install

	# Add the somewhat weird license file.
	mkdir -p $dataDir/licenses
	cp -a COPYING $dataDir/licenses/mmv
}