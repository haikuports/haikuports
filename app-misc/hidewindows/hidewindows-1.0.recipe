SUMMARY="Minimize all windows and bring them back"
DESCRIPTION="hidewindows is a tiny utility that minimizes all windows to show \
a clean Desktop. Run it again to restore the windows. Handy together with \
Shortcuts"
HOMEPAGE="https://github.com/discotag/hidewindows"
COPYRIGHT="2026 discotag"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="$HOMEPAGE/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256="033e130ad8dc7ac90173a157d28e70bae9fd795105ffa00f69840a7a0b78950e"
ARCHITECTURES="all"
PROVIDES="
	hidewindows = $portVersion
	cmd:hidewindows = $portVersion
	"
REQUIRES="haiku"
BUILD_REQUIRES="haiku_devel"
BUILD_PREREQUIRES="cmd:g++"
BUILD() {
	g++ -Wno-multichar -Os -o hidewindows hidewindows.cpp -lbe
}
INSTALL() {
	mkdir -p $binDir
	install hidewindows $binDir
}
