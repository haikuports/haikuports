index 46751c6..4cca755 100755
--- a/misc/ext.d/image.sh
+++ b/misc/ext.d/image.sh
@@ -7,7 +7,13 @@ action=$1
 filetype=$2
 
 if [ -n "$DISPLAY" ]; then
-    [ -n "${MC_XDG_OPEN}" ] || MC_XDG_OPEN="xdg-open"
+    if [ -z "${MC_XDG_OPEN}" ]; then
+        if [[ "$OSTYPE" = "haiku" ]]; then
+            MC_XDG_OPEN="open"
+        else
+            MC_XDG_OPEN="xdg-open"
