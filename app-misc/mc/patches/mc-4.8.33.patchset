+    if [[ "$OSTYPE" = "haiku" ]]; then
+        MC_XDG_OPEN="open"
+    else
+        MC_XDG_OPEN="xdg-open"
+    fi
+fi
 
 STAROFFICE_REGEXP='\.(sxw|sdw|stw|sxc|stc|sxi|sti|sxd|std||sxm||sxg)$'
 
