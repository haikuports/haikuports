From c951fc201f03b204f227076189cfb76d5d62659c Mon Sep 17 00:00:00 2001
From: "Ken L. Mays" <kmays2000@gmail.com>
Date: Fri, 25 Sep 2026 23:13:43 +0600
Subject: Resync the Haiku implementation


diff --git a/kernel/OS/BeOS/os_beos.c b/kernel/OS/BeOS/os_beos.c
index 0a6abc9..4879c5c 100644
--- a/kernel/OS/BeOS/os_beos.c
+++ b/kernel/OS/BeOS/os_beos.c
@@ -20,6 +20,12 @@
 #include <KernelExport.h>
 #include <driver_settings.h>
 
+#ifdef __HAIKU__
+	#ifdef ioctl
+		#undef ioctl
+	#endif
+#endif
+
 /*
  * The BeOS and Haiku kernels are preemptible, 
  * therefore we must ensure safe access to global variables.
diff --git a/kernel/drv/lynxtwo/HalEnv.h b/kernel/drv/lynxtwo/HalEnv.h
index 75b10a2..e7db0a0 100644
--- a/kernel/drv/lynxtwo/HalEnv.h
+++ b/kernel/drv/lynxtwo/HalEnv.h
@@ -60,7 +60,7 @@
 // Figure out which operating system we are using
 /////////////////////////////////////////////////////////////////////////////
 #if defined(i386) || defined(__x86_64__) || defined(sparc)
-#if defined(linux) || defined(sun)
+#if defined(linux) || defined(sun) || defined(__HAIKU__)
 #define OSS
 #define memcpy oss_memcpy
 #else
diff --git a/kernel/drv/lynxtwo/HalOSS.cpp b/kernel/drv/lynxtwo/HalOSS.cpp
index db4e12e..aa3dd8c 100644
--- a/kernel/drv/lynxtwo/HalOSS.cpp
+++ b/kernel/drv/lynxtwo/HalOSS.cpp
@@ -9,6 +9,9 @@
 #include "HalDevice.h"
 #include "LynxTWO.h"
 #include "resource.h"
+#if defined(__HAIKU__)
+#include <stdio.h>
+#endif
 
 extern "C"
 {
@@ -381,7 +384,7 @@ CHalOSS::SetGroup (int g)
   m_group = g;
 }
 
-EXTERN_C static int
+static int
 mixer_callback (int dev, int ctrl, unsigned int cmd, int value)
 {
   lynxtwo_devc *devc = (lynxtwo_devc *) mixer_devs[dev]->devc;
@@ -1378,10 +1381,12 @@ AllocateMemory (oss_device_t * osdev, PVOID * pObject, PVOID * pVAddr,
 // by the caller
 /////////////////////////////////////////////////////////////////////////////
 {
-  DMAADDR ulAddress;
   oss_native_word phaddr;
   oss_dma_handle_t dma_handle;
 
+  if (pObject == NULL || pVAddr == NULL || pPAddr == NULL)
+    return (HSTATUS_OK);
+
   if (ulLength < 4096)
     ulLength = 4096;
 
@@ -1390,9 +1395,12 @@ AllocateMemory (oss_device_t * osdev, PVOID * pObject, PVOID * pVAddr,
   *pObject =
     (PVOID) CONTIG_MALLOC (osdev, ulLength, MEMLIMIT_32BITS, &phaddr,
 			   dma_handle);
-  ulAddress = ((DMAADDR) * pObject);
-  *pVAddr = (PVOID) ulAddress;	// 
-  *pPAddr = (PVOID) phaddr;
+  if (*pObject == NULL)
+    return (HSTATUS_OK);
+
+  *pVAddr = *pObject;
+  *pPAddr = (PVOID) (uintptr_t) phaddr;
+ 
 
   if (nblocks < MAXBLOCKS)
     {
@@ -1432,7 +1440,7 @@ FreeMemory (PVOID pObject, PVOID pVAddr)
  * Mixer stuff
  */
 
-EXTERN_C static int
+static int
 lynxtwo_mixer_ioctl (int dev, int audiodev, unsigned int cmd, ioctl_arg arg)
 {
 
@@ -1471,7 +1479,7 @@ static mixer_driver_t lynxtwo_mixer_driver = {
   lynxtwo_mixer_ioctl
 };
 
-EXTERN_C static int
+static int
 lynxtwo_adapter_mix_init (int dev)
 {
   lynxtwo_devc *devc = (lynxtwo_devc *) mixer_devs[dev]->devc;
@@ -1480,7 +1488,7 @@ lynxtwo_adapter_mix_init (int dev)
   return pOSS->InitAdapterMixer (dev, devc);
 }
 
-EXTERN_C static int
+static int
 aes16_adapter_mix_init (int dev)
 {
   lynxtwo_devc *devc = (lynxtwo_devc *) mixer_devs[dev]->devc;
@@ -1489,7 +1497,7 @@ aes16_adapter_mix_init (int dev)
   return pOSS->InitAES16AdapterMixer (dev, devc);
 }
 
-EXTERN_C static int
+static int
 lynxtwo_rec_mix_init (int dev)
 {
   lynxtwo_devc *devc = (lynxtwo_devc *) mixer_devs[dev]->devc;
@@ -1498,7 +1506,7 @@ lynxtwo_rec_mix_init (int dev)
   return pOSS->InitRecMixer (dev, devc);
 }
 
-EXTERN_C static int
+static int
 lynxtwo_play_mix_init (int dev)
 {
   lynxtwo_devc *devc = (lynxtwo_devc *) mixer_devs[dev]->devc;
diff --git a/kernel/drv/lynxtwo/OssAudio.cpp b/kernel/drv/lynxtwo/OssAudio.cpp
index f37af90..9e02121 100644
--- a/kernel/drv/lynxtwo/OssAudio.cpp
+++ b/kernel/drv/lynxtwo/OssAudio.cpp
@@ -15,6 +15,9 @@ extern "C"
 #include "lynxtwo_cfg.h"
 #include "lynxtwo.h"
 #include "HalOSS.h"
+#if defined (__HAIKU__)
+#include <stdio.h>
+#endif
 
 #ifdef USE_LICENSING
 #include "../private/licensing/licensing.h"
@@ -27,7 +30,7 @@ int glSampleRates[NUM_SAMPLE_RATES] =
 };
 
 #define FMT_MASK (AFMT_S32_NE|AFMT_S16_NE|AFMT_S8)
-EXTERN_C static void lynxtwo_reset (int dev);
+static void lynxtwo_reset (int dev);
 
 /***********************************
  * Audio routines 
@@ -546,7 +549,7 @@ lynxtwo_portc::PrepareForOutput (int bsize, int bcount)
   return 0;
 }
 
-EXTERN_C static int
+static int
 lynxtwo_set_rate (int dev, int arg)
 {
   lynxtwo_portc *portc = (lynxtwo_portc *) audio_engines[dev]->portc;
@@ -554,7 +557,7 @@ lynxtwo_set_rate (int dev, int arg)
   return portc->SetSpeed (arg);
 }
 
-EXTERN_C static short
+static short
 lynxtwo_set_channels (int dev, short arg)
 {
   lynxtwo_portc *portc = (lynxtwo_portc *) audio_engines[dev]->portc;
@@ -562,7 +565,7 @@ lynxtwo_set_channels (int dev, short arg)
   return portc->SetChannels (arg);
 }
 
-EXTERN_C static unsigned int
+static unsigned int
 lynxtwo_set_format (int dev, unsigned int arg)
 {
   lynxtwo_portc *portc = (lynxtwo_portc *) audio_engines[dev]->portc;
@@ -570,7 +573,7 @@ lynxtwo_set_format (int dev, unsigned int arg)
   return portc->SetFormat (arg);
 }
 
-EXTERN_C static int
+static int
 lynxtwo_ioctl (int dev, unsigned int cmd, ioctl_arg arg)
 {
   lynxtwo_portc *portc = (lynxtwo_portc *) audio_engines[dev]->portc;
@@ -578,7 +581,7 @@ lynxtwo_ioctl (int dev, unsigned int cmd, ioctl_arg arg)
   return portc->Ioctl (cmd, arg);
 }
 
-EXTERN_C static void
+static void
 lynxtwo_trigger (int dev, int state)
 {
   lynxtwo_portc *portc;
@@ -600,15 +603,15 @@ lynxtwo_trigger (int dev, int state)
   portc->SetTrigger (state);
 }
 
-EXTERN_C static void
+static void
 lynxtwo_reset (int dev)
 {
   lynxtwo_trigger (dev, 0);
 }
 
-EXTERN_C static void lynxtwo_close (int dev, int mode);
+static void lynxtwo_close (int dev, int mode);
 
-EXTERN_C static int
+static int
 lynxtwo_open (int dev, int mode, int open_flags)
 {
   lynxtwo_portc *portc = (lynxtwo_portc *) audio_engines[dev]->portc;
@@ -621,7 +624,7 @@ lynxtwo_open (int dev, int mode, int open_flags)
   return portc->Open (mode, open_flags);
 }
 
-EXTERN_C static void
+static void
 lynxtwo_close (int dev, int mode)
 {
   lynxtwo_portc *portc = (lynxtwo_portc *) audio_engines[dev]->portc;
@@ -635,7 +638,7 @@ lynxtwo_close (int dev, int mode)
   portc->Close (mode);
 }
 
-EXTERN_C static void
+static void
 lynxtwo_output_block (int dev, oss_native_word ptr, int count, int fragsize,
 		      int intrflag)
 {
@@ -643,7 +646,7 @@ lynxtwo_output_block (int dev, oss_native_word ptr, int count, int fragsize,
   portc->OutputBlock (ptr, count, fragsize, intrflag);
 }
 
-EXTERN_C static void
+static void
 lynxtwo_start_input (int dev, oss_native_word ptr, int count, int fragsize,
 		     int intrflag)
 {
@@ -651,27 +654,27 @@ lynxtwo_start_input (int dev, oss_native_word ptr, int count, int fragsize,
   portc->StartInput (ptr, count, fragsize, intrflag);
 }
 
-EXTERN_C static int
+static int
 lynxtwo_prepare_for_output (int dev, int bsize, int bcount)
 {
   lynxtwo_portc *portc = (lynxtwo_portc *) audio_engines[dev]->portc;
   return portc->PrepareForOutput (bsize, bcount);
 }
 
-EXTERN_C static int
+static int
 lynxtwo_prepare_for_input (int dev, int bsize, int bcount)
 {
   lynxtwo_portc *portc = (lynxtwo_portc *) audio_engines[dev]->portc;
   return portc->PrepareForInput (bsize, bcount);
 }
 
-EXTERN_C static int
+static int
 lynxtwo_check_output (int dev)
 {
   return OSS_EIO;
 }
 
-EXTERN_C static int
+static int
 lynxtwo_sync_control (int dev, int event, int mode)
 {
   lynxtwo_portc *portc = (lynxtwo_portc *) audio_engines[dev]->portc;
@@ -690,7 +693,7 @@ lynxtwo_sync_control (int dev, int event, int mode)
 }
 
 #if 0
-EXTERN_C static int
+static int
 lynxtwo_get_buffer_pointer (int dev, dmap_t * dmap, int direction)
 {
 }
