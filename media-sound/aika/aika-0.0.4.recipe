SUMMARY="A fast, themable console audio player"
DESCRIPTION="Aika is a command line-based open source audio player.  It supports \
MPEG-1 (mp3, mp2, and mp1), FLAC, Ogg Vorbis, Opus, WavPack, \
module/tracker files, QOA and Extended QOA Format, and has some \
support for VGM files."
HOMEPAGE="https://fossil.cyberia9.org/aika/"
COPYRIGHT="2026 Remilia Scarlet"
LICENSE="AGPL-3.0"
REVISION="1"
SOURCE_URI="https://fossil.cyberia9.org/aika/uv/aika-0.0.4.tar.bz2"
CHECKSUM_SHA256="3d7a74902e19461f8af0c4c0375f4972f57bffc36f75b64bcf02e4c175217c97"
SOURCE_DIR="aika-$portVersion"

ARCHITECTURES="all !x86_gcc2 ?ppc"

PROVIDES="
        aika = $portVersion
        cmd:aika = $portVersion
        "

REQUIRES="
        haiku
        lib:libslang
        lib:libzmq
        lib:libao
        lib:libmpg123
        lib:libwavpack
        lib:libopus
        lib:libiconv
        lib:libzstd
        lib:libxmp
        lib:libz
        "

BUILD_REQUIRES="
        haiku_devel
        slang_devel
        zeromq_devel
        libao_devel
        mpg123_devel
        wavpack_devel
        opus_devel
        zstd_devel
        libxmp_devel
        libiconv_devel
        zlib_devel
		asciidoc
        "

BUILD_PREREQUIRES="
        fpc >= 3.2.0
        cmd:rake
        cmd:gcc
        cmd:install
        cmd:fossil
        cmd:zstd
        cmd:tar
        cmd:nm
		cmd:a2x
        "

PATCH()
{
    # Remi: I made a small error in my Rakefile for v0.0.4, it's
    # easier to patch it here since it's Haiku-specific.
    sed -i -e 's|haikuporterinstall => \[MAN_FILE_GZ, :release\]|haikuporterinstall => [MAN_FILE_GZ]|g' Rakefile
}

BUILD()
{
    # Custom configure script.  Must be run without options on Haiku (the
    # defaults are correct).
    ./configure.rb

    # Switch to using vendored dependencies since we don't have network
    # access. We need to specify a USER and HOME, or Fossil will not work.
    # NO_FOSSIL_NET=1 is used by the Rakefile to disable Fossil network access
    # attempts that would fail.
    USER="user" HOME=/ NO_FOSSIL_NET=1 rake usevendored

    # FPC uses different nomeclature for some platforms, so check to see if
    # we're building on those now.  We'll use this variable to locate the
    # RTL/FPC units that ship with FPC.
    case $targetArchitecture in
        x86_gcc2|x86)
            fpcArch=i386
            ;;
        *)
            # Assume it's the same.  If it fails, then please provide a patch
            # ^_^
            fpcArch=$targetArchitecture
            ;;
    esac

    # The /system/settings/etc/fpc.conf file doesn't seem to get linked by
    # HaikuPorter, so we'll rebuild the command line ourselves.  These are the
    # same options as found in fpc.cfg.  The FPC_OPTS variable is handled by the
    # Rakefile.
    fpcVersion=$(fpc -iW)
    FPC_OPTS="-Sgic -viwn "
    FPC_OPTS="$FPC_OPTS -Fu/boot/system/lib/fpc/$fpcVersion/units/$fpcArch-haiku "
    FPC_OPTS="$FPC_OPTS -Fu/boot/system/lib/fpc/$fpcVersion/units/$fpcArch-haiku/*"
    FPC_OPTS="$FPC_OPTS -Fu/boot/system/lib/fpc/$fpcVersion/units/$fpcArch-haiku/rtl"
    FPC_OPTS="$FPC_OPTS -Fl/boot/system/lib/fpc/$fpcVersion/lib/$fpcArch-haiku"

    # Again, we need to specify a USER and HOME, or Fossil will not work.
    FPC_OPTS="$FPC_OPTS -l" USER="user" HOME=/ NO_FOSSIL_NET=1 rake release

    true
}

INSTALL()
{
    # This is a Rakefile target explicitly for HaikuPorter recipes.  It's
    # normally not used by people hand-compiling Aika.
    NO_FOSSIL_NET=1 rake haikuporterinstall DESTDIR=$prefix
}
