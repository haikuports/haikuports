From 39e2a4e3089c45b958d2208d5ffb7cbe58233333 Mon Sep 17 00:00:00 2001
From: Ken Mays <kmays2000@gmail.com>
Date: Sun, 27 Sep 2026 22:31:19 -0600
Subject: OpenSSL fix


diff --git a/CMakeLists.txt b/CMakeLists.txt
index c169a44..d82ad23 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -168,6 +168,9 @@ find_package(Backtrace)
 if(Backtrace_FOUND)
   set(HAVE_BACKTRACE ON)
 endif()
+if(HAIKU)
+find_package(OpenSSL COMPONENTS Crypto REQUIRED MODULE)
+else()
 find_package(OpenSSL COMPONENTS Crypto CONFIG)
 if(NOT OpenSSL_FOUND)
   find_package(OpenSSL COMPONENTS Crypto REQUIRED)
@@ -176,6 +179,7 @@ find_package(Boost CONFIG)
 if(NOT Boost_FOUND)
   find_package(Boost REQUIRED)
 endif()
+endif()
 find_package(ICU COMPONENTS uc i18n REQUIRED)
 if(UNIX AND NOT APPLE)
   if(LINUX)
-- 
2.54.0
