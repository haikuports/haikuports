SOURCE_URI_475="https://github.com/m199/mio/archive/d20971caf8dc4033ae0059c7e22869088386d426.tar.gz"
CHECKSUM_SHA256_475="505ad7cd18ad718434679f836747de45b2433c0d3ffe76d42657f6a59cf77524"
ADDITIONAL_FILES="librespot.rdef"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	librespot$secondaryArchSuffix = $portVersion
	cmd:librespot
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libcrypto$secondaryArchSuffix >= 3
	libsdl2$secondaryArchSuffix
	lib:libssl$secondaryArchSuffix >= 3
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libcrypto$secondaryArchSuffix >= 3
	devel:libSDL2$secondaryArchSuffix
	devel:libssl$secondaryArchSuffix >= 3
	"
BUILD_PREREQUIRES="
	cmd:cargo$secondaryArchSuffix
	cmd:gcc$secondaryArchSuffix
	cmd:pkg_config$secondaryArchSuffix
	"

defineDebugInfoPackage librespot$secondaryArchSuffix \
	$prefix/bin/librespot

BUILD()
{
	export CARGO_HOME=$sourceDir/../cargo
	vendor=$CARGO_HOME/haiku
	mkdir -p "$vendor"
	for i in $(seq 2 472); do
		eval "srcDir=\$sourceDir$i"
		eval "sha256sum=\$CHECKSUM_SHA256_$i"
		set -- "$srcDir"/*
		ln -sf "$1" "$vendor"
		cat <<-EOF >"$vendor/${1##*/}/.cargo-checksum.json"
		{
		  "package": "$sha256sum",
		  "files": {}
		}
		EOF
	done

	cat <<-EOF >"$CARGO_HOME"/config.toml
	[source.haiku]
	directory = "$vendor"

	[source.crates-io]
	replace-with = "haiku"
	EOF

	sed -i \
		-e "s|^mio = .*|mio = { path = \"$sourceDir475/mio-d20971caf8dc4033ae0059c7e22869088386d426\" }|" \
		-e "s|^if-addrs = .*|if-addrs = { path = \"$sourceDir473/if-addrs-64fe7fb9971eb59da8614fbcd2f3ab9b248a26b9\" }|" \
		-e "s|^libmdns = .*|libmdns = { path = \"$sourceDir474/libmdns-6e9ec501cb717ac3035ed3398977a6b1082962dc\" }|" \
		Cargo.toml

	sed -i \
		-e '/source = "git+https:\/\/github.com\/m199\/if-addrs/d' \
		-e '/source = "git+https:\/\/github.com\/m199\/libmdns/d' \
		-e '/source = "git+https:\/\/github.com\/m199\/mio/d' \
		Cargo.lock

	cargo build --release --frozen --no-default-features --features "native-tls sdl-backend with-libmdns"
}

INSTALL()
{
	mkdir -p $binDir
	cp target/release/librespot $binDir

	rc -o librespot.rsrc $portDir/additional-files/librespot.rdef
	xres -o $binDir/librespot librespot.rsrc
}
