From d1f6bad48b2d7aa2e3524e57144f3c6e76976039 Mon Sep 17 00:00:00 2001
From: Yourself <user@shredder.speedport.ip>
Date: Wed, 25 Nov 2026 16:23:50 +0100
Subject: [PATCH] On Haiku explicitly remove the pipe file on exit

Workaround for Haiku's pipe implementation not blocking even
if there is no reader.
---
 picard/util/pipe.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/picard/util/pipe.py b/picard/util/pipe.py
index d5990ca7a..337cf48c9 100644
--- a/picard/util/pipe.py
+++ b/picard/util/pipe.py
@@ -373,6 +373,15 @@ class MacOSPipe(UnixPipe):
 class HaikuPipe(UnixPipe):
     PIPE_DIRS: tuple[str] = ("~/config/var/MusicBrainz/Picard/",)
 
+    def stop(self):
+        super().stop()
+		# Workaround for Haiku's pipe implementation not blocking on write.
+		# Remove the pipe on exit, if this is the primary instance. Otherwise
+		# a new insance will always assume Picard is already running, as Haiku's
+		# pipes currently never block even if there is no reader.
+        if self.is_pipe_owner and os.path.exists(self.path):
+            os.unlink(self.path)
+
 
 class WinPipe(AbstractPipe):
     # win32pipe.CreateNamedPipe
-- 
2.56.0

