SUMMARY="Open Cubic Player"
DESCRIPTION="ocp - Open Cubic Player, a music player ported from DOS."
HOMEPAGE="https://stian.cubic.org/project-ocp.php"
COPYRIGHT="1994-2024 Niklas Beisert, Stian Skjelstad and others"
LICENSE="GNU GPL v2"
REVISION="1"
SOURCE_URI_1="https://stian.cubic.org/ocp/ocp-$portVersion.tar.bz2"
CHECKSUM_SHA256_1="af3b7034a68d6ef654e0888115e3763204b3d2de432de2dd8f3be2a8f8a9e28d"

SOURCE_URI_2="https://stian.cubic.org/mirror/ftp.cubic.org/pub/player/gfx/opencp25ani1.zip"
CHECKSUM_SHA256_2="083786c7cb6a0ba98ea6aa2ddce5caa1e0c5259bb297a955a404d8cbd0fa5dad"

SOURCE_URI_3="https://stian.cubic.org/mirror/ftp.cubic.org/pub/player/gfx/opencp25image1.zip"
CHECKSUM_SHA256_3="3695aab527df75ff41c397c91b21e84a878dbf683947f3c9fbcfee0e9c50d808"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

# On x86_gcc2 we don't want to install the commands in bin/<arch>/, but in bin/.
commandSuffix=$secondaryArchSuffix
commandBinDir=$binDir
if [ "$targetArchitecture" = x86_gcc2 ]; then
	commandSuffix=
	commandBinDir=$prefix/bin
fi

PROVIDES="
	ocp$secondaryArchSuffix = $portVersion
	cmd:ocp$commandSuffix = $portVersion
	cmd:ocp_curses = $portVersion
	cmd:ocp_sdl3 = $portVersion
	app:OpenCubicPlayer = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	cmd:curl$secondaryArchSuffix
	lib:libancient$secondaryArchSuffix >= 2
	lib:libbz2$secondaryArchSuffix
	lib:libcjson$secondaryArchSuffix
	lib:libdiscid$secondaryArchSuffix
	lib:libFLAC$secondaryArchSuffix
	lib:libfreetype$secondaryArchSuffix
	lib:libgme$secondaryArchSuffix
	lib:libiconv$secondaryArchSuffix
	lib:libjpeg$secondaryArchSuffix
	lib:libncurses$secondaryArchSuffix
	lib:libmad$secondaryArchSuffix
	lib:libogg$secondaryArchSuffix
	lib:libopus$secondaryArchSuffix
	lib:libpng16$secondaryArchSuffix
	lib:libSDL3$secondaryArchSuffix
	lib:libspeex$secondaryArchSuffix
	lib:libvorbis$secondaryArchSuffix
	lib:libvorbisfile$secondaryArchSuffix
	lib:libwavpack$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	unifont
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libancient$secondaryArchSuffix
	devel:libbz2$secondaryArchSuffix
	devel:libcjson$secondaryArchSuffix
	devel:libdiscid$secondaryArchSuffix
	devel:libFLAC$secondaryArchSuffix
	devel:libfreetype$secondaryArchSuffix
	devel:libgme$secondaryArchSuffix
	devel:libiconv$secondaryArchSuffix
	devel:libjpeg$secondaryArchSuffix
	devel:libncurses$secondaryArchSuffix
	devel:libmad$secondaryArchSuffix
	devel:libogg$secondaryArchSuffix
	devel:libopus$secondaryArchSuffix
	devel:libpng16$secondaryArchSuffix
	devel:libSDL3$secondaryArchSuffix
	devel:libspeex$secondaryArchSuffix
	devel:libvorbis$secondaryArchSuffix
	devel:libvorbisfile$secondaryArchSuffix
	devel:libwavpack$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	unifont
	"
BUILD_PREREQUIRES="
	cmd:autoconf
	cmd:gcc$secondaryArchSuffix
	cmd:g++$secondaryArchSuffix
	cmd:hexdump
	cmd:libtoolize$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	cmd:xa
	"

BUILD()
{
	libtoolize -vfi
	chmod +x configure
	runConfigure --omit-dirs binDir ./configure \
		--bindir=$commandBinDir \
		--without-update-mime-database \
		--with-libiconv=yes \
		--with-unifontdir-ttf=/system/data/fonts/ttfonts \
		--with-unifontdir-otf=/system/data/fonts/otfonts
	make $jobArgs
}

INSTALL()
{
	make install
	cp $sourceDir2/*.DAT $dataDir/ocp/data
	cp $sourceDir3/*.TGA $dataDir/ocp/data
	addAppDeskbarSymlink $commandBinDir/ocp OpenCubicPlayer
}
