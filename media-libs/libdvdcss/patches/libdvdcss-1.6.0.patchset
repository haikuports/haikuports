Subject: fix build


diff --git a/src/ioctl.c b/src/ioctl.c
index 7da97fe..db32773 100644
--- a/src/ioctl.c
+++ b/src/ioctl.c
@@ -1096,7 +1096,7 @@ int ioctl_ReadCPRMMediaId(int i_fd,int *p_agid, uint8_t *p_data_buffer)
     if( i_ret == 0 && rdc.scsi_status != 0 )
         i_ret = -1;
     if( i_ret == 0 )
-        memcpy( p_buffer, dvdbs + 4, CPRM_MEDIA_ID_SIZE);
+        memcpy( p_data_buffer, dvdbs + 4, CPRM_MEDIA_ID_SIZE);
 
 #elif defined( DARWIN_DVD_IOCTL )
     dk_dvd_read_structure_t dvd = { 0 };
