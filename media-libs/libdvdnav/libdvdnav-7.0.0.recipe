SUMMARY="DVD navigation library"
DESCRIPTION="libdvdnav is a library that allows easy use of sophisticated DVD navigation \
features such as DVD menus, multiangle playback and even interactive DVD games."
HOMEPAGE="https://www.videolan.org/developers/libdvdnav.html"
COPYRIGHT="2000 Rich Wareham
	2001-2004 the dvdnav project"
LICENSE="GNU GPL v2"
REVISION="1"
SOURCE_URI="https://videolan.mirrorservice.org/libdvdnav/$portVersion/libdvdnav-$portVersion.tar.xz"
CHECKSUM_SHA256="a2a18f5ad36d133c74bf9106b6445806fa253b09141a46392550394b647b221e"
PATCHES="libdvdnav-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

libVersion="4.4.0"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

PROVIDES="
	libdvdnav$secondaryArchSuffix = $portVersion
	lib:libdvdnav$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libdvdread$secondaryArchSuffix
	"

PROVIDES_devel="
	libdvdnav${secondaryArchSuffix}_devel = $portVersion
	devel:libdvdnav$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	libdvdnav$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libdvdcss$secondaryArchSuffix
	devel:libdvdread$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	cmd:meson
	cmd:pkg_config$secondaryArchSuffix
	"

defineDebugInfoPackage libdvdnav$secondaryArchSuffix \
	"$libDir"/libdvdnav.so.$libVersion

BUILD()
{
	unset meson
	meson setup \
		--buildtype=debugoptimized \
		--prefix=$prefix \
		--libdir=$libDir \
		--includedir=$includeDir \
		--mandir=$manDir \
		--infodir=$infoDir \
		--datadir=$dataDir \
		haiku_build
	meson compile -C haiku_build $jobArgs
}

INSTALL()
{
	meson install -C haiku_build

	rm $libDir/libdvdnav.a

	# prepare develop/lib
	prepareInstalledDevelLib libdvdnav
	fixPkgconfig

	packageEntries devel \
		$dataDir/doc \
		$developDir
}
