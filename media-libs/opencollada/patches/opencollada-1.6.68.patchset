Subject: Fix CMake minimum version, disable DAEValidator (build is broken,
 seems not installed anyway)


diff --git a/CMakeLists.txt b/CMakeLists.txt
index a3d94df..1bfea45 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -18,7 +18,7 @@ if(${CMAKE_SOURCE_DIR} STREQUAL ${CMAKE_BINARY_DIR})
 	endif()
 endif()
 
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.5)
 
 
 #-----------------------------------------------------------------------------
@@ -286,7 +286,7 @@ add_subdirectory(COLLADAStreamWriter)
 add_subdirectory(COLLADAValidator)
 
 # DAE validator app
-add_subdirectory(DAEValidator)
+# add_subdirectory(DAEValidator)
 
 # Library export
 install(EXPORT LibraryExport DESTINATION ${OPENCOLLADA_INST_CMAKECONFIG} FILE OpenCOLLADATargets.cmake)
