From e6182a4579c3c46d0a2d55f3265cf4a1d8d15210 Mon Sep 17 00:00:00 2001
From: Oscar Lesta <oscar.lesta@gmail.com>
Date: Sun, 26 Jul 2026 01:40:59 -0300
Subject: Quick change to fix the build against lxml2-2.15.3.


diff --git a/src/xmlParser.cc b/src/xmlParser.cc
index e63df55..04dd8ac 100644
--- a/src/xmlParser.cc
+++ b/src/xmlParser.cc
@@ -56,7 +56,7 @@ XMLNode *XMLRootNode::parseFile(const std::string &filename, XMLResults* results
 
     doc = xmlParseFile(filename.c_str());
     if ((doc == NULL) && (results != NULL)) {
-        xmlErrorPtr error = xmlGetLastError();
+        const xmlError* error = xmlGetLastError();
         results->message = error->message;
         results->line = error->line;
         results->code = error->code;
@@ -71,7 +71,7 @@ XMLNode *XMLRootNode::parseString(const std::string &xml, XMLResults* results)
 
     doc = xmlParseMemory(xml.c_str(), xml.length());
     if ((doc == NULL) && (results != NULL)) {
-        xmlErrorPtr error = xmlGetLastError();
+        const xmlError* error = xmlGetLastError();
         results->message = error->message;
         results->line = error->line;
         results->code = error->code;
-- 
2.54.0

