ARCHITECTURES="?all x86_64"
if [ "$targetArchitecture" = x86_gcc2 ]; then
SECONDARY_ARCHITECTURES="?x86"
fi

commandBinDir=$binDir
commandSuffix=$secondaryArchSuffix
if [ "$targetArchitecture" = x86_gcc2 ]; then
	commandSuffix=
	commandBinDir=$prefix/bin
fi

PROVIDES="
	glycin$secondaryArchSuffix = $portVersion
#	cmd:glycin_thumbnailer$commandSuffix
	lib:libglycin_2$secondaryArchSuffix
	lib:libglycin_gtk4_2$secondaryArchSuffix
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libgio_2.0$secondaryArchSuffix
	lib:libglib_2.0$secondaryArchSuffix
	lib:libgobject_2.0$secondaryArchSuffix
	lib:libgtk_4$secondaryArchSuffix
	"

PROVIDES_devel="
	glycin${secondaryArchSuffix}_devel = $portVersion
	devel:libglycin_2$secondaryArchSuffix
	devel:libglycin_gtk4_2$secondaryArchSuffix
	"
REQUIRES_devel="
	glycin$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libgirepository_1.0$secondaryArchSuffix
	devel:libglib_2.0$secondaryArchSuffix
	devel:libgtk_4$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:cargo$secondaryArchSuffix
	cmd:gcc$secondaryArchSuffix
	cmd:meson
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	cmd:vapigen
	"

BUILD()
{
	export CARGO_HOME=$sourceDir/build/cargo-home
	vendor=$CARGO_HOME/haiku
	mkdir -p "$vendor"
	for i in $(seq 2 319); do
		eval "srcDir=\$sourceDir$i"
		eval "sha256sum=\$CHECKSUM_SHA256_$i"
		set -- "$srcDir"/*
		ln -sf "$1" "$vendor"
		cat <<-EOF >"$vendor/${1##*/}/.cargo-checksum.json"
		{
		  "package": "$sha256sum",
		  "files": {}
		}
		EOF
	done

	cat <<-EOF >"$CARGO_HOME"/config.toml
	[source.haiku]
	directory = "$vendor"

	[source.crates-io]
	replace-with = "haiku"
	EOF

	meson --buildtype=release build \
		--prefix=$prefix \
		--bindir=$commandBinDir \
		--datadir=$dataDir \
		--localedir=$dataDir/locale \
		--includedir=$includeDir \
		--libdir=$libDir \
		-D glycin-thumbnailer=false \
		-D tests=false
}

INSTALL()
{
	export CARGO_PROFILE_RELEASE_LTO=false
	export CARGO_BUILD_JOBS=1
	export RUST_BACKTRACE=1
	ninja -C build install

	prepareInstalledDevelLibs \
		libglycin-2 \
		libglycin-gtk4-2
	fixPkgconfig

	packageEntries devel \
		$developDir \
		$dataDir
}

TEST()
{
	meson test -C build --print-errorlogs
}
