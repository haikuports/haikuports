SUMMARY="2D graphics library"
DESCRIPTION="open source 2D graphics library \
providing high-performance rasterization, text rendering, image \
decoding/encoding, paths, gradients, filters, GPU rendering and \
OpenGL/Graphite graphics backends."

HOMEPAGE="https://skia.org/"
COPYRIGHT="2005-2026 Google LLC"
LICENSE="BSD (3-clause)"
REVISION="1"

srcGitRev="e9bf12b060bba818e1850733305ceabdb5cdecc9"
SOURCE_URI="https://github.com/google/skia/archive/$srcGitRev.tar.gz"
CHECKSUM_SHA256="af49fa5d3ce71860ae4de89b0711bc77209cb1daefdf3abb505c56ed632aad1c"
SOURCE_DIR="skia-$srcGitRev"
#PATCHES="skia-$srcGitRev.patchset"
ADDITIONAL_FILES="
	haiku-args.gn
	"

ARCHITECTURES="?all !x86_gcc2"
SECONDARY_ARCHITECTURES="?x86"

libVersion="0.0.0"
libVersionCompat="$libVersion compat >= 0.0.0"

PROVIDES="
	skia$secondaryArchSuffix = $portVersion
	lib:libskia$secondaryArchSuffix = $libVersionCompat
	"

REQUIRES="
	haiku$secondaryArchSuffix
	lib:libfontconfig$secondaryArchSuffix
	lib:libfreetype$secondaryArchSuffix
	lib:libGL$secondaryArchSuffix
	lib:libjpeg$secondaryArchSuffix
	lib:libpng16$secondaryArchSuffix
	lib:libwebp$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

PROVIDES_devel="
	skia${secondaryArchSuffix}_devel = $portVersion
	devel:libskia$secondaryArchSuffix = $libVersionCompat
	"

REQUIRES_devel="
	skia$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libfontconfig$secondaryArchSuffix
	devel:libfreetype$secondaryArchSuffix
	devel:libGL$secondaryArchSuffix
	devel:libjpeg$secondaryArchSuffix
	devel:libpng16$secondaryArchSuffix
	devel:libwebp$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"

BUILD_PREREQUIRES="
	cmd:clang$secondaryArchSuffix
	cmd:clang++$secondaryArchSuffix
	cmd:gn
	cmd:ninja
	cmd:python3
	cmd:git
	cmd:tar
	cmd:pkg_config$secondaryArchSuffix
	cmd:ar$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	cmd:strip$secondaryArchSuffix
	"

BUILD()
{
	cp "$portDir/additional-files/haiku-args.gn" args.gn

	mkdir -p out/Haiku

	cp args.gn out/Haiku/args.gn

	python3 tools/git-sync-deps

	bin/gn gen out/Haiku

	ninja -C out/Haiku skia
}

INSTALL()
{
	mkdir -p "$libDir"
	mkdir -p "$includeDir/skia"
	mkdir -p "$developLibDir/cmake"
	mkdir -p "$developLibDir/pkgconfig"

	cp -a out/Haiku/libskia.so* "$libDir/"

	cp -a include/* "$includeDir/skia/"
	cp -a modules/*/include/* "$includeDir/skia/" 2>/dev/null || true

	prepareInstalledDevelLib libskia

	fixPkgconfig

	packageEntries devel \
		"$developDir"
}
