SUMMARY="A cross-platform game programming library"
DESCRIPTION="Allegro 4 and Allegro 5 are cross-platform, libraries mainly \
aimed at video game and multimedia programming. They handle common, low-level \
tasks such as creating windows, accepting user input, loading data, drawing \
images, playing sounds, etc. and generally abstracting away the underlying \
platform. However, Allegro is not a game engine: you are free to design and \
structure your program as you like.

According to the Oxford Companion to Music, Allegro is the Italian for «quick, \
lively, bright». It is also a recursive acronym which stands for «Allegro Low \
LEvel Game ROutines». Allegro was started by Shawn Hargreaves in the mid-90's \
but has since received contributions from hundreds of people over the net."
HOMEPAGE="https://liballeg.org/"
COPYRIGHT="2008-2026 Allegro Development Team"
LICENSE="Allegro"
REVISION="1"
SOURCE_URI="https://github.com/liballeg/allegro5/releases/download/$portVersion/allegro-$portVersion.tar.gz"
CHECKSUM_SHA256="aba4679a5b1f2bf62482eba6e8814a94de7ffc86de5f8587ba199fcc61b4a04f"
SOURCE_DIR="allegro-$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

libVersion="5.2.11"
libVersionCompat="$libVersion compat >= 5.2"

PROVIDES="
	allegro5$secondaryArchSuffix = $portVersion
	lib:liballegro$secondaryArchSuffix = $libVersionCompat
	lib:liballegro_acodec$secondaryArchSuffix = $libVersionCompat
	lib:liballegro_audio$secondaryArchSuffix = $libVersionCompat
	lib:liballegro_color$secondaryArchSuffix = $libVersionCompat
	lib:liballegro_font$secondaryArchSuffix = $libVersionCompat
	lib:liballegro_image$secondaryArchSuffix = $libVersionCompat
	lib:liballegro_main$secondaryArchSuffix = $libVersionCompat
	lib:liballegro_memfile$secondaryArchSuffix = $libVersionCompat
	lib:liballegro_primitives$secondaryArchSuffix = $libVersionCompat
	lib:liballegro_ttf$secondaryArchSuffix = $libVersionCompat
	devel:liballegro_video$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libGL$secondaryArchSuffix
	lib:libGLU$secondaryArchSuffix
	lib:libflac$secondaryArchSuffix
	lib:libfreeimage$secondaryArchSuffix
	lib:libfreetype$secondaryArchSuffix
	lib:libogg$secondaryArchSuffix
	lib:libopenal$secondaryArchSuffix
	lib:libopenmpt$secondaryArchSuffix
#	lib:libopus$secondaryArchSuffix
	lib:libpng16$secondaryArchSuffix
	lib:libsdl2_2.0$secondaryArchSuffix
	lib:libtheora$secondaryArchSuffix
	lib:libturbojpeg$secondaryArchSuffix
	lib:libvorbis$secondaryArchSuffix
	lib:libvorbisfile$secondaryArchSuffix
	lib:libwebp$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

PROVIDES_devel="
	allegro5${secondaryArchSuffix}_devel = $portVersion
	devel:liballegro$secondaryArchSuffix = $libVersionCompat
	devel:liballegro_acodec$secondaryArchSuffix = $libVersionCompat
	devel:liballegro_audio$secondaryArchSuffix = $libVersionCompat
	devel:liballegro_color$secondaryArchSuffix = $libVersionCompat
	devel:liballegro_font$secondaryArchSuffix = $libVersionCompat
	devel:liballegro_image$secondaryArchSuffix = $libVersionCompat
	devel:liballegro_main$secondaryArchSuffix = $libVersionCompat
	devel:liballegro_memfile$secondaryArchSuffix = $libVersionCompat
	devel:liballegro_primitives$secondaryArchSuffix = $libVersionCompat
	devel:liballegro_ttf$secondaryArchSuffix = $libVersionCompat
	devel:liballegro_video$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	allegro5$secondaryArchSuffix == $portVersion base
	devel:libGL$secondaryArchSuffix
	devel:libGLU$secondaryArchSuffix
	devel:libflac$secondaryArchSuffix
	devel:libfreeimage$secondaryArchSuffix
	devel:libfreetype$secondaryArchSuffix
	devel:libogg$secondaryArchSuffix
	devel:libopenal$secondaryArchSuffix
	devel:libopenmpt$secondaryArchSuffix
#	devel:libopus$secondaryArchSuffix
	devel:libpng16$secondaryArchSuffix
	devel:libsdl2_2.0$secondaryArchSuffix
	devel:libtheora$secondaryArchSuffix
	devel:libturbojpeg$secondaryArchSuffix
	devel:libvorbis$secondaryArchSuffix
	devel:libvorbisfile$secondaryArchSuffix
	devel:libwebp$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"
BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libGL$secondaryArchSuffix
	devel:libGLU$secondaryArchSuffix
	devel:libflac$secondaryArchSuffix
	devel:libfreeimage$secondaryArchSuffix
	devel:libfreetype$secondaryArchSuffix
	devel:libogg$secondaryArchSuffix
	devel:libopenal$secondaryArchSuffix
	devel:libopenmpt$secondaryArchSuffix
#	devel:libopus$secondaryArchSuffix
	devel:libpng16$secondaryArchSuffix
	devel:libsdl2_2.0$secondaryArchSuffix
	devel:libtheora$secondaryArchSuffix
	devel:libturbojpeg$secondaryArchSuffix
	devel:libvorbis$secondaryArchSuffix
	devel:libvorbisfile$secondaryArchSuffix
	devel:libwebp$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	cmd:ninja
	cmd:pkg_config$secondaryArchSuffix
	"

BUILD()
{
	 cmake -B build -S . -G Ninja \
	 	$cmakeDirArgs \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_LIBDIR=$relativeLibDir \
        -DCMAKE_INSTALL_INCLUDEDIR=$relativeIncludeDir \
		-DLIB_SUFFIX=$secondaryArchSubDir \
        -DBUILD_SHARED_LIBS=ON \
        -DSDL2_INCLUDE_DIR=$(finddir B_SYSTEM_HEADERS_DIRECTORY)/SDL2 \
        -DALLEGRO_SDL=ON \
        -DWANT_X11=OFF \
        -DWANT_DOCS=OFF \
        -DWANT_DEMO=OFF \
        -DWANT_EXAMPLES=OFF \
        -DWANT_IMAGE_FREEIMAGE=ON \
        -DWANT_LUAJIT=OFF \
        -DWANT_NATIVE_DIALOG=OFF \
        -DWANT_PRIMITIVES=ON \
        -DWANT_PYTHON_WRAPPER=OFF \
        -DWANT_OPENGL=ON \
        -DWANT_OPUS=OFF \
        -DWANT_SHADERS_GL=ON \
        -DWANT_TESTS=ON \
        -DWANT_VIDEO=ON

	cmake --build build --parallel "$jobArgs"
}

INSTALL()
{
	cmake --install build

	mkdir -p "$developDir/headers"
	mv "$prefix/include/allegro5" "$developDir/headers/"
	rmdir "$prefix/include"

	prepareInstalledDevelLibs liballegro liballegro_acodec liballegro_audio \
		liballegro_color liballegro_font liballegro_image liballegro_main \
		liballegro_memfile liballegro_primitives liballegro_ttf liballegro_video
	fixPkgconfig

	packageEntries devel \
		$developDir
}

TEST()
{
    ctest --test-dir build --output-on-failure
}
