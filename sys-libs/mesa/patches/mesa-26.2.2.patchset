From 59f165c8aac0ee34836e7b5fbd50e02119983ace Mon Sep 17 00:00:00 2001
From: Ken Mays <kmays2000@gmail.com>
Date: Wed, 1 Jul 2026 01:12:06 -0700
Subject: Fix ENOMEM warnings


diff --git a/src/util/os_file.c b/src/util/os_file.c
index 7d99383e..14a86d59 100644
--- a/src/util/os_file.c
+++ b/src/util/os_file.c
@@ -156,7 +156,7 @@ os_read_file(const char *filename, size_t *size)
    char *buf = malloc(len);
    if (!buf) {
       close(fd);
-      errno = -ENOMEM;
+      errno = ENOMEM;
       return NULL;
    }
 
@@ -167,7 +167,7 @@ os_read_file(const char *filename, size_t *size)
       if (!newbuf) {
          free(buf);
          close(fd);
-         errno = -ENOMEM;
+         errno = ENOMEM;
          return NULL;
       }
 
@@ -187,7 +187,7 @@ os_read_file(const char *filename, size_t *size)
    char *newbuf = realloc(buf, len);
    if (!newbuf) {
       free(buf);
-      errno = -ENOMEM;
+      errno = ENOMEM;
       return NULL;
    }
    buf = newbuf;
-- 
2.54.0


From d4f665673a54005e7f5853c5ad46141a85cf4a1f Mon Sep 17 00:00:00 2001
From: Augustin Cavalier <waddlesplash@gmail.com>
Date: Fri, 2 Jan 2026 09:42:13 -0600
Subject: renderdoc: Add Haiku platform support


diff --git a/include/renderdoc_app.h b/include/renderdoc_app.h
index b2d10c5e..debd0c72 100644
--- a/include/renderdoc_app.h
+++ b/include/renderdoc_app.h
@@ -35,7 +35,7 @@
 
 #if defined(WIN32) || defined(__WIN32__) || defined(_WIN32) || defined(_MSC_VER)
 #define RENDERDOC_CC __cdecl
-#elif defined(__linux__)
+#elif defined(__linux__) || defined(__HAIKU__)
 #define RENDERDOC_CC
 #elif defined(__APPLE__)
 #define RENDERDOC_CC
-- 
2.54.0

