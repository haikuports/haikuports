SUMMARY="Simulator Construction Tools library"
DESCRIPTION="SimGear is a set of open-source libraries used as building blocks for 3D simulations, games, visualization applications, and FlightGear."
HOMEPAGE="https://www.flightgear.org/"
COPYRIGHT="2000-2025 The FlightGear contributors"
LICENSE="GNU LGPL v2.1"
REVISION="1"
SOURCE_URI="https://gitlab.com/flightgear/simgear/-/archive/$portVersion/simgear-$portVersion.tar.bz2"
CHECKSUM_SHA256="131a7a2fce9c652a530c651e8c589ba02e2b22e5a64269801303c2fdedb072fb"
SOURCE_FILENAME="simgear-$portVersion.tar.gz"
SOURCE_DIR="simgear-$portVersion"
PATCHES="simgear-$portVersion.patchset"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="!x86"

libVersion="$portVersion"

PROVIDES="
	simgear$secondaryArchSuffix = $portVersion
	lib:libSimGearCore$secondaryArchSuffix = $libVersion
	lib:libSimGearScene$secondaryArchSuffix = $libVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libcares$secondaryArchSuffix
	lib:libcurl$secondaryArchSuffix
	lib:libexpat$secondaryArchSuffix
	lib:libgl$secondaryArchSuffix
	lib:libjpeg$secondaryArchSuffix
	lib:liblzma$secondaryArchSuffix
	lib:libopenal$secondaryArchSuffix
	lib:libosg$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

PROVIDES_devel="
	simgear${secondaryArchSuffix}_devel = $portVersion
	devel:libSimGearCore$secondaryArchSuffix = $libVersion
	devel:libSimGearScene$secondaryArchSuffix = $libVersion
	"
REQUIRES_devel="
	simgear$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	boost1.90${secondaryArchSuffix}_devel
	devel:libcares$secondaryArchSuffix
	devel:libcurl$secondaryArchSuffix
	devel:libexpat$secondaryArchSuffix
	devel:libgl$secondaryArchSuffix
	devel:libjpeg$secondaryArchSuffix
	devel:liblzma$secondaryArchSuffix
	devel:libopenal$secondaryArchSuffix
	devel:libosg$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:gcc$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	cmd:make
	cmd:pkg_config$secondaryArchSuffix
	"

defineDebugInfoPackage simgear$secondaryArchSuffix \
	"$libDir"/libSimGearCore.so.$libVersion \
	"$libDir"/libSimGearScene.so.$libVersion \


PATCH()
{
	sed -i \
		-e "/^[ ]*install .*DESTINATION include/ \
			s|include\(/simgear/\)|$relativeIncludeDir\1|" \
		CMakeLists.txt \
		simgear/CMakeLists.txt \
		CMakeModules/SimGearComponent.cmake
}

BUILD()
{
	mkdir -p build && cd build
	cmake .. $cmakeDirArgs \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_INSTALL_PREFIX:PATH="$prefix" \
		-DCMAKE_INSTALL_INCLUDEDIR:PATH="$includeDir" \
		-DCMAKE_INSTALL_LIBDIR:PATH="$libDir" \
		-DSIMGEAR_SHARED=ON \
		-DSIMGEAR_HEADLESS=OFF \
		-DENABLE_SOUND=ON \
		-DUSE_AEONWAVE=OFF \
		-DUSE_OPENALSOFT=ON \
		-DENABLE_CYCLONE=OFF \
		-DENABLE_RTI=OFF \
		-DENABLE_GDAL=OFF \
		-DENABLE_TESTS=OFF \
		-DENABLE_PKGUTIL=OFF \
		-DENABLE_VIDEO_RECORD=OFF \
		-DENABLE_SIMD=OFF \
		-DSYSTEM_EXPAT=ON \
		-DSYSTEM_UDNS=OFF \
		-DCMAKE_SKIP_RPATH=ON

	make $jobArgs
}

INSTALL()
{
	cd build
	cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-P cmake_install.cmake

	sed -i \
		-e "s|\(\${_IMPORT_PREFIX}/\)include;|\1$relativeIncludeDir;|" \
		"$libDir"/cmake/SimGear/SimGearTargets.cmake

	prepareInstalledDevelLibs libSimGearCore libSimGearScene
	fixPkgconfig

	packageEntries devel \
		"$developDir" \
		"$libDir"/cmake
}
