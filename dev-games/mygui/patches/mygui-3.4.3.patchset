From cc18cf65ee48a9ee0134fd162bd55432d01fef86 Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Mon, 27 Jul 2026 19:36:41 +0200
Subject: Port patch from MyGUI 3.2.3


diff --git a/CMake/InstallResources.cmake b/CMake/InstallResources.cmake
index 999df0e..606afae 100644
--- a/CMake/InstallResources.cmake
+++ b/CMake/InstallResources.cmake
@@ -52,6 +52,8 @@ if (MYGUI_INSTALL_DEMOS OR MYGUI_INSTALL_TOOLS)
 
 	if (WIN32)
 		set(MYGUI_MEDIA_DIR "../../Media")
+	elseif (HAIKU)
+		set(MYGUI_MEDIA_DIR "/system/data/MYGUI/Media")
 	elseif (UNIX)
 		set(MYGUI_MEDIA_DIR "../share/MYGUI/Media")
 	else ()
diff --git a/Common/Base/Main.h b/Common/Base/Main.h
index 8fc476a..fa64163 100644
--- a/Common/Base/Main.h
+++ b/Common/Base/Main.h
@@ -16,12 +16,27 @@
 	#include <direct.h>
 #endif
 
+#ifdef __HAIKU__
+#include <unistd.h>
+#endif
+
 #if MYGUI_PLATFORM == MYGUI_PLATFORM_WIN32
 	#define MYGUI_APP(cls) \
 		INT WINAPI WinMain(HINSTANCE hInst, HINSTANCE, LPSTR strCmdLine, INT argc) \
 		{ \
 			return startApp<cls>(); \
 		}
+#elif defined(__HAIKU__)
+#	define MYGUI_APP(cls) \
+	int main(int argc, char **argv) \
+	{ \
+		char *ptr; \
+		if(ptr = strrchr(argv[0], '/')) { \
+			*ptr = '\0'; \
+			chdir(argv[0]); \
+		} \
+		return startApp<cls>(); \
+	}
 #else
 	#define MYGUI_APP(cls) \
 		int main(int argc, char** argv) \
diff --git a/Media/CMakeLists.txt b/Media/CMakeLists.txt
index 070a06a..f352878 100644
--- a/Media/CMakeLists.txt
+++ b/Media/CMakeLists.txt
@@ -5,6 +5,8 @@
 # Set media target directory
 if (WIN32)
   set(MYGUI_MEDIA_PATH "Media")
+elseif (HAIKU)
+  set(MYGUI_MEDIA_PATH "data/MYGUI/Media")
 elseif (UNIX)
   set(MYGUI_MEDIA_PATH "share/MYGUI/Media")
 endif ()
-- 
2.54.0


From 7a60b758e931b7ba3276dbed9d1849b7d5b1b918 Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Mon, 27 Jul 2026 19:37:05 +0200
Subject: Fix libgl name for Haiku


diff --git a/Platforms/OpenGL/OpenGLPlatform/CMakeLists.txt b/Platforms/OpenGL/OpenGLPlatform/CMakeLists.txt
index 0d58d3d..39b6012 100644
--- a/Platforms/OpenGL/OpenGLPlatform/CMakeLists.txt
+++ b/Platforms/OpenGL/OpenGLPlatform/CMakeLists.txt
@@ -23,7 +23,7 @@ add_library(${PROJECTNAME} ${HEADER_FILES} ${SOURCE_FILES})
 
 add_dependencies(${PROJECTNAME} MyGUIEngine)
 
-if (APPLE OR WIN32)
+if (APPLE OR WIN32 OR HAIKU)
 	target_link_libraries(${PROJECTNAME} ${OPENGL_gl_LIBRARY} MyGUIEngine)
 else ()
 	# opengl instead of gl makes it compile and work in a libX11-free wayland setup
-- 
2.54.0

