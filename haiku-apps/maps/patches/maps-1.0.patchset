From 1ac3cc86884400120543dda841cd478cfe090e85 Mon Sep 17 00:00:00 2001
From: Luc Schrijvers <begasus@gmail.com>
Date: Tue, 13 Oct 2026 18:32:51 +0200
Subject: Fixes for beta6 Burl


diff --git a/src/MapsData.cpp b/src/MapsData.cpp
index d3714dd..aed87d7 100644
--- a/src/MapsData.cpp
+++ b/src/MapsData.cpp
@@ -130,7 +130,7 @@ void MapsData::Retrieve()
 	dataUrl.SetToFormat(baseUrl.String(), mapsVector.longitude, mapsVector.latitude, mapsVector.zoom, mapsVector.bearing, mapsVector.pitch, mapsVector.width, mapsVector.height);
 	
 	listener = new MapsData_Listener();
-	request = BPrivate::Network::BUrlProtocolRoster::MakeRequest(BUrl(dataUrl.String()), data, listener);
+	request = BPrivate::Network::BUrlProtocolRoster::MakeRequest(BUrl(dataUrl.String(), true), data, listener);
 
 	thread = request->Run();
 }
diff --git a/src/SearchForm.cpp b/src/SearchForm.cpp
index ab0b125..53ab9d2 100644
--- a/src/SearchForm.cpp
+++ b/src/SearchForm.cpp
@@ -216,7 +216,7 @@ void SearchResultList::MessageReceived(BMessage* message) {
 				request = NULL;
 			}
 			result = new BMallocIO();
-			request = BPrivate::Network::BUrlProtocolRoster::MakeRequest(BUrl(url.String()), result, this);
+			request = BPrivate::Network::BUrlProtocolRoster::MakeRequest(BUrl(url.String(), true), result, this);
 			thread = request->Run();
 		}break;
 		case M_SEARCHRESULTLIST_ON_SELECT: {
