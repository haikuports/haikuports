From 62d8dc87bee1f265aec352ab3f83795542723f56 Mon Sep 17 00:00:00 2001
From: Oscar Lesta <oscar.lesta@gmail.com>
Date: Mon, 9 Nov 2026 03:58:11 -0300
Subject: quick build fix for x86 (x86_32).

On Haiku beta6.

diff --git a/APlayer/Agents/ProWizard/Makefile b/APlayer/Agents/ProWizard/Makefile
index ff29f51..3f8e05f 100644
--- a/APlayer/Agents/ProWizard/Makefile
+++ b/APlayer/Agents/ProWizard/Makefile
@@ -151,7 +151,7 @@ SYMBOLS :=
 DEBUGGER :=
 
 #	Specify any additional compiler flags to be used.
-COMPILER_FLAGS =
+COMPILER_FLAGS = -Wno-narrowing
 
 #	Specify any additional linker flags to be used.
 LINKER_FLAGS =
diff --git a/APlayer/Players/SidPlay/Makefile b/APlayer/Players/SidPlay/Makefile
index a289b81..525f412 100644
--- a/APlayer/Players/SidPlay/Makefile
+++ b/APlayer/Players/SidPlay/Makefile
@@ -121,7 +121,7 @@ SYMBOLS :=
 DEBUGGER :=
 
 #	Specify any additional compiler flags to be used.
-COMPILER_FLAGS =
+COMPILER_FLAGS = -Wno-narrowing
 
 #	Specify any additional linker flags to be used.
 LINKER_FLAGS =
diff --git a/PolyKit/Sources/PSystem.cpp b/PolyKit/Sources/PSystem.cpp
index f7b1043..213889c 100644
--- a/PolyKit/Sources/PSystem.cpp
+++ b/PolyKit/Sources/PSystem.cpp
@@ -241,7 +241,7 @@ uint32 PSystem::ConvertOSError(int32 osError)
 		//
 		case B_STREAM_NOT_FOUND:
 		case B_SERVER_NOT_FOUND:
-		case 0x80004100:
+		case B_MEDIA_SYSTEM_FAILURE:
 		{
 			polyErr = P_SOUND_ERR_NO_SOFTWARE;
 			break;
@@ -249,7 +249,7 @@ uint32 PSystem::ConvertOSError(int32 osError)
 
 		case B_RESOURCE_NOT_FOUND:
 		case B_RESOURCE_UNAVAILABLE:
-		case 0x80004101:
+		case B_MEDIA_BAD_NODE:
 		{
 			polyErr = P_SOUND_ERR_NO_SOUNDCARD;
 			break;
-- 
2.54.0

