SUMMARY="A native REST API client"
DESCRIPTION="NetWorker is a native REST API client. Send HTTP requests with custom methods, \
headers and body content, and view the response code, headers and body. Import and export JSON-encoded collections."
HOMEPAGE="https://github.com/dospuntos/NetWorker"
COPYRIGHT="2026 Johan Wagenheim"
LICENSE="MIT"
REVISION="2"
SOURCE_URI="$HOMEPAGE/archive/v$portVersion.tar.gz"
CHECKSUM_SHA256="c7c6c98f9c3f44cc0bc67b23032c855a68758923d72e4ca1813527c5165776f6"
SOURCE_DIR="NetWorker-$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	networker$secondaryArchSuffix = $portVersion
	app:NetWorker = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	makefile_engine
	cmd:gcc$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	make $jobArgs
}

INSTALL()
{
	mkdir -p $appsDir
	cp NetWorker $appsDir
	addAppDeskbarSymlink $appsDir/NetWorker
}
