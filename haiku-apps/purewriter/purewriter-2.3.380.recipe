SUMMARY="LibreOffice and MS Word compatible word processor"
DESCRIPTION="PureWriter is a LibreOffice and MS Word compatible word \
processor with drawing features, partly inspired by Gobe Productive. It \
opens and saves ODF and Office Open XML documents, exports PDF, RTF, \
Markdown, LyX and e-books, and checks spelling with hunspell."
HOMEPAGE="https://codeberg.org/pmandalian/PureMail"
COPYRIGHT="2021-2026 Pawel Mandalian"
LICENSE="MIT"
REVISION="1"
srcGitRev="6523beefd2f556cdc9060605d83004f08e1e7b36"
SOURCE_URI="$HOMEPAGE/archive/$srcGitRev.tar.gz"
CHECKSUM_SHA256="d870a93ab04fd679753d5fc30551db01b7d4a0eb341b2815836bbf220f837943"
SOURCE_DIR="puremail"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	purewriter$secondaryArchSuffix = $portVersion
	app:PureWriter = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libcrypto$secondaryArchSuffix
	lib:libfreetype$secondaryArchSuffix
	lib:libhpdf$secondaryArchSuffix
	lib:libhunspell_1.7$secondaryArchSuffix
	lib:libicui18n$secondaryArchSuffix
	lib:libicuuc$secondaryArchSuffix
	lib:libjpeg$secondaryArchSuffix
	lib:libopenjp2$secondaryArchSuffix
	lib:libpng16$secondaryArchSuffix
	lib:libsqlite3$secondaryArchSuffix
	lib:libssl$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
#	loaded at run time
	lib:libharfbuzz$secondaryArchSuffix
	noto_emoji_color
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libcrypto$secondaryArchSuffix >= 3
	devel:libfreetype$secondaryArchSuffix >= 6
	devel:libhpdf$secondaryArchSuffix >= 2.4.3
	devel:libhunspell_1.7$secondaryArchSuffix
	devel:libicui18n$secondaryArchSuffix >= 74
	devel:libicuuc$secondaryArchSuffix >= 74
	devel:libjpeg$secondaryArchSuffix >= 62
	devel:libopenjp2$secondaryArchSuffix >= 7
	devel:libpng16$secondaryArchSuffix >= 16
	devel:libsqlite3$secondaryArchSuffix >= 3
	devel:libssl$secondaryArchSuffix >= 3
	devel:libz$secondaryArchSuffix >= 1
	"
BUILD_PREREQUIRES="
	makefile_engine
	cmd:g++$secondaryArchSuffix
	cmd:make
	cmd:mkdepend
	"

BUILD()
{
	sh PureWriter/build.sh --release
}

INSTALL()
{
	appDir=$appsDir/PureWriter
	mkdir -p $appDir/Translations
	cp PureWriter/app/objects.*/PureWriter $appDir/
	cp PureWriter/app/StylesStandard.odt PureWriter/app/StylesStandard.dotx \
		PureWriter/Assets/PureWriterHyph.txt PureWriter/license*.txt $appDir/
	cp PureWriter/Translations/*.txt.po $appDir/Translations/
	addAppDeskbarSymlink $appDir/PureWriter
}
