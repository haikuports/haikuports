From c4f23c12325920caab97ba032485ea8f9528051a Mon Sep 17 00:00:00 2001
From: Jackburton79 <stefano.ceccherini@gmail.com>
Date: Thu, 12 Nov 2026 12:19:47 +0100
Subject: [PATCH] Fixed build on 32 bit

uname -p returns x86_64 on 64 bit, just like getarch, but on 32 bit it returns BePC
So, use the arch (getarch) variable instead of platform (uname -p)
---
 Makefile | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index 20be7bcc..f54bb643 100644
--- a/Makefile
+++ b/Makefile
@@ -49,8 +49,8 @@ LIBS += libs/scintilla/bin/libscintilla.a
 
 PRIVATE_HEADERS = interface locale shared storage support tracker
 SYSTEM_INCLUDE_PATHS  = $(foreach header,$(PRIVATE_HEADERS),$(shell findpaths -e B_FIND_PATH_HEADERS_DIRECTORY private/$(header)))
-SYSTEM_INCLUDE_PATHS += $(shell findpaths -a $(platform) -e B_FIND_PATH_HEADERS_DIRECTORY lexilla)
-SYSTEM_INCLUDE_PATHS += $(shell findpaths -a $(platform) -e B_FIND_PATH_HEADERS_DIRECTORY lsp)
+SYSTEM_INCLUDE_PATHS += $(shell findpaths -a $(arch) -e B_FIND_PATH_HEADERS_DIRECTORY lexilla)
+SYSTEM_INCLUDE_PATHS += $(shell findpaths -a $(arch) -e B_FIND_PATH_HEADERS_DIRECTORY lsp)
 SYSTEM_INCLUDE_PATHS += libs libs/json libs/scintilla/haiku libs/scintilla/include
 
 
-- 
2.56.0

