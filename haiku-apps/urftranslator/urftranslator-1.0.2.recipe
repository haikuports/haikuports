SUMMARY="URF Translator for Haiku"
DESCRIPTION="A Haiku Translation Kit add-on to support URF (AirPrint) image viewing"
HOMEPAGE="https://codeberg.org/phoudoin/URFTranslator"
COPYRIGHT="2026 Philippe Houdoin"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="$HOMEPAGE/archive/v$portVersion.tar.gz"
CHECKSUM_SHA256="09f5bc6e39708b7a66d9cdfc69eb788a1cb6416db0dd91959d85fee607d3aa0c"
SOURCE_DIR="urftranslator"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	urftranslator$secondaryArchSuffix = $portVersion
	addon:URFTranslator$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	makefile_engine
	cmd:gcc$secondaryArchSuffix
	cmd:ld$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	make $jobArgs OBJ_DIR=build
	make bindcatalogs OBJ_DIR=build
	rc URFMime.rdef -o URFMime.rsrc
}

INSTALL()
{
	mkdir -p $addOnsDir/Translators
	cp build/URFTranslator $addOnsDir/Translators

	# Install MIME registration resources
	mkdir -p $dataDir/mime_db/image
	resattr -O -o $dataDir/mime_db/image/urf URFMime.rsrc
}
