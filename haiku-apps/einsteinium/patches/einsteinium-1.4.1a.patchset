From 6952bab0dc33a35cd283ac3a89a3fd78dee0061d Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Sun, 26 Jul 2026 17:11:39 +0200
Subject: Fix build with current compilers


diff --git a/src/Preferences/BitmapListItem.cpp b/src/Preferences/BitmapListItem.cpp
index 2893b7a..15afc41 100644
--- a/src/Preferences/BitmapListItem.cpp
+++ b/src/Preferences/BitmapListItem.cpp
@@ -175,3 +175,6 @@ BitmapListItem::GetWidth(const BFont *font)
 		width += fIconSize + (2*kIconInset);
 	return width;
 }
+
+const float BitmapListItem::kIconInset = 2;
+const float BitmapListItem::kTextInset = 2;
diff --git a/src/Preferences/BitmapListItem.h b/src/Preferences/BitmapListItem.h
index 5f95b83..83bad61 100644
--- a/src/Preferences/BitmapListItem.h
+++ b/src/Preferences/BitmapListItem.h
@@ -20,8 +20,8 @@ public:
 	virtual void	Update(BView *owner, const BFont *font);
 	float			GetWidth(const BFont*);
 private:
-	static const float kIconInset = 2;
-	static const float kTextInset = 2;
+	static const float kIconInset;
+	static const float kTextInset;
 	BString			fText;
 	BBitmap			*fIcon;
 	float			fFontHeight, fFontAscent, fTextOnlyHeight;
-- 
2.54.0

