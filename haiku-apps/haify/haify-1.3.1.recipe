SUMMARY="A Spotify WebApi Client"
DESCRIPTION="Haify is a native Spotify Web API client for Haiku.

Browse your library, discover artists and albums, manage playlists, and control \
Spotify playback through a classic desktop interface.

Haify can also use librespot as a Spotify Connect target, allowing music to be \
played directly on Haiku.

This software was developed with extensive use of AI-assisted coding."
HOMEPAGE="https://github.com/m199/Haify"
COPYRIGHT="2026 Daniel Weber"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://github.com/m199/Haify/archive/refs/tags/1.3.1.tar.gz"
CHECKSUM_SHA256="665c39466e580e1324cab8639eb628d9cd4c0822a0e68676aa8116ca51310b39"
SOURCE_DIR="Haify-$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	Haify$secondaryArchSuffix = $portVersion
	app:Haify = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	cmd:librespot
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:nlohmann_json
	"
BUILD_PREREQUIRES="
	makefile_engine
	cmd:g++$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	make OBJ_DIR=objects $jobArgs
}

INSTALL()
{
	mkdir -p $appsDir
	cp objects/Haify $appsDir
	addAppDeskbarSymlink $appsDir/Haify
}
