From e82c8e47d4bfdf9641dfa96db5014a9ce7c6efc4 Mon Sep 17 00:00:00 2001
From: Humdinger <humdinger@mailbox.org>
Date: Sun, 18 Oct 2026 14:10:21 +0200
Subject: No -Wno-unused-variable, gcc2 doesn't like that


diff --git a/src/Makefile b/src/Makefile
index 9dcf239..b21a516 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -113,7 +113,7 @@ SYMBOLS :=
 DEBUGGER :=
 
 #	Specify any additional compiler flags to be used.
-COMPILER_FLAGS = -Wall -Wno-multichar -Wno-unused-variable
+COMPILER_FLAGS = -Wall -Wno-multichar
 
 #	Specify any additional linker flags to be used.
 LINKER_FLAGS =
