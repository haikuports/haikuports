SUMMARY="A Gopher Client for Haiku"
DESCRIPTION="A human-written, native Gopher client for Haiku, providing basic Gopher capabilities"
HOMEPAGE="https://codeberg.org/mattlacey/GoingDown/releases"
COPYRIGHT="2026 Matt Lacey"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://codeberg.org/mattlacey/GoingDown/archive/$portVersion.tar.gz"
CHECKSUM_SHA256="e5087f74c4d2b34a73c3bf10a490f49761fd65e4f4cccfe2c29de1e803a1bc0b"
SOURCE_FILENAME="GoingDown-$portVersion.tar.gz"
SOURCE_DIR="goingdown"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	goingdown$secondaryArchSuffix = $portVersion
	app:GoingDown = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	makefile_engine
	cmd:gcc$secondaryArchSuffix
	cmd:make
	"

BUILD()
{
	make $jobArgs
}

INSTALL()
{
	install -m 0755 -d "$appsDir"
	install -m 0755 -t "$appsDir" GoingDown

	addAppDeskbarSymlink $appsDir/GoingDown
}
