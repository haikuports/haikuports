SUMMARY="Browse and apply wallpapers from wallhaven.cc"
DESCRIPTION="An unofficial wallpaper browser with previews and original downloads. \
Browse saved images offline and set the desktop background on all workspaces. \
The interface supports English and Chinese."
HOMEPAGE="https://github.com/lhfchym/wallhaven-haiku"
COPYRIGHT="2026 lhfchym"
LICENSE="MIT"
REVISION="7"
srcGitRev="c93b11b5c6783e0b3fdb97fc797018f1bc9ac963"
SOURCE_URI="$HOMEPAGE/archive/$srcGitRev.tar.gz"
CHECKSUM_SHA256="040c50feccaadd2d83e13737dc1d8c87ad830a09c675e498c66ed5d3549337d0"
SOURCE_FILENAME="wallhaven-$portVersion-$srcGitRev.tar.gz"
SOURCE_DIR="wallhaven-haiku-$srcGitRev/Haiku"

ARCHITECTURES="x86_64"

USER_SETTINGS_FILES="settings/Wallhaven directory"

PROVIDES="
	wallhaven = $portVersion
	app:Wallhaven = $portVersion
	"
REQUIRES="
	haiku >= r1~beta6
	lib:libcurl
	lib:libgcc_s
	lib:libstdc++
	"

BUILD_REQUIRES="
	haiku_devel >= r1~beta6
	devel:libcurl
	"
BUILD_PREREQUIRES="
	cmd:g++
	cmd:install
	cmd:ld
	cmd:make
	cmd:objcopy
	"

defineDebugInfoPackage wallhaven "$appsDir/Wallhaven/Wallhaven"

BUILD()
{
	make clean
	make $jobArgs CXXFLAGS="$CXXFLAGS -O2 -g -std=c++17 -Wall -Wextra"
	make test
}

INSTALL()
{
	make install-staged PREFIX="$prefix"
	addAppDeskbarSymlink "$appsDir/Wallhaven/Wallhaven"
}

TEST()
{
	make test
}
